selbox(176, 380, 184, 20, 45);
col(0.03,0.03,0.035); rct(46, 406, 316, 74, 1);
col(0.10,0.105,0.115); gx_ui = 1; loop(3, rct(46 + gx_ui*79, 406, 1, 74, 1); gx_ui += 1;); rct(46, 430, 316, 1, 1);
slider44 ? col(thc0r,thc0g,thc0b) : col(0.35,0.36,0.40);
gx_fc = 20*1000^slider46; gx_r = slider47; gx_ty = slider45; gx_k = 2 - 1.96*gx_r;
gx_ui = 0; gx_lx = 0; gx_ly = 0;
loop(80,
  gx_fh = 20*1000^(gx_ui/79); gx_x = gx_fh/gx_fc;
  gx_dn = sqrt(sqr(1 - gx_x*gx_x) + sqr(gx_k*gx_x)); gx_bw = sqrt(sqr(1 - gx_x*gx_x) + sqr(1.414*gx_x));
  gx_h = gx_ty == 2 ? (
         gx_m4 = sqr(1 + gx_x*gx_x); gx_an = 4*atan(gx_x);
         (1 + gx_r*2.2)/sqrt(sqr(gx_m4*cos(gx_an) + gx_r*4.1) + sqr(gx_m4*sin(gx_an)));
       ) :
       gx_ty == 0 ? 1/gx_dn : gx_ty == 1 ? 1/gx_dn/gx_bw :
       gx_ty == 3 ? gx_x*gx_x/gx_dn : gx_ty == 4 ? gx_x*gx_x/gx_dn*gx_x*gx_x/gx_bw :
       gx_ty == 5 ? gx_k*gx_x/gx_dn : gx_ty == 6 ? gx_k*gx_x/gx_dn*1.414*gx_x/gx_bw :
       gx_ty == 7 ? abs(1 - gx_x*gx_x)/gx_dn : (1 + gx_x*gx_x)/gx_dn;
  gx_db = clamp(20*log10(max(gx_h, 0.00001)), -36, 24);
  gx_x = 46 + gx_ui*316/79; gx_y = 430 - gx_db*48/36;
  gx_ui > 0 ? ln(gx_lx, clamp(gx_ly, 407, 479), gx_x, clamp(gx_y, 407, 479)); gx_lx = gx_x; gx_ly = gx_y;
  gx_ui += 1;
);

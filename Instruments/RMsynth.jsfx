// ---- Glisser-déposer d'une source de modulation ---------------------------------------
md_drag ? (
  col(0.45,0.60,0.95);
  gx_ui = 0; loop(max(1, ceil(2*S)), gfx_line(PX(md_x0) + gx_ui, PY(md_y0), PX(mx) + gx_ui, PY(my), 1); gx_ui += 1;);
  gfx_circle(PX(mx), PY(my), 5*S, 1, 1);
  gfx_setfont(6); strcpy(#s, 170 + md_src); text_l(mx + 10, my - 10, #s);
);

// ---- Saisie du nom (SAVE) ---------------------------------------------------------------
ted_on ? (
  col(0.0,0.0,0.0); gfx_a = 0.55; gfx_rect(0, 0, gfx_w, gfx_h); gfx_a = 1;
  col(0.03,0.03,0.035); rct(330, 250, 440, 130, 1);
  col(0.115,0.12,0.13); rct(332, 252, 436, 126, 1);
  col(thc0r,thc0g,thc0b); rct(332, 252, 436, 2, 1);
  gfx_setfont(4); col(thc0r,thc0g,thc0b);
  strcpy(#t, "SAVE  -  "); strcat(#t, 10 + ted_cat); sprintf(#s, "  /  USER %d", ted_slot + 1); strcat(#t, #s);
  text_l(350, 276, #t);
  col(0.03,0.03,0.035); rct(350, 296, 400, 30, 1);
  gfx_setfont(4); col(0.92,0.93,0.95); strcpy(#t, #ted); (time_precise()*2 % 2) < 1 ? strcat(#t, "_"); text_l(360, 311, #t);
  gfx_setfont(7); col(0.55,0.56,0.60); text_l(350, 352, "type a name  -  Enter: save  -  Esc: cancel");
  gx_ch = gfx_getchar();
  while (gx_ch > 0) (
    gx_ch == 13 ? (
      strlen(#ted) == 0 ? sprintf(#ted, "User %d", ted_slot + 1);
      save_user(ted_cat, ted_slot, #ted); ted_on = 0; gx_ch = 0;
    ) : gx_ch == 27 ? ( ted_on = 0; gx_ch = 0; ) :
    gx_ch == 8 ? ( strlen(#ted) > 0 ? strcpy_substr(#ted, #ted, 0, strlen(#ted) - 1); ) :
    (gx_ch >= 32 && gx_ch < 127 && strlen(#ted) < 28) ? ( str_setchar(#ted, -0.25, gx_ch); );
    gx_ch > 0 ? ( gx_ch = gfx_getchar(); );
  );
);

// ---- Souris ------------------------------------------------------------------------------
mb1 = mouse_cap & 1; mb2 = mouse_cap & 2;
gx_hit = -1;
!ted_on ? (
  gx_ui = rg_n - 1;
  while (gx_ui >= 0 && gx_hit < 0) ( gx_r = RG + gx_ui*8; (mx >= gx_r[0] && mx < gx_r[0] + gx_r[2] && my >= gx_r[1] && my < gx_r[1] + gx_r[3]) ? ( gx_hit = gx_ui; ); gx_ui -= 1; );
);
// clic gauche
(mb1 && !last_mb && gx_hit >= 0) ? (
  gx_r = RG + gx_hit*8; gx_ty = gx_r[4]; gx_ip = gx_r[5]; gx_va = gx_r[6];
  gx_ty == 1 ? (
    (mouse_cap & 4) ? set_sl(gx_ip, PDEF[gx_ip]) : ( drag_p = gx_ip; drag_acc = 0; );
  ) :
  gx_ty == 2 ? set_sl(gx_ip, slider(gx_ip) >= 0.5 ? 0 : 1) :
  gx_ty == 3 ? set_sl(gx_ip, gx_va) :
  gx_ty == 5 ? (
    gx_v = slider(gx_ip) + gx_va; gx_v > PMAX[gx_ip] ? ( gx_v = PMIN[gx_ip]; ); gx_v < PMIN[gx_ip] ? ( gx_v = PMAX[gx_ip]; ); set_sl(gx_ip, gx_v);
  ) :
  gx_ty == 6 ? (
    strcpy(#mn, ""); gx_ui = PMIN[gx_ip];
    loop(PMAX[gx_ip] - PMIN[gx_ip] + 1,
      gx_ui == slider(gx_ip) ? strcat(#mn, "!"); strcat(#mn, PSTR[gx_ip] + gx_ui); strcat(#mn, "|");
      gx_ui += 1;
    );
    gfx_x = PX(gx_r[0]); gfx_y = PY(gx_r[1] + gx_r[3]);
    gx_res = gfx_showmenu(#mn);
    gx_res > 0 ? set_sl(gx_ip, PMIN[gx_ip] + gx_res - 1);
  ) :
  gx_ty == 7 ? ( md_src = gx_va; md_x0 = mx; md_y0 = my; md_drag = 0; md_down = 1; ) :
  gx_ty == 4 ? (
    gx_va >= 1 && gx_va <= 8 ? ( load_pre(gx_va - 1, 0); cur_cat = gx_va - 1; ) :
    gx_va == 20 ? step_pre(-1) : gx_va == 21 ? step_pre(1) :
    gx_va == 22 ? (
      // menu de tous les presets, rangés par catégorie
      strcpy(#mn, ""); gx_mi = 0; gx_c = 0;
      loop(8,
        strcat(#mn, ">"); strcat(#mn, 10 + gx_c); strcat(#mn, "|");
        gx_nn = 0; gx_k = 0; loop(24, pre_ok(gx_c, gx_k) ? ( gx_nn += 1; ); gx_k += 1;);
        gx_j = 0; gx_k = 0;
        loop(24,
          pre_ok(gx_c, gx_k) ? (
            gx_j += 1; gx_j == gx_nn ? strcat(#mn, "<");
            (gx_c == cur_cat && gx_k == cur_idx) ? strcat(#mn, "!");
            gx_k >= 16 ? strcat(#mn, "User: "); pre_name(gx_c, gx_k); strcat(#mn, #pn); strcat(#mn, "|");
            MMAP[gx_mi] = gx_c*32 + gx_k; gx_mi += 1;
          );
          gx_k += 1;
        );
        gx_c += 1;
      );
      gfx_x = PX(590); gfx_y = PY(92);
      gx_res = gfx_showmenu(#mn);
      gx_res > 0 ? ( gx_k = MMAP[gx_res - 1]; load_pre(floor(gx_k/32), gx_k % 32); );
    ) :
    gx_va == 23 ? (
      strcpy(#mn, ""); gx_mi = 0; gx_c = 0;
      loop(8,
        strcat(#mn, ">Save to "); strcat(#mn, 10 + gx_c); strcat(#mn, "|");
        gx_k = 0;
        loop(8,
          gx_k == 7 ? strcat(#mn, "<");
          (UP + (gx_c*8 + gx_k)*NPS)[0] ? ( sprintf(#s, "User %d: ", gx_k + 1); strcat(#s, 300 + gx_c*8 + gx_k); strcat(#s, " (replace)|"); )
                                    : ( sprintf(#s, "User %d (empty)|", gx_k + 1); );
          strcat(#mn, #s); MMAP[gx_mi] = gx_c*32 + 16 + gx_k; gx_mi += 1;
          gx_k += 1;
        );
        gx_c += 1;
      );
      strcat(#mn, "|>Delete user preset|");
      gx_nn = 0; gx_k = 0; loop(64, UP[gx_k*NPS] ? ( gx_nn += 1; ); gx_k += 1;);
      gx_nn == 0 ? ( strcat(#mn, "<#(none)|"); MMAP[gx_mi] = -1; gx_mi += 1; ) : (
        gx_j = 0; gx_k = 0;
        loop(64,
          UP[gx_k*NPS] ? (
            gx_j += 1; gx_j == gx_nn ? strcat(#mn, "<");
            strcpy(#s, 10 + floor(gx_k/8)); strcat(#s, " / "); strcat(#s, 300 + gx_k); strcat(#s, "|"); strcat(#mn, #s);
            MMAP[gx_mi] = 1000 + gx_k; gx_mi += 1;
          );
          gx_k += 1;
        );
      );
      gfx_x = PX(926); gfx_y = PY(92);
      gx_res = gfx_showmenu(#mn);
      gx_res > 0 ? (
        gx_k = MMAP[gx_res - 1];
        gx_k >= 1000 ? (
          gx_k -= 1000; UP[gx_k*NPS] = 0; strcpy(300 + gx_k, "");
          (cur_cat == floor(gx_k/8) && cur_idx == 16 + (gx_k % 8)) ? ( cur_idx = -1; dirty = 1; );
        ) : gx_k >= 0 ? (
          ted_cat = floor(gx_k/32); ted_slot = (gx_k % 32) - 16; ted_on = 1;
          (UP + (ted_cat*8 + ted_slot)*NPS)[0] ? strcpy(#ted, 300 + ted_cat*8 + ted_slot) :
            cur_idx >= 0 && cur_idx < 16 ? ( strcpy(#ted, 400 + cur_cat*16 + cur_idx); strcat(#ted, " 2"); ) : strcpy(#ted, "");
        );
      );
    ) :
    gx_va == 24 ? load_init() :
    (gx_va >= 30 && gx_va <= 32) ? ( page = gx_va - 30; ) :
    (gx_va >= 60 && gx_va <= 67) ? ( set_sl(77 + (gx_va - 60)*3, 0); set_sl(78 + (gx_va - 60)*3, 0); set_sl(79 + (gx_va - 60)*3, 0); ) :
    (gx_va >= 70 && gx_va <= 74) ? ( slider138 = gx_va - 70; sliderchange(slider138); );
  );
);
// glisser
(mb1 && drag_p > 0) ? (
  gx_dy = (last_my - my)*((mouse_cap & 8) ? 0.1 : 1);
  gx_dy != 0 ? (
    gx_rg = PMAX[drag_p] - PMIN[drag_p];
    PSTP[drag_p] >= 1 ? (
      drag_acc += gx_dy/(gx_rg > 24 ? 2 : 7);
      abs(drag_acc) >= 1 ? (
        set_sl(drag_p, clamp(slider(drag_p) + (drag_acc > 0 ? floor(drag_acc) : -floor(-drag_acc))*PSTP[drag_p], PMIN[drag_p], PMAX[drag_p]));
        drag_acc -= drag_acc > 0 ? floor(drag_acc) : -floor(-drag_acc);
      );
    ) : (
      set_sl(drag_p, clamp(slider(drag_p) + gx_dy*gx_rg/200, PMIN[drag_p], PMAX[drag_p]));
    );
  );
);
// source de modulation glissée
(mb1 && md_down) ? ( (abs(mx - md_x0) + abs(my - md_y0) > 8) ? ( md_drag = 1; ); );
(!mb1 && md_down) ? (
  md_drag ? (
    // dépôt sur un potard modulable
    (gx_hit >= 0 && (RG + gx_hit*8)[4] == 1 && PDST[(RG + gx_hit*8)[5]] > 0) ? (
      gx_d = PDST[(RG + gx_hit*8)[5]]; gx_k = -1; gx_ui = 0;
      loop(8, (gx_k < 0 && slider(77 + gx_ui*3) == md_src && slider(78 + gx_ui*3) == gx_d) ? ( gx_k = gx_ui; ); gx_ui += 1;);
      gx_ui = 0;
      loop(8, (gx_k < 0 && (slider(77 + gx_ui*3) == 0 || slider(78 + gx_ui*3) == 0)) ? ( gx_k = gx_ui; ); gx_ui += 1;);
      gx_k >= 0 ? (
        set_sl(77 + gx_k*3, md_src); set_sl(78 + gx_k*3, gx_d);
        slider(79 + gx_k*3) == 0 ? set_sl(79 + gx_k*3, 0.5);
      );
    );
  ) : (
    md_src <= 3 ? ( etab = md_src - 1; ) : ( ltab = md_src - 4; );
  );
  md_down = 0; md_drag = 0;
);
// clic droit : réglage par défaut ou retrait des modulations d'un potard
(mb2 && !last_mb2 && gx_hit >= 0 && (RG + gx_hit*8)[4] == 1) ? (
  gx_ip = (RG + gx_hit*8)[5]; gx_d = PDST[gx_ip];
  strcpy(#mn, "Reset to default|"); gx_mi = 0;
  gx_d > 0 ? (
    gx_ui = 0;
    loop(8,
      (slider(78 + gx_ui*3) == gx_d && slider(77 + gx_ui*3) > 0) ? (
        strcpy(#s, "Remove "); strcat(#s, 170 + slider(77 + gx_ui*3)); strcat(#s, " -> "); strcat(#s, 200 + gx_d);
        fmt_p(79 + gx_ui*3); strcat(#s, "  ("); strcat(#s, #vs); strcat(#s, ")|"); strcat(#mn, #s);
        MMAP[gx_mi] = gx_ui; gx_mi += 1;
      );
      gx_ui += 1;
    );
  );
  gfx_x = mouse_x; gfx_y = mouse_y;
  gx_res = gfx_showmenu(#mn);
  gx_res == 1 ? set_sl(gx_ip, PDEF[gx_ip]) :
  gx_res > 1 ? ( gx_k = MMAP[gx_res - 2]; set_sl(77 + gx_k*3, 0); set_sl(78 + gx_k*3, 0); set_sl(79 + gx_k*3, 0); );
);
// molette
mouse_wheel != 0 ? (
  (gx_hit >= 0 && !ted_on) ? (
    gx_r = RG + gx_hit*8; gx_ty = gx_r[4]; gx_ip = gx_r[5]; gx_wd = mouse_wheel > 0 ? 1 : -1;
    (gx_ty == 1 || gx_ty == 5 || gx_ty == 6) ? (
      PSTP[gx_ip] >= 1 ? set_sl(gx_ip, clamp(slider(gx_ip) + gx_wd*PSTP[gx_ip], PMIN[gx_ip], PMAX[gx_ip]))
                     : set_sl(gx_ip, clamp(slider(gx_ip) + gx_wd*(PMAX[gx_ip] - PMIN[gx_ip])*((mouse_cap & 8) ? 0.002 : 0.02), PMIN[gx_ip], PMAX[gx_ip]));
    );
  );
  mouse_wheel = 0;
);
!mb1 ? ( drag_p = 0; );
last_mb = mb1; last_mb2 = mb2;
last_my = (mouse_y - oy)/S;

// ---- Thème : double-clic sur le nom du plug-in = orange / vert ----------------------------
th_mb = mouse_cap & 1;
(th_mb && !th_lmb) ? (
  (mouse_x >= th_x0 - 6 && mouse_x <= th_x1 + 6 && mouse_y >= th_y0 - 6 && mouse_y <= th_y0 + th_h + 6) ? (
    (time_precise() - th_t < 0.4) ? ( slider139 = slider139 >= 0.5 ? 0 : 1; sliderchange(slider139); th_t = 0; ) : ( th_t = time_precise(); );
  );
);
th_lmb = th_mb;


loop(121,
  gx_ph = gx_ui/60; gx_cy = floor(gx_ph); gx_p = gx_ph - gx_cy; gx_ph >= 2 ? ( gx_cy = 1; gx_p = 0.99999; );
  gx_s = lfo_val(gx_sh, gx_p, hrnd(gx_cy, 3)*2 - 1, hrnd(gx_cy + 1, 3)*2 - 1);
  gx_x = 748 + gx_ui*304/120; gx_y = 437 - gx_s*27;
  gx_ui > 0 ? ln(gx_lx, gx_ly, gx_x, gx_y); gx_lx = gx_x; gx_ly = gx_y;
  gx_ui += 1;
);
selbox(746, 476, 170, 20, gx_l);

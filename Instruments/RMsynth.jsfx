gx_ml = clamp((20*log10(max(vu_l, 0.00001)) + 48)/48, 0, 1); gx_mr = clamp((20*log10(max(vu_r, 0.00001)) + 48)/48, 0, 1);
vu_l > 0.98 ? col(1.0,0.30,0.20) : col(thc0r,thc0g,thc0b); rct(926, 600, 130*gx_ml, 8, 1);
vu_r > 0.98 ? col(1.0,0.30,0.20) : col(thc0r,thc0g,thc0b); rct(926, 612, 130*gx_mr, 8, 1);


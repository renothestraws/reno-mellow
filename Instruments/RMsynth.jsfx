text_l(900, 536, "TRIG : restart per note"); text_l(900, 550, "FREE : shared, tempo-locked"); text_l(900, 564, "ENV : one cycle per note");

// ---- Jeu (voicing) ------------------------------------------------------------------------
col(0.03,0.03,0.035); rct(34, 592, 1032, 34, 1);

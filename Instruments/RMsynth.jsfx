fp_ = FP + 120*NPS; init_pre(fp_); fp_[3]=0; fp_[50]=0.2173; fp_[51]=0; fp_[52]=0.7173; fp_[53]=1; fp_[54]=0.6037; fp_[65]=5; fp_[67]=1; fp_[68]=13; fp_[69]=0; fp_[77]=4; fp_[78]=23; fp_[79]=0.4; fp_[109]=-10; fp_[119]=1; fp_[120]=11; fp_[121]=0.4; fp_[122]=1; fp_[123]=0.6; fp_[124]=0.35; fp_[125]=1; fp_[126]=0.6; fp_[127]=0.5; fp_[128]=0.5; fp_[130]=0.3; strcpy(520, "Bubbles");
fp_ = FP + 121*NPS; init_pre(fp_); fp_[1]=0; fp_[39]=1; fp_[40]=0.4; fp_[41]=1; fp_[44]=1; fp_[45]=1; fp_[46]=0.534; fp_[47]=0.2; fp_[48]=0; fp_[49]=0; fp_[50]=0.7173; fp_[51]=0; fp_[52]=0.7173; fp_[53]=1; fp_[54]=0.7827; fp_[65]=0; fp_[66]=0.1824; fp_[67]=0; fp_[69]=1; fp_[77]=4; fp_[78]=16; fp_[79]=0.3; fp_[80]=4; fp_[81]=21; fp_[82]=0.4; fp_[109]=-2; fp_[125]=1; fp_[126]=0.9; fp_[127]=0.8; fp_[128]=0.5; fp_[130]=0.5; strcpy(521, "Ocean");
fp_ = FP + 122*NPS; init_pre(fp_); fp_[2]=6; fp_[3]=0.5; fp_[39]=1; fp_[41]=0.3; fp_[44]=1; fp_[45]=5; fp_[46]=0.625; fp_[47]=0.5; fp_[48]=0; fp_[49]=0; fp_[65]=6; fp_[66]=0.3563; fp_[67]=0; fp_[69]=0; fp_[77]=4; fp_[78]=1; fp_[79]=0.2; fp_[80]=4; fp_[81]=16; fp_[82]=0.2; fp_[109]=0; fp_[110]=1; fp_[111]=5; fp_[112]=0.4; fp_[113]=1; strcpy(522, "Radio Tune");
fp_ = FP + 123*NPS; init_pre(fp_); fp_[2]=1; fp_[3]=0.7; fp_[65]=5; fp_[67]=1; fp_[68]=13; fp_[69]=1; fp_[71]=4; fp_[73]=1; fp_[74]=13; fp_[75]=1; fp_[77]=4; fp_[78]=2; fp_[79]=0.8; fp_[80]=5; fp_[81]=21; fp_[82]=-0.5; fp_[109]=-12; fp_[119]=1; fp_[120]=14; fp_[121]=0.35; fp_[122]=1; fp_[123]=0.6; fp_[124]=0.3; strcpy(523, "Glitch Arp");
fp_ = FP + 124*NPS; init_pre(fp_); fp_[2]=9; fp_[6]=-1; fp_[9]=8; fp_[10]=0.5; fp_[17]=1; fp_[18]=3; fp_[30]=0.5; fp_[44]=1; fp_[45]=0; fp_[46]=0.6667; fp_[47]=0.1; fp_[48]=0; fp_[49]=0; fp_[50]=0.821; fp_[51]=0; fp_[52]=0.7173; fp_[53]=1; fp_[54]=0.8481; fp_[65]=6; fp_[66]=0.0533; fp_[67]=0; fp_[69]=1; fp_[71]=6; fp_[72]=0.1206; fp_[73]=0; fp_[75]=1; fp_[77]=4; fp_[78]=2; fp_[79]=0.9; fp_[80]=5; fp_[81]=16; fp_[82]=0.3; fp_[109]=-1.5; fp_[119]=1; fp_[120]=5; fp_[121]=0.4; fp_[122]=1; fp_[123]=0.6; fp_[124]=0.35; fp_[125]=1; fp_[126]=1; fp_[127]=0.9; fp_[128]=0.5; fp_[130]=0.7; strcpy(524, "Space Drone");
fp_ = FP + 125*NPS; init_pre(fp_); fp_[44]=1; fp_[45]=1; fp_[46]=0.7254; fp_[47]=0.1; fp_[48]=0; fp_[49]=0; fp_[50]=0; fp_[51]=0; fp_[52]=0.6419; fp_[53]=0; fp_[54]=0.5; fp_[55]=0; fp_[56]=0; fp_[57]=0.6308; fp_[58]=0; fp_[59]=0.5; fp_[77]=2; fp_[78]=23; fp_[79]=0.6; fp_[80]=2; fp_[81]=16; fp_[82]=0.3; fp_[109]=-5.5; fp_[119]=1; fp_[120]=10; fp_[121]=0.35; fp_[122]=1; fp_[123]=0.6; fp_[124]=0.3; strcpy(525, "Zap Down");
fp_ = FP + 126*NPS; init_pre(fp_); fp_[2]=4; fp_[65]=6; fp_[66]=0.6971; fp_[67]=0; fp_[69]=0; fp_[71]=0; fp_[72]=0.4678; fp_[73]=0; fp_[75]=0; fp_[77]=4; fp_[78]=2; fp_[79]=0.9; fp_[80]=5; fp_[81]=23; fp_[82]=0.05; fp_[109]=-6; fp_[125]=1; fp_[126]=0.6; fp_[127]=0.5; fp_[128]=0.5; fp_[130]=0.3; strcpy(526, "Alien Talk");
fp_ = FP + 127*NPS; init_pre(fp_); fp_[3]=0; fp_[6]=-2; fp_[39]=1; fp_[41]=0.8; fp_[44]=1; fp_[45]=1; fp_[46]=0.3333; fp_[47]=0.3; fp_[48]=0; fp_[49]=0; fp_[50]=0; fp_[51]=0; fp_[52]=0.7827; fp_[53]=0; fp_[54]=0.7173; fp_[55]=0; fp_[56]=0; fp_[57]=0.6037; fp_[58]=0; fp_[59]=0.5654; fp_[60]=0; fp_[61]=0; fp_[62]=0.6691; fp_[63]=0; fp_[64]=0.6037; fp_[77]=2; fp_[78]=23; fp_[79]=0.3; fp_[80]=3; fp_[81]=16; fp_[82]=0.6; fp_[109]=-3; fp_[110]=1; fp_[111]=0; fp_[112]=0.3; fp_[113]=1; fp_[125]=1; fp_[126]=1; fp_[127]=0.7; fp_[128]=0.5; fp_[130]=0.5; strcpy(527, "Impact");

// ---- Tables d'onde ---------------------------------------------------------------------
// remplit WB (complexe entrelacé) avec l'image f de la table t ; mode 0 = temporel, 1 = spectral
function sin_h(h, a) ( h > 0 && h < 1024 ? ( WB[2*h + 1] = -a; WB[2*(WN - h) + 1] = a; ); );
function wt_fill(t, f) local(i, p, x, a, b, s, g, h, c, k, f1, f2, f3, vv, w, amp)
(
  memset(WB, 0, 4096);
  wt_spec = 0;
  t == 0 ? (                                   // BASIC : sinus -> triangle -> dent de scie -> carré
    s = f/15*3; k = min(floor(s), 2); a = s - k;
    i = 0;
    loop(WN,
      p = i/WN;
      g = sin(2*$pi*p);
      h = p < 0.25 ? 4*p : p < 0.75 ? 2 - 4*p : 4*p - 4;
      c = 2*frac_(p + 0.5) - 1;
      b = p < 0.5 ? 1 : -1;
      x = k == 0 ? g + a*(h - g) : k == 1 ? h + a*(c - h) : c + a*(b - c);
      WB[2*i] = x; i += 1;
    );
  ) : t == 1 ? (                               // PWM : largeur 50 % -> 3 %
    w = 0.5 - 0.47*f/15;
    i = 0; loop(WN, WB[2*i] = i/WN < w ? 1 : -1; i += 1;);
  ) : t == 2 ? (                               // SYNC : dent de scie synchronisée, rapport 1 -> 8
    s = 1 + 7*f/15;
    i = 0; loop(WN, p = i/WN; WB[2*i] = (2*frac_(p*s) - 1)*(1 - p*0.15); i += 1;);
  ) : t == 3 ? (                               // HARMO : bosse spectrale qui monte
    wt_spec = 1; c = 1 + f*2.1;
    h = 1; loop(80, sin_h(h, exp(-sqr((h - c)/(1.2 + f*0.25))) + 0.15/h); h += 1;);
  ) : t == 4 ? (                               // VOWEL : formants A E I O U sur une dent de scie
    wt_spec = 1; s = f/15*4; k = min(floor(s), 3); a = s - k;
    f1 = k == 0 ? 800 + a*(400 - 800) : k == 1 ? 400 + a*(350 - 400) : k == 2 ? 350 + a*(450 - 350) : 450 + a*(325 - 450);
    f2 = k == 0 ? 1150 + a*(1600 - 1150) : k == 1 ? 1600 + a*(1700 - 1600) : k == 2 ? 1700 + a*(800 - 1700) : 800 + a*(700 - 800);
    f3 = k == 0 ? 2900 + a*(2700 - 2900) : k == 1 ? 2700 : k == 2 ? 2700 + a*(2830 - 2700) : 2830 + a*(2530 - 2830);
    h = 1;
    loop(100,
      x = 110*h;
      amp = (exp(-sqr((x - f1)/90)) + 0.6*exp(-sqr((x - f2)/120)) + 0.3*exp(-sqr((x - f3)/160)) + 0.02)/sqrt(h);
      sin_h(h, amp); h += 1;
    );
  ) : t == 5 ? (                               // ORGAN : registrations de tirettes
    wt_spec = 1; s = f/15;
    sin_h(1, 1); sin_h(2, 0.2 + 0.6*s); sin_h(3, 0.7*(1 - s) + 0.2); sin_h(4, 0.5*s);
    sin_h(6, 0.35*s*s); sin_h(8, 0.3*s); sin_h(10, 0.15*s*s); sin_h(12, 0.12*s);
    sin_h(16, 0.1*s*s);
  ) : t == 6 ? (                               // FM : 2 opérateurs, rapport 1 puis 2, indice croissant
    k = f < 8 ? 1 : 2; a = (f % 8)/7*5;
    i = 0; loop(WN, p = i/WN; WB[2*i] = sin(2*$pi*p + a*sin(2*$pi*p*k)); i += 1;);
  ) : t == 7 ? (                               // FOLD : repliement d'un sinus
    g = 1 + 7*f/15;
    i = 0; loop(WN, p = i/WN; WB[2*i] = sin(1.5707963*g*sin(2*$pi*p)); i += 1;);
  ) : t == 8 ? (                               // GLASS : partiels clairsemés
    wt_spec = 1; s = f/15;
    sin_h(1, 1); sin_h(3, 0.3*s); sin_h(4, 0.5*(1 - s) + 0.1); sin_h(7, 0.45*s + 0.05);
    sin_h(9, 0.2*(1 - s)); sin_h(11, 0.35*s); sin_h(16, 0.25*(1 - s)*(1 - s) + 0.05);
    sin_h(23, 0.2*s*s); sin_h(29, 0.12*s); sin_h(37, 0.08*s*s);
  ) : (                                        // SPECTRAL : spectres aléatoires qui se fondent
    wt_spec = 1; s = f/15*3; k = min(floor(s), 2); a = s - k; a = 0.5 - 0.5*cos($pi*a);
    h = 1;
    loop(96,
      vv = hrnd(h, k*7 + 3)*(1 - a) + hrnd(h, k*7 + 10)*a;
      sin_h(h, vv*vv/pow(h, 0.7)); h += 1;
    );
  );
);
// calcule les 11 niveaux de mip-map de l'image f de la table t
function wt_build(t, f) local(i, l, hl, d, pk, sc)
(
  wt_fill(t, f);
  !wt_spec ? ( fft(WB, WN); fft_permute(WB, WN); );
  WB[0] = WB[1] = 0; WB[2*1024] = WB[2*1024 + 1] = 0;
  // crête du niveau 0 pour normaliser
  d = TB + ((t*NFR + f)*NLV)*4096;
  memcpy(d, WB, 4096); fft_ipermute(d, WN); ifft(d, WN);
  pk = EPS; i = 0; loop(WN, pk = max(pk, abs(d[2*i])); i += 1;);
  sc = 1/pk;
  i = 0; loop(4096, WB[i] *= sc; i += 1;);
  l = 0;
  loop(NLV,
    hl = 1024/(2^l);
    d = TB + ((t*NFR + f)*NLV + l)*4096;
    memcpy(d, WB, 4096);
    hl < 1024 ? memset(d + 2*(hl + 1), 0, 2*(WN - 2*hl - 1));
    fft_ipermute(d, WN); ifft(d, WN);
    l += 1;
  );
);
!wt_done ? (
  zt = 0; loop(NWT, zf = 0; loop(NFR, wt_build(zt, zf); zf += 1;); zt += 1;);
  wt_done = 1;
);

// ---- Oscillateur : lecture avec warp -------------------------------------------------------
// t0/t1 : images voisines, ff : fondu entre elles, p : phase, m : mode, a : quantité, o : autre osc
function osc_rd(t0, t1, ff, p, m, a, o) local(q, x, i0, i1, fr, s0, s1, e)
(
  q = m == 0 ? p :
      m <= 2 ? frac_(p*(1 + 7*a)) :
      m == 3 ? ( x = 2*p - 1; 0.5 + 0.5*sign(x)*pow(abs(x), 1/(1 + 4*a)); ) :
      m == 4 ? ( x = 2*p - 1; 0.5 + 0.5*sign(x)*pow(abs(x), 1 + 4*a); ) :
      m == 5 ? min(p/(1 - 0.95*a), 0.99999) :
      m == 6 ? pow(p, 1 + 4*a) :
      m == 7 ? 1 - pow(1 - p, 1 + 4*a) :
      m == 8 ? ( x = p < 0.5 ? 2*p : 2 - 2*p; pow(x, 1 + 3*a); ) :
      m == 10 ? ( e = floor(2 + sqr(1 - a)*510); floor(p*e)/e; ) :
      m == 11 ? frac_(p + a*1.5*o + 8) : p;
  x = q*WN; i0 = floor(x); fr = x - i0; i1 = (i0 + 1) & 2047; i0 = i0 & 2047;
  s0 = t0[2*i0]; s0 += fr*(t0[2*i1] - s0);
  ff > 0.0001 ? ( s1 = t1[2*i0]; s1 += fr*(t1[2*i1] - s1); s0 += ff*(s1 - s0); );
  m == 2 ? ( s0 *= 0.5 - 0.5*cos(2*$pi*p); ) :
  m == 9 ? ( (a > 0.001 && p >= 1 - a) ? ( s0 = -s0; ); ) :
  m == 12 ? ( s0 *= 1 - a + a*(0.5 + 0.5*o); ) :
  m == 13 ? ( s0 *= 1 - a + a*o; );
  s0;
);
function blep(t, dt) ( t < dt ? ( t /= dt; 2*t - t*t - 1; ) : t > 1 - dt ? ( t = (t - 1)/dt; t*t + 2*t + 1; ) : 0; );

// ---- Paramètres lus à chaque bloc ------------------------------------------------------------
function env_par(k, a, h, d, s, r) local(e, ta, td, tr)
(
  e = ENVP + k*8;
  ta = 0.0005*40000^a; td = 0.0005*40000^d; tr = 0.0005*40000^r;
  e[0] = dtc/ta; e[1] = h > 0.0001 ? 0.0005*40000^h : 0; e[2] = exp(-4.6*dtc/td); e[3] = s; e[4] = exp(-6.9*dtc/tr);
);
function lfo_par(k, sh, rt, sy, dv, md, rs) local(l)
(
  l = LFOP + k*8;
  l[0] = sh; l[1] = sy ? (tempo/60)/DIVB[dv] : 0.02*2000^rt; l[2] = md; l[3] = 5*rs*rs; l[4] = sy; l[5] = rt;
);
function read_par() local(i)
(
  dtc = CR/srate;
  a_on = slider1; a_wt = slider2; a_pos = slider3; a_wm = slider4; a_wa = slider5;
  a_tr = slider6*12 + slider7 + slider8/100; a_uni = slider9; a_det = slider10; a_bld = slider11;
  a_phs = slider12; a_rnd = slider13; a_lvl = slider14; a_pan = slider15; a_flt = slider16;
  b_on = slider17; b_wt = slider18; b_pos = slider19; b_wm = slider20; b_wa = slider21;
  b_tr = slider22*12 + slider23 + slider24/100; b_uni = slider25; b_det = slider26; b_bld = slider27;
  b_phs = slider28; b_rnd = slider29; b_lvl = slider30; b_pan = slider31; b_flt = slider32;
  s_on = slider33; s_sh = slider34; s_oct = slider35; s_lvl = slider36; s_pan = slider37; s_dir = slider38;
  n_on = slider39; n_col = slider40; n_lvl = slider41; n_pan = slider42; n_flt = slider43;
  f_on = slider44; f_ty = slider45; f_cut = slider46; f_res = slider47; f_drv = slider48; f_key = slider49;
  env_par(0, slider50, slider51, slider52, slider53, slider54);
  env_par(1, slider55, slider56, slider57, slider58, slider59);
  env_par(2, slider60, slider61, slider62, slider63, slider64);
  lfo_par(0, slider65, slider66, slider67, slider68, slider69, slider70);
  lfo_par(1, slider71, slider72, slider73, slider74, slider75, slider76);
  i = 0; loop(8, MSRC[i] = slider(77 + i*3); MDST[i] = slider(78 + i*3); MAMT[i] = slider(79 + i*3); i += 1;);
  poly = slider101; mono = slider102; legato = slider103; glide = 2*sqr(slider104); glm = slider105;
  bend_r = slider106; vels = slider107; uwd = slider108;
  mvol = db2lin(slider109)*0.5;
);

// ---- LFO / enveloppes --------------------------------------------------------------------
function lfo_val(sh, ph, a, b)
(
  sh == 0 ? sin(2*$pi*ph) :
  sh == 1 ? ( ph < 0.25 ? 4*ph : ph < 0.75 ? 2 - 4*ph : 4*ph - 4; ) :
  sh == 2 ? 2*ph - 1 :
  sh == 3 ? 1 - 2*ph :
  sh == 4 ? ( ph < 0.5 ? 1 : -1; ) :
  sh == 5 ? a : a + (b - a)*(0.5 - 0.5*cos($pi*ph));
);
function env_tick(vb, o, k) local(e, st, lv)
(
  e = ENVP + k*8; st = vb[o]; lv = vb[o + 1];
  st == 1 ? ( lv += e[0]; lv >= 1 ? ( lv = 1; vb[o + 2] = 0; st = e[1] > 0 ? 2 : 3; ); ) :
  st == 2 ? ( vb[o + 2] += dtc; vb[o + 2] >= e[1] ? ( st = 3; ); ) :
  st == 3 ? ( lv = e[3] + (lv - e[3])*e[2]; abs(lv - e[3]) < 0.0005 ? ( lv = e[3]; st = 4; ); ) :
  st == 4 ? ( lv = e[3]; ) :
  st == 5 ? ( lv *= e[4]; lv < 0.00003 ? ( lv = 0; st = 0; ); );
  vb[o] = st; vb[o + 1] = lv;
);
// LFO d'une voix (o : décalage des états), rm : modulation de vitesse (matrice)
function lfo_tick(vb, o, k, rm) local(l, ph, inc, g)
(
  l = LFOP + k*8;
  l[2] == 1 ? (
    vb[o + 1] = LGV[k];
  ) : (
    inc = l[4] ? l[1]*2^(rm*4) : 0.02*2000^clamp(l[5] + rm, 0, 1);
    ph = vb[o] + inc*dtc;
    ph >= 1 ? (
      l[2] == 2 ? ( ph = 0.99999; ) : ( ph -= floor(ph); vb[o + 2] = vb[o + 3]; vb[o + 3] = rand(2) - 1; );
    );
    vb[o] = ph;
    vb[o + 1] = lfo_val(l[0], ph, vb[o + 2], vb[o + 3]);
  );
  vb[o + 4] += dtc;
  g = l[3] > 0.001 ? min(1, vb[o + 4]/l[3]) : 1;
  vb[o + 1] *= g;
);

// ---- Unisson : incréments, gains, panoramiques d'un oscillateur --------------------------------
function uni_set(ug, n, inc, det, bld, lvl, pan) local(u, s, d, gc, go, g, sm, pu, an, ctr)
(
  d = det*det;
  gc = min(1, (1 - bld)*4); go = min(1, bld*4/3);
  sm = 0; u = 0;
  loop(n,
    s = n > 1 ? 2*u/(n - 1) - 1 : 0;
    ctr = n == 1 || (n % 2 == 1 && u == (n - 1)/2) || (n % 2 == 0 && (u == n/2 - 1 || u == n/2));
    g = n <= 2 ? 1 : ctr ? gc : go;
    ug[u] = inc*exp(s*d*0.057762265);
    ug[32 + u] = g; sm += g*g;
    u += 1;
  );
  sm = lvl/sqrt(max(sm, 0.0001));
  u = 0;
  loop(n,
    s = n > 1 ? 2*u/(n - 1) - 1 : 0;
    pu = clamp(pan + s*uwd, -1, 1); an = (pu + 1)*0.7853981634;
    g = ug[32 + u]*sm*1.4142;
    ug[16 + u] = g*cos(an); ug[24 + u] = g*sin(an);
    u += 1;
  );
);
function mip(f) local(h) ( h = 0.5*srate/max(f, 1); h >= 1024 ? 0 : h < 1 ? 10 : min(10, ceil(log(1024/h)/log(2) - 0.0001)); );

// ---- Contrôle d'une voix (tous les CR échantillons) ------------------------------------------
function ctrl_voice(v) local(vb, i, s, d, nt, f, pos, f0, ff, wa, sm, lv, pn, dt_, hz, g, r, an)
(
  vb = VOX + v*VS;
  // glide
  vb[4] += (vb[5] - vb[4])*(glide > 0.0005 ? 1 - exp(-dtc/(glide/3)) : 1);
  env_tick(vb, 7, 0); env_tick(vb, 10, 1); env_tick(vb, 13, 2);
  lfo_tick(vb, 16, 0, vb[86]); lfo_tick(vb, 22, 1, vb[87]);
  vb[7] == 0 ? ( vb[0] = 0; );
  // matrice
  SV[0] = 0; SV[1] = vb[8]; SV[2] = vb[11]; SV[3] = vb[14]; SV[4] = vb[17]; SV[5] = vb[23];
  SV[6] = vb[2]; SV[7] = clamp((vb[1] - 60)/48, -1, 1); SV[8] = modw; SV[9] = aftt; SV[10] = vb[28];
  memset(DS, 0, 24);
  i = 0; loop(8, (MSRC[i] > 0 && MDST[i] > 0) ? ( DS[MDST[i]] += MAMT[i]*SV[MSRC[i]]; ); i += 1;);
  vb[86] = DS[19]; vb[87] = DS[20];
  nt = vb[4] + pbend*bend_r;
  // OSC A
  a_on ? (
    f = 440*2^((nt + a_tr + (DS[1] + DS[23])*24 - 69)/12);
    pos = clamp(a_pos + DS[2], 0, 1)*15; f0 = min(floor(pos), 14); ff = pos - f0;
    wa = clamp(a_wa + DS[3], 0, 1); sm = (a_wm == 1 || a_wm == 2) ? 1 + 7*wa : 1;
    lv = mip(f*sm*(1 + a_det*0.06))*4096;
    vb[51] = TB + ((a_wt*NFR + f0)*NLV)*4096 + lv; vb[52] = vb[51] + NLV*4096; vb[53] = ff; vb[54] = wa;
    vb[55] = a_uni;
    uni_set(UNI + v*128, a_uni, f/srate, clamp(a_det + DS[6], 0, 1), a_bld, clamp(a_lvl + DS[4], 0, 1), clamp(a_pan + DS[5], -1, 1));
  ) : ( vb[55] = 0; );
  // OSC B
  b_on ? (
    f = 440*2^((nt + b_tr + (DS[7] + DS[23])*24 - 69)/12);
    pos = clamp(b_pos + DS[8], 0, 1)*15; f0 = min(floor(pos), 14); ff = pos - f0;
    wa = clamp(b_wa + DS[9], 0, 1); sm = (b_wm == 1 || b_wm == 2) ? 1 + 7*wa : 1;
    lv = mip(f*sm*(1 + b_det*0.06))*4096;
    vb[57] = TB + ((b_wt*NFR + f0)*NLV)*4096 + lv; vb[58] = vb[57] + NLV*4096; vb[59] = ff; vb[60] = wa;
    vb[61] = b_uni;
    uni_set(UNI + v*128 + 64, b_uni, f/srate, clamp(b_det + DS[12], 0, 1), b_bld, clamp(b_lvl + DS[10], 0, 1), clamp(b_pan + DS[11], -1, 1));
  ) : ( vb[61] = 0; );
  // SUB
  s_on ? (
    vb[64] = 440*2^((nt + s_oct*12 - 69)/12)/srate;
    lv = clamp(s_lvl + DS[13], 0, 1)*0.9; an = (clamp(s_pan, -1, 1) + 1)*0.7853981634;
    vb[65] = lv*cos(an)*1.4142; vb[66] = lv*sin(an)*1.4142;
  ) : ( vb[65] = vb[66] = 0; );
  // NOISE
  n_on ? (
    lv = clamp(n_lvl + DS[14], 0, 1)*0.5; an = (clamp(n_pan, -1, 1) + 1)*0.7853981634;
    vb[69] = lv*cos(an)*1.4142; vb[70] = lv*sin(an)*1.4142; vb[71] = clamp(n_col + DS[15], 0, 1);
  ) : ( vb[69] = vb[70] = 0; );
  // FILTRE
  hz = 20*1000^clamp(f_cut + DS[16] + f_key*(vb[4] - 60)*0.0083617, 0, 1);
  hz = min(hz, 0.45*srate);
  g = tan($pi*hz/srate);
  vb[90] ? ( vb[31] = g; vb[32] = 0; vb[90] = 0; ) : ( vb[32] = (g - vb[31])/CR; );
  r = clamp(f_res + DS[17], 0, 1);
  vb[33] = r; vb[34] = 1 + clamp(f_drv + DS[18], 0, 1)*12;
  // AMPLI + PAN
  lv = vb[8]*(1 - vels + vels*vb[2]*vb[2])*max(0, 1 + DS[21]);
  vb[30] = (lv - vb[29])/CR;
  an = (clamp(DS[22], -1, 1) + 1)*0.7853981634;
  vb[72] = cos(an)*1.4142; vb[73] = sin(an)*1.4142;
);
function ctrl_all() local(v, k, l)
(
  // LFO en mode FREE : phase commune
  k = 0;
  loop(2,
    l = LFOP + k*8;
    LGP[k] += l[1]*dtc;
    LGP[k] >= 1 ? ( LGP[k] -= floor(LGP[k]); LGA[k] = LGB[k]; LGB[k] = rand(2) - 1; );
    LGV[k] = lfo_val(l[0], LGP[k], LGA[k], LGB[k]);
    k += 1;
  );
  v = 0; loop(NV, (VOX + v*VS)[0] ? ctrl_voice(v); v += 1;);
);
// ---- Notes -------------------------------------------------------------------------------------
function voice_start(v, nt, vel, retrig) local(vb, u, k, was)
(
  vb = VOX + v*VS; was = vb[0];
  !was ? (
    memset(vb, 0, VS); memset(PHS + v*16, 0, 16);
    vb[29] = 0; vb[90] = 1;
  );
  vb[4] = (glide > 0.0005 && last_nt >= 0 && (glm == 1 || held > 1)) ? (was ? vb[4] : last_nt) : nt;
  vb[0] = 1; vb[1] = nt; vb[2] = vel; vb[3] = 1; vb[88] = 0;
  vb[5] = nt;
  agec += 1; vb[6] = agec;
  vb[7] = 1; vb[10] = 1; vb[13] = 1;
  retrig ? (
    k = 0;
    loop(2,
      (LFOP + k*8)[2] != 1 ? ( vb[16 + k*6] = 0; vb[18 + k*6] = rand(2) - 1; vb[19 + k*6] = rand(2) - 1; );
      vb[20 + k*6] = 0;
      k += 1;
    );
    vb[28] = rand(2) - 1;
    u = 0;
    loop(8,
      (PHS + v*16)[u] = frac_(a_phs + a_rnd*rand(1));
      (PHS + v*16)[8 + u] = frac_(b_phs + b_rnd*rand(1));
      u += 1;
    );
    vb[63] = 0;
  );
  ctrl_voice(v);
);
function note_on(nt, vel) local(v, best, bs, vb, i)
(
  held += 1;
  NSTK[min(held - 1, 31)] = nt;
  mono ? (
    vb = VOX;
    (vb[0] && vb[3] && legato) ? (
      vb[5] = nt; vb[1] = nt;
      (glide <= 0.0005) ? ( vb[4] = nt; );
    ) : (
      voice_start(0, nt, vel, 1);
    );
  ) : (
    best = -1; v = 0;
    loop(poly, (best < 0 && !(VOX + v*VS)[0]) ? ( best = v; ); v += 1;);
    best < 0 ? (
      // vol de voix : la plus faible relâchée, sinon la plus ancienne
      bs = 10; v = 0;
      loop(poly, vb = VOX + v*VS; (!vb[3] && vb[8] < bs) ? ( bs = vb[8]; best = v; ); v += 1;);
      best < 0 ? ( bs = 1000000000; v = 0; loop(poly, vb = VOX + v*VS; vb[6] < bs ? ( bs = vb[6]; best = v; ); v += 1;); );
    );
    voice_start(best, nt, vel, 1);
  );
  last_nt = nt;
);
function rel_voice(vb) ( sustain ? ( vb[88] = 1; ) : ( vb[3] = 0; vb[7] = vb[10] = vb[13] = 5; ); );
function note_off(nt) local(v, vb, i, j)
(
  // retire la note de la pile
  i = 0; j = 0;
  held > 0 ? ( loop(min(held, 32), NSTK[i] != nt ? ( NSTK[j] = NSTK[i]; j += 1; ); i += 1;); );
  held = j;
  mono ? (
    vb = VOX;
    (vb[0] && vb[1] == nt) ? (
      held > 0 ? (
        vb[5] = vb[1] = NSTK[held - 1]; glide <= 0.0005 ? ( vb[4] = vb[5]; );
      ) : ( rel_voice(vb); );
    );
  ) : (
    v = 0; loop(NV, vb = VOX + v*VS; (vb[0] && vb[3] && vb[1] == nt) ? rel_voice(vb); v += 1;);
  );
);
function all_off(hard) local(v, vb)
(
  v = 0; loop(NV, vb = VOX + v*VS; hard ? ( vb[0] = 0; ) : ( vb[3] = 0; vb[7] = vb[10] = vb[13] = 5; ); v += 1;);
  held = 0; sustain = 0;
);
function midi_ev(m1, m2, m3) local(st, v, vb)
(
  st = m1 & 0xF0;
  (st == 0x90 && m3 > 0) ? note_on(m2, m3/127) :
  (st == 0x80 || (st == 0x90 && m3 == 0)) ? note_off(m2) :
  st == 0xE0 ? ( pbend = ((m3*128 + m2) - 8192)/8192; ) :
  st == 0xD0 ? ( aftt = m2/127; ) :
  st == 0xB0 ? (
    m2 == 1 ? ( modw = m3/127; ) :
    m2 == 64 ? (
      sustain = m3 >= 64;
      !sustain ? ( v = 0; loop(NV, vb = VOX + v*VS; (vb[0] && vb[88]) ? ( vb[88] = 0; vb[3] = 0; vb[7] = vb[10] = vb[13] = 5; ); v += 1;); );
    ) :
    (m2 == 120 || m2 == 123) ? ( all_off(m2 == 120); );
  );
);

// ---- Effets -----------------------------------------------------------------------------------
function fx_clear() local(i)
(
  memset(CHB, 0, 16384); memset(DLB, 0, 2*DLMAX); memset(RVB, 0, 524288); memset(DIF, 0, 32768);
  ch_w = dl_w = rv_w = 0; dl_lpl = dl_lpr = 0;
  i = 0; loop(8, RVLP[i] = 0; i += 1;);
);
RVLN[0] = 1557; RVLN[1] = 1617; RVLN[2] = 1491; RVLN[3] = 1422; RVLN[4] = 1277; RVLN[5] = 1356; RVLN[6] = 1188; RVLN[7] = 1116;
DIFL[0] = 142; DIFL[1] = 107; DIFL[2] = 379; DIFL[3] = 277;
function fx_par() local(i, t60, ln, w, ga, cs, al, a0, sq)
(
  d_on = slider110; d_ty = slider111; d_drv = slider112; d_mix = slider113;
  d_g = 1 + d_drv*d_drv*40; d_c = 1/(1 + d_drv*2.2);
  d_bits = 2^floor(16 - d_drv*13); d_hold = 1 + floor(d_drv*d_drv*24);
  c_on = slider114; c_rt = 0.05*100^slider115; c_dp = slider116; c_fb = slider117; c_mix = slider118;
  y_on = slider119; y_fb = slider121; y_pp = slider122; y_mix = slider124;
  y_tgt = min(DIVB[slider120]*60/max(tempo, 20), 4)*srate;
  y_lp = 1 - exp(-2*$pi*(500*40^slider123)/srate);
  r_on = slider125; r_mix = slider130; r_wd = slider129;
  t60 = 0.2*60^slider127; r_dmp = 1 - 0.85*slider128;
  i = 0;
  loop(8,
    ln = floor(RVLN[i]*(0.4 + 1.2*slider126)*srate/44100); RVLN[8 + i] = ln;
    RVG[i] = 10^(-3*ln/(t60*srate));
    i += 1;
  );
  i = 0; loop(4, DIFL[4 + i] = floor(DIFL[i]*srate/44100); i += 1;);
  k_on = slider131; k_th = slider132; k_rt = slider133; k_mk = db2lin(slider134);
  k_at = exp(-1/(0.005*srate)); k_rl = exp(-1/(0.12*srate));
  lim_rl = 1 - exp(-1/(0.08*srate));
  q_on = slider135;
  // EQ : plateaux RBJ 150 Hz et 6 kHz
  ga = 10^(slider136/40); w = 2*$pi*150/srate; cs = cos(w); sq = 2*sqrt(ga)*sin(w)/2*1.4142;
  a0 = (ga + 1) + (ga - 1)*cs + sq;
  ql0 = ga*((ga + 1) - (ga - 1)*cs + sq)/a0; ql1 = 2*ga*((ga - 1) - (ga + 1)*cs)/a0; ql2 = ga*((ga + 1) - (ga - 1)*cs - sq)/a0;
  ql3 = -2*((ga - 1) + (ga + 1)*cs)/a0; ql4 = ((ga + 1) + (ga - 1)*cs - sq)/a0;
  ga = 10^(slider137/40); w = 2*$pi*6000/srate; cs = cos(w); sq = 2*sqrt(ga)*sin(w)/2*1.4142;
  a0 = (ga + 1) - (ga - 1)*cs + sq;
  qh0 = ga*((ga + 1) + (ga - 1)*cs + sq)/a0; qh1 = -2*ga*((ga - 1) + (ga + 1)*cs)/a0; qh2 = ga*((ga + 1) + (ga - 1)*cs - sq)/a0;
  qh3 = 2*((ga - 1) - (ga + 1)*cs)/a0; qh4 = ((ga + 1) - (ga - 1)*cs - sq)/a0;
);
function shape(x) local(y)
(
  d_ty == 0 ? tanh_(x + 0.25) - 0.2449 :
  d_ty == 1 ? tanh_(x) :
  d_ty == 2 ? clamp(x, -1, 1) :
  d_ty == 3 ? ( x > 0 ? tanh_(x) : 0.5*tanh_(x*0.5); ) :
  d_ty == 4 ? sin(x*1.5707963) : x;
);

// ---- Outils graphiques (coordonnées logiques 1100 x 676) ------------------------
function PX(x) ( ox + x*S; );
function PY(y) ( oy + y*S; );
function col(r,g,b) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = 1; );
function rct(x,y,w,h,f) ( gfx_rect(PX(x), PY(y), ceil(w*S), ceil(h*S), f); );
function ln(x1,y1,x2,y2) ( gfx_line(PX(x1), PY(y1), PX(x2), PY(y2), 1); );
function text_c(x,y,str) local(w,h) ( gfx_measurestr(str,w,h); gfx_x = PX(x) - w*0.5; gfx_y = PY(y) - h*0.5; gfx_drawstr(str); );
function text_l(x,y,str) local(w,h) ( gfx_measurestr(str,w,h); gfx_x = PX(x); gfx_y = PY(y) - h*0.5; gfx_drawstr(str); );
function text_r(x,y,str) local(w,h) ( gfx_measurestr(str,w,h); gfx_x = PX(x) - w; gfx_y = PY(y) - h*0.5; gfx_drawstr(str); );
function knob_pt(cx,cy,rad,frac) local(an)
(
  an = (225 - 270*frac)*$pi/180;
  kx = cx + rad*cos(an);
  ky = cy - rad*sin(an);
);
function arc(cx,cy,r,f1,f2,th) local(i, a1, a2)
(
  a1 = (-135 + 270*min(f1,f2))*$pi/180;
  a2 = (-135 + 270*max(f1,f2))*$pi/180;
  i = 0;
  loop(max(1, ceil(th*S)), gfx_arc(PX(cx), PY(cy), r*S + i, a1, a2, 1); i += 1;);
);
function draw_knob(cx,cy,r,frac,fz) local(i, x1, y1, t)
(
  col(0.07,0.07,0.08); arc(cx, cy, r + 9, 0, 1, 4);
  col(thc0r,thc0g,thc0b); arc(cx, cy, r + 9, fz, frac, 4);
  col(0.03,0.03,0.035); gfx_circle(PX(cx), PY(cy + 3), (r + 2)*S, 1, 1);
  i = 0;
  loop(10,
    t = 0.30 + 0.05*i;
    col(t, t, t + 0.01); gfx_circle(PX(cx), PY(cy), r*(1 - i*0.035)*S, 1, 1);
    i += 1;
  );
  col(0.72,0.73,0.75); gfx_circle(PX(cx), PY(cy), r*0.62*S, 1, 1);
  col(0.80,0.81,0.83); gfx_circle(PX(cx - r*0.1), PY(cy - r*0.12), r*0.45*S, 1, 1);
  col(0.66,0.67,0.69); gfx_circle(PX(cx), PY(cy), r*0.62*S, 0, 1);
  col(0.06,0.06,0.07);
  knob_pt(cx, cy, r*0.66, frac); x1 = kx; y1 = ky;
  knob_pt(cx, cy, r*0.95, frac);
  t = 0; loop(max(2, ceil(3*S)), gfx_line(PX(x1)+t-1, PY(y1), PX(kx)+t-1, PY(ky), 1); t += 1;);
);
function draw_btn(x,y,w,h,on,str)
(
  on ? col(thc0r,thc0g,thc0b) : col(0.16,0.165,0.18);
  rct(x,y,w,h,1);
  col(0.03,0.03,0.035); rct(x,y,w,h,0);
  on ? col(thc5r,thc5g,thc5b) : col(0.72,0.73,0.76);
  text_c(x + w*0.5, y + h*0.5, str);
);
function set_sl(idx, v) ( v != slider(idx) ? ( slider(idx) = v; slider_automate(slider(idx)); dirty = 1; ); );
function reg(x, y, w, h, ty, i, va) local(r)
(
  rg_n < RMAX ? (
    r = RG + rg_n*8; r[0] = x; r[1] = y; r[2] = w; r[3] = h; r[4] = ty; r[5] = i; r[6] = va;
    rg_n += 1;
  );
);
function panel(x, y, w, h)
(
  col(0.03,0.03,0.035); rct(x, y, w, h, 1);
  col(0.055,0.06,0.07); rct(x + 2, y + 2, w - 4, h - 4, 1);
);
// texte de la valeur d'un paramètre -> #vs
function fmt_p(i) local(x, f, d)
(
  x = slider(i); f = PF[i];
  f == 0 ? sprintf(#vs, "%d %%", floor(x*100 + 0.5)) :
  f == 1 ? ( abs(x) < 0.005 ? strcpy(#vs, "C") : x < 0 ? sprintf(#vs, "L %d", floor(-x*100 + 0.5)) : sprintf(#vs, "R %d", floor(x*100 + 0.5)); ) :
  f == 2 ? sprintf(#vs, "%d", x) :
  f == 3 ? ( x == 0 ? strcpy(#vs, "0") : sprintf(#vs, "%+d", x); ) :
  f == 4 ? (
    (x < 0.0001 && (i - 50) % 5 == 1) ? strcpy(#vs, "0 ms") : (
      x = 0.0005*40000^x;
      x < 0.01 ? sprintf(#vs, "%.1f ms", x*1000) : x < 1 ? sprintf(#vs, "%.0f ms", x*1000) : sprintf(#vs, "%.2f s", x);
    );
  ) :
  f == 5 ? (
    slider(i + 1) ? strcpy(#vs, 240 + slider(i + 2)) : ( x = 0.02*2000^x; x < 1 ? sprintf(#vs, "%.2f Hz", x) : sprintf(#vs, "%.1f Hz", x); );
  ) :
  f == 6 ? ( x = 20*1000^x; x < 1000 ? sprintf(#vs, "%.0f Hz", x) : sprintf(#vs, "%.1f kHz", x/1000); ) :
  f == 7 ? sprintf(#vs, "%+.1f dB", x) :
  f == 8 ? strcpy(#vs, PSTR[i] + x) :
  f == 9 ? (
    x = (i == 104 ? 2 : 5)*x*x;
    x < 0.0005 ? strcpy(#vs, "OFF") : x < 1 ? sprintf(#vs, "%.0f ms", x*1000) : sprintf(#vs, "%.2f s", x);
  ) :
  f == 10 ? sprintf(#vs, "%.2f Hz", 0.05*100^x) :
  f == 12 ? sprintf(#vs, "%.1f : 1", x) :
  f == 13 ? sprintf(#vs, "%.1f s", 0.2*60^x) :
  f == 14 ? sprintf(#vs, "%d st", x) :
  f == 15 ? ( x = 500*40^x; x < 1000 ? sprintf(#vs, "%.0f Hz", x) : sprintf(#vs, "%.1f kHz", x/1000); ) :
  f == 16 ? (
    d = slider(i - 1);
    (d == 1 || d == 7 || d == 23) ? sprintf(#vs, "%+.2f st", x*24) : sprintf(#vs, "%+d %%", floor(x*100 + (x >= 0 ? 0.5 : -0.5)));
  ) : sprintf(#vs, "%.2f", x);
);
function knob(cx, cy, r, i, title) local(fr, fz, d, sm, k, krg)
(
  krg = PMAX[i] - PMIN[i];
  fr = (slider(i) - PMIN[i])/krg; fz = PMIN[i] < 0 ? -PMIN[i]/krg : 0;
  draw_knob(cx, cy, r, fr, fz);
  d = PDST[i];
  d > 0 ? (
    sm = 0; k = 0;
    loop(8, (slider(78 + k*3) == d && slider(77 + k*3) > 0) ? ( sm += slider(79 + k*3); ); k += 1;);
    sm != 0 ? ( col(0.45,0.60,0.95); arc(cx, cy, r + 15, fr, clamp(fr + (d == 21 ? sm : sm/krg), 0, 1), 2); );
    md_drag ? ( col(0.45,0.60,0.95); gfx_circle(PX(cx), PY(cy), (r + 4)*S, 0, 1); );
  );
  gfx_setfont(6); col(0.62,0.63,0.66); text_c(cx, cy - r - 13, title);
  fmt_p(i); gfx_setfont(1); col(thc1r,thc1g,thc1b); text_c(cx, cy + r + 14, #vs);
  reg(cx - r - 10, cy - r - 10, 2*r + 20, 2*r + 20, 1, i, 0);
);
function vbox(x, y, w, h, i, label)
(
  col(0.03,0.03,0.035); rct(x, y, w, h, 1);
  fmt_p(i); gfx_setfont(1); col(thc1r,thc1g,thc1b); text_c(x + w*0.5, y + h*0.5, #vs);
  strlen(label) > 0 ? ( gfx_setfont(6); col(0.62,0.63,0.66); text_c(x + w*0.5, y - 9, label); );
  reg(x, y, w, h, PF[i] == 8 ? 6 : 1, i, 0);
);
function mbox(x, y, w, h, i)
(
  col(0.03,0.03,0.035); rct(x, y, w, h, 1);
  fmt_p(i); gfx_setfont(1); slider(i) > 0 ? col(0.90,0.91,0.93) : col(0.45,0.47,0.52); text_l(x + 8, y + h*0.5, #vs);
  col(0.45,0.47,0.52); text_r(x + w - 8, y + h*0.5, "v");
  reg(x, y, w, h, 6, i, 0);
);
function selbox(x, y, w, h, i)
(
  gfx_setfont(1);
  draw_btn(x, y, 18, h, 0, "<"); reg(x, y, 18, h, 5, i, -1);
  col(0.03,0.03,0.035); rct(x + 20, y, w - 40, h, 1);
  fmt_p(i); col(thc1r,thc1g,thc1b); text_c(x + w*0.5, y + h*0.5, #vs);
  reg(x + 20, y, w - 40, h, 6, i, 0);
  draw_btn(x + w - 18, y, 18, h, 0, ">"); reg(x + w - 18, y, 18, h, 5, i, 1);
);
function tog(x, y, w, h, i, label)
(
  draw_btn(x, y, w, h, slider(i) >= 0.5, label); reg(x, y, w, h, 2, i, 0);
);
function fx_head(x, y, w, name, ion) local(tw, th)
(
  panel(x, y, w, 125);
  gfx_setfont(4); slider(ion) ? col(thc0r,thc0g,thc0b) : col(0.62,0.63,0.66); text_l(x + 14, y + 16, name);
  gfx_measurestr(name, tw, th);
  gfx_setfont(6); tog(x + 24 + tw/S, y + 6, 36, 20, ion, "ON");
);
function osc_panel(x0, y0, o) local(pb, i, j, wt, pos, f0, ff, wm, wa, t0, t1, lx, ly, x, y, p, sv, fr, on)
(
  pb = 1 + o*16; on = slider(pb);
  panel(x0, y0, 340, 260);
  gfx_setfont(4); col(thc0r,thc0g,thc0b);
  o ? text_l(x0 + 14, y0 + 16, "OSC B") : text_l(x0 + 14, y0 + 16, "OSC A");
  gfx_setfont(6); tog(x0 + 66, y0 + 6, 34, 20, pb, "ON");
  selbox(x0 + 106, y0 + 6, 170, 20, pb + 1);
  gfx_setfont(6); tog(x0 + 282, y0 + 6, 46, 20, pb + 15, "FILTER");
  // affichage : images de la table en perspective + image jouée (avec warp)
  col(0.03,0.03,0.035); rct(x0 + 12, y0 + 30, 316, 82, 1);
  wt = slider(pb + 1); pos = slider(pb + 2)*15; f0 = min(floor(pos), 14); ff = pos - f0;
  wm = slider(pb + 3); wa = slider(pb + 4);
  j = 5;
  loop(5,
    fr = j*3; t0 = TB + ((wt*NFR + fr)*NLV)*4096;
    col(0.13 + 0.02*(5 - j), 0.135 + 0.02*(5 - j), 0.15 + 0.02*(5 - j));
    i = 0;
    loop(41,
      p = i/40; sv = t0[2*(floor(p*2047) & 2047)];
      x = x0 + 24 + j*9 + p*230; y = y0 + 76 - j*6 - sv*16;
      i > 0 ? ln(lx, ly, x, y); lx = x; ly = y;
      i += 1;
    );
    j -= 1;
  );
  t0 = TB + ((wt*NFR + f0)*NLV)*4096; t1 = t0 + NLV*4096;
  on ? col(thc0r,thc0g,thc0b) : col(0.40,0.41,0.45);
  i = 0;
  loop(97,
    p = min(i/96, 0.9999); sv = osc_rd(t0, t1, ff, p, wm, wa, 0);
    x = x0 + 20 + p*250; y = y0 + 80 - sv*26;
    i > 0 ? ( ln(lx, ly, x, y); ln(lx, ly + 1/S, x, y + 1/S); ); lx = x; ly = y;
    i += 1;
  );
  gfx_setfont(7); col(0.50,0.51,0.55); sprintf(#sv, "frame %d / 16", floor(pos + 0.5) + 1); text_r(x0 + 322, y0 + 104, #sv);
  gfx_setfont(6); col(0.62,0.63,0.66); text_l(x0 + 14, y0 + 127, "WARP");
  selbox(x0 + 48, y0 + 118, 170, 18, pb + 3);
  knob(x0 + 42, y0 + 174, 17, pb + 2, "WT POS");
  knob(x0 + 106, y0 + 174, 17, pb + 4, "WARP");
  knob(x0 + 170, y0 + 174, 17, pb + 11, "PHASE");
  knob(x0 + 234, y0 + 174, 17, pb + 13, "LEVEL");
  knob(x0 + 298, y0 + 174, 17, pb + 14, "PAN");
  vbox(x0 + 12, y0 + 228, 41, 22, pb + 5, "OCT");
  vbox(x0 + 57, y0 + 228, 41, 22, pb + 6, "SEMI");
  vbox(x0 + 102, y0 + 228, 41, 22, pb + 7, "FINE");
  vbox(x0 + 147, y0 + 228, 41, 22, pb + 8, "UNISON");
  vbox(x0 + 192, y0 + 228, 41, 22, pb + 9, "DETUNE");
  vbox(x0 + 237, y0 + 228, 41, 22, pb + 10, "BLEND");
  vbox(x0 + 282, y0 + 228, 46, 22, pb + 12, "RAND");
);


// ---- État initial -----------------------------------------------------------------------------
!st_ok ? (
  cur_cat = 0; cur_idx = -1; page = 0; etab = 0; ltab = 0; dirty = 0;
  memset(UP, 0, 64*NPS);
  zi = 0; loop(64, strcpy(300 + zi, ""); zi += 1;);
  st_ok = 1;
);
read_par(); fx_par();
!fx_ok ? ( fx_clear(); fx_ok = 1; );
last_nt = -1; held = 0; pbend = 0; modw = 0; aftt = 0; sustain = 0;
memset(VOX, 0, NV*VS);
dl_t = y_tgt; crc = 0; lim_g = 1;
LGP[0] = LGP[1] = 0;

// ---- Gestion des presets ----------------------------------------------------------------------
function pre_addr(c, k) ( k < 16 ? FP + (c*16 + k)*NPS : UP + (c*8 + k - 16)*NPS; );
function pre_ok(c, k) ( k < 16 ? (k < NPRE) : (UP + (c*8 + k - 16)*NPS)[0]; );
function pre_name(c, k) ( k < 16 ? strcpy(#pn, 400 + c*16 + k) : strcpy(#pn, 300 + c*8 + k - 16); );
function load_vals(src) local(i)
(
  i = 1; loop(NP, slider(i) = src[i]; i += 1;);
  sliderchange(-1);
  need_clr = 1;
);
function load_pre(c, k)
(
  pre_ok(c, k) ? ( load_vals(pre_addr(c, k)); cur_cat = c; cur_idx = k; dirty = 0; );
);
function load_init() ( init_pre(INITB); load_vals(INITB); cur_idx = -1; dirty = 0; );
function save_user(c, s, nm) local(d, i)
(
  d = UP + (c*8 + s)*NPS; d[0] = 1;
  i = 1; loop(NP, d[i] = slider(i); i += 1;);
  strcpy(300 + c*8 + s, nm);
  cur_cat = c; cur_idx = 16 + s; dirty = 0;
);
function step_pre(dir) local(k, n)
(
  k = cur_idx < 0 ? (dir > 0 ? -1 : 24) : cur_idx; n = 0;
  while (
    k += dir; k > 23 ? ( k = 0; ); k < 0 ? ( k = 23; );
    n += 1;
    !pre_ok(cur_cat, k) && n < 25;
  );
  load_pre(cur_cat, k);
);

@serialize
ser_ver = 2;
rd_ = file_avail(0) >= 0;
file_var(0, ser_ver);
file_var(0, cur_cat); file_var(0, cur_idx); file_var(0, page); file_var(0, etab); file_var(0, ltab); file_var(0, dirty);
// v1 : 8 presets d'usine par catégorie, les places utilisateur commençaient à 8
(rd_ && ser_ver < 2) ? ( cur_idx >= 8 ? ( cur_idx += 8; ) : cur_idx >= 6 ? ( cur_idx = -1; ); );
ser_ver = 2;
sr_i = 0; loop(64*NPS, file_var(0, UP[sr_i]); sr_i += 1;);
sr_i = 0;
loop(64,
  rd_ ? ( file_string(0, #ls); strcpy(300 + sr_i, #ls); ) : ( strcpy(#ls, 300 + sr_i); file_string(0, #ls); );
  sr_i += 1;
);

@block
read_par(); fx_par();
need_clr ? ( fx_clear(); need_clr = 0; );
// file MIDI de ce bloc
qn = 0; qi = 0; spos = 0;
while (qn < EQMAX && midirecv(ofs_, m1_, m2_, m3_)) (
  EQB[qn*4] = ofs_; EQB[qn*4 + 1] = m1_; EQB[qn*4 + 2] = m2_; EQB[qn*4 + 3] = m3_; qn += 1;
);
// LFO libres synchronisés : calés sur la position de lecture
(play_state & 1) ? (
  bk_i = 0;
  loop(2,
    ((LFOP + bk_i*8)[4] && (LFOP + bk_i*8)[2] == 1) ? ( LGP[bk_i] = frac_(beat_position/DIVB[slider(68 + bk_i*6)]); );
    bk_i += 1;
  );
);
vu_l *= 0.8; vu_r *= 0.8;

@sample
while (qi < qn && EQB[qi*4] <= spos) ( midi_ev(EQB[qi*4 + 1], EQB[qi*4 + 2], EQB[qi*4 + 3]); qi += 1; );
spos += 1;
crc <= 0 ? ( ctrl_all(); crc = CR; );
crc -= 1;
oL = oR = 0;
v = 0;
loop(NV,
  vb = VOX + v*VS;
  vb[0] ? (
    amp = vb[29] += vb[30];
    flL = flR = dL = dR = 0;
    ph_ = PHS + v*16; ug = UNI + v*128;
    // OSC A
    n_ = vb[55];
    n_ > 0 ? (
      t0_ = vb[51]; t1_ = vb[52]; ff_ = vb[53]; wa_ = vb[54]; o_ = vb[75];
      xl = xr = xm = 0; u = 0;
      loop(n_,
        p_ = ph_[u] + ug[u]; p_ >= 1 ? ( p_ -= 1; ); ph_[u] = p_;
        s_ = osc_rd(t0_, t1_, ff_, p_, a_wm, wa_, o_);
        xl += s_*ug[16 + u]; xr += s_*ug[24 + u]; xm += s_;
        u += 1;
      );
      vb[74] = xm/n_;
      a_flt ? ( flL += xl; flR += xr; ) : ( dL += xl; dR += xr; );
    ) : ( vb[74] = 0; );
    // OSC B
    n_ = vb[61];
    n_ > 0 ? (
      t0_ = vb[57]; t1_ = vb[58]; ff_ = vb[59]; wa_ = vb[60]; o_ = vb[74];
      xl = xr = xm = 0; u = 0;
      loop(n_,
        p_ = ph_[8 + u] + ug[64 + u]; p_ >= 1 ? ( p_ -= 1; ); ph_[8 + u] = p_;
        s_ = osc_rd(t0_, t1_, ff_, p_, b_wm, wa_, o_);
        xl += s_*ug[80 + u]; xr += s_*ug[88 + u]; xm += s_;
        u += 1;
      );
      vb[75] = xm/n_;
      b_flt ? ( flL += xl; flR += xr; ) : ( dL += xl; dR += xr; );
    ) : ( vb[75] = 0; );
    // SUB
    vb[65] != 0 || vb[66] != 0 ? (
      p_ = vb[63] + vb[64]; p_ >= 1 ? ( p_ -= 1; ); vb[63] = p_; dt_ = vb[64];
      s_ = s_sh == 0 ? sin(2*$pi*p_) :
           s_sh == 1 ? ( p_ < 0.25 ? 4*p_ : p_ < 0.75 ? 2 - 4*p_ : 4*p_ - 4; ) :
           s_sh == 2 ? 2*p_ - 1 - blep(p_, dt_) :
           s_sh == 3 ? ( (p_ < 0.5 ? 1 : -1) + blep(p_, dt_) - blep(frac_(p_ + 0.5), dt_); ) :
                       ( (p_ < 0.25 ? 1 : -1) + blep(p_, dt_) - blep(frac_(p_ + 0.75), dt_) - 0.5; );
      s_dir ? ( dL += s_*vb[65]; dR += s_*vb[66]; ) : ( flL += s_*vb[65]; flR += s_*vb[66]; );
    );
    // NOISE
    vb[69] != 0 || vb[70] != 0 ? (
      w_ = rand(2) - 1; c_ = vb[71];
      c_ < 0.5 ? (
        k_ = 0.01 + sqr(c_*2)*0.99; vb[67] += (w_ - vb[67])*k_; s_ = vb[67]*min(5, 1/sqrt(k_));
      ) : (
        vb[68] += (w_ - vb[68])*0.15; s_ = w_ - (c_ - 0.5)*1.8*vb[68];
      );
      n_flt ? ( flL += s_*vb[69]; flR += s_*vb[70]; ) : ( dL += s_*vb[69]; dR += s_*vb[70]; );
    );
    // FILTRE
    f_on ? (
      g_ = vb[31] += vb[32]; r_ = vb[33]; dg_ = vb[34];
      dg_ > 1.01 ? ( flL = tanh_(flL*dg_)/sqrt(dg_)*1.6; flR = tanh_(flR*dg_)/sqrt(dg_)*1.6; );
      f_ty == 2 ? (
        // MG LADDER : 4 pôles, rétroaction saturée
        gq_ = g_/(1 + g_); k4 = r_*4.1;
        x_ = tanh_(flL - k4*vb[39]);
        y_ = (x_ - vb[35])*gq_ + vb[35]; vb[35] = 2*y_ - vb[35];
        z_ = (y_ - vb[36])*gq_ + vb[36]; vb[36] = 2*z_ - vb[36];
        y_ = (z_ - vb[37])*gq_ + vb[37]; vb[37] = 2*y_ - vb[37];
        z_ = (y_ - vb[38])*gq_ + vb[38]; vb[38] = 2*z_ - vb[38]; vb[39] = z_;
        flL = z_*(1 + r_*2.2);
        x_ = tanh_(flR - k4*vb[47]);
        y_ = (x_ - vb[43])*gq_ + vb[43]; vb[43] = 2*y_ - vb[43];
        z_ = (y_ - vb[44])*gq_ + vb[44]; vb[44] = 2*z_ - vb[44];
        y_ = (z_ - vb[45])*gq_ + vb[45]; vb[45] = 2*y_ - vb[45];
        z_ = (y_ - vb[46])*gq_ + vb[46]; vb[46] = 2*z_ - vb[46]; vb[47] = z_;
        flR = z_*(1 + r_*2.2);
      ) : (
        // SVF (TPT) : 1 étage (12 dB) ou 2 étages (24 dB)
        k_ = 2 - 1.96*r_; two = (f_ty == 1 || f_ty == 4 || f_ty == 6);
        two ? ( kb = 1.414; a1b = 1/(1 + g_*(g_ + kb)); a2b = g_*a1b; a3b = g_*a2b; );
        a1 = 1/(1 + g_*(g_ + k_)); a2 = g_*a1; a3 = g_*a2;
        ch = 0;
        loop(2,
          o_ = 35 + ch*8; x_ = ch ? flR : flL;
          two ? (
            v3 = x_ - vb[o_ + 3]; v1 = a1b*vb[o_ + 2] + a2b*v3; v2 = vb[o_ + 3] + a2b*vb[o_ + 2] + a3b*v3;
            vb[o_ + 2] = 2*v1 - vb[o_ + 2]; vb[o_ + 3] = 2*v2 - vb[o_ + 3];
            x_ = f_ty == 1 ? v2 : f_ty == 4 ? x_ - kb*v1 - v2 : v1*kb;
          );
          v3 = x_ - vb[o_ + 1]; v1 = a1*vb[o_] + a2*v3; v2 = vb[o_ + 1] + a2*vb[o_] + a3*v3;
          vb[o_] = 2*v1 - vb[o_]; vb[o_ + 1] = 2*v2 - vb[o_ + 1];
          y_ = (f_ty == 0 || f_ty == 1) ? v2 :
               (f_ty == 3 || f_ty == 4) ? x_ - k_*v1 - v2 :
               (f_ty == 5 || f_ty == 6) ? v1*k_ :
               f_ty == 7 ? x_ - k_*v1 : v2 - (x_ - k_*v1 - v2);
          ch ? ( flR = y_; ) : ( flL = y_; );
          ch += 1;
        );
      );
    );
    xl = (flL + dL)*amp; xr = (flR + dR)*amp;
    oL += xl*vb[72]; oR += xr*vb[73];
  );
  v += 1;
);
oL *= 0.5; oR *= 0.5;
// ---- EFFETS : DIST -> CHORUS -> DELAY -> COMP -> REVERB -> EQ ----
d_on ? (
  d_ty == 5 ? (
    d_cnt -= 1; d_cnt <= 0 ? ( d_cnt = d_hold; d_hl = floor(oL*d_bits + 0.5)/d_bits; d_hr = floor(oR*d_bits + 0.5)/d_bits; );
    xl = d_hl; xr = d_hr;
  ) : (
    xl = shape(oL*d_g)*d_c; xr = shape(oR*d_g)*d_c;
    d_dcl += (xl - d_dcl)*0.0015; d_dcr += (xr - d_dcr)*0.0015; xl -= d_dcl; xr -= d_dcr;
  );
  oL += d_mix*(xl - oL); oR += d_mix*(xr - oR);
);
c_on ? (
  c_ph += c_rt/srate; c_ph >= 1 ? ( c_ph -= 1; );
  ch = 0;
  loop(2,
    bf = CHB + ch*8192; x_ = ch ? oR : oL; y_ = 0;
    k_ = 0;
    loop(2,
      md = sin(2*$pi*(c_ph + ch*0.25 + k_*0.5));
      dd = (0.008 + k_*0.004 + c_dp*0.005*(1 + md))*srate;
      rp = ch_w - dd; rp < 0 ? ( rp += 8192; ); i0 = floor(rp); fr = rp - i0;
      y_ += bf[i0 & 8191] + fr*(bf[(i0 + 1) & 8191] - bf[i0 & 8191]);
      k_ += 1;
    );
    y_ *= 0.5;
    bf[ch_w] = x_ + c_fb*y_;
    ch ? ( oR += c_mix*(y_ - oR); ) : ( oL += c_mix*(y_ - oL); );
    ch += 1;
  );
  ch_w = (ch_w + 1) & 8191;
);
y_on ? (
  dl_t += (y_tgt - dl_t)*0.0004;
  rp = dl_w - dl_t; rp < 0 ? ( rp += DLMAX; ); i0 = floor(rp); fr = rp - i0; i1 = i0 + 1; i1 >= DLMAX ? ( i1 = 0; );
  yl = DLB[i0] + fr*(DLB[i1] - DLB[i0]);
  yr = DLB[DLMAX + i0] + fr*(DLB[DLMAX + i1] - DLB[DLMAX + i0]);
  dl_lpl += (yl - dl_lpl)*y_lp; dl_lpr += (yr - dl_lpr)*y_lp;
  y_pp ? (
    DLB[dl_w] = (oL + oR)*0.5 + y_fb*dl_lpr; DLB[DLMAX + dl_w] = y_fb*dl_lpl;
  ) : (
    DLB[dl_w] = oL + y_fb*dl_lpl; DLB[DLMAX + dl_w] = oR + y_fb*dl_lpr;
  );
  dl_w += 1; dl_w >= DLMAX ? ( dl_w = 0; );
  oL += y_mix*yl; oR += y_mix*yr;
);
k_on ? (
  x_ = max(abs(oL), abs(oR));
  k_env = x_ > k_env ? x_ + (k_env - x_)*k_at : x_ + (k_env - x_)*k_rl;
  ov = 20*log10(max(k_env, 0.00001)) - k_th;
  gr = ov <= -3 ? 0 : ov >= 3 ? ov*(1 - 1/k_rt) : sqr(ov + 3)/12*(1 - 1/k_rt);
  k_gr = gr;
  g_ = db2lin(-gr)*k_mk; oL *= g_; oR *= g_;
) : ( k_gr = 0; );
r_on ? (
  x_ = (oL + oR)*0.5;
  // diffusion : 4 passe-tout en série
  k_ = 0;
  loop(4,
    bf = DIF + k_*8192; ln = DIFL[4 + k_];
    rp = (rv_w - ln) & 8191; y_ = bf[rp];
    bf[rv_w & 8191] = x_ + 0.6*y_; x_ = y_ - 0.6*(x_ + 0.6*y_);
    k_ += 1;
  );
  // FDN 8 lignes, matrice de Hadamard
  i = 0;
  loop(8,
    y_ = RVB[i*65536 + ((rv_w - RVLN[8 + i]) & 65535)];
    RVLP[i] += (y_ - RVLP[i])*r_dmp; HD[i] = RVLP[i]*RVG[i];
    i += 1;
  );
  rl = HD[0] + HD[2] + HD[4] + HD[6]; rr = HD[1] + HD[3] + HD[5] + HD[7];
  a0_ = HD[0] + HD[1]; a1_ = HD[0] - HD[1]; a2_ = HD[2] + HD[3]; a3_ = HD[2] - HD[3];
  a4_ = HD[4] + HD[5]; a5_ = HD[4] - HD[5]; a6_ = HD[6] + HD[7]; a7_ = HD[6] - HD[7];
  b0_ = a0_ + a2_; b1_ = a1_ + a3_; b2_ = a0_ - a2_; b3_ = a1_ - a3_;
  b4_ = a4_ + a6_; b5_ = a5_ + a7_; b6_ = a4_ - a6_; b7_ = a5_ - a7_;
  HD[0] = b0_ + b4_; HD[1] = b1_ + b5_; HD[2] = b2_ + b6_; HD[3] = b3_ + b7_;
  HD[4] = b0_ - b4_; HD[5] = b1_ - b5_; HD[6] = b2_ - b6_; HD[7] = b3_ - b7_;
  i = 0;
  loop(8, RVB[i*65536 + (rv_w & 65535)] = HD[i]*0.35355339 + x_*((i & 1) ? -0.5 : 0.5); i += 1;);
  rv_w = (rv_w + 1) & 65535;
  rl *= 0.35; rr *= 0.35;
  mm = (rl + rr)*0.5; ss = (rl - rr)*0.5*r_wd; rl = mm + ss; rr = mm - ss;
  oL += r_mix*(rl - oL*0.5*r_mix); oR += r_mix*(rr - oR*0.5*r_mix);
);
q_on ? (
  y_ = ql0*oL + qs1; qs1 = ql1*oL - ql3*y_ + qs2; qs2 = ql2*oL - ql4*y_; oL = y_;
  y_ = ql0*oR + qs3; qs3 = ql1*oR - ql3*y_ + qs4; qs4 = ql2*oR - ql4*y_; oR = y_;
  y_ = qh0*oL + qs5; qs5 = qh1*oL - qh3*y_ + qs6; qs6 = qh2*oL - qh4*y_; oL = y_;
  y_ = qh0*oR + qs7; qs7 = qh1*oR - qh3*y_ + qs8; qs8 = qh2*oR - qh4*y_; oR = y_;
);
// limiteur de sécurité sans latence (plafond -0,3 dBFS), puis écrêteur caché
oL *= mvol*2; oR *= mvol*2;
!lim_off ? (
  x_ = max(abs(oL), abs(oR));
  lim_t = x_ > 0.966 ? 0.966/x_ : 1;
  lim_g = lim_t < lim_g ? lim_t : lim_g + (1 - lim_g)*lim_rl;
  oL *= lim_g; oR *= lim_g;
);
spl0 = clamp(oL, -1, 1);
spl1 = clamp(oR, -1, 1);
vu_l = max(vu_l, abs(spl0)); vu_r = max(vu_r, abs(spl1));

@gfx 1100 676
// thème : orange ou vert (double-clic sur le nom du plug-in), mémorisé dans le dernier slider
slider139 >= 0.5 ? (
  thc0r = 0.424; thc0g = 0.851; thc0b = 0.78;
  thc1r = 0.6; thc1g = 0.92; thc1b = 0.86;
  thc5r = 0.02; thc5g = 0.1; thc5b = 0.09;
) : (
  thc0r = 1.0; thc0g = 0.58; thc0b = 0.12;
  thc1r = 1.0; thc1g = 0.7; thc1b = 0.35;
  thc5r = 0.1; thc5g = 0.06; thc5b = 0.02;
);
size_ = floor(slider138 + 0.5);
S  = size_ >= 4 ? 2 : 0.75 + 0.25*size_;
ox = max(0, floor((gfx_w - 1100*S)/2));
oy = max(0, floor((gfx_h - 676*S)/2));
mx = (mouse_x - ox)/S;
my = (mouse_y - oy)/S;

gfx_setfont(1, "Arial", max(6, floor(12*S)), 'b');
gfx_setfont(2, "Arial", max(10, floor(30*S)), 'b');
gfx_setfont(3, "Arial", max(5, floor(10*S)), 'b');
gfx_setfont(4, "Arial", max(6, floor(13*S)), 'b');
gfx_setfont(5, "Arial", max(6, floor(11*S)));
gfx_setfont(6, "Arial", max(5, floor(9*S)), 'b');
gfx_setfont(7, "Arial", max(5, floor(9*S)));

rg_n = 0;

// ---- Façade -----------------------------------------------------------------------
col(0.07,0.07,0.075); gfx_rect(0,0,gfx_w,gfx_h);
col(0.115,0.12,0.13); rct(6,6,1088,634,1);
gx_ui = 0; loop(63, col(0.125,0.13,0.14); rct(6, 10 + gx_ui*10, 1088, 1, 1); gx_ui += 1;);
col(0.20,0.21,0.23); rct(6,6,1088,2,1);
col(0.04,0.04,0.045); rct(6,638,1088,2,1);
col(0.06,0.06,0.065);
gfx_circle(PX(18), PY(20), 4*S, 1, 1);   gfx_circle(PX(18), PY(626), 4*S, 1, 1);
gfx_circle(PX(1082), PY(20), 4*S, 1, 1); gfx_circle(PX(1082), PY(626), 4*S, 1, 1);
gfx_setfont(2); col(thc0r,thc0g,thc0b); text_l(34, 34, "RMsynth"); th_x1 = gfx_x; th_y0 = gfx_y; gfx_measurestr("RMsynth", th_w, th_h); th_x0 = th_x1 - th_w;
gfx_setfont(3); col(0.62,0.63,0.66); text_l(34 + th_w/S + 14, 38, "WAVETABLE  SYNTH");
gfx_setfont(4); col(0.85,0.86,0.88); text_r(1066, 34, "ReNo Mellow");
// pages
gfx_setfont(1);
gx_ui = 0;
loop(3,
  gx_ui == 0 ? strcpy(#s, "OSC") : gx_ui == 1 ? strcpy(#s, "MATRIX") : strcpy(#s, "FX");
  draw_btn(640 + gx_ui*84, 22, 80, 24, page == gx_ui, #s); reg(640 + gx_ui*84, 22, 80, 24, 4, 0, 30 + gx_ui);

gx_wa = 0.06 + slider(gx_e); gx_wh = slider(gx_e + 1) > 0.0001 ? 0.04 + slider(gx_e + 1) : 0; gx_wd = 0.06 + slider(gx_e + 2); gx_wr = 0.06 + slider(gx_e + 4);
gx_tt = gx_wa + gx_wh + gx_wd + 0.35 + gx_wr; gx_sc = 308/gx_tt; gx_su = slider(gx_e + 3);
gx_x0 = 400; gx_y0 = 476; gx_hh = 64;
ln(gx_x0, gx_y0, gx_x0 + gx_wa*gx_sc, gx_y0 - gx_hh);
ln(gx_x0 + gx_wa*gx_sc, gx_y0 - gx_hh, gx_x0 + (gx_wa + gx_wh)*gx_sc, gx_y0 - gx_hh);
gx_xs = gx_x0 + (gx_wa + gx_wh)*gx_sc; gx_lx = gx_xs; gx_ly = gx_y0 - gx_hh;
gx_ui = 1; loop(20, gx_x = gx_xs + gx_wd*gx_sc*gx_ui/20; gx_y = gx_y0 - gx_hh*(gx_su + (1 - gx_su)*exp(-4.6*gx_ui/20)); ln(gx_lx, gx_ly, gx_x, gx_y); gx_lx = gx_x; gx_ly = gx_y; gx_ui += 1;);
ln(gx_lx, gx_ly, gx_lx + 0.35*gx_sc, gx_ly); gx_xs = gx_lx + 0.35*gx_sc; gx_lx = gx_xs;
gx_ui = 1; loop(20, gx_x = gx_xs + gx_wr*gx_sc*gx_ui/20; gx_y = gx_y0 - gx_hh*gx_su*exp(-6.9*gx_ui/20); ln(gx_lx, gx_ly, gx_x, gx_y); gx_lx = gx_x; gx_ly = gx_y; gx_ui += 1;);
knob(428, 524, 16, gx_e, "ATTACK");

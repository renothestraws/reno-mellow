in_pin:none
out_pin:Out L
out_pin:Out R

options:maxmem=12582912

@init
ext_noinit = 1;
ext_nodenorm = 1;
NP = 137; NPS = 160; NPRE = 16;
NWT = 10; NFR = 16; NLV = 11; WN = 2048;
TB = 0;
B2 = 7340032;
WB = B2;              // tampon FFT de travail (4096)
VOX = B2 + 8192; VS = 96; NV = 16;
PHS = B2 + 10240;     // phases d'unisson : 16 par voix
UNI = B2 + 45056;     // incréments / gains d'unisson : 128 par voix (A puis B)
PMIN = B2 + 12288; PMAX = B2 + 12544; PDEF = B2 + 12800; PSTP = B2 + 13056;
PF = B2 + 13312; PSTR = B2 + 13568; PDST = B2 + 13824;
DIVB = B2 + 14080;
SV = B2 + 14112; DS = B2 + 14144;
MSRC = B2 + 14200; MDST = B2 + 14216; MAMT = B2 + 14232;
ENVP = B2 + 14260; LFOP = B2 + 14300;
EQB = B2 + 47104; EQMAX = 400;
RG = B2 + 16384; RMAX = 250;
NSTK = B2 + 18432;
MMAP = B2 + 18500;
FP = B2 + 20480;      // presets d'usine (8 catégories x 16) x NPS
UP = B2 + 53248;      // presets utilisateur (8 catégories x 8) x NPS
CHB = B2 + 65536;     // chorus 2 x 8192
DLB = B2 + 131072; DLMAX = 786432;
RVB = 9109504; DIF = 9633792;
EPS = 0.000000001;
CR = 16;
INITB = B2 + 49152;
LGP = B2 + 14380; LGA = B2 + 14384; LGB = B2 + 14388; LGV = B2 + 14392;
RVLP = B2 + 14600; RVLN = B2 + 14610; RVG = B2 + 14630; DIFL = B2 + 14640; HD = B2 + 14660;

function clamp(x, a, b) ( x < a ? a : x > b ? b : x; );
function frac_(x) ( x - floor(x); );
function tanh_(x) local(x2) ( x > 3 ? 1 : x < -3 ? -1 : ( x2 = x*x; x*(27 + x2)/(27 + 9*x2); ); );
function db2lin(d) ( exp(d*0.11512925464970228); );
function hrnd(a, b) local(x) ( x = sin(a*12.9898 + b*78.233)*43758.5453; x - floor(x); );


// ---- Souris ----------------------------------------------------------------------------------
mb1 = mouse_cap & 1;
mb2 = mouse_cap & 2;
(mb1 && !last_mb) ? (
  drag = -1;
  ui = 0; loop(8, in_circ(kxpos(ui), KNY, 40) ? ( drag = kdisp(ui); ); ui += 1;);
  (drag >= 0 && (mouse_cap & 4)) ? ( k_def(drag); drag = -1; );
  in_rect(660, 88, 110, 34) ? ( set_sl(1, 0); );
  in_rect(776, 88, 110, 34) ? ( set_sl(1, 1); );
  in_rect(WX, WY, WW, WH) ? ( s_ok ? ( aud_req = 1; ); );
  in_rect(842, 377, 46, 24) ? (slider9 = 0; sliderchange(slider9););
  in_rect(892, 377, 46, 24) ? (slider9 = 1; sliderchange(slider9););
  in_rect(942, 377, 46, 24) ? (slider9 = 2; sliderchange(slider9););
  in_rect(992, 377, 46, 24) ? (slider9 = 3; sliderchange(slider9););
);
(mb2 && !last_mb2 && in_rect(WX, WY, WW, WH)) ? ( strcpy(#path, ""); strcpy(#sname, ""); s_req = 1; );
(mb1 && drag >= 0) ? (
  fine = (mouse_cap & 8) ? 0.15 : 1;
  dy = (last_my - my)*fine;
  dy != 0 ? k_set(drag, k_frac(drag) + dy*0.006);
);
!mb1 ? (drag = -1);
last_mb = mb1; last_mb2 = mb2;
last_my = (mouse_y - oy)/S;

// ---- Thème : double-clic sur le nom du plug-in = orange / vert ----------------------------
th_mb = mouse_cap & 1;
(th_mb && !th_lmb) ? (
  (mouse_x >= th_x0 - 6 && mouse_x <= th_x1 + 6 && mouse_y >= th_y0 - 6 && mouse_y <= th_y0 + th_h + 6) ? (
    (time_precise() - th_t < 0.4) ? ( slider11 = slider11 >= 0.5 ? 0 : 1; sliderchange(slider11); th_t = 0; ) : ( th_t = time_precise(); );
  );
);
th_lmb = th_mb;

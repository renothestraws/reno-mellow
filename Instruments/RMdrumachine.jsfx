  gfx_setfont(6); fl_ > 0.5 ? col(0.10,0.06,0.02) : col(0.55,0.56,0.60);
  sprintf(#s, "%d", ui + 1); text_l(px_ + 6, py_ + 10, #s);
  sprintf(#s, "%d", P_NOTE[ui]); text_r(px_ + 80, py_ + 10, #s);
  gfx_setfont(1); fl_ > 0.5 ? col(0.10,0.06,0.02) : col(0.90,0.91,0.93);
  text_c(px_ + 43, py_ + 36, 400 + ui);
  gfx_setfont(7); fl_ > 0.5 ? col(0.20,0.12,0.04) : (P_USER[ui] ? col(1.00,0.70,0.35) : col(0.50,0.51,0.55));
  strcpy_substr(#sn, 300 + ui, 0, 14); text_c(px_ + 43, py_ + 56, #sn);
  // mute / solo / motif
  P_MUTE[ui] ? ( col(0.85,0.25,0.20); rct(px_ + 6, py_ + 64, 14, 8, 1); );
  P_SOLO[ui] ? ( col(0.98,0.84,0.22); rct(px_ + 22, py_ + 64, 14, 8, 1); );
  hs_ = 0; k_ = 0; loop(16, (SUBNc[ui*16 + k_] > 1 ? (SUBVc[(ui*16 + k_)*8] || SUBVc[(ui*16 + k_)*8 + 1] || SUBVc[(ui*16 + k_)*8 + 2] || SUBVc[(ui*16 + k_)*8 + 3] || SUBVc[(ui*16 + k_)*8 + 4] || SUBVc[(ui*16 + k_)*8 + 5] || SUBVc[(ui*16 + k_)*8 + 6] || SUBVc[(ui*16 + k_)*8 + 7]) : PATc[ui*16 + k_]) ? (hs_ = 1); k_ += 1;);
  hs_ ? ( col(1.00,0.58,0.12); gfx_circle(PX(px_ + 78), PY(py_ + 68), 3*S, 1, 1); );
  ui += 1;
);

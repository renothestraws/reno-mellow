// ---- Séquenceur ----------------------------------------------------------------------------
gfx_setfont(4); col(0.92,0.93,0.95); sprintf(#s, "STEPS  -  PAD %d  ", sel + 1); text_l(34, 440, #s);
gfx_measurestr(#s, sw_, sh_); col(1.00,0.58,0.12); text_l(34 + sw_/S, 440, 400 + sel);
gfx_setfont(6); col(0.62,0.63,0.66); text_r(560, 441, "PATTERN");
gfx_setfont(1);
ui = 0;
loop(8,
  strcpy_substr(#s, "ABCDEFGH", ui, 1);
  draw_btn(568 + ui*40, 430, 36, 22, cur_pat == ui, #s);
  ui += 1;
);
gfx_setfont(7); col(0.45,0.47,0.52); text_l(892, 441, "shift: copy");
gfx_setfont(1); draw_btn(966, 430, 60, 22, 0, "CLEAR");
ui = 0;
loop(16,
  sx_ = 34 + ui*62;
  floor(ui/4) % 2 == 0 ? ( col(0.09,0.095,0.105); rct(sx_ - 3, 456, 62, 98, 1); );
  sn_g = max(SUBNc[sel*16 + ui], 1);
  cw_ = (56 - (sn_g - 1)*2)/sn_g;
  k_ = 0;
  loop(sn_g,
    sv_ = sn_g > 1 ? SUBVc[(sel*16 + ui)*8 + k_] : PATc[sel*16 + ui];
    cx_ = sx_ + k_*(cw_ + 2);
    // accent
    sv_ == 2 ? col(1.00,0.30,0.20) : col(0.16,0.165,0.18); rct(cx_, 460, cw_, 14, 1);
    col(0.03,0.03,0.035); rct(cx_, 460, cw_, 14, 0);
    // pas / sous-pas
    sv_ > 0 ? ( sv_ == 3 ? col(0.55,0.36,0.14) : col(1.00,0.58,0.12); ) : col(0.16,0.165,0.18);
    rct(cx_, 478, cw_, 44, 1);
    col(0.03,0.03,0.035); rct(cx_, 478, cw_, 44, 0);
    // ghost
    sv_ == 3 ? col(0.45,0.60,0.95) : col(0.16,0.165,0.18); rct(cx_, 526, cw_, 14, 1);
    col(0.03,0.03,0.035); rct(cx_, 526, cw_, 14, 0);
    k_ += 1;
  );
  ui == cur_step ? ( col(1,1,1); rct(sx_ - 1, 477, 58, 46, 0); rct(sx_ - 2, 476, 60, 48, 0); );
  gfx_setfont(6); col(0.55,0.56,0.60);
  sn_g > 1 ? sprintf(#s, "%d  /%d", ui + 1, sn_g) : sprintf(#s, "%d", ui + 1); text_c(sx_ + 28, 548, #s);
  ui += 1;
);

// ---- Bandeau -------------------------------------------------------------------------
gfx_setfont(3); col(0.62,0.63,0.66); text_c(818, 589, "SIZE");
gfx_setfont(1);
draw_btn(842, 577, 46, 24, floor(size_ + 0.5) == 0, "75%");
draw_btn(892, 577, 46, 24, floor(size_ + 0.5) == 1, "100%");
draw_btn(942, 577, 46, 24, floor(size_ + 0.5) == 2, "125%");

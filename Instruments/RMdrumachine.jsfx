gfx_setfont(5); col(0.45,0.46,0.50); text_l(34, 589, "Ctrl-click: default  -  Shift: fine  -  step: top = accent, bottom = ghost  -  Shift + right-drag on a step: split it (1-8)");

// ---- Souris ----------------------------------------------------------------------------------
mb1 = mouse_cap & 1; mb2 = mouse_cap & 2;
(mb2 && !last_mb2) ? (
  ui = 0; loop(16, in_rect(34 + (ui % 4)*94, 74 + floor(ui/4)*84, 86, 76) ? ( P_DEF[ui] = 1; sel = ui; ); ui += 1;);
  // shift + clic droit sur un pas : début de découpe
  sd_st = -1;
  (mouse_cap & 8) ? (
    ui = 0; loop(16, in_rect(34 + ui*62, 456, 56, 90) ? ( sd_st = ui; sd_o = max(SUBNc[sel*16 + ui], 1); sd_y = my; ); ui += 1;);
  );
);
(mb2 && sd_st >= 0) ? (
  sd_n = min(max(sd_o + floor((sd_y - my)/10), 1), 8);
  sd_n != max(SUBNc[sel*16 + sd_st], 1) ? set_subn(sel, sd_st, sd_n);
);
!mb2 ? (sd_st = -1);
(mb1 && !last_mb) ? (
  drag = 0;
  ui = 0;
  loop(16,
    in_rect(34 + (ui % 4)*94, 74 + floor(ui/4)*84, 86, 76) ? ( sel = ui; P_AUD[ui] = 1; );
    ui += 1;
  );
  in_circ(470, 178, 34) ? drag = 1;
  in_circ(560, 178, 34) ? drag = 2;
  in_circ(650, 178, 34) ? drag = 3;
  in_circ(740, 178, 34) ? drag = 4;
  in_circ(672, 340, 34) ? drag = 5;
  in_circ(752, 340, 34) ? drag = 6;
  in_circ(832, 340, 34) ? drag = 7;
  in_rect(712, 80, 44, 20) ? ( drag = 8; nacc_ = 0; );
  ui = 0; loop(3, in_rect(882 + (ui == 0 ? 0 : ui == 1 ? 44 : 90), 372, ui == 1 ? 44 : 42, 22) ? (pstyle = ui); ui += 1;);
  ui = 0;
  loop(8,
    in_rect(568 + ui*40, 430, 36, 22) ? (
      (mouse_cap & 8) && ui != cur_pat ? (
        memcpy(PAT + ui*256, PATc, 256); memcpy(SUBN + ui*256, SUBNc, 256); memcpy(SUBV + ui*2048, SUBVc, 2048);
      );
      cur_pat = ui; setpat();
    );
    ui += 1;
  );
  in_rect(676, 24, 82, 24) ? (
    strcpy(#mn, "");
    ui = 0; loop(NFK, ui == cur_kit ? strcat(#mn, "!"); strcat(#mn, 520 + ui); strcat(#mn, "|"); ui += 1;);
    ui = 0;
    loop(8,
      ui + NFK == cur_kit ? strcat(#mn, "!");
      UK[ui*128] ? sprintf(#mi, "User %d|", ui + 1) : sprintf(#mi, "#User %d (empty)|", ui + 1);
      strcat(#mn, #mi); ui += 1;
    );
    gfx_x = PX(676); gfx_y = PY(48);
    mres_ = gfx_showmenu(#mn);
    mres_ > 0 ? ( kit_req = mres_; );
  );
  in_rect(762, 24, 82, 24) ? (
    strcpy(#mn, "");
    ui = 0; loop(8, UK[ui*128] ? sprintf(#mi, "Save to User %d (replace)|", ui + 1) : sprintf(#mi, "Save to User %d|", ui + 1); strcat(#mn, #mi); ui += 1;);
    gfx_x = PX(762); gfx_y = PY(48);
    mres_ = gfx_showmenu(#mn);
    mres_ > 0 ? (
      us_ = mres_ - 1; u_ = UK + us_*128;
      u_[0] = 1; u_[1] = cur_fkit;
      ui = 0;
      loop(16,
        u_[2 + ui*7] = slider(1 + ui); u_[3 + ui*7] = slider(17 + ui);
        u_[4 + ui*7] = slider(33 + ui); u_[5 + ui*7] = slider(49 + ui);
        u_[6 + ui*7] = P_OUT[ui]; u_[7 + ui*7] = P_SWG[ui]; u_[8 + ui*7] = P_NOTE[ui];
        P_USER[ui] ? strcpy(600 + us_*16 + ui, 200 + ui) : strcpy(600 + us_*16 + ui, "");
        ui += 1;
      );
      cur_kit = NFK + us_;
    );
  );
  ui = 0; loop(4, in_rect(830 + ui*44, 136, 42, 24) ? (P_OUT[sel] = ui); ui += 1;);
  in_rect(830, 184, 56, 26) ? (P_MUTE[sel] = !P_MUTE[sel]);
  in_rect(890, 184, 56, 26) ? (P_SOLO[sel] = !P_SOLO[sel]);
  in_rect(950, 184, 56, 26) ? (P_SWG[sel] = !P_SWG[sel]);
  ui = 0; loop(3, in_rect(436 + ui*60, 294, 56, 24) ? (tmode = ui); in_rect(436 + ui*60, 350, 56, 24) ? (grid = ui); ui += 1;);
  in_rect(436, 392, 104, 24) ? (seq_on = !seq_on);
  in_rect(544, 392, 68, 24) ? (midi_out = !midi_out);
  in_rect(722, 400, 60, 20) ? (cv_on = !cv_on);
  in_rect(882, 294, 132, 24) ? (g14 = !g14);
  ui = 0; loop(3, in_rect(908 + ui*36, 326, 34, 22) ? (g15 = ui); ui += 1;);
  in_rect(966, 430, 60, 22) ? ( memset(PATc + sel*16, 0, 16); memset(SUBVc + sel*128, 0, 128); ui = 0; loop(16, SUBNc[sel*16 + ui] = 1; ui += 1;); );
  ui = 0;
  loop(16,
    sx_ = 34 + ui*62; ad_ = PATc + sel*16 + ui;
    sn_m = max(SUBNc[sel*16 + ui], 1);
    (sn_m > 1 && mx >= sx_ && mx < sx_ + 56) ? ( ad_ = SUBVc + (sel*16 + ui)*8 + min(floor((mx - sx_)/56*sn_m), sn_m - 1); );
    in_rect(sx_, 460, 56, 14) ? ( ad_[0] = ad_[0] == 2 ? 1 : 2; );
    in_rect(sx_, 478, 56, 44) ? ( ad_[0] = ad_[0] > 0 ? 0 : 1; );
    in_rect(sx_, 526, 56, 14) ? ( ad_[0] = ad_[0] == 3 ? 1 : 3; );
    ui += 1;
  );
  ui = 0; loop(4, in_rect(842 + ui*50, 577, 46, 24) ? (size_ = ui); ui += 1;);
  (drag > 0 && (mouse_cap & 4)) ? (
    drag == 1 ? set_sl(1 + sel, 0) : drag == 2 ? set_sl(17 + sel, 0) : drag == 3 ? set_sl(33 + sel, 0) :
    drag == 4 ? set_sl(49 + sel, 100) : drag == 5 ? (swing = 0) : drag == 6 ? (cvthr = -36) :
    drag == 8 ? ( P_NOTE[sel] = sel == 0 ? 36 : sel == 1 ? 38 : sel == 2 ? 45 : sel == 3 ? 47 : sel == 4 ? 50 : sel == 5 ? 39 : sel == 6 ? 56 : sel == 7 ? 37 : sel == 8 ? 51 : sel == 9 ? 49 : sel == 10 ? 42 : sel == 11 ? 46 : sel == 12 ? 70 : sel == 13 ? 35 : sel == 14 ? 40 : 44; ) : (master = 0);
    drag = 0;
  );
);
(mb1 && drag > 0) ? (
  fine = (mouse_cap & 8) ? 0.2 : 1;
  dy = (last_my - my)*fine;
  dy != 0 ? (
    drag == 1 ? set_sl(1 + sel, floor(min(max(slider(1 + sel) + dy*0.3, -60), 6)*10 + 0.5)/10) :
    drag == 2 ? set_sl(17 + sel, floor(min(max(slider(17 + sel) + dy, -100), 100) + 0.5)) :
    drag == 3 ? set_sl(33 + sel, floor(min(max(slider(33 + sel) + dy*0.1, -12), 12)*10 + 0.5)/10) :
    drag == 4 ? set_sl(49 + sel, floor(min(max(slider(49 + sel) + dy*0.5, 0), 100)*10 + 0.5)/10) :
    drag == 5 ? ( swing = floor(min(max(swing + dy, -100), 100) + 0.5); ) :
    drag == 6 ? ( cvthr = floor(min(max(cvthr + dy*0.25, -60), -6) + 0.5); ) :
    drag == 8 ? ( nacc_ += dy*0.15; abs(nacc_) >= 1 ? ( P_NOTE[sel] = min(max(P_NOTE[sel] + (nacc_ > 0 ? 1 : -1)*floor(abs(nacc_)), 1), 100); nacc_ = 0; ); ) :
                ( master = floor(min(max(master + dy*0.3, -60), 12)*10 + 0.5)/10; );
  );
);
!mb1 ? (drag = 0);
last_mb = mb1; last_mb2 = mb2;
last_my = (mouse_y - oy)/S;

// ---- Souris ----------------------------------------------------------------------------------
mb1 = mouse_cap & 1;
(mb1 && !last_mb) ? (
  drag = -1;
  ui = 0; loop(9, (in_circ(kxpos(ui), KNY, 36) || in_rect(kxpos(ui) - 42, KNY + 36, 84, 24)) ? ( drag = kd(ui); ); ui += 1;);
  edit_k >= 0 && drag != edit_k ? ( edit_k = -1; );
  (drag >= 0 && (mouse_cap & 4)) ? ( k_def(drag); drag = -1; );
  drag >= 0 ? (
    (time_precise() - lc_t < 0.35 && lc_k == drag) ? ( edit_k = drag; strcpy(#ed, ""); drag = -1; lc_k = -1; ) : ( lc_t = time_precise(); lc_k = drag; );
  );
  ui = 0; loop(5, in_rect(34 + ui*100, 88, 94, 28) ? ( set_sl(4, ui); ); ui += 1;);
  in_rect(34, 146, 64, 58) ? ( set_sl(10, 0); );
  ui = 1; loop(12, in_rect(104 + ((ui - 1) % 6)*70, ui <= 6 ? 146 : 176, 64, 28) ? ( set_sl(10, ui); ); ui += 1;);
  in_rect(842, 377, 46, 24) ? ( set_sl(12, 0); );
  in_rect(892, 377, 46, 24) ? ( set_sl(12, 1); );
  in_rect(942, 377, 46, 24) ? ( set_sl(12, 2); );
  in_rect(992, 377, 46, 24) ? ( set_sl(12, 3); );
);
(mb1 && drag >= 0) ? (
  fine = (mouse_cap & 8) ? 0.15 : 1;
  dy = (last_my - my)*fine;
  dy != 0 ? k_set(drag, k_frac(drag) + dy*0.006);
);
!mb1 ? ( drag = -1; );
// saisie clavier
edit_k >= 0 ? (
  while ((ch = gfx_getchar()) > 0) (
    (ch >= '0' && ch <= '9') || ch == '.' || ch == '-' ? ( strlen(#ed) < 8 ? ( sprintf(#ch1, "%c", ch); strcat(#ed, #ch1); ); ) :
    ch == 8 ? ( strlen(#ed) > 0 ? strcpy_substr(#ed, #ed, 0, strlen(#ed) - 1); ) :
    ch == 13 ? ( strlen(#ed) > 0 && match("%f", #ed, ed_v) ? k_type(edit_k, ed_v); edit_k = -1; ) :
    ch == 27 ? ( edit_k = -1; );
  );
);
last_mb = mb1;
last_my = (mouse_y - oy)/S;

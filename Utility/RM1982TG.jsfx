    drag == 3 ? ( scp_ = min(max(scp_ + dy*0.005, 0), 1); set_sl(3, floor(lval(scp_, 5, 500) + 0.5)); ) :
    drag == 4 ? ( scp_ = min(max(scp_ + dy*0.005, 0), 1); set_sl(4, floor(lval(scp_, 0.5, 10)*10 + 0.5)/10); ) :
    drag == 5 ? set_sl(5, floor(min(max(slider5 + dy*0.25, -24), 24)*10 + 0.5)/10) :

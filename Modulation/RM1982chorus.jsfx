desc:RM1982chorus - ReNo Mellow chorus
//@author ReNo Mellow
//@version 1.1
//@changelog Keyboard value entry: double-click a knob or its value, type, Enter (Esc = cancel)
//@about
//  # RM1982chorus
//  Classic multi-voice chorus: up to 4 modulated delay voices per side, mixed with the dry signal.
//  - RATE (or SYNC to the project tempo), DEPTH (modulation up to +/- 4 ms), DELAY (5 to 30 ms).
//  - VOICES 1 to 4 (each voice has its own LFO phase and a slightly longer delay).
//  - STEREO = spread between left and right LFOs, MIX = dry / wet.
//  - SYNC locks the LFO to the project tempo (8 bars to 1/32, follows the play position).
//  - Drag the knobs (Shift = fine), Ctrl-click or double-click = default, mouse wheel. Zero latency.
//  - Double-click the plug-in name to switch the colour (green / orange).

slider1:0.6<0.05,5,0.01>-Rate
slider2:40<0,100,0.01>-Depth
slider3:12<5,30,0.01>-Delay
slider4:1<0,3,1{1,2,3,4}>-Voices
slider5:70<0,100,0.01>-Stereo
slider6:50<0,100,0.01>-Mix
slider7:0<0,1,1{Off,On}>-Sync
slider8:5<0,8,1{8 BARS,4 BARS,2 BARS,1/1,1/2,1/4,1/8,1/16,1/32}>-Sync division
slider9:1<0,4,1{75%,100%,125%,150%,200%}>-Size
slider10:1<0,1,1{Orange,Green}>-Theme (double-click the plug-in name)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_noinit = 1;
pdc_delay = 0;
d_ph = 0;

// 4-point Hermite read, d samples behind write position wp
function rd_h(base, size, wp, d) local(r, i, f, i0, i1, i2, i3, xm1, x0, x1, x2, c1, c2, c3)
(
  r = wp - d;
  i = floor(r); f = r - i;
  i0 = i - 1; i1 = i; i2 = i + 1; i3 = i + 2;
  i0 < 0 ? i0 += size; i1 < 0 ? i1 += size; i2 < 0 ? i2 += size; i3 < 0 ? i3 += size;
  i0 >= size ? i0 -= size; i1 >= size ? i1 -= size; i2 >= size ? i2 -= size; i3 >= size ? i3 -= size;
  xm1 = base[i0]; x0 = base[i1]; x1 = base[i2]; x2 = base[i3];
  c1 = 0.5 * (x1 - xm1);
  c2 = xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2;
  c3 = 0.5 * (x2 - xm1) + 1.5 * (x0 - x1);
  ((c3 * f + c2) * f + c1) * f + x0;
);

d_size = 16384;
d_bl = 0; d_br = 16384;
memset(0, 0, 32768);
d_wp = 0;
d_dly = slider3;

@block
d_psm = 1 - exp(-1 / (0.03 * srate));
d_div = floor(slider8 + 0.5);
d_cb = 1;
d_div == 0 ? d_cb = 32;
d_div == 1 ? d_cb = 16;
d_div == 2 ? d_cb = 8;
d_div == 3 ? d_cb = 4;
d_div == 4 ? d_cb = 2;
d_div == 5 ? d_cb = 1;
d_div == 6 ? d_cb = 0.5;
d_div == 7 ? d_cb = 0.25;
d_div == 8 ? d_cb = 0.125;
slider7 >= 0.5 ? (
  d_inc = tempo / 60 / srate / d_cb;
  (play_state & 1) ? ( d_ph = beat_position / d_cb; d_ph -= floor(d_ph); );
) : (
  d_inc = slider1 / srate;
);

d_dep = slider2 * 0.01 * 4;
d_tdly = slider3;
d_nv = floor(slider4 + 0.5) + 1;
d_off = slider5 * 0.005;
d_mix = slider6 * 0.01;

@sample
d_ph += d_inc; d_ph >= 1 ? d_ph -= 1;
d_lfol = sin(2 * $pi * d_ph);
d_lfor = sin(2 * $pi * (d_ph + d_off));

d_dly += (d_tdly - d_dly) * d_psm;
d_bl[d_wp] = spl0;
d_br[d_wp] = spl1;
d_wl = 0; d_wr = 0;
d_v = 0;
loop(d_nv,
  d_pv = d_ph + d_v / d_nv;
  d_bd = d_dly * (1 + 0.17 * d_v);
  d_dsl = (d_bd + d_dep * sin(2 * $pi * d_pv)) * 0.001 * srate;
  d_dsr = (d_bd + d_dep * sin(2 * $pi * (d_pv + d_off))) * 0.001 * srate;
  d_wl += rd_h(d_bl, d_size, d_wp, min(d_size - 4, max(2, d_dsl)));
  d_wr += rd_h(d_br, d_size, d_wp, min(d_size - 4, max(2, d_dsr)));
  d_v += 1;
);
d_wl /= sqrt(d_nv); d_wr /= sqrt(d_nv);
d_wp += 1; d_wp >= d_size ? d_wp = 0;
spl0 = spl0 * (1 - d_mix) + d_wl * d_mix;
spl1 = spl1 * (1 - d_mix) + d_wr * d_mix;

@gfx 600 230
LW = 600;
LH = 230;
KY = 112; KR = 26;
NK = 6;

function PX(x) ( ox + x * sc; );
function PY(y) ( oy + y * sc; );
function col(r, g, b) ( gfx_set(r, g, b, 1); );
function acc() ( gfx_set(acR, acG, acB, 1); );
function acc_d() ( gfx_set(adR, adG, adB, 1); );
function rct(x, y, ww, hh) ( gfx_rect(PX(x), PY(y), ww * sc, hh * sc); );
function text_c(x, y, str) local(tw, th)
(
  gfx_measurestr(str, tw, th);
  gfx_x = PX(x) - tw / 2; gfx_y = PY(y) - th / 2;
  gfx_drawstr(str);
);
function text_l(x, y, str) local(tw, th)
(
  gfx_measurestr(str, tw, th);
  gfx_x = PX(x); gfx_y = PY(y) - th / 2;
  gfx_drawstr(str);
);
function text_r(x, y, str) local(tw, th)
(
  gfx_measurestr(str, tw, th);
  gfx_x = PX(x) - tw; gfx_y = PY(y) - th / 2;
  gfx_drawstr(str);
);
function in_rect(x, y, ww, hh) ( mx >= x && mx < x + ww && my >= y && my < y + hh; );

function k_x(i) ( 64 + (i - 1) * 80; );
function k_norm(i)
(
  i == 1 ? ( slider7 >= 0.5 ? slider8 / 8 : log(slider1 / 0.05) / log(5 / 0.05); ) :
  i == 2 ? (slider2 - (0)) / (100) :
  i == 3 ? (slider3 - (5)) / (25) :
  i == 4 ? slider4 / 3 :
  i == 5 ? (slider5 - (0)) / (100) :
  i == 6 ? (slider6 - (0)) / (100) :
  0;
);
function k_set(i, n)
(
  n = min(1, max(0, n));
  i == 1 ? (
    slider7 >= 0.5 ? ( slider8 = floor(n * 8 + 0.5); sliderchange(slider8); ) :
    ( slider1 = floor(0.05 * exp(log(5 / 0.05) * n) * 1000 + 0.5) / 1000; sliderchange(slider1); );
  );
  i == 2 ? ( slider2 = floor((0 + n * 100) * 100 + 0.5) / 100; sliderchange(slider2); );
  i == 3 ? ( slider3 = floor((5 + n * 25) * 100 + 0.5) / 100; sliderchange(slider3); );
  i == 4 ? ( slider4 = floor(n * 3 + 0.5); sliderchange(slider4); );
  i == 5 ? ( slider5 = floor((0 + n * 100) * 100 + 0.5) / 100; sliderchange(slider5); );
  i == 6 ? ( slider6 = floor((0 + n * 100) * 100 + 0.5) / 100; sliderchange(slider6); );
);
function k_default(i)
(
  i == 1 ? ( slider7 >= 0.5 ? ( slider8 = 5; sliderchange(slider8); ) : ( slider1 = 0.6; sliderchange(slider1); ); );
  i == 2 ? ( slider2 = 40; sliderchange(slider2); );
  i == 3 ? ( slider3 = 12; sliderchange(slider3); );
  i == 4 ? ( slider4 = 1; sliderchange(slider4); );
  i == 5 ? ( slider5 = 70; sliderchange(slider5); );
  i == 6 ? ( slider6 = 50; sliderchange(slider6); );
);
function k_lab(i)
(
  i == 1 ? strcpy(#kl, "RATE");
  i == 2 ? strcpy(#kl, "DEPTH");
  i == 3 ? strcpy(#kl, "DELAY");
  i == 4 ? strcpy(#kl, "VOICES");
  i == 5 ? strcpy(#kl, "STEREO");
  i == 6 ? strcpy(#kl, "MIX");
);
function k_str(i) local(v)
(
  strcpy(#va, "");
  i == 1 && slider7 >= 0.5 ? (
    floor(slider8 + 0.5) == 0 ? strcpy(#va, "8 BARS");
    floor(slider8 + 0.5) == 1 ? strcpy(#va, "4 BARS");
    floor(slider8 + 0.5) == 2 ? strcpy(#va, "2 BARS");
    floor(slider8 + 0.5) == 3 ? strcpy(#va, "1/1");
    floor(slider8 + 0.5) == 4 ? strcpy(#va, "1/2");
    floor(slider8 + 0.5) == 5 ? strcpy(#va, "1/4");
    floor(slider8 + 0.5) == 6 ? strcpy(#va, "1/8");
    floor(slider8 + 0.5) == 7 ? strcpy(#va, "1/16");
    floor(slider8 + 0.5) == 8 ? strcpy(#va, "1/32");
  );
  i == 1 && slider7 < 0.5 ? (
    v = slider1;
    v < 1 ? ( sprintf(#va, "%.2f Hz", v); ) : ( sprintf(#va, "%.1f Hz", v); );
  );
  i == 2 ? ( v = slider2;
    sprintf(#va, "%d %%", floor(v + 0.5));
  );
  i == 3 ? ( v = slider3;
    v < 10 ? ( sprintf(#va, "%.2f ms", v); ) : ( sprintf(#va, "%.1f ms", v); );
  );
  i == 4 ? ( v = floor(slider4 + 0.5);
    v == 0 ? strcpy(#va, "1");
    v == 1 ? strcpy(#va, "2");
    v == 2 ? strcpy(#va, "3");
    v == 3 ? strcpy(#va, "4");
  );
  i == 5 ? ( v = slider5;
    sprintf(#va, "%d %%", floor(v + 0.5));
  );
  i == 6 ? ( v = slider6;
    sprintf(#va, "%d %%", floor(v + 0.5));
  );
);

function theme_set()
(
  slider10 >= 0.5 ? (
    acR = 0.424; acG = 0.851; acB = 0.780;
    adR = 0.03;  adG = 0.10;  adB = 0.09;
  ) : (
    acR = 1.00; acG = 0.58; acB = 0.12;
    adR = 0.10; adG = 0.06; adB = 0.02;
  );
);

function draw_knob(i) local(x, n, a1, z, qx, qy)
(
  x = k_x(i); n = min(1, max(0, k_norm(i)));
  a1 = -2.36 + 4.72 * n;
  qx = PX(x); qy = PY(KY);
  col(0.22, 0.23, 0.25);
  z = 0;
  loop(ceil(4 * sc), gfx_arc(qx, qy, KR * sc - z * 0.9, -2.36, 2.36, 1); z += 1;);
  acc();
  n > 0.001 ? (
    z = 0;
    loop(ceil(4 * sc), gfx_arc(qx, qy, KR * sc - z * 0.9, -2.36, a1, 1); z += 1;);
  );
  col(0.16, 0.165, 0.18);
  gfx_circle(qx, qy, (KR - 7) * sc, 1, 1);
  col(0.26, 0.27, 0.29);
  gfx_circle(qx, qy, (KR - 7) * sc, 0, 1);
  col(0.92, 0.92, 0.92);
  gfx_line(qx + sin(a1) * (KR - 17) * sc, qy - cos(a1) * (KR - 17) * sc,
           qx + sin(a1) * (KR - 8) * sc,  qy - cos(a1) * (KR - 8) * sc, 1);
  gfx_setfont(1);
  i == 1 && slider7 >= 0.5 ? acc() : col(0.62, 0.63, 0.66);
  k_lab(i);
  text_c(x, KY - KR - 14, #kl);
  gfx_setfont(6);
  col(0.85, 0.85, 0.86);
  k_str(i);
  text_c(x, KY + KR + 15, #va);
);

// ---------- frame setup ----------
theme_set();
sz = floor(slider9 + 0.5);
sc = sz >= 4 ? 2 : 0.75 + 0.25 * sz;
sc != last_sc ? (
  gfx_setfont(1, "Arial", 12 * sc, 'b');
  gfx_setfont(2, "Arial", 24 * sc, 'b');
  gfx_setfont(4, "Arial", 11 * sc);
  gfx_setfont(6, "Arial", 12 * sc);
  last_sc = sc;
);
ox = max(0, floor((gfx_w - LW * sc) / 2));
oy = max(0, floor((gfx_h - LH * sc) / 2));
mx = (mouse_x - ox) / sc;
my = (mouse_y - oy) / sc;

// ---------- background ----------
col(0.07, 0.07, 0.075);
gfx_rect(0, 0, gfx_w, gfx_h);
col(0.115, 0.12, 0.13);
rct(6, 6, LW - 12, 184);
col(0.105, 0.11, 0.12);
gi = 10;
while (gi < 190) ( rct(6, gi, LW - 12, 1); gi += 4; );
col(0.20, 0.205, 0.22);
gfx_circle(PX(16), PY(16), 3.5 * sc, 1, 1);
gfx_circle(PX(LW - 16), PY(16), 3.5 * sc, 1, 1);
gfx_circle(PX(16), PY(180), 3.5 * sc, 1, 1);
gfx_circle(PX(LW - 16), PY(180), 3.5 * sc, 1, 1);

// title
gfx_setfont(2);
acc();
text_l(30, 32, "RM1982chorus");
gfx_measurestr("RM1982chorus", t_w, t_h);
th_x0 = 30; th_x1 = 30 + t_w / sc;
gfx_setfont(4);
col(0.55, 0.56, 0.58);
text_l(th_x1 + 14, 34, "C H O R U S");
text_r(LW - 30, 34, "ReNo Mellow");
acc();
rct(30, 48, LW - 60, 1);

gi = 1;
loop(NK, draw_knob(gi); gi += 1;);

// LFO light + SYNC button
gfx_setfont(4);
col(0.62, 0.63, 0.66);
text_c(524 + 32, 74, "LFO");
col(0.16, 0.165, 0.18);
gfx_circle(PX(524 + 32), PY(90), 6 * sc, 1, 1);
gfx_set(acR, acG, acB, 0.15 + 0.85 * (0.5 + 0.5 * d_lfol));
gfx_circle(PX(524 + 32), PY(90), 5 * sc, 1, 1);
slider7 >= 0.5 ? ( acc(); rct(524, 108, 64, 26); acc_d(); ) : ( col(0.16, 0.165, 0.18); rct(524, 108, 64, 26); col(0.80, 0.81, 0.83); );
gfx_setfont(1);
text_c(524 + 32, 121, "SYNC");

// ---------- bottom bar : help + SIZE ----------
col(0.045, 0.045, 0.05);
rct(6, 196, LW - 12, 28);
gfx_setfont(4);
col(0.45, 0.46, 0.48);
text_l(16, 210, "Drag   Shift: fine   Ctrl-click: default");
col(0.55, 0.56, 0.58);
text_r(LW - 202, 210, "SIZE");
gi = 0;
loop(5,
  gx = LW - 194 + gi * 38;
  gi == sz ? ( acc(); rct(gx, 199, 34, 22); acc_d(); ) : ( col(0.16, 0.165, 0.18); rct(gx, 199, 34, 22); col(0.70, 0.71, 0.73); );
  gi == 0 ? strcpy(#lb, "75");
  gi == 1 ? strcpy(#lb, "100");
  gi == 2 ? strcpy(#lb, "125");
  gi == 3 ? strcpy(#lb, "150");
  gi == 4 ? strcpy(#lb, "200");
  text_c(gx + 17, 210, #lb);
  gi += 1;
);

// ---------- mouse ----------

// ---------- keyboard value entry (ReNo Mellow standard) : double-click a knob or its value, type, Enter ----------
function kbx_pnum() local(i, n, c, v, frac, dv)
(
  n = strlen(#kbx_ed); i = 0; v = 0; frac = 0; dv = 1;
  kbx_ok = 0; kbx_neg = 0; kbx_kil = 0; kbx_off = 0; kbx_inf = 0; kbx_sec = 0; kbx_pc = 0; kbx_pl = 0; kbx_pr = 0; kbx_pc0 = 0; kbx_sl2 = 0;
  loop(n,
    c = str_getchar(#kbx_ed, i);
    (c >= 'A' && c <= 'Z') ? c += 32;
    c == 'i' ? kbx_inf = 1;
    c == 'l' ? kbx_pl = 1;
    c == 'r' ? kbx_pr = 1;
    c == 'c' ? kbx_pc0 = 1;
    c == '/' ? kbx_sl2 = 1;
    (c == 's' && kbx_pc != 'm') ? kbx_sec = 1;
    kbx_pc = c;
    c == '-' ? kbx_neg = 1;
    c == 'k' ? kbx_kil = 1;
    c == 'o' ? kbx_off = 1;
    (c == '.' || c == ',') ? frac = 1;
    (c >= '0' && c <= '9') ? (
      kbx_ok = 1;
      frac ? ( dv *= 10; v += (c - '0') / dv; ) : ( v = v * 10 + (c - '0'); );
    );
    i += 1;
  );
  kbx_neg ? -v : v;
);
function kbx_setsl(idx, v) ( slider(idx) = v; slider_automate(2 ^ (idx - 1)); );
function kbx_ic(cx, cy, r) ( sqr(mx - cx) + sqr(my - cy) <= r * r; );
function kbx_ir(x, y, w, h) ( mx >= x && mx < x + w && my >= y && my < y + h; );
function kbx_put(idx, v, lo, hi, st)
(
  v = min(hi, max(lo, v));
  st > 0 ? v = lo + floor((v - lo) / st + 0.5) * st;
  kbx_setsl(idx, min(hi, max(lo, v)));
);
function kbx_norm() local(i, n, c)
(
  strcpy(#kbx_n, "");
  n = strlen(#kbx_ed); i = 0;
  loop(n,
    c = str_getchar(#kbx_ed, i);
    (c >= 'A' && c <= 'Z') ? c += 32;
    c != ' ' ? ( sprintf(#kbx_c1, "%c", c); strcat(#kbx_n, #kbx_c1); );
    i += 1;
  );
);
function kbx_hit()
(
  kbx_ic(64, 112, 26) ? 1 :
  kbx_ir(18, 142, 92, 22) ? 1 :
  kbx_ic(144, 112, 26) ? 2 :
  kbx_ir(98, 142, 92, 22) ? 2 :
  kbx_ic(224, 112, 26) ? 3 :
  kbx_ir(178, 142, 92, 22) ? 3 :
  kbx_ic(304, 112, 26) ? 4 :
  kbx_ir(258, 142, 92, 22) ? 4 :
  kbx_ic(384, 112, 26) ? 5 :
  kbx_ir(338, 142, 92, 22) ? 5 :
  kbx_ic(464, 112, 26) ? 6 :
  kbx_ir(418, 142, 92, 22) ? 6 :
  0;
);
function kbx_x(i)
(
  i == 1 ? 64 :
  i == 2 ? 144 :
  i == 3 ? 224 :
  i == 4 ? 304 :
  i == 5 ? 384 :
  i == 6 ? 464 :
  0;
);
function kbx_y(i)
(
  i == 1 ? 153 :
  i == 2 ? 153 :
  i == 3 ? 153 :
  i == 4 ? 153 :
  i == 5 ? 153 :
  i == 6 ? 153 :
  0;
);
function kbx_apply(i) local(v)
(
  v = kbx_pnum();
  i == 1 ? (
    slider7 >= 0.5 ? ( kbx_norm(); kbx_b = -1; kbx_bd = 1000000000;
    stricmp(#kbx_n, "8bars") == 0 ? kbx_b = 0;
    stricmp(#kbx_n, "4bars") == 0 ? kbx_b = 1;
    stricmp(#kbx_n, "2bars") == 0 ? kbx_b = 2;
    stricmp(#kbx_n, "1/1") == 0 ? kbx_b = 3;
    stricmp(#kbx_n, "1/2") == 0 ? kbx_b = 4;
    stricmp(#kbx_n, "1/4") == 0 ? kbx_b = 5;
    stricmp(#kbx_n, "1/8") == 0 ? kbx_b = 6;
    stricmp(#kbx_n, "1/16") == 0 ? kbx_b = 7;
    stricmp(#kbx_n, "1/32") == 0 ? kbx_b = 8;
    kbx_b < 0 && kbx_ok && !kbx_sl2 ? (
      min(abs(v - (8)), abs(v * 1000 - (8))) < kbx_bd ? ( kbx_bd = min(abs(v - (8)), abs(v * 1000 - (8))); kbx_b = 0; );
      min(abs(v - (4)), abs(v * 1000 - (4))) < kbx_bd ? ( kbx_bd = min(abs(v - (4)), abs(v * 1000 - (4))); kbx_b = 1; );
      min(abs(v - (2)), abs(v * 1000 - (2))) < kbx_bd ? ( kbx_bd = min(abs(v - (2)), abs(v * 1000 - (2))); kbx_b = 2; );
      min(abs(v - (1)), abs(v * 1000 - (1))) < kbx_bd ? ( kbx_bd = min(abs(v - (1)), abs(v * 1000 - (1))); kbx_b = 3; );
      min(abs(v - (1)), abs(v * 1000 - (1))) < kbx_bd ? ( kbx_bd = min(abs(v - (1)), abs(v * 1000 - (1))); kbx_b = 4; );
      min(abs(v - (1)), abs(v * 1000 - (1))) < kbx_bd ? ( kbx_bd = min(abs(v - (1)), abs(v * 1000 - (1))); kbx_b = 5; );
      min(abs(v - (1)), abs(v * 1000 - (1))) < kbx_bd ? ( kbx_bd = min(abs(v - (1)), abs(v * 1000 - (1))); kbx_b = 6; );
      min(abs(v - (1)), abs(v * 1000 - (1))) < kbx_bd ? ( kbx_bd = min(abs(v - (1)), abs(v * 1000 - (1))); kbx_b = 7; );
      min(abs(v - (1)), abs(v * 1000 - (1))) < kbx_bd ? ( kbx_bd = min(abs(v - (1)), abs(v * 1000 - (1))); kbx_b = 8; );
    );
    kbx_b >= 0 ? kbx_setsl(8, kbx_b); ) : ( kbx_ok ? kbx_put(1, v * 1, 0.05, 5, 0.01); );
  );
  i == 2 ? (
    kbx_ok ? kbx_put(2, v * 1, 0, 100, 0.01);
  );
  i == 3 ? (
    kbx_ok ? kbx_put(3, v * 1, 5, 30, 0.01);
  );
  i == 4 ? (
    kbx_norm(); kbx_b = -1; kbx_bd = 1000000000;
    stricmp(#kbx_n, "1") == 0 ? kbx_b = 0;
    stricmp(#kbx_n, "2") == 0 ? kbx_b = 1;
    stricmp(#kbx_n, "3") == 0 ? kbx_b = 2;
    stricmp(#kbx_n, "4") == 0 ? kbx_b = 3;
    kbx_b < 0 && kbx_ok && !kbx_sl2 ? (
      min(abs(v - (1)), abs(v * 1000 - (1))) < kbx_bd ? ( kbx_bd = min(abs(v - (1)), abs(v * 1000 - (1))); kbx_b = 0; );
      min(abs(v - (2)), abs(v * 1000 - (2))) < kbx_bd ? ( kbx_bd = min(abs(v - (2)), abs(v * 1000 - (2))); kbx_b = 1; );
      min(abs(v - (3)), abs(v * 1000 - (3))) < kbx_bd ? ( kbx_bd = min(abs(v - (3)), abs(v * 1000 - (3))); kbx_b = 2; );
      min(abs(v - (4)), abs(v * 1000 - (4))) < kbx_bd ? ( kbx_bd = min(abs(v - (4)), abs(v * 1000 - (4))); kbx_b = 3; );
    );
    kbx_b >= 0 ? kbx_setsl(4, kbx_b);
  );
  i == 5 ? (
    kbx_ok ? kbx_put(5, v * 1, 0, 100, 0.01);
  );
  i == 6 ? (
    kbx_ok ? kbx_put(6, v * 1, 0, 100, 0.01);
  );
);

kbx_mb = mouse_cap & 1;
kbx_sc = PX(1) - PX(0);
kbx_ed > 0 ? (
  kbx_c = gfx_getchar();
  while (kbx_c > 0) (
    kbx_c == 13 ? ( kbx_apply(kbx_ed); kbx_ed = 0; ) :
    kbx_c == 27 ? ( kbx_ed = 0; ) :
    kbx_c == 8 ? ( strlen(#kbx_ed) > 0 ? str_delsub(#kbx_ed, strlen(#kbx_ed) - 1, 1); ) :
    (kbx_c >= 32 && kbx_c < 127) ? (
      strlen(#kbx_ed) < 12 ? ( sprintf(#kbx_ch, "%c", kbx_c); strcat(#kbx_ed, #kbx_ch); );
    );
    kbx_c = kbx_ed > 0 ? gfx_getchar() : 0;
  );
);
(kbx_mb && !kbx_lmb) ? (
  kbx_h = kbx_hit();
  kbx_ed > 0 ? ( kbx_apply(kbx_ed); kbx_ed = 0; );
  (kbx_h > 0 && kbx_h == kbx_lh && time_precise() - kbx_t < 0.3) ? (
    kbx_ed = kbx_h; strcpy(#kbx_ed, ""); kbx_t = 0;
    mouse_cap = 0;
  ) : (
    kbx_t = time_precise(); kbx_lh = kbx_h;
  );
);
kbx_lmb = kbx_mb;
kbx_ed > 0 ? ( mouse_wheel = 0; );
m_l = mouse_cap & 1;
m_pl = g_lcap & 1;

m_l && !m_pl ? (
  g_tg = 0;
  my >= 199 && my < 221 ? (
    gi = 0;
    loop(5,
      in_rect(LW - 194 + gi * 38, 199, 34, 22) ? ( slider9 = gi; sliderchange(slider9); );
      gi += 1;
    );
  );
  in_rect(th_x0, 18, th_x1 - th_x0, 28) ? (
    time_precise() - th_t < 0.35 ? (
      slider10 = slider10 >= 0.5 ? 0 : 1; sliderchange(slider10); th_t = 0;
    ) : th_t = time_precise();
  );
  in_rect(524, 108, 64, 26) ? ( slider7 = slider7 >= 0.5 ? 0 : 1; sliderchange(slider7); );
  gi = 1;
  loop(NK,
    sqr(mx - k_x(gi)) + sqr(my - KY) <= sqr(KR + 8) ? (
      (mouse_cap & 4) || (time_precise() - g_kt < 0.3 && g_kl == gi) ? (
        k_default(gi); g_kt = 0;
      ) : (
        g_tg = gi; g_kn = k_norm(gi); g_ly = mouse_y; g_kt = time_precise(); g_kl = gi;
      );
    );
    gi += 1;
  );
);

m_l && m_pl && g_tg > 0 ? (
  mouse_y != g_ly ? (
    g_kn -= (mouse_y - g_ly) / (200 * sc) * ((mouse_cap & 8) ? 0.1 : 1);
    g_kn = min(1, max(0, g_kn));
    k_set(g_tg, g_kn);
    g_ly = mouse_y;
  );
);
!m_l ? g_tg = 0;

mouse_wheel != 0 ? (
  g_w = mouse_wheel / 120;
  gi = 1;
  loop(NK,
    sqr(mx - k_x(gi)) + sqr(my - KY) <= sqr(KR + 8) ? (
      (gi == 1 && slider7 >= 0.5) ? (
        k_set(gi, k_norm(gi) + (g_w > 0 ? 0.125 : -0.125));
      ) : (
        k_set(gi, k_norm(gi) + g_w * ((mouse_cap & 8) ? 0.002 : 0.02));
      );
    );
    gi += 1;
  );
  mouse_wheel = 0;
);

g_lcap = mouse_cap;

// ---------- keyboard value entry : edit box ----------
kbx_ed > 0 ? (
  kbx_cx = kbx_x(kbx_ed); kbx_cy = kbx_y(kbx_ed);
  gfx_setfont(15, "Arial", 15 * kbx_sc, 'b');
  gfx_set(0.06, 0.065, 0.07, 0.96);
  gfx_rect(PX(kbx_cx - 42), PY(kbx_cy - 13), 84 * kbx_sc, 26 * kbx_sc);
  gfx_set(0.92, 0.92, 0.92, 1);
  gfx_rect(PX(kbx_cx - 42), PY(kbx_cy - 13), 84 * kbx_sc, 26 * kbx_sc, 0);
  strcpy(#kbx_sh, #kbx_ed);
  (time_precise() * 2) % 2 < 1 ? strcat(#kbx_sh, "_");
  gfx_measurestr(#kbx_sh, kbx_tw, kbx_th);
  gfx_x = PX(kbx_cx) - kbx_tw / 2; gfx_y = PY(kbx_cy) - kbx_th / 2;
  gfx_drawstr(#kbx_sh);
);

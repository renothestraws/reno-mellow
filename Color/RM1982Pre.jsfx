md_g = floor(slider6 + 0.5);
md_g == 0 ? strcpy(#s, "class A + transformers : H2 then H3, thick low-mids, silky top") :
md_g == 1 ? strcpy(#s, "discrete op-amp : H3 / H5, harder clip, 2-5 kHz presence, fast") :
md_g == 2 ? strcpy(#s, "tubes : pure H2, grid compression, warm mids, soft extremes") :
md_g == 3 ? strcpy(#s, "transformerless IC : clean until +17 VU, then crisp clip") :
            strcpy(#s, "digital console : 100 % transparent gain");
text_c(202, 342, #s);

// ---- VU-mètres ---------------------------------------------------------------------------
aes = slider5 >= 0.5 ? 3.0103 : 0;

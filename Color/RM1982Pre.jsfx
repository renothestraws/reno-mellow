ui = 0;
loop(5,
  ui == 0 ? strcpy(#s, "1073") : ui == 1 ? strcpy(#s, "512") : ui == 2 ? strcpy(#s, "610") : ui == 3 ? strcpy(#s, "4000") : strcpy(#s, "32");
  draw_btn(34 + ui*68, 300, 63, 26, floor(slider6 + 0.5) == ui, #s);
  ui += 1;
);

// ---- Souris ----------------------------------------------------------------------------------
mb1 = mouse_cap & 1;
(mb1 && !last_mb) ? (
  drag = 0;
  in_circ(96, 170, 52) ? drag = 3;
  in_circ(226, 170, 46) ? drag = 1;
  in_circ(334, 170, 38) ? drag = 2;
  in_rect(458, 377, 44, 24) ? set_sl(3, 0);
  in_rect(506, 377, 50, 24) ? set_sl(3, 1);
  in_rect(592, 377, 60, 24) ? set_sl(7, slider7 >= 0.5 ? 0 : 1);
  ui = 0; loop(5, in_rect(34 + ui*68, 300, 63, 26) ? set_sl(6, ui); ui += 1;);
  (in_rect(934, 322, 64, 32) || in_rect(400, 74, 516, 230)) ? ( pm0 = 0; pm1 = 0; );
  in_rect(722, 377, 80, 24) ? set_sl(5, slider5 >= 0.5 ? 0 : 1);
  in_rect(842, 377, 46, 24) ? (slider4 = 0; sliderchange(slider4););
  in_rect(892, 377, 46, 24) ? (slider4 = 1; sliderchange(slider4););
  in_rect(942, 377, 46, 24) ? (slider4 = 2; sliderchange(slider4););
  in_rect(992, 377, 46, 24) ? (slider4 = 3; sliderchange(slider4););
  (drag > 0 && (mouse_cap & 4)) ? (
    drag == 1 ? set_sl(1, 0) : drag == 3 ? set_sl(8, 0) : set_sl(2, -18);
    drag = 0;
  );
);
(mb1 && drag > 0) ? (
  fine = (mouse_cap & 8) ? 0.2 : 1;
  dy = (last_my - my)*fine;
  dy != 0 ? (
    drag == 1 ? set_sl(1, floor(min(max(slider1 + dy*0.2, -24), 24)*10 + 0.5)/10) :
    drag == 3 ? set_sl(8, floor(min(max(slider8 + dy*0.15, -12), 24)*10 + 0.5)/10) :
                set_sl(2, floor(min(max(slider2 + dy*0.1, -28), -6)*10 + 0.5)/10);
  );
);
!mb1 ? (drag = 0);
last_mb = mb1;
last_my = (mouse_y - oy)/S;

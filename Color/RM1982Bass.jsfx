desc:RM1982Bass - ReNo Mellow 1982Bass (parallel harmonic bass enhancer)
//tags: bass enhancer psychoacoustic harmonics sub parallel saturation filter
//@author ReNo Mellow
//@version 2.0
//@changelog New engine built like a parallel harmonic chain: resonant SUB low-pass, DRIVE (tube / hard character), resonant high-pass at FREQ to keep only the harmonics, INTENSITY blend and POLARITY. Intensity OFF = untouched signal. New factory presets.
//@about
//  # RM1982Bass
//  Parallel harmonic bass enhancer: makes the low end heard on small speakers by adding harmonics of the sub.
//  - SUB (20..150 Hz) isolates the sub-bass with a resonant low-pass filter.
//  - DRIVE pushes it into a saturation; CHARACTER goes from TUBE (warm, lots of 2nd harmonic) to HARD (hard clipping, odd harmonics).
//  - FREQ (32..256 Hz): resonant high-pass on the saturated signal, only the harmonics above FREQ are kept.
//  - RESONANCE: resonance of both filters (bump at SUB and at FREQ).
//  - INTENSITY blends the harmonics with the dry signal (-24 dB = OFF: signal untouched), POLARITY flips them.
//  - ORIGINAL BASS IN / OUT keeps or removes the original lows under FREQ.
//  - Zero latency. Hidden clipper at 0 dBFS.
//
// ---------------------------------------------------------------------------
// RM1982Bass 2.0 - chaîne parallèle (d'après l'analyse du R Bass par Dan Worrall) :
//   grave mono -> passe-bas résonant 24 dB/oct à SUB -> DRIVE -> saturation
//   (TUBE : asymétrique, H2 ; HARD : écrêtage dur) -> passe-haut résonant
//   24 dB/oct à FREQ + passe-bas doux à 6 x FREQ -> INTENSITY, POLARITY
//   -> ajouté au signal sec (ORIGINAL BASS IN) ou au signal sans grave (OUT).
// INTENSITY au minimum = OFF : rien n'est ajouté (contrairement au R Bass).
// ---------------------------------------------------------------------------

slider1:100<32,256,0.1>-Freq (Hz)
slider2:-6<-24,24,0.1>-Intensity (dB)
slider3:1<0,1,1{Out,In}>-Original Bass
slider4:0<-24,12,0.1>-Output (dB)
slider5:1<0,4,1{75%,100%,125%,150%,200%}>-Size
slider6:1<0,1,1{Orange,Green}>-Theme (double-click the plug-in name)
slider7:45<20,150,0.1>-Sub (Hz)
slider8:18<0,36,0.1>-Drive (dB)
slider9:25<0,100,0.1>-Character (tube..hard)
slider10:30<0,100,0.1>-Resonance (%)
slider11:0<0,1,1{Normal,Inverted}>-Polarity

in_pin:Left In
in_pin:Right In
out_pin:Left Out
out_pin:Right Out

@init
EPS = 0.000000001;
CS1 = 100; CS2 = 110; CX1 = 120; CH1 = 130; CH2 = 140; CT1 = 150; CDC = 160;
W_NORM = 1.0;                                   // niveau des harmoniques à INTENSITY 0 dB
function db2lin(d) ( exp(d*0.11512925464970228); );
function lin2db(x) ( 8.685889638065035*log(max(x, EPS)); );
function tcoef(ms) ( 1 - exp(-1/(0.001*ms*srate)); );
function bq(x, c) instance(z1, z2) local(y)
(
  y  = c[0]*x + z1;
  z1 = c[1]*x - c[3]*y + z2;
  z2 = c[2]*x - c[4]*y;
  y;
);
function setc(c, b0, b1, b2, a0, a1, a2) ( c[0] = b0/a0; c[1] = b1/a0; c[2] = b2/a0; c[3] = a1/a0; c[4] = a2/a0; );
function c_lp(c, f, q) local(w, al)
(
  w = 2*$pi*min(f, 0.45*srate)/srate; al = sin(w)/(2*q);
  setc(c, (1 - cos(w))/2, 1 - cos(w), (1 - cos(w))/2, 1 + al, -2*cos(w), 1 - al);
);
function c_hp(c, f, q) local(w, al)
(
  w = 2*$pi*min(f, 0.45*srate)/srate; al = sin(w)/(2*q);
  setc(c, (1 + cos(w))/2, -(1 + cos(w)), (1 + cos(w))/2, 1 + al, -2*cos(w), 1 - al);
);
// saturation : TUBE (asymétrique, riche en H2) <-> HARD (écrêtage dur, impaires)
function tanh_(x) local(e) ( x = min(max(x, -20), 20); e = exp(2*x); (e - 1)/(e + 1); );
function tube(x) ( (tanh_(x + 0.45) - TB0)*1.15; );
function hard(x) ( min(max(x, -1), 1); );
TB0 = tanh_(0.45);

function update_params() local(f, fs, q)
(
  f  = min(max(slider1, 32), 256);
  fs = min(max(slider7, 20), 150);
  q  = 0.7071 + 2.3*min(max(slider10, 0), 100)/100;
  // SUB : passe-bas résonant + Butterworth (24 dB/oct), anti-DC 12 Hz
  c_lp(CS1, fs, q); c_lp(CS2, fs, 0.7071); c_hp(CDC, 12, 0.7071);
  // harmoniques : passe-haut résonant + Butterworth (24 dB/oct) à FREQ, passe-bas doux à 6 FREQ
  c_hp(CH1, f, q); c_hp(CH2, f, 0.7071); c_lp(CT1, min(f*6, 2000), 0.7071);
  // ORIGINAL BASS OUT : passe-haut Linkwitz-Riley 24 dB/oct à FREQ
  c_hp(CX1, f, 0.7071);
  drv = db2lin(min(max(slider8, 0), 36));
  chr = min(max(slider9, 0), 100)/100;
  h_g  = db2lin(min(max(slider2, -24), 24))*W_NORM*(slider11 >= 0.5 ? -1 : 1);
  h_on = slider2 > -23.95;
  orig = slider3 >= 0.5;
  out_g = db2lin(min(max(slider4, -24), 12));
  k_fd = tcoef(10);
  k_mt = exp(-1/(0.3*srate));
);

// ---- Outils graphiques (coordonnées logiques 840 x 412) ------------------------
function PX(x) ( ox + x*S; );
function PY(y) ( oy + y*S; );
function col(r,g,b) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = 1; );
function rct(x,y,w,h,f) ( gfx_rect(PX(x), PY(y), ceil(w*S), ceil(h*S), f); );
function ln(x1,y1,x2,y2) ( gfx_line(PX(x1), PY(y1), PX(x2), PY(y2), 1); );
function text_c(x,y,str) local(w,h) ( gfx_measurestr(str,w,h); gfx_x = PX(x) - w*0.5; gfx_y = PY(y) - h*0.5; gfx_drawstr(str); );
function text_l(x,y,str) local(w,h) ( gfx_measurestr(str,w,h); gfx_x = PX(x); gfx_y = PY(y) - h*0.5; gfx_drawstr(str); );
function text_r(x,y,str) local(w,h) ( gfx_measurestr(str,w,h); gfx_x = PX(x) - w; gfx_y = PY(y) - h*0.5; gfx_drawstr(str); );
function knob_pt(cx,cy,rad,frac) local(an)
(
  an = (225 - 270*frac)*$pi/180;
  kx = cx + rad*cos(an);
  ky = cy - rad*sin(an);
);
function arc(cx,cy,r,f1,f2,th) local(i, a1, a2)
(
  a1 = (-135 + 270*min(f1,f2))*$pi/180;
  a2 = (-135 + 270*max(f1,f2))*$pi/180;
  i = 0;
  loop(max(1, ceil(th*S)), gfx_arc(PX(cx), PY(cy), r*S + i, a1, a2, 1); i += 1;);
);
function draw_knob(cx,cy,r,frac,fz) local(i, x1, y1, t)
(
  col(0.07,0.07,0.08); arc(cx, cy, r + 9, 0, 1, 4);
  col(thc0r,thc0g,thc0b); arc(cx, cy, r + 9, fz, frac, 4);
  col(0.03,0.03,0.035); gfx_circle(PX(cx), PY(cy + 3), (r + 2)*S, 1, 1);
  i = 0;
  loop(10,
    t = 0.30 + 0.05*i;
    col(t, t, t + 0.01); gfx_circle(PX(cx), PY(cy), r*(1 - i*0.035)*S, 1, 1);
    i += 1;
  );
  col(0.72,0.73,0.75); gfx_circle(PX(cx), PY(cy), r*0.62*S, 1, 1);
  col(0.80,0.81,0.83); gfx_circle(PX(cx - r*0.1), PY(cy - r*0.12), r*0.45*S, 1, 1);
  col(0.66,0.67,0.69); gfx_circle(PX(cx), PY(cy), r*0.62*S, 0, 1);
  col(0.06,0.06,0.07);
  knob_pt(cx, cy, r*0.66, frac); x1 = kx; y1 = ky;
  knob_pt(cx, cy, r*0.95, frac);
  t = 0; loop(max(2, ceil(3*S)), gfx_line(PX(x1)+t-1, PY(y1), PX(kx)+t-1, PY(ky), 1); t += 1;);
);
function klab(cx,cy,r,frac,str) ( knob_pt(cx,cy,r,frac); text_c(kx,ky,str); );
function draw_btn(x,y,w,h,on,str)
(
  on ? col(thc0r,thc0g,thc0b) : col(0.16,0.165,0.18);
  rct(x,y,w,h,1);
  col(0.03,0.03,0.035); rct(x,y,w,h,0);
  on ? col(thc5r,thc5g,thc5b) : col(0.72,0.73,0.76);
  text_c(x + w*0.5, y + h*0.5, str);
);
function in_rect(x,y,w,h) ( mx >= x && mx < x+w && my >= y && my < y+h; );
function in_circ(cx,cy,r) ( sqr(mx - cx) + sqr(my - cy) <= r*r; );
function set_sl(idx, v) ( v != slider(idx) ? ( slider(idx) = v; slider_automate(2^(idx-1)); ); );
function lpos(v, a, b) ( log(v/a)/log(b/a); );
function lval(p, a, b) ( a*pow(b/a, p); );
// vumètre vertical -48..0 dB (segments)
function vbar(x, y, w, h, d, r, g, b) local(i, n, lit)
(
  col(0.03,0.03,0.035); rct(x - 2, y - 2, w + 4, h + 4, 1);
  n = 24; i = 0;
  loop(n,
    lit = d > -48 + 2*(i + 1) - 2;
    lit ? ( i >= 22 ? col(1.00,0.25,0.20) : i >= 18 ? col(thc2r,thc2g,thc2b) : col(r, g, b); )
        : col(0.10,0.11,0.12);
    rct(x, y + h - (i + 1)*h/n + 1, w, h/n - 2, 1);
    i += 1;
  );
);

// ---- Table des potards : 1 SUB, 2 DRIVE, 3 CHARACTER, 4 RESONANCE, 5 FREQ, 6 INTENSITY, 7 OUTPUT ----
function k_sl(i) ( i == 1 ? 7 : i == 2 ? 8 : i == 3 ? 9 : i == 4 ? 10 : i == 5 ? 1 : i == 6 ? 2 : 4; );
function k_lo(i) ( i == 1 ? 20 : i == 2 ? 0 : i == 3 ? 0 : i == 4 ? 0 : i == 5 ? 32 : -24; );
function k_hi(i) ( i == 1 ? 150 : i == 2 ? 36 : i == 3 ? 100 : i == 4 ? 100 : i == 5 ? 256 : i == 6 ? 24 : 12; );
function k_df(i) ( i == 1 ? 45 : i == 2 ? 18 : i == 3 ? 25 : i == 4 ? 30 : i == 5 ? 100 : i == 6 ? -6 : 0; );
function k_lg(i) ( i == 1 || i == 5; );
function k_cx(i) ( i == 1 || i == 5 ? 90 : i == 2 || i == 6 ? 210 : i == 3 || i == 7 ? 330 : 450; );
function k_cy(i) ( i <= 4 ? 148 : 296; );
function k_vy(i) ( k_cy(i) + 52; );
function k_frac(i) local(v, lo, hi)
(
  v = slider(k_sl(i)); lo = k_lo(i); hi = k_hi(i);
  min(max(k_lg(i) ? log(v/lo)/log(hi/lo) : (v - lo)/(hi - lo), 0), 1);
);
function k_put(i, v) local(lo, hi)
(
  lo = k_lo(i); hi = k_hi(i);
  v = floor(min(max(v, lo), hi)*10 + 0.5)/10;
  set_sl(k_sl(i), min(max(v, lo), hi));
);
function k_set_frac(i, f) local(lo, hi)
(
  f = min(max(f, 0), 1); lo = k_lo(i); hi = k_hi(i);
  k_put(i, k_lg(i) ? lo*pow(hi/lo, f) : lo + (hi - lo)*f);
);
function k_hit() local(i, r)
(
  r = 0; i = 1;
  loop(7, (r == 0 && in_circ(k_cx(i), k_cy(i), 36)) ? r = i; i += 1;);
  r;
);
function v_hit() local(i, r)
(
  r = 0; i = 1;
  loop(7, (r == 0 && in_rect(k_cx(i) - 46, k_vy(i) - 10, 92, 20)) ? r = i; i += 1;);
  r;
);
function k_str(i) local(v)
(
  v = slider(k_sl(i));
  i == 1 || i == 5 ? sprintf(#ks, "%.0f Hz", v) :
  i == 2 ? sprintf(#ks, "%+.1f dB", v) :
  i == 3 ? ( v < 0.5 ? strcpy(#ks, "TUBE") : v > 99.5 ? strcpy(#ks, "HARD") : sprintf(#ks, "%.0f %%", v); ) :
  i == 4 ? sprintf(#ks, "%.0f %%", v) :
  i == 6 ? ( v <= -23.95 ? strcpy(#ks, "OFF") : sprintf(#ks, "%+.1f dB", v); ) :
  sprintf(#ks, "%+.1f dB", v);
);
function kbx_pnum() local(i, n, c, v, frac, dv)
(
  n = strlen(#kbx_ed); i = 0; v = 0; frac = 0; dv = 1;
  kbx_ok = 0; kbx_neg = 0; kbx_kilo = 0; kbx_off = 0;
  loop(n,
    c = str_getchar(#kbx_ed, i);
    (c >= 'A' && c <= 'Z') ? c += 32;
    c == '-' ? kbx_neg = 1;
    c == 'k' ? kbx_kilo = 1;
    c == 'o' ? kbx_off = 1;
    (c == '.' || c == ',') ? frac = 1;
    (c >= '0' && c <= '9') ? (
      kbx_ok = 1;
      frac ? ( dv *= 10; v += (c - '0')/dv; ) : ( v = v*10 + (c - '0'); );
    );
    i += 1;
  );
  kbx_kilo ? v *= 1000;
  kbx_neg ? -v : v;
);
function kbx_apply(i) local(v)
(
  v = kbx_pnum();
  (kbx_off && !kbx_ok && i == 6) ? k_put(6, -24);
  kbx_ok ? k_put(i, v);
);

update_params();
om = orig;

@slider
update_params();

@block
update_params();

@sample
x0 = spl0; x1 = spl1;
// version sans grave (LR4) : toujours calculée -> bascule IN/OUT sans clic
hi0 = sh0b.bq(sh0a.bq(x0, CX1), CX1);
hi1 = sh1b.bq(sh1a.bq(x1, CX1), CX1);
// voie parallèle (mono) : SUB -> DRIVE -> saturation -> passe-haut à FREQ
lm = 0.5*(x0 + x1);
sb = ss2.bq(ss1.bq(sdc.bq(lm, CDC), CS1), CS2);
hh = 0;
h_on ? (
  u = sb*drv;
  w = tube(u)*(1 - chr) + hard(u)*chr;
  hh = gt.bq(gh2.bq(gh1.bq(w, CH1), CH2), CT1)*h_g;
);
om += k_fd*(orig - om);
y0 = om*x0 + (1 - om)*hi0 + hh;
y1 = om*x1 + (1 - om)*hi1 + hh;
y0 *= out_g; y1 *= out_g;
// mesures
mo_b = max(mo_b*k_mt, abs(sb));
mo_h = max(mo_h*k_mt, abs(hh));
mo_l = max(mo_l*k_mt, abs(y0));
mo_r = max(mo_r*k_mt, abs(y1));
(abs(y0) > 1 || abs(y1) > 1) ? clip_f = 1;
spl0 = min(max(y0, -1), 1);
spl1 = min(max(y1, -1), 1);

@gfx 840 412
// thème : orange ou vert (double-clic sur le nom du plug-in), mémorisé dans slider6
slider6 >= 0.5 ? (
  thc0r = 0.424; thc0g = 0.851; thc0b = 0.78;
  thc1r = 0.6; thc1g = 0.92; thc1b = 0.86;
  thc2r = 0.55; thc2g = 0.9; thc2b = 0.83;
  thc5r = 0.02; thc5g = 0.1; thc5b = 0.09;
) : (
  thc0r = 1.0; thc0g = 0.58; thc0b = 0.12;
  thc1r = 1.0; thc1g = 0.7; thc1b = 0.35;
  thc2r = 1.0; thc2g = 0.7; thc2b = 0.2;
  thc5r = 0.1; thc5g = 0.06; thc5b = 0.02;
);
S  = floor(slider5 + 0.5) >= 4 ? 2 : 0.75 + 0.25*floor(slider5 + 0.5);
ox = max(0, floor((gfx_w - 840*S)/2));
oy = max(0, floor((gfx_h - 412*S)/2));
mx = (mouse_x - ox)/S;
my = (mouse_y - oy)/S;
clip_f ? ( clip_hold = 40; clip_f = 0; ) : ( clip_hold = max(clip_hold - 1, 0); );

gfx_setfont(1, "Arial", max(6, floor(12*S)), 'b');
gfx_setfont(2, "Arial", max(10, floor(30*S)), 'b');
gfx_setfont(3, "Arial", max(5, floor(10*S)), 'b');
gfx_setfont(4, "Arial", max(6, floor(13*S)), 'b');
gfx_setfont(5, "Arial", max(6, floor(11*S)));
gfx_setfont(6, "Arial", max(5, floor(9*S)), 'b');

// ---- Façade -----------------------------------------------------------------------
col(0.07,0.07,0.075); gfx_rect(0,0,gfx_w,gfx_h);
col(0.115,0.12,0.13); rct(6,6,828,360,1);
ui = 0; loop(36, col(0.125,0.13,0.14); rct(6, 10 + ui*10, 828, 1, 1); ui += 1;);
col(0.20,0.21,0.23); rct(6,6,828,2,1);
col(0.04,0.04,0.045); rct(6,364,828,2,1);
col(0.06,0.06,0.065);
gfx_circle(PX(18), PY(20), 4*S, 1, 1);  gfx_circle(PX(18), PY(352), 4*S, 1, 1);
gfx_circle(PX(822), PY(20), 4*S, 1, 1); gfx_circle(PX(822), PY(352), 4*S, 1, 1);

gfx_setfont(2); col(thc0r,thc0g,thc0b); text_l(34, 34, "RM1982Bass"); th_x1 = gfx_x; th_y0 = gfx_y; gfx_measurestr("RM1982Bass", th_w, th_h); th_x0 = th_x1 - th_w;
t_x = 34 + th_w/S + 14;
gfx_setfont(3); col(0.62,0.63,0.66); text_l(t_x, 38, "PARALLEL  HARMONIC  BASS");
gfx_setfont(4); col(0.85,0.86,0.88); text_r(806, 34, "ReNo Mellow");
col(thc0r,thc0g,thc0b); rct(34, 56, 772, 2, 1);

// ---- Potards ---------------------------------------------------------------------------
gfx_setfont(4); col(0.92,0.93,0.95);
text_c(90, 84, "SUB"); text_c(210, 84, "DRIVE"); text_c(330, 84, "CHARACTER"); text_c(450, 84, "RESONANCE");
text_c(90, 232, "FREQ"); text_c(210, 232, "INTENSITY"); text_c(330, 232, "OUTPUT");
gfx_setfont(6); col(0.45,0.46,0.50);
text_c(270, 68, "SUB  >  DRIVE  >  HARMONICS");
col(0.25,0.26,0.29); rct(60, 73, 420, 1, 1);
ki = 1;
loop(7,
  fz = ki == 2 ? 0 : ki == 3 ? 0 : ki == 4 ? 0 : ki == 6 ? 0.5 : ki == 7 ? 24/36 : 0;
  draw_knob(k_cx(ki), k_cy(ki), 28, k_frac(ki), fz);
  gfx_setfont(1); col(thc1r,thc1g,thc1b);
  k_str(ki);
  kbx_ed != ki ? text_c(k_cx(ki), k_vy(ki), #ks);
  ki += 1;
);
gfx_setfont(3); col(0.62,0.63,0.66);
klab(90, 148, 48, 0, "20"); klab(90, 148, 48, lpos(50, 20, 150), "50"); klab(90, 148, 48, 1, "150");
klab(210, 148, 48, 0, "0"); klab(210, 148, 48, 0.5, "18"); klab(210, 148, 48, 1, "36");
klab(330, 148, 48, 0, "TUBE"); klab(330, 148, 48, 1, "HARD");
klab(450, 148, 48, 0, "0"); klab(450, 148, 48, 1, "100");
klab(90, 296, 48, 0, "32"); klab(90, 296, 48, lpos(90, 32, 256), "90"); klab(90, 296, 48, 1, "256");
klab(210, 296, 48, 0, "OFF"); klab(210, 296, 48, 0.5, "0"); klab(210, 296, 48, 1, "+24");
klab(330, 296, 48, 0, "-24"); klab(330, 296, 48, 24/36, "0"); klab(330, 296, 48, 1, "+12");

// ---- ORIGINAL BASS, POLARITY -----------------------------------------------------------
gfx_setfont(3); col(0.62,0.63,0.66); text_c(458, 258, "ORIGINAL BASS"); text_c(458, 318, "POLARITY");
gfx_setfont(1);
draw_btn(402, 270, 54, 24, slider3 >= 0.5, "IN");
draw_btn(460, 270, 54, 24, slider3 < 0.5, "OUT");
draw_btn(402, 330, 54, 24, slider11 < 0.5, "NORM");
draw_btn(460, 330, 54, 24, slider11 >= 0.5, "INV");
gfx_setfont(6); col(0.55,0.56,0.60);
sprintf(#s, "harmonics kept above %.0f Hz", slider1); text_c(458, 214, #s);

// ---- Vumètres ---------------------------------------------------------------------------
mb = lin2db(mo_b); mh = lin2db(mo_h); ml = lin2db(mo_l); mr = lin2db(mo_r);
vbar(624, 90, 22, 220, mb, 0.30, 0.65, 1.00);
vbar(674, 90, 22, 220, mh, 1.00, 0.58, 0.12);
vbar(728, 90, 18, 220, ml, 0.35, 0.90, 0.45);
vbar(752, 90, 18, 220, mr, 0.35, 0.90, 0.45);
gfx_setfont(3); col(0.62,0.63,0.66);
text_c(635, 76, "SUB"); text_c(685, 76, "HARM"); text_c(749, 76, "OUT");
ui = 0; loop(5, sprintf(#s, "%d", -ui*12); text_l(776, 90 + ui*220/4 - 1, #s); ui += 1;);
col(0.03,0.03,0.035); gfx_circle(PX(749), PY(336), 7*S, 1, 1);
clip_hold > 0 ? col(1.00,0.20,0.15) : col(0.20,0.05,0.04); gfx_circle(PX(749), PY(336), 5*S, 1, 1);
gfx_setfont(3); col(0.62,0.63,0.66); text_l(762, 336, "CLIP");

// ---- Bandeau -------------------------------------------------------------------------
gfx_setfont(3); col(0.62,0.63,0.66); text_c(598, 389, "SIZE");
gfx_setfont(1);
sz = floor(slider5 + 0.5);
draw_btn(622, 377, 36.0, 24, sz == 0, "75");
draw_btn(662, 377, 36.0, 24, sz == 1, "100");
draw_btn(702, 377, 36.0, 24, sz == 2, "125");
draw_btn(742, 377, 36.0, 24, sz == 3, "150");
draw_btn(782, 377, 36.0, 24, sz == 4, "200");
gfx_setfont(5); col(0.45,0.46,0.50); text_l(34, 389, "Ctrl-click: default  -  Shift: fine  -  Value: click = type");

// ---- Saisie clavier ----------------------------------------------------------------------------
kbx_mb = mouse_cap & 1;
kbx_sc = PX(1) - PX(0);
kbx_ed > 0 ? (
  kbx_c = gfx_getchar();
  while (kbx_c > 0) (
    kbx_c == 13 ? ( kbx_apply(kbx_ed); kbx_ed = 0; ) :
    kbx_c == 27 ? ( kbx_ed = 0; ) :
    kbx_c == 8 ? ( strlen(#kbx_ed) > 0 ? str_delsub(#kbx_ed, strlen(#kbx_ed) - 1, 1); ) :
    (kbx_c >= 32 && kbx_c < 127) ? (
      strlen(#kbx_ed) < 12 ? ( sprintf(#kbx_ch, "%c", kbx_c); strcat(#kbx_ed, #kbx_ch); );
    );
    kbx_c = kbx_ed > 0 ? gfx_getchar() : 0;
  );
);
(kbx_mb && !kbx_lmb) ? (
  kbx_h = k_hit(); kbx_v = v_hit();
  kbx_was = kbx_ed;
  kbx_ed > 0 ? ( kbx_apply(kbx_ed); kbx_ed = 0; );
  (kbx_v > 0 && kbx_v != kbx_was) ? (
    kbx_ed = kbx_v; strcpy(#kbx_ed, ""); kbx_t = 0; mouse_cap = 0;
  ) : (kbx_v > 0) ? (
    mouse_cap = 0;
  ) : (kbx_h > 0 && kbx_h == kbx_lh && time_precise() - kbx_t < 0.3) ? (
    kbx_ed = kbx_h; strcpy(#kbx_ed, ""); kbx_t = 0; mouse_cap = 0;
  ) : (
    kbx_t = time_precise(); kbx_lh = kbx_h;
  );
);
kbx_lmb = kbx_mb;
kbx_ed > 0 ? ( mouse_wheel = 0; );

// ---- Souris ----------------------------------------------------------------------------------
mb1 = mouse_cap & 1;
(mb1 && !last_mb) ? (
  drag = k_hit();
  drag > 0 ? ( (mouse_cap & 4) ? ( k_put(drag, k_df(drag)); drag = 0; ) : ( drag_f = k_frac(drag); ); );
  in_rect(402, 270, 54, 24) ? set_sl(3, 1);
  in_rect(460, 270, 54, 24) ? set_sl(3, 0);
  in_rect(402, 330, 54, 24) ? set_sl(11, 0);
  in_rect(460, 330, 54, 24) ? set_sl(11, 1);
  (in_rect(612, 80, 180, 240)) ? ( mo_b = 0; mo_h = 0; mo_l = 0; mo_r = 0; );
  ui = 0; loop(5, in_rect(622 + ui*40, 377, 36, 24) ? ( slider5 = ui; sliderchange(slider5); ); ui += 1;);
);
(mb1 && drag > 0) ? (
  fine = (mouse_cap & 8) ? 0.2 : 1;
  dy = (last_my - my)*fine;
  dy != 0 ? ( drag_f = min(max(drag_f + dy*0.005, 0), 1); k_set_frac(drag, drag_f); );
);
mouse_wheel != 0 ? (
  wv = mouse_wheel/120*((mouse_cap & 8) ? 0.2 : 1);
  kw = k_hit();
  kw > 0 ? k_set_frac(kw, k_frac(kw) + wv*0.02);
  mouse_wheel = 0;
);
!mb1 ? (drag = 0);
last_mb = mb1;
last_my = (mouse_y - oy)/S;

// ---- Thème : double-clic sur le nom du plug-in = orange / vert ----------------------------
th_mb = mouse_cap & 1;
(th_mb && !th_lmb) ? (
  (mouse_x >= th_x0 - 6 && mouse_x <= th_x1 + 6 && mouse_y >= th_y0 - 6 && mouse_y <= th_y0 + th_h + 6) ? (
    (time_precise() - th_t < 0.4) ? ( slider6 = slider6 >= 0.5 ? 0 : 1; sliderchange(slider6); th_t = 0; ) : ( th_t = time_precise(); );
  );
);
th_lmb = th_mb;

// ---- Saisie clavier : cadre d'édition ----------------------------------------------------
kbx_ed > 0 ? (
  kbx_cx = k_cx(kbx_ed); kbx_cy = k_vy(kbx_ed);
  gfx_setfont(15, "Arial", 14*kbx_sc, 'b');
  col(0.06,0.065,0.07); gfx_a = 0.96;
  gfx_rect(PX(kbx_cx - 46), PY(kbx_cy - 11), 92*kbx_sc, 22*kbx_sc);
  col(thc0r,thc0g,thc0b);
  gfx_rect(PX(kbx_cx - 46), PY(kbx_cy - 11), 92*kbx_sc, 22*kbx_sc, 0);
  strcpy(#kbx_sh, #kbx_ed);
  (time_precise()*2) % 2 < 1 ? strcat(#kbx_sh, "_");
  gfx_measurestr(#kbx_sh, kbx_tw, kbx_th);
  gfx_x = PX(kbx_cx) - kbx_tw/2; gfx_y = PY(kbx_cy) - kbx_th/2;
  col(0.95,0.95,0.95);
  gfx_drawstr(#kbx_sh);
);

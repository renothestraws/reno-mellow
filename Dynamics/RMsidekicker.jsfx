text_l(th_x1 + 14, 28, "S I D E C H A I N    S H A P E R");
text_r(LW - 34, 26, "ReNo Mellow");
// power switch
gfx_setfont(5);
g_byp ? ( col(0.16, 0.165, 0.18); rct(704, 15, 82, 22); col(0.95, 0.30, 0.25); text_c(745, 26, "BYPASS"); ) :
        ( acc(); rct(704, 15, 82, 22); acc_d(); text_c(745, 26, "ACTIVE"); );
acc();
rct(34, 42, LW - 68, 1);

// column separators
col(0.20, 0.205, 0.22);
rct(202, 56, 1, 370);
rct(697, 56, 1, 370);

// ---------- left column : clock / trigger / level ----------
head(26, 64, "CLOCK");
gfx_setfont(5);
btn(26, 74, 80, 24, g_sync, "SYNC");
btn(110, 74, 80, 24, !g_sync, "FREE");
col(0.085, 0.09, 0.095);
rct(26, 104, 164, 30);
in_rect(26, 104, 164, 30) ? acc() : col(0.22, 0.23, 0.25);
frm(26, 104, 164, 30);
gfx_setfont(3);
acc_l();
g_sync ? ( rate_name(floor(slider2 + 0.5)); ) : ( sprintf(#rn, "%.2f Hz", slider3); );
text_c(108, 119, #rn);

head(26, 150, "TRIGGER");
gfx_setfont(4);
btn(26, 160, 52, 24, g_trg == 0, "AUTO");
btn(82, 160, 52, 24, g_trg == 1, "MIDI");
btn(138, 160, 52, 24, g_trg == 2, "AUDIO");
col(0.14, 0.145, 0.155);
rct(26, 190, 164, 20);
strcpy(#lb, "SC :  INPUT 3/4");
slider16 >= 0.5 ? strcpy(#lb, "SC :  MAIN INPUT");
g_trg == 2 ? col(0.85, 0.85, 0.86) : col(0.42, 0.43, 0.45);
text_c(108, 200, #lb);

sprintf(#va, "%.1f dB", slider5);
draw_knob(k_x(6), k_y(6), k_r(6), k_norm(6), "THRESHOLD", #va);
sprintf(#va, "%.1f %%", slider6);
draw_knob(k_x(7), k_y(7), k_r(7), k_norm(7), "OFFSET", #va);
// sidechain activity led
g_lit = g_trg == 2 && d_lev >= pow(10, slider5 / 20);
g_lit ? acc_l() : col(0.22, 0.23, 0.25);
gfx_circle(PX(64), PY(k_y(6)), 4 * sc, 1, 1);

head(26, 316, "LEVEL");
gfx_setfont(4);
col(0.62, 0.63, 0.66);
text_l(26, 333, "IN");
text_l(26, 351, "OUT");
hmeter(56, 328, 134, mt_il, mt_ir);
hmeter(56, 346, 134, mt_ol, mt_or);
sprintf(#va, "%.1f dB", slider13);
draw_knob(k_x(4), k_y(4), k_r(4), k_norm(4), "IN TRIM", #va);
sprintf(#va, "%.1f dB", slider14);
draw_knob(k_x(5), k_y(5), k_r(5), k_norm(5), "OUT TRIM", #va);

// ---------- centre : curve ----------
col(0.085, 0.09, 0.095);
rct(CX0, CY0, CW, CH);
col(0.125, 0.13, 0.14);
gi = 1; loop(7, rct(CX0 + CW * gi / 8, CY0, 1, CH); gi += 1;);

g_idle = shape_val(1, g_shp, g_mph, g_inv);
g_nb = 64;
g_bw = CW / g_nb;
g_ph = min(1, max(0, d_disp));
g_cur = floor(g_ph * g_nb);
gi = 0;
loop(g_nb,
  g_t = (gi + 0.5) / g_nb;
  g_trg == 0 ? (
    g_tt = g_t - g_del; g_tt < 0 ? g_tt += 1;
    g_e = shape_val(g_tt, g_shp, g_mph, g_inv);
  ) : (
    g_tt = g_t - g_del;
    g_e = g_tt < 0 ? g_idle : shape_val(g_tt, g_shp, g_mph, g_inv);
  );
  g_h = (1 - g_e * g_dep) * (CH - 30);
  gi == g_cur ? acc_l() : gfx_set(acR, acG, acB, 0.35 + 0.5 * (1 - g_e * g_dep));
  rct(CX0 + gi * g_bw + 1, CY0 + CH - 7 - g_h, g_bw - 2, g_h);
  gi += 1;
);
in_rect(CX0, CY0, CW, CH) ? acc() : col(0.20, 0.205, 0.22);
frm(CX0, CY0, CW, CH);
gfx_setfont(4);
col(0.50, 0.51, 0.53);
text_l(CX0 + 8, CY0 + 10, "GAIN");
strcpy(#lb, "AFTER TRIGGER"); g_trg == 0 ? strcpy(#lb, "CYCLE");
text_r(CX0 + CW - 8, CY0 + 10, #lb);

// curve buttons
gfx_setfont(5);
btn(210, 244, 112, 26, g_shp == 0, "SOFT");
btn(326, 244, 112, 26, g_shp == 1, "HARD");
btn(442, 244, 112, 26, g_shp == 2, "WAVE");
btn(578, 244, 112, 26, g_inv, "FLIP");

strcpy(#lb, "VARIANT : WAVE");
g_shp == 0 ? strcpy(#lb, "VARIANT : RELEASE");
g_shp == 1 ? strcpy(#lb, "VARIANT : POINT");
sprintf(#va, "%.1f", slider9);
draw_knob(k_x(1), k_y(1), k_r(1), k_norm(1), #lb, #va);
sprintf(#va, "%.1f %%", slider10);
draw_knob(k_x(2), k_y(2), k_r(2), k_norm(2), "AMOUNT", #va);

// live readout
g_u = g_dep * min(1, max(0, d_es));
g_byp ? ( g_u = 0; );
col(0.085, 0.09, 0.095);
rct(386, 300, 128, 96);
col(0.20, 0.205, 0.22);
frm(386, 300, 128, 96);
gfx_setfont(4);
col(0.50, 0.51, 0.53);
text_c(450, 314, "MOTION");
gfx_setfont(6);
acc_l();
sprintf(#va, "%d", floor(g_u * 100 + 0.5));
text_c(450, 344, #va);
col(0.13, 0.135, 0.145);
rct(398, 372, 104, 8);
acc();
rct(398, 372, 104 * g_u, 8);

// ---------- right column : target ----------
head(710, 64, "TARGET");
gfx_setfont(4);
gi = 0;
loop(8,
  type_name(gi);
  lbtn(704, 74 + gi * 22, 176, 20, gi == g_typ, #tn);
  gi += 1;
);

col(0.085, 0.09, 0.095);
rct(EX, EY, EW, EH);
g_typ == 0 ? (
  g_gm = 1 - g_u * min(1, 2 * (1 - g_tw));
  g_gs = 1 - g_u * min(1, 2 * g_tw);
  gfx_setfont(4);
  col(0.62, 0.63, 0.66);
  text_l(EX + 8, EY + 18, "M");
  text_l(EX + 8, EY + 44, "S");
  col(0.13, 0.135, 0.145);
  rct(EX + 24, EY + 12, EW - 34, 12);
  rct(EX + 24, EY + 38, EW - 34, 12);
  acc();
  rct(EX + 24, EY + 12, (EW - 34) * g_gm, 12);
  acc_l();
  rct(EX + 24, EY + 38, (EW - 34) * g_gs, 12);
  strcpy(#va, "M ");
  g_gm < 0.0001 ? ( strcat(#va, "-inf"); ) : ( sprintf(#tn, "%.1f", 20 * log10(g_gm)); strcat(#va, #tn); );
  strcat(#va, "   S ");
  g_gs < 0.0001 ? ( strcat(#va, "-inf"); ) : ( sprintf(#tn, "%.1f", 20 * log10(g_gs)); strcat(#va, #tn); );
  strcat(#va, " dB");
) : g_typ == 3 ? (
  g_fr = sr_freq(g_u);
  g_stp = max(1, floor((1 - g_fr / srate) * 20 * sc) + 1);
  acc();
  gi = 0;
  g_np = floor(EW * sc);
  loop(g_np,
    g_q = floor(gi / g_stp) * g_stp;
    g_y = PY(EY + EH / 2) - sin(2 * $pi * 2 * g_q / g_np) * (EH / 2 - 8) * sc;
    gi > 0 ? gfx_line(PX(EX) + gi - 1, g_py, PX(EX) + gi, g_y, 1);
    g_py = g_y;
    gi += 1;
  );
  fmt_hz(g_fr);
  strcpy(#va, #hz);
) : (
  col(0.13, 0.135, 0.145);
  rct(EX, EY + 6 + 18 / 54 * (EH - 12), EW, 1);
  g_q0 = res_q(g_tw);
  g_qq = 0.707 + (g_q0 - 0.707) * min(1, g_u * 4);
  g_shf = shelf_f(g_typ, g_tw);
  g_fa = cut_a(g_typ, g_u);
  g_fb = cut_b(g_typ, g_u);
  g_w = min(1, g_u * 20);
  g_np = floor(EW * sc / 2);
  gi = 0;
  loop(g_np + 1,
    g_f = 20 * pow(1000, gi / g_np);
    g_typ == 1 ? (
      g_db = -24 * g_u * sqr(g_f / g_shf) / (1 + sqr(g_f / g_shf));
    ) : g_typ == 2 ? (
      g_db = -24 * g_u / (1 + sqr(g_f / g_shf));
    ) : (
      g_m = sqrt(sqr(lp2(g_f / g_fa, g_qq)) + sqr(hp2(g_f / g_fb, g_qq)));
      g_typ == 4 ? ( g_m = hp2(g_f / g_fa, g_qq); );
      g_typ == 5 ? ( g_m = lp2(g_f / g_fa, g_qq); );
      g_typ == 6 ? ( g_m = hp2(g_f / g_fa, g_qq) * lp2(g_f / g_fb, g_qq); );
      g_m = 1 + (g_m - 1) * g_w;
      g_db = 20 * log10(max(0.00001, g_m));
    );
    g_db = min(18, max(-36, g_db));
    g_x = PX(EX) + gi * 2;
    g_y = PY(EY + 6 + (18 - g_db) / 54 * (EH - 12));
    acc();
    gi > 0 ? (
      gfx_line(g_px, g_py, g_x, g_y, 1);
      gfx_line(g_px, g_py + 1, g_x, g_y + 1, 1);
    );
    g_px = g_x; g_py = g_y;
    gi += 1;
  );
  (g_typ == 1 || g_typ == 2) ? (
    sprintf(#va, "%.1f dB", -24 * g_u);
  ) : (
    fmt_hz(g_fa);
    strcpy(#va, "LP ");
    (g_typ == 4 || g_typ == 6) ? strcpy(#va, "HP ");
    strcat(#va, #hz);
    g_typ >= 6 ? (
      fmt_hz(g_fb);
      g_typ == 6 ? ( strcat(#va, "  LP "); ) : ( strcat(#va, "  HP "); );
      strcat(#va, #hz);
    );
  );
);
col(0.20, 0.205, 0.22);
frm(EX, EY, EW, EH);
gfx_setfont(4);
col(0.70, 0.71, 0.73);
text_c(EX + EW / 2, EY + EH + 10, #va);

g_typ == 0 ? (
  sprintf(#va, "M %d  /  S %d", floor(min(1, 2 * (1 - g_tw)) * 100 + 0.5), floor(min(1, 2 * g_tw) * 100 + 0.5));
  strcpy(#lb, "MID  <>  SIDE");
) : (g_typ == 1 || g_typ == 2) ? (
  fmt_hz(shelf_f(g_typ, g_tw)); strcpy(#va, #hz);
  strcpy(#lb, "FREQUENCY");
) : g_typ == 3 ? (
  sprintf(#va, "%.1f %%", slider12);
  strcpy(#lb, "SMOOTH");
) : (
  sprintf(#va, "Q %.2f", res_q(g_tw));
  strcpy(#lb, "RESONANCE");
);
draw_knob(k_x(3), k_y(3), k_r(3), k_norm(3), #lb, #va);

// ---------- bottom bar ----------
col(0.045, 0.045, 0.05);
rct(12, 436, LW - 24, 26);
gfx_setfont(4);
col(0.45, 0.46, 0.48);
text_l(22, 449, "Drag / wheel: adjust   Shift: fine   Ctrl-click: default   Click the rate: note values");
col(0.55, 0.56, 0.58);
text_r(632, 449, "SIZE");
gi = 0;
loop(5,
  gx = 640 + gi * 48;
  gi == sz ? ( acc(); rct(gx, 439, 46, 20); acc_d(); ) : ( col(0.16, 0.165, 0.18); rct(gx, 439, 46, 20); col(0.70, 0.71, 0.73); );
  gi == 0 ? strcpy(#lb, "75%");
  gi == 1 ? strcpy(#lb, "100%");
  gi == 2 ? strcpy(#lb, "125%");
  gi == 3 ? strcpy(#lb, "150%");
  gi == 4 ? strcpy(#lb, "200%");
  text_c(gx + 23, 449, #lb);
  gi += 1;
);

// ---------- mouse ----------

// ---------- keyboard value entry (ReNo Mellow standard) : double-click a knob or its value, type, Enter ----------
function kbx_pnum() local(i, n, c, v, frac, dv)
(
  n = strlen(#kbx_ed); i = 0; v = 0; frac = 0; dv = 1;
  kbx_ok = 0; kbx_neg = 0; kbx_kil = 0; kbx_off = 0; kbx_inf = 0; kbx_sec = 0; kbx_pc = 0; kbx_pl = 0; kbx_pr = 0; kbx_pc0 = 0; kbx_sl2 = 0;
  loop(n,
    c = str_getchar(#kbx_ed, i);
    (c >= 'A' && c <= 'Z') ? c += 32;
    c == 'i' ? kbx_inf = 1;
    c == 'l' ? kbx_pl = 1;
    c == 'r' ? kbx_pr = 1;
    c == 'c' ? kbx_pc0 = 1;
    c == '/' ? kbx_sl2 = 1;
    (c == 's' && kbx_pc != 'm') ? kbx_sec = 1;
    kbx_pc = c;
    c == '-' ? kbx_neg = 1;
    c == 'k' ? kbx_kil = 1;
    c == 'o' ? kbx_off = 1;
    (c == '.' || c == ',') ? frac = 1;
    (c >= '0' && c <= '9') ? (
      kbx_ok = 1;
      frac ? ( dv *= 10; v += (c - '0') / dv; ) : ( v = v * 10 + (c - '0'); );
    );
    i += 1;
  );
  kbx_neg ? -v : v;
);
function kbx_setsl(idx, v) ( slider(idx) = v; slider_automate(2 ^ (idx - 1)); );
function kbx_ic(cx, cy, r) ( sqr(mx - cx) + sqr(my - cy) <= r * r; );
function kbx_ir(x, y, w, h) ( mx >= x && mx < x + w && my >= y && my < y + h; );
function kbx_put(idx, v, lo, hi, st)
(
  v = min(hi, max(lo, v));
  st > 0 ? v = lo + floor((v - lo) / st + 0.5) * st;
  kbx_setsl(idx, min(hi, max(lo, v)));
);
function kbx_norm() local(i, n, c)
(
  strcpy(#kbx_n, "");
  n = strlen(#kbx_ed); i = 0;
  loop(n,
    c = str_getchar(#kbx_ed, i);
    (c >= 'A' && c <= 'Z') ? c += 32;
    c != ' ' ? ( sprintf(#kbx_c1, "%c", c); strcat(#kbx_n, #kbx_c1); );
    i += 1;
  );
);
function kbx_hit()
(
  kbx_ic(300, 352, 34) ? 1 :
  kbx_ir(254, 385, 92, 22) ? 1 :
  kbx_ic(600, 352, 34) ? 2 :
  kbx_ir(554, 385, 92, 22) ? 2 :
  kbx_ic(792, 388, 24) ? 3 :
  kbx_ir(746, 411, 92, 22) ? 3 :
  kbx_ic(64, 396, 16) ? 4 :
  kbx_ir(18, 411, 92, 22) ? 4 :
  kbx_ic(152, 396, 16) ? 5 :
  kbx_ir(106, 411, 92, 22) ? 5 :
  kbx_ic(64, 260, 22) ? 6 :
  kbx_ir(18, 281, 92, 22) ? 6 :
  kbx_ic(152, 260, 22) ? 7 :
  kbx_ir(106, 281, 92, 22) ? 7 :
  0;
);
function kbx_x(i)
(
  i == 1 ? 300 :
  i == 2 ? 600 :
  i == 3 ? 792 :
  i == 4 ? 64 :
  i == 5 ? 152 :
  i == 6 ? 64 :
  i == 7 ? 152 :
  0;
);
function kbx_y(i)
(
  i == 1 ? 396 :
  i == 2 ? 396 :
  i == 3 ? 422 :
  i == 4 ? 422 :
  i == 5 ? 422 :
  i == 6 ? 292 :
  i == 7 ? 292 :
  0;
);
function kbx_apply(i) local(v)
(
  v = kbx_pnum();
  i == 1 ? (
    kbx_ok ? kbx_put(9, v * 1, 0, 100, 0.1);
  );
  i == 2 ? (
    kbx_ok ? kbx_put(10, v * 1, 0, 100, 0.1);
  );
  i == 3 ? (
    kbx_ok ? kbx_put(12, v * 1, 0, 100, 0.1);
  );
  i == 4 ? (
    kbx_ok ? kbx_put(13, v * 1, -24, 24, 0.1);
  );
  i == 5 ? (
    kbx_ok ? kbx_put(14, v * 1, -24, 24, 0.1);
  );
  i == 6 ? (
    kbx_ok ? kbx_put(5, v * 1, -60, 0, 0.1);
  );
  i == 7 ? (
    kbx_ok ? kbx_put(6, v * 1, 0, 100, 0.1);
  );
);

kbx_mb = mouse_cap & 1;
kbx_sc = PX(1) - PX(0);
kbx_ed > 0 ? (
  kbx_c = gfx_getchar();
  while (kbx_c > 0) (
    kbx_c == 13 ? ( kbx_apply(kbx_ed); kbx_ed = 0; ) :
    kbx_c == 27 ? ( kbx_ed = 0; ) :
    kbx_c == 8 ? ( strlen(#kbx_ed) > 0 ? str_delsub(#kbx_ed, strlen(#kbx_ed) - 1, 1); ) :
    (kbx_c >= 32 && kbx_c < 127) ? (
      strlen(#kbx_ed) < 12 ? ( sprintf(#kbx_ch, "%c", kbx_c); strcat(#kbx_ed, #kbx_ch); );
    );
    kbx_c = kbx_ed > 0 ? gfx_getchar() : 0;
  );
);
(kbx_mb && !kbx_lmb) ? (
  kbx_h = kbx_hit();
  kbx_ed > 0 ? ( kbx_apply(kbx_ed); kbx_ed = 0; );
  (kbx_h > 0 && kbx_h == kbx_lh && time_precise() - kbx_t < 0.3) ? (
    kbx_ed = kbx_h; strcpy(#kbx_ed, ""); kbx_t = 0;
    mouse_cap = 0;
  ) : (
    kbx_t = time_precise(); kbx_lh = kbx_h;
  );
);
kbx_lmb = kbx_mb;
kbx_ed > 0 ? ( mouse_wheel = 0; );
m_l = mouse_cap & 1;
m_pl = g_lcap & 1;
m_ctl = mouse_cap & 4;
m_fine = (mouse_cap & 8) ? 0.1 : 1;

m_l && !m_pl ? (
  g_tg = 0;
  my >= 439 && my < 459 ? (
    gi = 0;
    loop(5,
      in_rect(640 + gi * 48, 439, 46, 20) ? ( slider17 = gi; sliderchange(slider17); );
      gi += 1;
    );
  );
  in_rect(th_x0, 12, th_x1 - th_x0, 28) ? (
    time_precise() - th_t < 0.35 ? (
      slider18 = slider18 >= 0.5 ? 0 : 1; sliderchange(slider18); th_t = 0;
    ) : th_t = time_precise();
  );
  in_rect(704, 15, 82, 22) ? ( slider15 = g_byp ? 0 : 1; sliderchange(slider15); );
  in_rect(26, 74, 80, 24) ? ( slider1 = 0; sliderchange(slider1); );
  in_rect(110, 74, 80, 24) ? ( slider1 = 1; sliderchange(slider1); );
  in_rect(26, 104, 164, 30) ? (
    m_ctl ? (
      g_sync ? ( set_rate(6); ) : ( set_hz(2); );
    ) : (
      g_tg = 10; g_ly = mouse_y; g_mv = 0; g_acc = 0;
    );
  );
  gi = 0;
  loop(3,
    in_rect(26 + gi * 56, 160, 52, 24) ? ( slider4 = gi; sliderchange(slider4); );
    gi += 1;
  );
  in_rect(26, 190, 164, 20) ? ( slider16 = slider16 >= 0.5 ? 0 : 1; sliderchange(slider16); );
  gi = 0;
  loop(3,
    in_rect(210 + gi * 116, 244, 112, 26) ? ( slider7 = gi; sliderchange(slider7); );
    gi += 1;
  );
  in_rect(578, 244, 112, 26) ? ( slider8 = g_inv ? 0 : 1; sliderchange(slider8); );
  gi = 0;
  loop(8,
    in_rect(704, 74 + gi * 22, 176, 20) ? ( slider11 = gi; sliderchange(slider11); );
    gi += 1;
  );
  gi = 1;
  loop(7,
    sqr(mx - k_x(gi)) + sqr(my - k_y(gi)) <= sqr(k_r(gi) + 6) ? (
      (m_ctl || (time_precise() - g_kt < 0.3 && g_kl == gi)) ? (
        k_default(gi); g_kt = 0;
      ) : (
        g_tg = gi; g_kn = k_norm(gi); g_ly = mouse_y; g_kt = time_precise(); g_kl = gi;
      );
    );
    gi += 1;
  );
);

m_l && m_pl ? (
  g_tg >= 1 && g_tg <= 7 ? (
    mouse_y != g_ly ? (
      g_kn -= (mouse_y - g_ly) / (200 * sc) * m_fine;
      g_kn = min(1, max(0, g_kn));
      k_set(g_tg, g_kn);
      g_ly = mouse_y;
    );
  );
  g_tg == 10 ? (
    mouse_y != g_ly ? (
      g_mv = 1;
      g_sync ? (
        g_acc -= mouse_y - g_ly;
        g_acc >= 12 * sc ? ( set_rate(floor(slider2 + 0.5) + 1); g_acc = 0; );
        g_acc <= -12 * sc ? ( set_rate(floor(slider2 + 0.5) - 1); g_acc = 0; );
      ) : (
        g_n = log(max(0.1, slider3) / 0.1) / log(200);
        g_n -= (mouse_y - g_ly) / (200 * sc) * m_fine;
        set_hz(0.1 * pow(200, min(1, max(0, g_n))));
      );
      g_ly = mouse_y;
    );
  );
);

!m_l && m_pl ? (
  (g_tg == 10 && !g_mv && g_sync) ? rate_menu();
  g_tg = 0;
);

mouse_wheel != 0 ? (
  g_w = mouse_wheel / 120;
  in_rect(26, 104, 164, 30) ? (
    g_sync ? ( set_rate(floor(slider2 + 0.5) + (g_w > 0 ? 1 : -1)); ) : ( set_hz(slider3 * pow(1.06, g_w * m_fine)); );
  ) : in_rect(704, 74, 176, 174) ? (
    slider11 = min(7, max(0, g_typ + (g_w > 0 ? -1 : 1))); sliderchange(slider11);
  ) : (
    gi = 1;
    loop(7,
      sqr(mx - k_x(gi)) + sqr(my - k_y(gi)) <= sqr(k_r(gi) + 6) ? (
        k_set(gi, k_norm(gi) + g_w * 0.02 * m_fine);
      );
      gi += 1;
    );
  );
  mouse_wheel = 0;
);

g_lcap = mouse_cap;

// ---------- keyboard value entry : edit box ----------
kbx_ed > 0 ? (
  kbx_cx = kbx_x(kbx_ed); kbx_cy = kbx_y(kbx_ed);
  gfx_setfont(15, "Arial", 15 * kbx_sc, 'b');
  gfx_set(0.06, 0.065, 0.07, 0.96);
  gfx_rect(PX(kbx_cx - 42), PY(kbx_cy - 13), 84 * kbx_sc, 26 * kbx_sc);
  gfx_set(0.92, 0.92, 0.92, 1);
  gfx_rect(PX(kbx_cx - 42), PY(kbx_cy - 13), 84 * kbx_sc, 26 * kbx_sc, 0);
  strcpy(#kbx_sh, #kbx_ed);
  (time_precise() * 2) % 2 < 1 ? strcat(#kbx_sh, "_");
  gfx_measurestr(#kbx_sh, kbx_tw, kbx_th);
  gfx_x = PX(kbx_cx) - kbx_tw / 2; gfx_y = PY(kbx_cy) - kbx_th / 2;
  gfx_drawstr(#kbx_sh);
);

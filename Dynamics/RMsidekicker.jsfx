desc:RMsidekicker - ReNo Mellow sidechain shaper
//@author ReNo Mellow
//@version 1.2
//@changelog Keyboard value entry: double-click a knob or its value, type, Enter (Esc = cancel)
//@about
//  # RMsidekicker
//  Sidechain-style ducking / pumping shaper.
//  - Clock: SYNC (2/1 to 1/32, dotted and triplets) or FREE (0.1 to 20 Hz).
//  - Trigger: AUTO (runs on its own), MIDI (each note-on starts one cycle), AUDIO (sidechain on inputs 3/4, or the main input, with threshold).
//  - Offset: lets the transient through before the curve starts (percentage of the cycle).
//  - Curves: SOFT (compressor-like, variant = release), HARD (hard switch, variant = switch point), WAVE (swell into the downbeat, sine, double sine). FLIP turns ducking into pumping.
//  - Amount sets the intensity. Targets: M/S gain (tweak = mid / side balance), Hi shelf and Lo shelf (tweak = frequency), Decimate (tweak = smoothing), High-pass, Low-pass, Band-pass, Notch (tweak = resonance).
//  - In / out trim with meters, ACTIVE / BYPASS switch.
//  - Zero latency. Double-click the plug-in name to switch the colour (green / orange).

slider1:0<0,1,1{Sync,Free}>-Clock
slider2:6<0,13,1{2/1,1/1,1/2D,1/2,1/2T,1/4D,1/4,1/4T,1/8D,1/8,1/8T,1/16,1/16T,1/32}>-Rate (sync)
slider3:2<0.1,20,0.01>-Rate (Hz)
slider4:0<0,2,1{Auto,MIDI,Audio}>-Trigger
slider5:-24<-60,0,0.1>-Threshold (dB)
slider6:0<0,100,0.1>-Offset (%)
slider7:0<0,2,1{Soft,Hard,Wave}>-Curve
slider8:0<0,1,1{Normal,Flip}>-Flip
slider9:50<0,100,0.1>-Variant
slider10:100<0,100,0.1>-Amount (%)
slider11:0<0,7,1{M/S gain,Hi shelf,Lo shelf,Decimate,High-pass,Low-pass,Band-pass,Notch}>-Target
slider12:50<0,100,0.1>-Tweak
slider13:0<-24,24,0.1>-Input trim (dB)
slider14:0<-24,24,0.1>-Output trim (dB)
slider15:0<0,1,1{Off,On}>-Bypass
slider16:0<0,1,1{Sidechain 3/4,Main input}>-Audio trigger source
slider17:1<0,4,1{75%,100%,125%,150%,200%}>-Size
slider18:1<0,1,1{Orange,Green}>-Theme (double-click the plug-in name)

in_pin:left input
in_pin:right input
in_pin:sidechain left
in_pin:sidechain right
out_pin:left output
out_pin:right output

@init
ext_noinit = 1;
pdc_delay = 0;

mq = 0;     // MIDI note-on offsets of the current block (256)

function smoothst(u) ( u <= 0 ? 0 : (u >= 1 ? 1 : u * u * (3 - 2 * u)); );

// effect amount 0..1 at cycle position t (0..1)
function shape_val(t, sh, m, iv) local(e, a, r, p, w, ea, es, ed)
(
  t = min(1, max(0, t));
  sh < 0.5 ? (
    a = 0.012;
    r = 0.06 + 0.92 * m;
    e = t < a ? t / a : 1 - smoothst((t - a) / r);
  ) : sh < 1.5 ? (
    w = 0.012;
    p = 0.06 + 0.88 * m;
    e = t < w ? t / w : (t < p ? 1 : (t < p + w ? 1 - (t - p) / w : 0));
  ) : (
    ea = t * t * t;
    es = 0.5 + 0.5 * cos(2 * $pi * t);
    ed = 0.5 + 0.5 * cos(4 * $pi * t);
    m < 0.5 ? (
      w = m * 2; e = ea + (es - ea) * w;
    ) : (
      w = (m - 0.5) * 2; e = es + (ed - es) * w;
    );
  );
  iv > 0.5 ? 1 - e : e;
);

function lerpf(a, b, u) ( a * exp(log(b / a) * u); );

// filter cutoffs for the filter types (u = depth x shape)
function cut_a(ty, u)
(
  ty == 4 ? lerpf(20, 8000, u) :
  ty == 5 ? lerpf(20000, 150, u) :
  ty == 6 ? lerpf(20, 700, u) :
  lerpf(20000, 120, u);
);
function cut_b(ty, u)
(
  ty == 6 ? lerpf(20000, 1400, u) : lerpf(20000, 4000, u);
);
function shelf_f(ty, tw) ( ty == 1 ? 500 * exp(log(24) * tw) : 40 * exp(log(25) * tw); );
function res_q(tw) ( 0.5 * exp(log(20) * tw); );
function sr_freq(u) ( srate * exp(log(600 / srate) * u); );

function rate_beats(i)
(
  i == 0 ? 8 : i == 1 ? 4 : i == 2 ? 3 : i == 3 ? 2 : i == 4 ? 4/3 :
  i == 5 ? 1.5 : i == 6 ? 1 : i == 7 ? 2/3 : i == 8 ? 0.75 : i == 9 ? 0.5 :
  i == 10 ? 1/3 : i == 11 ? 0.25 : i == 12 ? 1/6 : 0.125;
);

// TPT state-variable filter
function svf_c(fc, q) instance(a1, a2, a3, kk) local(g)
(
  g = tan($pi * max(10, min(fc, 0.45 * srate)) / srate);
  kk = 1 / q;
  a1 = 1 / (1 + g * (g + kk));
  a2 = g * a1;
  a3 = g * a2;
);
function svf_r(x) instance(ic1, ic2, a1, a2, a3, kk, lp, hp) local(v1, v2, v3)
(
  v3 = x - ic2;
  v1 = a1 * ic1 + a2 * v3;
  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;
  ic2 = 2 * v2 - ic2;
  lp = v2;
  hp = x - kk * v1 - v2;
);

// RBJ shelf (S = 1)
function bq_shelf(f, gdb, hi) instance(c0, c1, c2, c3, c4) local(aa, w0, cs, al, sq, a0)
(
  aa = pow(10, gdb / 40);
  w0 = 2 * $pi * min(f, 0.45 * srate) / srate;
  cs = cos(w0);
  al = sin(w0) / 2 * sqrt(2);
  sq = 2 * sqrt(aa) * al;
  hi ? (
    a0 = (aa + 1) - (aa - 1) * cs + sq;
    c0 = aa * ((aa + 1) + (aa - 1) * cs + sq) / a0;
    c1 = -2 * aa * ((aa - 1) + (aa + 1) * cs) / a0;
    c2 = aa * ((aa + 1) + (aa - 1) * cs - sq) / a0;
    c3 = 2 * ((aa - 1) - (aa + 1) * cs) / a0;
    c4 = ((aa + 1) - (aa - 1) * cs - sq) / a0;
  ) : (
    a0 = (aa + 1) + (aa - 1) * cs + sq;
    c0 = aa * ((aa + 1) - (aa - 1) * cs + sq) / a0;
    c1 = 2 * aa * ((aa - 1) - (aa + 1) * cs) / a0;
    c2 = aa * ((aa + 1) - (aa - 1) * cs - sq) / a0;
    c3 = -2 * ((aa - 1) + (aa + 1) * cs) / a0;
    c4 = ((aa + 1) + (aa - 1) * cs - sq) / a0;
  );
);
function bq_r(x) instance(c0, c1, c2, c3, c4, x1, x2, y1, y2) local(y)
(
  y = c0 * x + c1 * x1 + c2 * x2 - c3 * y1 - c4 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);

d_ph = 0;
d_tph = 100;
d_es = 0;
d_arm = 1;
d_hold = 0;
d_cc = 0;
d_bx = 1;
d_sph = 0;

@block
d_qn = 0;
while (midirecv(mi_o, mi_1, mi_2, mi_3)) (
  ((mi_1 & 240) == 144 && mi_3 > 0) ? ( mq[d_qn] = mi_o; d_qn = min(255, d_qn + 1); );
  midisend(mi_o, mi_1, mi_2, mi_3);
);
d_qi = 0;
d_si = 0;

d_sync = slider1 < 0.5;
d_beats = rate_beats(floor(slider2 + 0.5));
d_cyc = d_sync ? d_beats * 60 / max(1, tempo) : 1 / max(0.1, slider3);
d_inc = 1 / (d_cyc * srate);
d_trg = floor(slider4 + 0.5);
d_thr = pow(10, slider5 / 20);
d_del = min(1, max(0, slider6 / 100));
d_shp = floor(slider7 + 0.5);
d_inv = slider8 >= 0.5;
d_mph = min(1, max(0, slider9 / 100));
d_dep = min(1, max(0, slider10 / 100));
d_typ = floor(slider11 + 0.5);
d_tw = min(1, max(0, slider12 / 100));
d_q = res_q(d_tw);
d_wm = min(1, 2 * (1 - d_tw));
d_ws = min(1, 2 * d_tw);
d_shf = shelf_f(d_typ, d_tw);
d_gin = pow(10, slider13 / 20);
d_gout = pow(10, slider14 / 20);
d_on = slider15 < 0.5 ? 1 : 0;
d_scs = slider16 >= 0.5;
d_idle = shape_val(1, d_shp, d_mph, d_inv);

d_sm = 1 - exp(-1 / (0.0015 * srate));
d_bsm = 1 - exp(-1 / (0.01 * srate));
d_mdc = exp(-1 / (0.3 * srate));
d_lrc = exp(-1 / (0.06 * srate));

(d_trg == 0 && d_sync && (play_state & 1)) ? d_ph = beat_position / d_beats;

d_typ != d_ltyp ? (
  fAL.ic1 = fAL.ic2 = fAR.ic1 = fAR.ic2 = 0;
  fBL.ic1 = fBL.ic2 = fBR.ic1 = fBR.ic2 = 0;
  shL.x1 = shL.x2 = shL.y1 = shL.y2 = 0;
  shR.x1 = shR.x2 = shR.y1 = shR.y2 = 0;
  d_cc = 0;
  d_ltyp = d_typ;
);

@sample
d_inL = spl0 * d_gin;
d_inR = spl1 * d_gin;
mt_il = max(abs(d_inL), mt_il * d_mdc);
mt_ir = max(abs(d_inR), mt_ir * d_mdc);

// trigger detection
d_scx = d_scs ? max(abs(d_inL), abs(d_inR)) : max(abs(spl2), abs(spl3));
d_lev = max(d_scx, d_lev * d_lrc);
d_tr = 0;
d_trg == 1 ? (
  while (d_qi < d_qn && mq[d_qi] <= d_si) ( d_tr = 1; d_qi += 1; );
);
d_trg == 2 ? (
  (d_arm && d_lev >= d_thr && d_hold <= 0) ? ( d_tr = 1; d_arm = 0; d_hold = floor(0.03 * srate); );
  d_lev < d_thr * 0.7 ? d_arm = 1;
  d_hold -= 1;
);

// shape position
d_trg == 0 ? (
  d_ph -= floor(d_ph);
  d_tt = d_ph - d_del;
  d_tt < 0 ? d_tt += 1;
  d_e = shape_val(d_tt, d_shp, d_mph, d_inv);
  d_disp = d_ph;
  d_ph += d_inc;
) : (
  d_tr ? ( d_tph = 0; );
  d_tt = d_tph - d_del;
  d_e = (d_tt < 0 || d_tt >= 1) ? d_idle : shape_val(d_tt, d_shp, d_mph, d_inv);
  d_disp = min(1, d_tph);
  d_tph = min(100, d_tph + d_inc);
);
d_si += 1;

d_es += (d_e - d_es) * d_sm;
d_u = d_dep * d_es;

d_cc -= 1;
d_upd = d_cc <= 0;
d_upd ? ( d_cc = 8; );

d_oL = d_inL;
d_oR = d_inR;

d_typ == 0 ? (
  d_m = (d_inL + d_inR) * 0.5;
  d_s = (d_inL - d_inR) * 0.5;
  d_m *= 1 - d_u * d_wm;
  d_s *= 1 - d_u * d_ws;
  d_oL = d_m + d_s;
  d_oR = d_m - d_s;
) : (d_typ == 1 || d_typ == 2) ? (
  d_upd ? (
    shL.bq_shelf(d_shf, -24 * d_u, d_typ == 1);
    shR.bq_shelf(d_shf, -24 * d_u, d_typ == 1);
  );
  d_oL = shL.bq_r(d_inL);
  d_oR = shR.bq_r(d_inR);
) : d_typ == 3 ? (
  d_upd ? (
    d_sfr = sr_freq(d_u);
    d_sri = d_sfr / srate;
    d_slc = 1 - exp(-2 * $pi * min(0.45 * srate, d_sfr * 0.5) / srate);
  );
  d_sri >= 0.999 ? (
    d_hL = d_inL; d_hR = d_inR; d_sph = 0;
  ) : (
    d_sph += d_sri;
    d_sph >= 1 ? ( d_sph -= 1; d_hL = d_inL; d_hR = d_inR; );
  );
  d_lpL += (d_hL - d_lpL) * d_slc;
  d_lpR += (d_hR - d_lpR) * d_slc;
  d_w = min(1, d_u * 20);
  d_oL = d_inL + (d_hL + (d_lpL - d_hL) * d_tw - d_inL) * d_w;
  d_oR = d_inR + (d_hR + (d_lpR - d_hR) * d_tw - d_inR) * d_w;
) : (
  d_upd ? (
    d_qq = 0.707 + (d_q - 0.707) * min(1, d_u * 4);
    d_fa = cut_a(d_typ, d_u);
    fAL.svf_c(d_fa, d_qq);
    fAR.svf_c(d_fa, d_qq);
    d_typ >= 6 ? (
      d_fb = cut_b(d_typ, d_u);
      fBL.svf_c(d_fb, d_qq);
      fBR.svf_c(d_fb, d_qq);
    );
  );
  fAL.svf_r(d_inL);
  fAR.svf_r(d_inR);
  d_typ == 4 ? ( d_fL = fAL.hp; d_fR = fAR.hp; );
  d_typ == 5 ? ( d_fL = fAL.lp; d_fR = fAR.lp; );
  d_typ == 6 ? (
    fBL.svf_r(fAL.hp); fBR.svf_r(fAR.hp);
    d_fL = fBL.lp; d_fR = fBR.lp;
  );
  d_typ == 7 ? (
    fBL.svf_r(d_inL); fBR.svf_r(d_inR);
    d_fL = fAL.lp + fBL.hp; d_fR = fAR.lp + fBR.hp;
  );
  d_w = min(1, d_u * 20);
  d_oL = d_inL + (d_fL - d_inL) * d_w;
  d_oR = d_inR + (d_fR - d_inR) * d_w;
);

d_bx += (d_on - d_bx) * d_bsm;
spl0 = (d_inL + (d_oL - d_inL) * d_bx) * d_gout;
spl1 = (d_inR + (d_oR - d_inR) * d_bx) * d_gout;
mt_ol = max(abs(spl0), mt_ol * d_mdc);
mt_or = max(abs(spl1), mt_or * d_mdc);

@gfx 900 470
LW = 900;
LH = 470;
CX0 = 210; CY0 = 56; CW = 480; CH = 180;   // curve display
EX = 704; EY = 256; EW = 176; EH = 62;     // target preview

function PX(x) ( ox + x * sc; );
function PY(y) ( oy + y * sc; );
function col(r, g, b) ( gfx_set(r, g, b, 1); );
function acc() ( gfx_set(acR, acG, acB, 1); );
function acc_l() ( gfx_set(alR, alG, alB, 1); );
function acc_d() ( gfx_set(adR, adG, adB, 1); );
function rct(x, y, ww, hh) ( gfx_rect(PX(x), PY(y), ww * sc, hh * sc); );
function frm(x, y, ww, hh) ( gfx_rect(PX(x), PY(y), ww * sc, hh * sc, 0); );
function text_c(x, y, str) local(tw, th)
(
  gfx_measurestr(str, tw, th);
  gfx_x = PX(x) - tw / 2; gfx_y = PY(y) - th / 2;
  gfx_drawstr(str);
);
function text_l(x, y, str) local(tw, th)
(
  gfx_measurestr(str, tw, th);
  gfx_x = PX(x); gfx_y = PY(y) - th / 2;
  gfx_drawstr(str);
);
function text_r(x, y, str) local(tw, th)
(
  gfx_measurestr(str, tw, th);
  gfx_x = PX(x) - tw; gfx_y = PY(y) - th / 2;
  gfx_drawstr(str);
);
function in_rect(x, y, ww, hh) ( mx >= x && mx < x + ww && my >= y && my < y + hh; );

function theme_set()
(
  slider18 >= 0.5 ? (
    acR = 0.424; acG = 0.851; acB = 0.780;
    alR = 0.70;  alG = 0.95;  alB = 0.90;
    adR = 0.03;  adG = 0.10;  adB = 0.09;
  ) : (
    acR = 1.00; acG = 0.58; acB = 0.12;
    alR = 1.00; alG = 0.70; alB = 0.35;
    adR = 0.10; adG = 0.06; adB = 0.02;
  );
);

function btn(x, y, ww, hh, on, str)
(
  on ? ( acc(); rct(x, y, ww, hh); acc_d(); ) : (
    col(0.16, 0.165, 0.18); rct(x, y, ww, hh);
    in_rect(x, y, ww, hh) ? col(0.92, 0.92, 0.93) : col(0.72, 0.73, 0.75);
  );
  text_c(x + ww / 2, y + hh / 2, str);
);

// list button : accent stripe on the left when selected
function lbtn(x, y, ww, hh, on, str)
(
  on ? col(0.19, 0.20, 0.215) : col(0.14, 0.145, 0.155);
  rct(x, y, ww, hh);
  on ? ( acc(); rct(x, y, 4, hh); ) : ( in_rect(x, y, ww, hh) ? col(0.92, 0.92, 0.93) : col(0.62, 0.63, 0.66); );
  text_l(x + 14, y + hh / 2, str);
);

function head(x, y, str)
(
  gfx_setfont(4);
  col(0.50, 0.51, 0.53);
  text_l(x, y, str);
);

function draw_knob(x, y, r, n, lab, val) local(i, a0, a1, qx, qy)
(
  a0 = -2.36; a1 = a0 + 4.72 * min(1, max(0, n));
  qx = PX(x); qy = PY(y);
  col(0.22, 0.23, 0.25);
  i = 0;
  loop(ceil(3 * sc), gfx_arc(qx, qy, r * sc - i * 0.9, -2.36, 2.36, 1); i += 1;);
  acc();
  n > 0.001 ? (
    i = 0;
    loop(ceil(3 * sc), gfx_arc(qx, qy, r * sc - i * 0.9, a0, a1, 1); i += 1;);
  );
  col(0.19, 0.195, 0.21);
  gfx_circle(qx, qy, (r - 5) * sc, 1, 1);
  col(0.13, 0.135, 0.145);
  gfx_circle(qx, qy, (r - 9) * sc, 1, 1);
  acc_l();
  gfx_circle(qx + sin(a1) * (r - 12) * sc, qy - cos(a1) * (r - 12) * sc, max(1.5, r * 0.07) * sc, 1, 1);
  gfx_setfont(4);
  col(0.62, 0.63, 0.66);
  text_c(x, y - r - 11, lab);
  col(0.85, 0.85, 0.86);
  text_c(x, y + r + 10, val);
);

// horizontal stereo meter, two thin rows
function hmeter(x, y, ww, vl, vr) local(n, n0, k, v)
(
  n0 = 60 / 66;
  k = 0;
  loop(2,
    v = k == 0 ? vl : vr;
    n = min(1, max(0, (20 * log10(max(0.000001, v)) + 60) / 66));
    col(0.085, 0.09, 0.095);
    rct(x, y + k * 6, ww, 5);
    acc();
    rct(x, y + k * 6, ww * min(n, n0), 5);
    n > n0 ? ( col(0.95, 0.30, 0.25); rct(x + ww * n0, y + k * 6, ww * (n - n0), 5); );
    k += 1;
  );
  col(0.35, 0.36, 0.38);
  rct(x + ww * n0, y - 2, 1, 15);
);

function rate_name(i)
(
  strcpy(#rn, "1/4");
  i == 0 ? strcpy(#rn, "2/1");
  i == 1 ? strcpy(#rn, "1/1");
  i == 2 ? strcpy(#rn, "1/2 D");
  i == 3 ? strcpy(#rn, "1/2");
  i == 4 ? strcpy(#rn, "1/2 T");
  i == 5 ? strcpy(#rn, "1/4 D");
  i == 7 ? strcpy(#rn, "1/4 T");
  i == 8 ? strcpy(#rn, "1/8 D");
  i == 9 ? strcpy(#rn, "1/8");
  i == 10 ? strcpy(#rn, "1/8 T");
  i == 11 ? strcpy(#rn, "1/16");
  i == 12 ? strcpy(#rn, "1/16 T");
  i == 13 ? strcpy(#rn, "1/32");
);

function type_name(i)
(
  strcpy(#tn, "M/S GAIN");
  i == 1 ? strcpy(#tn, "HI SHELF");
  i == 2 ? strcpy(#tn, "LO SHELF");
  i == 3 ? strcpy(#tn, "DECIMATE");
  i == 4 ? strcpy(#tn, "HIGH-PASS");
  i == 5 ? strcpy(#tn, "LOW-PASS");
  i == 6 ? strcpy(#tn, "BAND-PASS");
  i == 7 ? strcpy(#tn, "NOTCH");
);

function fmt_hz(f)
(
  f >= 1000 ? ( sprintf(#hz, "%.2f kHz", f / 1000); ) : ( sprintf(#hz, "%d Hz", floor(f + 0.5)); );
);

function rate_menu() local(r, i)
(
  strcpy(#mn, "");
  i = 0;
  loop(14,
    rate_name(i);
    i == floor(slider2 + 0.5) ? strcat(#mn, "!");
    strcat(#mn, #rn);
    i < 13 ? strcat(#mn, "|");
    i += 1;
  );
  gfx_x = PX(26); gfx_y = PY(136);
  r = gfx_showmenu(#mn);
  r > 0 ? ( slider2 = r - 1; sliderchange(slider2); );
);

function lp2(w, q) ( 1 / sqrt(sqr(1 - w * w) + sqr(w / q)); );
function hp2(w, q) ( w * w * lp2(w, q); );

// knobs : 1 variant, 2 amount, 3 tweak, 4 in trim, 5 out trim, 6 threshold, 7 offset
function k_x(i) ( i == 1 ? 300 : i == 2 ? 600 : i == 3 ? 792 : i == 4 ? 64 : i == 5 ? 152 : i == 6 ? 64 : 152; );
function k_y(i) ( i <= 2 ? 352 : i == 3 ? 388 : i <= 5 ? 396 : 260; );
function k_r(i) ( i <= 2 ? 34 : i == 3 ? 24 : i <= 5 ? 16 : 22; );
function k_norm(i)
(
  i == 1 ? slider9 / 100 :
  i == 2 ? slider10 / 100 :
  i == 3 ? slider12 / 100 :
  i == 4 ? (slider13 + 24) / 48 :
  i == 5 ? (slider14 + 24) / 48 :
  i == 6 ? (slider5 + 60) / 60 :
  slider6 / 100;
);
function k_set(i, n)
(
  n = min(1, max(0, n));
  i == 1 ? ( slider9 = floor(n * 1000 + 0.5) / 10; sliderchange(slider9); );
  i == 2 ? ( slider10 = floor(n * 1000 + 0.5) / 10; sliderchange(slider10); );
  i == 3 ? ( slider12 = floor(n * 1000 + 0.5) / 10; sliderchange(slider12); );
  i == 4 ? ( slider13 = floor((n * 48 - 24) * 10 + 0.5) / 10; sliderchange(slider13); );
  i == 5 ? ( slider14 = floor((n * 48 - 24) * 10 + 0.5) / 10; sliderchange(slider14); );
  i == 6 ? ( slider5 = floor((n * 60 - 60) * 10 + 0.5) / 10; sliderchange(slider5); );
  i == 7 ? ( slider6 = floor(n * 1000 + 0.5) / 10; sliderchange(slider6); );
);
function k_default(i)
(
  i == 1 ? ( slider9 = 50; sliderchange(slider9); );
  i == 2 ? ( slider10 = 100; sliderchange(slider10); );
  i == 3 ? ( slider12 = 50; sliderchange(slider12); );
  i == 4 ? ( slider13 = 0; sliderchange(slider13); );
  i == 5 ? ( slider14 = 0; sliderchange(slider14); );
  i == 6 ? ( slider5 = -24; sliderchange(slider5); );
  i == 7 ? ( slider6 = 0; sliderchange(slider6); );
);

function set_hz(v) ( slider3 = floor(min(20, max(0.1, v)) * 100 + 0.5) / 100; sliderchange(slider3); );
function set_rate(i) ( slider2 = min(13, max(0, i)); sliderchange(slider2); );

// ---------- frame setup ----------
theme_set();
sz = floor(slider17 + 0.5);
sc = sz >= 4 ? 2 : 0.75 + 0.25 * sz;
sc != last_sc ? (
  gfx_setfont(1, "Arial", 13 * sc);
  gfx_setfont(2, "Arial", 24 * sc, 'b');
  gfx_setfont(3, "Arial", 17 * sc, 'b');
  gfx_setfont(4, "Arial", 11 * sc);
  gfx_setfont(5, "Arial", 12 * sc, 'b');
  gfx_setfont(6, "Arial", 26 * sc, 'b');
  last_sc = sc;
);
ox = max(0, floor((gfx_w - LW * sc) / 2));
oy = max(0, floor((gfx_h - LH * sc) / 2));
mx = (mouse_x - ox) / sc;
my = (mouse_y - oy) / sc;

g_sync = slider1 < 0.5;
g_trg = floor(slider4 + 0.5);
g_shp = floor(slider7 + 0.5);
g_inv = slider8 >= 0.5;
g_mph = slider9 / 100;
g_dep = slider10 / 100;
g_typ = floor(slider11 + 0.5);
g_tw = slider12 / 100;
g_del = slider6 / 100;
g_byp = slider15 >= 0.5;

// ---------- background ----------
col(0.07, 0.07, 0.075);
gfx_rect(0, 0, gfx_w, gfx_h);
col(0.115, 0.12, 0.13);
rct(6, 4, LW - 12, LH - 8);
col(0.105, 0.11, 0.12);
gi = 8;
while (gi < LH - 6) ( rct(6, gi, LW - 12, 1); gi += 4; );
col(0.20, 0.205, 0.22);
gfx_circle(PX(16), PY(14), 3.5 * sc, 1, 1);
gfx_circle(PX(LW - 16), PY(14), 3.5 * sc, 1, 1);
gfx_circle(PX(16), PY(LH - 14), 3.5 * sc, 1, 1);
gfx_circle(PX(LW - 16), PY(LH - 14), 3.5 * sc, 1, 1);

// title
gfx_setfont(2);
acc();
text_l(34, 26, "RMsidekicker");
gfx_measurestr("RMsidekicker", t_w, t_h);
th_x0 = 34; th_x1 = 34 + t_w / sc;

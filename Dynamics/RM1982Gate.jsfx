gfx_setfont(3); col(0.62,0.63,0.66); text_c(818, 389, "SIZE");
gfx_setfont(1);
sz = floor(slider15 + 0.5);
draw_btn(842, 377, 46, 24, sz == 0, "75%");
draw_btn(892, 377, 46, 24, sz == 1, "100%");
draw_btn(942, 377, 46, 24, sz == 2, "125%");
draw_btn(992, 377, 46, 24, sz == 3, "150%");
gfx_setfont(5); col(0.45,0.46,0.50); text_l(34, 389, "Ctrl-click: default value   -   Shift: fine adjust");

// ---- Souris ----------------------------------------------------------------------------------
mb1 = mouse_cap & 1;
(mb1 && !last_mb) ? (
  drag = 0;
  in_circ(96, 160, 56) ? drag = 1;
  in_circ(232, 128, 36) ? ( drag = 2; scp = lpos(slider2, 1, 100); );
  in_circ(332, 128, 36) ? drag = 3;
  in_circ(432, 128, 36) ? drag = 4;
  in_circ(532, 128, 36) ? drag = 8;
  in_circ(232, 262, 36) ? ( drag = 5; scp = lpos(slider5, 0.01, 250); );
  in_circ(332, 262, 36) ? drag = 6;
  in_circ(432, 262, 36) ? ( drag = 7; scp = lpos(slider7, 5, 5000); );
  in_circ(532, 262, 36) ? drag = 9;
  in_circ(52, 320, 26) ? drag = 10;
  in_circ(140, 320, 26) ? drag = 16;
  in_circ(770, 318, 24) ? ( drag = 12; scp = hp_pos(slider12); );
  in_circ(860, 318, 24) ? ( drag = 13; scp = lp_pos(slider13); );
  in_rect(616, 314, 104, 26) ? set_sl(11, slider11 >= 0.5 ? 0 : 1);
  in_rect(916, 314, 110, 26) ? set_sl(14, slider14 >= 0.5 ? 0 : 1);
  in_rect(842, 377, 46, 24) ? (slider15 = 0; sliderchange(slider15););
  in_rect(892, 377, 46, 24) ? (slider15 = 1; sliderchange(slider15););
  in_rect(942, 377, 46, 24) ? (slider15 = 2; sliderchange(slider15););
  in_rect(992, 377, 46, 24) ? (slider15 = 3; sliderchange(slider15););
  (drag > 0 && (mouse_cap & 4)) ? (
    drag == 1 ? set_sl(1, -40) : drag == 2 ? set_sl(2, 10) : drag == 3 ? set_sl(3, 40) :
    drag == 4 ? set_sl(4, 6) : drag == 5 ? set_sl(5, 0.5) : drag == 6 ? set_sl(6, 20) :
    drag == 7 ? set_sl(7, 120) : drag == 8 ? set_sl(8, 0) : drag == 9 ? set_sl(9, 100) :
    drag == 10 ? set_sl(10, 0) : drag == 16 ? set_sl(16, 3) : drag == 12 ? set_sl(12, 0) : set_sl(13, 20000);
    drag = 0;
  );
);
(mb1 && drag > 0) ? (
  fine = (mouse_cap & 8) ? 0.2 : 1;
  dy = (last_my - my)*fine;
  dy != 0 ? (
    drag == 1 ? set_sl(1, floor(min(max(slider1 + dy*0.3, -80), 0)*10 + 0.5)/10) :
    drag == 2 ? ( scp = min(max(scp + dy*0.005, 0), 1); set_sl(2, floor(lval(scp, 1, 100)*100 + 0.5)/100); ) :
    drag == 3 ? set_sl(3, floor(min(max(slider3 + dy*0.4, 0), 100)*10 + 0.5)/10) :
    drag == 4 ? set_sl(4, floor(min(max(slider4 + dy*0.12, 0), 30)*10 + 0.5)/10) :
    drag == 5 ? ( scp = min(max(scp + dy*0.005, 0), 1); set_sl(5, floor(lval(scp, 0.01, 250)*100 + 0.5)/100); ) :
    drag == 6 ? set_sl(6, floor(min(max(slider6 + dy*1, 0), 250)*10 + 0.5)/10) :
    drag == 7 ? ( scp = min(max(scp + dy*0.005, 0), 1); set_sl(7, floor(lval(scp, 5, 5000)*10 + 0.5)/10); ) :
    drag == 8 ? set_sl(8, floor(min(max(slider8 + dy*0.04, 0), 10)*10 + 0.5)/10) :
    drag == 9 ? set_sl(9, floor(min(max(slider9 + dy*0.5, 0), 100)*2 + 0.5)/2) :
    drag == 10 ? set_sl(10, floor(min(max(slider10 + dy*0.2, -20), 20)*10 + 0.5)/10) :
    drag == 16 ? set_sl(16, floor(min(max(slider16 + dy*0.1, 0), 24)*10 + 0.5)/10) :
    drag == 12 ? ( scp = min(max(scp + dy*0.005, 0), 1); set_sl(12, floor(hp_hz(scp) + 0.5)); ) :
                 ( scp = min(max(scp + dy*0.005, 0), 1); set_sl(13, floor(lp_hz(scp) + 0.5)); );
  );
);
!mb1 ? (drag = 0);
last_mb = mb1;
last_my = (mouse_y - oy)/S;

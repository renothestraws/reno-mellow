desc:RMdrumhumanizer - ReNo Mellow MIDI Drum Humanizer
//@author ReNo Mellow
//@version 1.2
//@changelog Curseurs REAPER masqués (interface seule) ; Interface aux conventions RM (façade, tailles 75-150 %, double-clic sur le nom = orange / vert) ; corrections de syntaxe
//@about Humaniseur MIDI de batterie en trois groupes : TIGHT (jusqu'à 12 notes, 0-20 % du fader), POCKET (jusqu'à 12 notes, 20-40 %), LOOSE (toutes les autres notes, 40-100 %). Vélocité et timing ; Laid Back (notes en retard, latence nulle) ou Rush (notes en avance, anticipation compensée par REAPER).
//tags: MIDI drums humanize velocity timing groove
//
// Souris : clic sur une case = Learn (jouer une note) ; molette = changer la note ;
// clic droit = vider la case ; faders : glisser / molette (Shift = fin) ;
// plages : glisser haut-bas / molette ; Ctrl + clic = valeur par défaut.

slider1:vel_amt=0<0,100,0.1>-Humanize Velocity (%)
slider2:tim_amt=0<0,100,0.1>-Humanize Timing (%)
slider3:mode=0<0,1,1{Laid Back,Rush}>-Timing Feel
slider4:vel_range=50<1,64,1>-Velocity Range (max +/-)
slider5:tim_range=60<1,100,1>-Timing Range (max ms)
slider6:size_idx=1<0,3,1{75%,100%,125%,150%}>-Size

// Default groups (General MIDI drum map)
// Tight : Kicks 35 36, Side Stick 37, Snares 38 40, Clap 39, Toms 41 43 45 47 48 50
// Pocket: Closed HH 42, Pedal HH 44, Open HH 46, Ride 51, Ride Bell 53, Ride 2 59
slider10:35<-1,127,1>-Tight 1
slider11:36<-1,127,1>-Tight 2
slider12:37<-1,127,1>-Tight 3
slider13:38<-1,127,1>-Tight 4
slider14:39<-1,127,1>-Tight 5
slider15:40<-1,127,1>-Tight 6
slider16:41<-1,127,1>-Tight 7
slider17:43<-1,127,1>-Tight 8
slider18:45<-1,127,1>-Tight 9
slider19:47<-1,127,1>-Tight 10
slider20:48<-1,127,1>-Tight 11
slider21:50<-1,127,1>-Tight 12
slider22:42<-1,127,1>-Pocket 1
slider23:44<-1,127,1>-Pocket 2
slider24:46<-1,127,1>-Pocket 3
slider25:51<-1,127,1>-Pocket 4
slider26:53<-1,127,1>-Pocket 5
slider27:59<-1,127,1>-Pocket 6
slider28:-1<-1,127,1>-Pocket 7
slider29:-1<-1,127,1>-Pocket 8
slider30:-1<-1,127,1>-Pocket 9
slider31:-1<-1,127,1>-Pocket 10
slider32:-1<-1,127,1>-Pocket 11
slider33:-1<-1,127,1>-Pocket 12
slider34:0<0,1,1{Orange,Green}>-Theme (double-click the plug-in name)


@init
ext_noinit = 1;

// ---- memory map ----
QMAX   = 4096;          // queued MIDI events (time, m1, m2, m3)
Q      = 0;             // 0 .. 16383
OFS    = 17000;         // applied offset per channel/note (2048)
LASTON = 20000;         // last scheduled note-on time per channel/note (2048)
ACT    = 23000;         // active (sent) notes per channel/note (2048)
GRP    = 26000;         // group per note number (128)
LEDT   = 26500;         // last hit time per note (128)
DLEN   = 40000;         // audio delay length per channel
DL     = 30000;         // audio delay buffer 2 x DLEN
NSLOT  = 12;            // slots per group (Tight / Pocket)

!inited ? (
  inited = 1;
  qn = 0; pos = 0; wp = 0; L = 0;
  learn_slot = -1; lastloose = -1;
  memset(Q, 0, QMAX*4);
  memset(OFS, 0, 2048);
  memset(LASTON, 0, 2048);
  memset(ACT, 0, 2048);
  memset(LEDT, 0, 128);
  memset(DL, 0, DLEN*2);
) : (
  flush = 1;   // playback (re)start / samplerate change: release everything
);

// ---------- functions ----------
function rebuild_groups() local(i, n) (
  memset(GRP, 2, 128);
  i = NSLOT*2 - 1;
  loop(NSLOT*2,
    n = slider(10 + i);
    (n >= 0 && n <= 127) ? ( GRP[n] = (i < NSLOT ? 0 : 1); );
    i -= 1;
  );
);

function assign_slot(k, n) local(i) (
  i = 0;
  loop(NSLOT*2,
    (i != k && slider(10 + i) == n) ? (
      slider(10 + i) = -1;
      slider_automate(2 ^ (9 + i));
    );
    i += 1;
  );
  slider(10 + k) = n;
  slider_automate(2 ^ (9 + k));
  rebuild_groups();
);

function update_latency() local(nl) (
  nl = mode >= 0.5 ? floor(tim_range * srate * 0.001 + 0.5) : 0;
  nl > DLEN - 1 ? ( nl = DLEN - 1; );
  nl != L ? (
    L = nl;
    memset(DL, 0, DLEN*2);
    flush = 1;
  );
  pdc_delay  = L;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;
  pdc_midi   = 1;
);

function q_insert(tm, a, b, c) local(i) (
  qn < QMAX ? (
    i = qn;
    while (i > 0 && Q[(i-1)*4] > tm) (
      memcpy(Q + i*4, Q + (i-1)*4, 4);
      i -= 1;
    );
    Q[i*4] = tm; Q[i*4+1] = a; Q[i*4+2] = b; Q[i*4+3] = c;
    qn += 1;
    1;
  ) : 0;
);

function q_remove(i) (
  i < qn - 1 ? memcpy(Q + i*4, Q + (i+1)*4, (qn - i - 1)*4);
  qn -= 1;
);

function is_noteoff(a, c) local(st) (
  st = a & $xF0;
  st == $x80 || (st == $x90 && c == 0);
);

// ---------- interface (fonctions) ----------
function PX(x) ( ox + x*S; );
function PY(y) ( oy + y*S; );
function col(r,g,b) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = 1; );
function rct(x,y,w,h,f) ( gfx_rect(PX(x), PY(y), ceil(w*S), ceil(h*S), f); );
function text_c(x,y,str) local(w,h) ( gfx_measurestr(str,w,h); gfx_x = PX(x) - w*0.5; gfx_y = PY(y) - h*0.5; gfx_drawstr(str); );
function text_l(x,y,str) local(w,h) ( gfx_measurestr(str,w,h); gfx_x = PX(x); gfx_y = PY(y) - h*0.5; gfx_drawstr(str); );
function text_r(x,y,str) local(w,h) ( gfx_measurestr(str,w,h); gfx_x = PX(x) - w; gfx_y = PY(y) - h*0.5; gfx_drawstr(str); );
function in_rect(x,y,w,h) ( mx >= x && mx < x+w && my >= y && my < y+h; );
function clampv(v, lo, hi) ( max(lo, min(hi, v)); );
// couleurs des groupes : TIGHT bleu, POCKET = couleur d'accent, LOOSE violet
function grp_col(g) ( g == 0 ? col(0.45,0.66,0.98) : col(0.74,0.54,0.96); );
function grp_dim(g) ( g == 0 ? col(0.32,0.47,0.72) : col(0.50,0.37,0.66); );
function draw_btn(x,y,w,h,on,str)
(
  on ? col(thc0r,thc0g,thc0b) : col(0.16,0.165,0.18);
  rct(x,y,w,h,1);
  col(0.05,0.05,0.055); rct(x,y,w,h,0);
  gfx_setfont(1); on ? col(thc5r,thc5g,thc5b) : col(0.78,0.79,0.82);
  text_c(x + w*0.5, y + h*0.5, str);
);
function draw_fader(i, label, v, y)
(
  gfx_setfont(4); col(0.92,0.93,0.95); text_l(34, y + 12, label);
  col(0.05,0.05,0.055); rct(230, y + 7, 360, 10, 1);
  col(thc0r,thc0g,thc0b); rct(230, y + 7, 360*v*0.01, 10, 1);
  col(0.88,0.89,0.92); rct(230 + 360*v*0.01 - 4, y, 8, 24, 1);
  col(0.30,0.31,0.34); rct(230 + 360*v*0.01 - 4, y, 8, 24, 0);
  gfx_setfont(1); col(thc1r,thc1g,thc1b);
  sprintf(#fv, "%.1f %%", v); text_r(680, y + 12, #fv);
);
function note_name(n)
(
  n < 0 ? strcpy(#nn, "--") : (
    strcpy_substr(#nb, "C C#D D#E F F#G G#A A#B ", (n % 12)*2, 2);
    str_getchar(#nb, 1) == ' ' ? str_setlen(#nb, 1);
    sprintf(#nn, "%s%d", #nb, floor(n/12) - 1);
  );
  #nn;
);

rebuild_groups();

@slider
rebuild_groups();
update_latency();

@block
// ---------- flush (transport start, latency change) ----------
flush ? (
  i = 0;
  loop(2048,
    ACT[i] > 0 ? ( midisend(0, $x80 | (i >> 7), i & 127, 0); ACT[i] = 0; );
    i += 1;
  );
  qn = 0;
  memset(LASTON, 0, 2048);
  memset(OFS, 0, 2048);
  flush = 0;
);

// ---------- input ----------
while (midirecv(ofs, m1, m2, m3)) (
  st = m1 & $xF0;
  ch = m1 & $x0F;
  t  = pos + ofs + L;
  key = ch*128 + m2;

  (st == $x90 && m3 > 0) ? (
    // learn
    learn_slot >= 0 ? ( assign_slot(learn_slot, m2); learn_slot = -1; );
    led_n = m2;

    g = GRP[m2];
    g == 0 ? ( flo = 0; fhi = 0.2; ) : g == 1 ? ( flo = 0.2; fhi = 0.4; ) : ( flo = 0.4; fhi = 1; lastloose = m2; );
    LEDT[m2] = time_precise();

    // velocity
    f  = flo + rand(1) * (fhi - flo);
    nv = m3 + (rand(1) < 0.5 ? -1 : 1) * f * vel_amt * 0.01 * vel_range;
    nv = floor(nv + 0.5);
    nv < 1 ? ( nv = 1; );
    nv > 127 ? ( nv = 127; );

    // timing
    f2 = flo + rand(1) * (fhi - flo);
    dv = f2 * tim_amt * 0.01 * tim_range * 0.001 * srate;
    mode >= 0.5 ? ( dv > L ? ( dv = L; ); d = -dv; ) : ( d = dv; );

    tn = t + d;
    tn < LASTON[key] ? ( tn = LASTON[key]; );

    // a pending note-off of the same key must not cut this new note
    i = 0;
    while (i < qn) (
      e = Q + i*4;
      (is_noteoff(e[1], e[3]) && (e[1] & 15) == ch && e[2] == m2 && e[0] > tn) ? (
        a = e[1]; b = e[2]; c = e[3];
        q_remove(i);
        q_insert(tn, a, b, c);
      ) : ( i += 1; );
    );

    LASTON[key] = tn;
    OFS[key] = tn - t;
    !q_insert(tn, m1, m2, nv) ? midisend(ofs, m1, m2, nv);
  ) : is_noteoff(m1, m3) ? (
    toff = t + OFS[key];
    toff < LASTON[key] ? ( toff = LASTON[key]; );
    !q_insert(toff, m1, m2, m3) ? midisend(ofs, m1, m2, m3);
  ) : (
    !q_insert(t, m1, m2, m3) ? midisend(ofs, m1, m2, m3);
  );
);

// ---------- output ----------
endt = pos + samplesblock;
i = 0;
while (i < qn && Q[i*4] < endt) (
  e = Q + i*4;
  o = floor(e[0] - pos);
  o < 0 ? ( o = 0; );
  o > samplesblock - 1 ? ( o = samplesblock - 1; );
  midisend(o, e[1], e[2], e[3]);
  k2 = (e[1] & 15)*128 + e[2];
  ((e[1] & $xF0) == $x90 && e[3] > 0) ? ( ACT[k2] += 1; ) : (
    (is_noteoff(e[1], e[3]) && ACT[k2] > 0) ? ( ACT[k2] -= 1; );
  );
  i += 1;
);
i > 0 ? (
  i < qn ? memcpy(Q, Q + i*4, (qn - i)*4);
  qn -= i;
);
pos = endt;

@sample
// audio is delayed by the same lookahead so the track stays aligned in Rush mode
L > 0 ? (
  DL[wp] = spl0;
  DL[DLEN + wp] = spl1;
  rp = wp - L; rp < 0 ? ( rp += DLEN; );
  spl0 = DL[rp];
  spl1 = DL[DLEN + rp];
  wp += 1; wp >= DLEN ? ( wp = 0; );
);

@gfx 760 420
// thème : orange ou vert (double-clic sur le nom du plug-in), mémorisé dans slider34
slider34 >= 0.5 ? (
  thc0r = 0.424; thc0g = 0.851; thc0b = 0.78;
  thc1r = 0.6; thc1g = 0.92; thc1b = 0.86;
  thc5r = 0.02; thc5g = 0.1; thc5b = 0.09;
  thc6r = 0.4; thc6g = 0.82; thc6b = 0.75;
) : (
  thc0r = 1.0; thc0g = 0.58; thc0b = 0.12;
  thc1r = 1.0; thc1g = 0.7; thc1b = 0.35;
  thc5r = 0.1; thc5g = 0.06; thc5b = 0.02;
  thc6r = 0.93; thc6g = 0.62; thc6b = 0.22;
);
S  = 0.75 + 0.25*floor(size_idx + 0.5);
ox = max(0, floor((gfx_w - 760*S)/2));
oy = max(0, floor((gfx_h - 420*S)/2));
mx = (mouse_x - ox)/S;
my = (mouse_y - oy)/S;
gfx_setfont(1, "Arial", max(6, floor(12*S)), 'b');
gfx_setfont(2, "Arial", max(10, floor(30*S)), 'b');
gfx_setfont(3, "Arial", max(5, floor(10*S)), 'b');
gfx_setfont(4, "Arial", max(6, floor(13*S)), 'b');
gfx_setfont(5, "Arial", max(6, floor(11*S)));
gfx_setfont(6, "Arial", max(6, floor(12*S)));

now = time_precise();
lclick = (mouse_cap & 1) && !(last_cap & 1);
rclick = (mouse_cap & 2) && !(last_cap & 2);
lrel   = !(mouse_cap & 1) && (last_cap & 1);
g_shift = mouse_cap & 8; g_ctrl = mouse_cap & 4;
wh = mouse_wheel; mouse_wheel = 0;
whs = wh > 0 ? 1 : wh < 0 ? -1 : 0;

// ---- Façade -----------------------------------------------------------------------
col(0.07,0.07,0.075); gfx_rect(0, 0, gfx_w, gfx_h);
col(0.115,0.12,0.13); rct(6, 6, 748, 364, 1);
ui = 0; loop(36, col(0.125,0.13,0.14); rct(6, 10 + ui*10, 748, 1, 1); ui += 1;);
col(0.20,0.21,0.23); rct(6, 6, 748, 2, 1);
col(0.04,0.04,0.045); rct(6, 368, 748, 2, 1);
col(0.06,0.06,0.065);
gfx_circle(PX(18), PY(20), 4*S, 1, 1);  gfx_circle(PX(18), PY(356), 4*S, 1, 1);
gfx_circle(PX(742), PY(20), 4*S, 1, 1); gfx_circle(PX(742), PY(356), 4*S, 1, 1);

gfx_setfont(2); col(thc0r,thc0g,thc0b); text_l(34, 34, "RMdrumhumanizer"); th_x1 = gfx_x; th_y0 = gfx_y; gfx_measurestr("RMdrumhumanizer", th_w, th_h); th_x0 = th_x1 - th_w; gfx_measurestr("RMdrumhumanizer", t_w, t_h); t_x = 34 + t_w/S + 14;
gfx_setfont(3); col(0.62,0.63,0.66); text_l(t_x, 38, "MIDI  DRUM  HUMANIZER");
gfx_setfont(4); col(0.85,0.86,0.88); text_r(726, 34, "ReNo Mellow");
col(thc0r,thc0g,thc0b); rct(34, 56, 692, 2, 1);

// ---- Groupes ----------------------------------------------------------------------
k = 0;
loop(NSLOT*2,
  row = k < NSLOT ? 0 : 1;
  cl = k % NSLOT;
  sx = 150 + cl*48; sy = row == 0 ? 72 : 120;
  n = slider(10 + k);
  lit = n >= 0 && (now - LEDT[n]) < 0.12;
  learning = learn_slot == k;
  blink = learning && (floor(now*4) % 2 == 0);
  lit ? ( row == 0 ? grp_col(0) : col(thc0r,thc0g,thc0b); ) : blink ? col(0.42,0.16,0.14) : col(0.16,0.165,0.18);
  rct(sx, sy, 44, 40, 1);
  learning ? col(1,0.35,0.3) : n >= 0 ? ( row == 0 ? grp_dim(0) : col(thc6r,thc6g,thc6b); ) : col(0.26,0.27,0.29);
  rct(sx, sy, 44, 40, 0);
  n >= 0 ? (
    gfx_setfont(4); lit ? col(0.06,0.06,0.07) : col(0.92,0.93,0.95);
    text_c(sx + 22, sy + 14, note_name(n));
    gfx_setfont(3); lit ? col(0.12,0.12,0.13) : col(0.55,0.56,0.6);
    sprintf(#num, "%d", n); text_c(sx + 22, sy + 30, #num);
  ) : (
    gfx_setfont(3); learning ? col(1,0.65,0.6) : col(0.42,0.43,0.46);
    learning ? strcpy(#num, "LEARN") : strcpy(#num, "+");
    text_c(sx + 22, sy + 20, #num);
  );
  in_rect(sx, sy, 44, 40) ? (
    lclick ? ( learn_slot = learn_slot == k ? -1 : k; );
    rclick ? ( slider(10 + k) = -1; slider_automate(2^(9 + k)); rebuild_groups(); learn_slot == k ? ( learn_slot = -1; ); );
    whs != 0 ? ( nn2 = n < 0 ? 36 : clampv(n + whs, 0, 127); assign_slot(k, nn2); );
  );
  k += 1;
);
gfx_setfont(4); grp_col(0); text_l(34, 86, "TIGHT");
col(thc0r,thc0g,thc0b); text_l(34, 134, "POCKET");
grp_col(2); text_l(34, 180, "LOOSE");
gfx_setfont(3); col(0.55,0.56,0.6);
text_l(34, 102, "0 - 20 %"); text_l(34, 150, "20 - 40 %"); text_l(34, 196, "40 - 100 %");
lit = lastloose >= 0 && (now - LEDT[lastloose]) < 0.12;
lit ? grp_col(2) : col(0.16,0.165,0.18); rct(150, 168, 572, 34, 1);
grp_dim(2); rct(150, 168, 572, 34, 0);
gfx_setfont(5); lit ? col(0.06,0.06,0.07) : col(0.75,0.76,0.79);
lastloose >= 0 ? sprintf(#ll, "ALL OTHER NOTES   -   LAST : %s (%d)", note_name(lastloose), lastloose) : strcpy(#ll, "ALL OTHER NOTES");
text_c(436, 185, #ll);

// ---- Faders -------------------------------------------------------------------------
draw_fader(0, "HUMANIZE VELOCITY", vel_amt, 222);
draw_fader(1, "HUMANIZE TIMING", tim_amt, 258);

// ---- Feel ---------------------------------------------------------------------------
gfx_setfont(4); col(0.92,0.93,0.95); text_l(34, 307, "FEEL");
draw_btn(230, 294, 120, 26, mode < 0.5, "LAID BACK");
draw_btn(356, 294, 120, 26, mode >= 0.5, "RUSH");
gfx_setfont(5); col(0.62,0.63,0.66);
sprintf(#lat, "LATENCY : %.1f ms", L/srate*1000); text_l(492, 307, #lat);
lclick && in_rect(230, 294, 120, 26) ? ( mode = 0; slider_automate(4); update_latency(); );
lclick && in_rect(356, 294, 120, 26) ? ( mode = 1; slider_automate(4); update_latency(); );

// ---- Plages -------------------------------------------------------------------------
gfx_setfont(4); col(0.92,0.93,0.95); text_l(34, 343, "RANGES");
col(0.05,0.05,0.055); rct(230, 330, 120, 26, 1); rct(356, 330, 120, 26, 1);
col(0.26,0.27,0.29); rct(230, 330, 120, 26, 0); rct(356, 330, 120, 26, 0);
gfx_setfont(1); col(thc1r,thc1g,thc1b);
sprintf(#vr, "VEL +/- %d", vel_range); text_c(290, 343, #vr);
sprintf(#tr, "TIME %d ms", tim_range); text_c(416, 343, #tr);

// ---- Souris : faders et plages ------------------------------------------------------
lclick ? (
  drag = 0;
  in_rect(226, 218, 368, 28) ? ( g_ctrl ? ( vel_amt = 0; slider_automate(1); ) : ( drag = 1; ); ) :
  in_rect(226, 254, 368, 28) ? ( g_ctrl ? ( tim_amt = 0; slider_automate(2); ) : ( drag = 2; ); ) :
  in_rect(230, 330, 120, 26) ? ( g_ctrl ? ( vel_range = 50; slider_automate(8); ) : ( drag = 3; dy0 = my; v0 = vel_range; ); ) :
  in_rect(356, 330, 120, 26) ? ( g_ctrl ? ( tim_range = 60; slider_automate(16); update_latency(); ) : ( drag = 4; dy0 = my; v0 = tim_range; ); );
  drag == 1 || drag == 2 ? ( dx0 = mx; v0 = drag == 1 ? vel_amt : tim_amt; );
);
(mouse_cap & 1) ? (
  drag == 1 ? ( vel_amt = clampv(g_shift ? v0 + (mx - dx0)*0.05 : (mx - 230)/360*100, 0, 100); slider_automate(1); );
  drag == 2 ? ( tim_amt = clampv(g_shift ? v0 + (mx - dx0)*0.05 : (mx - 230)/360*100, 0, 100); slider_automate(2); );
  drag == 3 ? ( vel_range = clampv(floor(v0 + (dy0 - my)/3), 1, 64); slider_automate(8); );
  drag == 4 ? ( tim_range = clampv(floor(v0 + (dy0 - my)/3), 1, 100); slider_automate(16); );
);
lrel ? ( drag == 4 ? update_latency(); drag = 0; );
whs != 0 ? (
  in_rect(226, 218, 368, 28) ? ( vel_amt = clampv(floor(vel_amt + whs*(g_shift ? 0.1 : 1)*10 + 0.5)/10, 0, 100); slider_automate(1); );
  in_rect(226, 254, 368, 28) ? ( tim_amt = clampv(floor(tim_amt + whs*(g_shift ? 0.1 : 1)*10 + 0.5)/10, 0, 100); slider_automate(2); );
  in_rect(230, 330, 120, 26) ? ( vel_range = clampv(vel_range + whs, 1, 64); slider_automate(8); );
  in_rect(356, 330, 120, 26) ? ( tim_range = clampv(tim_range + whs, 1, 100); slider_automate(16); update_latency(); );
);

// ---- Barre du bas -------------------------------------------------------------------
gfx_setfont(5); col(0.45,0.46,0.5);
text_l(12, 389, "SLOT: CLICK = LEARN  -  WHEEL = NOTE  -  RIGHT-CLICK = CLEAR     FADERS: DRAG / WHEEL     CTRL+CLICK = DEFAULT");
gfx_setfont(3); col(0.62,0.63,0.66); text_c(538, 389, "SIZE");
sz = floor(size_idx + 0.5);
draw_btn(562, 377, 44, 24, sz == 0, "75%");
draw_btn(610, 377, 44, 24, sz == 1, "100%");
draw_btn(658, 377, 44, 24, sz == 2, "125%");
draw_btn(706, 377, 44, 24, sz == 3, "150%");
lclick ? (

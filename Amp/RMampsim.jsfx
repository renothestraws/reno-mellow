// ---- Souris ----------------------------------------------------------------------------------
mb1 = mouse_cap & 1;
(mb1 && !last_mb) ? (
  drag = br_hit ? 0 : k_hit();
  drag > 0 ? (
    (mouse_cap & 4) ? ( k_put(drag, k_df(drag)); drag = 0; ) : ( drag_f = k_frac(drag); );
  );
  br_hit ? (
    // navigateur ouvert : dossiers, fichiers, fermeture
    in_rect(620, 119, 20, 18) ? br_on = 0 :
    in_rect(34, 142, 182, BR_N*18) ? (
      br_d = br_sd + floor((my - 142)/18);
      br_d < ix_d0 ? br_d = ix_nd;
      br_d < ix_nd ? ( br_fold = br_d; br_sf = 0; );
    ) :
    in_rect(218, 142, 424, BR_N*18) ? (
      br_k = br_sf + floor((my - 142)/18);
      (ix_nd > 0 && br_k < IX_DN[br_fold]) ? ix_load(IX_DF[br_fold] + br_k);
    );
  ) : (
    // clic hors du navigateur : il se ferme (sauf sur le nom qui l'a ouvert)
    br_was = br_on; br_on = (br_on && ((br_kind == 0 && in_rect(144, 86, 300, 28)) || (br_kind == 1 && in_rect(144, 290, 300, 26))));
    in_rect(34, 86, 70, 28) ? set_sl(1, slider1 >= 0.5 ? 0 : 1);
    in_rect(112, 86, 28, 28) ? br_step(0, -1);
    in_rect(448, 86, 28, 28) ? br_step(0, 1);
    in_rect(144, 86, 300, 28) ? ( (br_was && br_kind == 0) ? br_on = 0 : br_open(0); );
    in_rect(488, 86, 56, 28) ? set_sl(9, 0);
    in_rect(548, 86, 56, 28) ? set_sl(9, 1);
    in_rect(34, 290, 70, 26) ? ( set_sl(10, slider10 >= 0.5 ? 0 : 1); cab_auto = 0; );
    in_rect(112, 290, 28, 26) ? br_step(1, -1);
    in_rect(448, 290, 28, 26) ? br_step(1, 1);
    in_rect(144, 290, 300, 26) ? ( (br_was && br_kind == 1) ? br_on = 0 : br_open(1); );
  );
  in_rect(950, 84, 92, 312) ? ( gm_i0 = gm_o0 = gm_o1 = 0; );
  ui = 0; loop(5, in_rect(830 + ui*42, 435, 40, 24) ? ( slider13 = ui; sliderchange(slider13); ); ui += 1;);
);
(mb1 && drag > 0) ? (
  fine = (mouse_cap & 8) ? 0.2 : 1;
  dy = (last_my - my)*fine;
  dy != 0 ? ( drag_f = min(max(drag_f + dy*0.005, 0), 1); k_set_frac(drag, drag_f); );
);
(mouse_wheel != 0 && br_hit) ? (
  wv = mouse_wheel > 0 ? -3 : 3;
  mx < 216 ? br_sd = max(ix_d0, min(br_sd + wv, ix_nd - BR_N)) : ( ix_nd > 0 ? br_sf = max(0, min(br_sf + wv, IX_DN[br_fold] - BR_N)); );
  mouse_wheel = 0;
);
mouse_wheel != 0 ? (
  wv = mouse_wheel/120*((mouse_cap & 8) ? 0.2 : 1);

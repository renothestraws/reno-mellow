(th_mb && !th_lmb) ? (
  (mouse_x >= th_x0 - 6 && mouse_x <= th_x1 + 6 && mouse_y >= th_y0 - 6 && mouse_y <= th_y0 + th_h + 6) ? (
    (time_precise() - th_t < 0.4) ? ( slider15 = slider15 >= 0.5 ? 0 : 1; sliderchange(slider15); th_t = 0; ) : ( th_t = time_precise(); );
  );
);
th_lmb = th_mb;

// ---- Navigateur (clic sur le nom de l'ampli ou du baffle) ---------------------------------
br_on ? (
  col(0.06,0.065,0.07); rct(34, 116, 610, 300, 1); col(thc0r,thc0g,thc0b); rct(34, 116, 610, 300, 0);
  gfx_setfont(4); col(thc0r,thc0g,thc0b); br_kind == 0 ? text_l(44, 128, "AMP BROWSER") : text_l(44, 128, "CAB BROWSER");
  gfx_setfont(6); col(0.55,0.56,0.60);
  br_kind == 0 ? sprintf(#s, "%d NAM model(s)  -  REAPER/Data/RM Amp", ix_nf) : sprintf(#s, "%d IR  -  REAPER/Data/RM IR/Cab", ix_nf - 7);
  text_l(160, 128, #s);
  draw_btn(620, 119, 20, 18, 0, "x");
  col(0.03,0.03,0.035); rct(34, 140, 610, 1, 1); rct(216, 141, 1, 274, 1);
  br_fold = min(max(br_fold, 0), ix_nd - 1);
  gfx_setfont(1); ui = 0;
  loop(BR_N,
    br_d = br_sd + ui;
    br_d < ix_nd ? (
      br_d == br_fold ? ( col(thc0r,thc0g,thc0b); rct(36, 142 + ui*18, 179, 18, 1); col(thc5r,thc5g,thc5b); ) :
        ( (ix_cur >= 0 && IX_FI[ix_cur] == br_d) ? col(thc1r,thc1g,thc1b) : col(0.80,0.81,0.84); );
      ix_str(IX_DO[br_d], IX_DL[br_d]); strcpy(#s, #ixs);
      strlen(#s) > 24 ? ( strcpy_substr(#s2, #s, strlen(#s) - 22); strcpy(#s, ".."); strcat(#s, #s2); );
      text_l(42, 151 + ui*18, #s);
    );
    br_k = br_sf + ui;
    br_k < IX_DN[br_fold] ? (
      br_i = IX_DF[br_fold] + br_k;
      br_i == ix_cur ? ( col(thc0r,thc0g,thc0b); rct(218, 142 + ui*18, 424, 18, 1); col(thc5r,thc5g,thc5b); ) :
        ( (in_rect(218, 142 + ui*18, 424, 18)) ? col(1,1,1) : col(0.80,0.81,0.84); );
      ix_str(IX_NO[br_i], IX_NL[br_i]); strcpy(#s, #ixs);
      strlen(#s) > 60 ? ( strcpy_substr(#s2, #s, 0, 58); strcpy(#s, #s2); strcat(#s, ".."); );
      text_l(226, 151 + ui*18, #s);
    );
    ui += 1;
  );
  gfx_setfont(6); col(0.45,0.46,0.50);
  ix_nd > BR_N ? text_c(125, 410, "wheel: more folders");
  IX_DN[br_fold] > BR_N ? text_c(430, 410, "wheel: more files");
  (ix_nd == 1) ? (
    gfx_setfont(5); col(0.62,0.63,0.66);
    br_kind == 0 ? (
      text_l(228, 260, "No NAM model yet:");
      text_l(228, 278, "1. copy your .nam files (A2) into REAPER/Data/RM Amp");
      text_l(228, 296, "   (IR Buddy - Open RM Amp folder)");
      text_l(228, 314, "2. run the action \"IR Buddy - Rescan RM IR\".");
    ) : (
      text_l(228, 296, "Your own cab IRs: put .wav files in REAPER/Data/RM IR/Cab,");
      text_l(228, 314, "then IR Buddy - Rescan RM IR (or capture a cab plug-in");
      text_l(228, 332, "with IR Buddy, sub-folder \"Cab\").");
    );
  );
);

// ---- Saisie clavier : cadre d'édition ----------------------------------------------------
kbx_ed > 0 ? (
  kbx_cx = k_cx(kbx_ed); kbx_cy = k_vy(kbx_ed);
  gfx_setfont(15, "Arial", 14*kbx_sc, 'b');
  col(0.06,0.065,0.07); gfx_a = 0.96;
  gfx_rect(PX(kbx_cx - 46), PY(kbx_cy - 11), 92*kbx_sc, 22*kbx_sc);
  col(thc0r,thc0g,thc0b);
  gfx_rect(PX(kbx_cx - 46), PY(kbx_cy - 11), 92*kbx_sc, 22*kbx_sc, 0);
  strcpy(#kbx_sh, #kbx_ed);
  (time_precise()*2) % 2 < 1 ? strcat(#kbx_sh, "_");
  gfx_measurestr(#kbx_sh, kbx_tw, kbx_th);
  gfx_x = PX(kbx_cx) - kbx_tw/2; gfx_y = PY(kbx_cy) - kbx_th/2;
  col(0.95,0.95,0.95);
  gfx_drawstr(#kbx_sh);
);

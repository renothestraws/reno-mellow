desc:RMampsim - ReNo Mellow NAM amp player (A2 models, cab IR loader, zero latency)
//tags: amp simulator guitar bass neural amp modeler nam a2 capture cabinet impulse response ir zero latency
//@author ReNo Mellow
//@version 1.0
//@changelog First release: NAM A2 player (Lite / Full), cab IR loader with MIC, IN CAL, post EQ, full rig detection (CAB off). Factory set: 17 NAM A2 models (default Hot Plexi Head) and 10 cab IRs (default British Vintage 4x12). Needs the IR Buddy package (Rescan, Capture for NAM).
//@about
//  # RMampsim
//  Neural Amp Modeler (NAM) A2 player + cabinet impulse response, zero latency.
//  - Needs the free IR Buddy package ("ReNo Mellow - IR Buddy", shared with RM1982Verb): after installing, run
//    "IR Buddy - Rescan RM IR" once.
//  - CAPTURE YOUR OWN AMP: run "IR Buddy - Capture for NAM" on the track of your amp plug-in (no gate; cab off, or on for a full rig),
//    upload the output file on tone3000.com (signal "T3K sweep v3"), put the .nam you get in REAPER/Data/RM Amp, Rescan.
//  - AMP: put your .nam files (A2 captures, e.g. from TONE3000) in REAPER/Data/RM Amp, then run the IR Buddy action
//    "IR Buddy - Rescan RM IR": the models are converted and indexed. Click the amp name to browse them.
//    Only A2 models are supported (A1 models are listed as skipped by the rescan).
//  - LITE / FULL: an A2 file holds two sizes of the same capture. LITE is light on the CPU, FULL is a little more
//    accurate but several times heavier.
//  - INPUT: gain before the model (dB). IN CAL: level of your interface for 0 dBFS (dBu), used when the model was
//    captured with a known input level (OFF = no calibration).
//  - BASS / MID / TREBLE / PRESENCE: EQ after the amp. LEVEL: output. The model output is normalised from its loudness.
//  - CABINET: the IRs of REAPER/Data/RM IR/Cab (click the cab name, or drop a .wav). Default: British Vintage 4x12.
//    MIC moves the microphone from the center (bright) to the edge (dark). AMP off = cab IR loader only.
//    Full rig / amp + cab captures already hold a cabinet: picking one switches the CAB off (back on with an amp-only model).
//  - NAM models are made for 48 kHz: run the project at 48 kHz for the exact tone.
//  - Click a value (or double-click a knob) to type it. Ctrl-click = default. Double-click the plug-in name: orange / green.
//
// ---------------------------------------------------------------------------
// RMampsim - lecteur de modèles NAM A2 + IR de baffle, latence nulle.
// Chaîne : entrée (L+R)/2 -> INPUT x IN CAL -> modèle NAM A2 (WaveNet 23 couches, échantillon par échantillon)
//          -> normalisation (loudness du modèle -> -24 dB) -> EQ (graves, médiums, aigus, présence)
//          -> convolution du baffle (zéro latence) -> MIC -> LEVEL -> écrêteur caché à 0 dBFS.
// Moteur NAM : réécriture en EEL2 de l'architecture A2 de NeuralAmpModelerCore (licence MIT, Steven Atkinson) ;
//          sortie identique au code de référence à la précision float près. Poids lus dans les fichiers RMNAM
//          (WAV float 32) produits par IR Buddy (IRBuddy_nam.lua).

slider1:1<0,1,1{Off (IR loader only),On}>-Amp
slider2:0<-24,24,0.1>-Input (dB)
slider3:0<-12,12,0.1>-Bass (dB)
slider4:0<-12,12,0.1>-Mid (dB)
slider5:0<-12,12,0.1>-Treble (dB)
slider6:0<-12,12,0.1>-Presence (dB)
slider7:0<-24,12,0.1>-Level (dB)
slider8:0<0,30,0.5>-In cal (interface dBu at 0 dBFS, 0 = off)
slider9:0<0,1,1{Lite,Full}>-Model size
slider10:1<0,1,1{Off,On}>-Cab
slider11:7<0,7,1{1x12 Open,2x12 Open,4x10 Open,4x12 Vintage,4x12 Modern,1x15 Bass,8x10 Bass,User IR}>-Cabinet (IR files only since 0.15)
slider12:25<0,100,1>-Mic (0 = center, 100 = edge)
slider13:1<0,4,1{75%,100%,125%,150%,200%}>-Size
slider14:/RM IR/Cab:British Vintage 4x12.wav:Cab IR file (REAPER/Data/RM IR/Cab)
slider15:1<0,1,1{Orange,Green}>-Theme (double-click the plug-in name)
slider16:/RMIRIndex:amps.txt:-IR Buddy NAM index (REAPER/Data/RMIRIndex)
slider17:/RMIRIndex:index.txt:-IR Buddy IR index (REAPER/Data/RMIRIndex)

options:maxmem=16777216

in_pin:Left In
in_pin:Right In
out_pin:Left Out
out_pin:Right Out

@init
ext_noinit = 1;
EPS = 0.000000000001;
function db2lin(d) ( exp(d*0.11512925464970228); );
function lin2db(x) ( 8.685889638065035*log(max(x, EPS)); );

// ---- mémoire ---------------------------------------------------------------------------
RAW = 0; RAWN = 1048576;
IRB0 = 1048576; IRB1 = 1310720; IRMAX = 262144;
LMAXS = min(floor(srate), IRMAX);
SNC = 1572864; SN_OS = 512; SN_Z = 16;
FHB = 1581056; FIRC0 = 1581312; FIRC1 = 1581376;
RESP = 1581568; NRESP = 88;
FS = 1582700;                       // états des filtres (2 par biquad)
C_MIC = 1582830; C_TMP = 1582870;
C_EQ = 1582900;                     // 4 x 5 coefficients (graves, médiums, aigus, présence)
NS_C = 1582960; NS_N = 1582970; NS_LD = 1582980; NS_IN = 1582990; NS_OFF = 1583000; NS_SR = 1583010;
// moteur NAM : tables 1600000.., poids 1600256.., anneaux 1613000..1700000
LVT = 1700000; LVBASE = 1700512;
NRAW = 8388608; NRAWN = 1048576;    // fichier RMNAM brut (8 Mo .. 9 Mo)
// index des navigateurs (ampli ou baffle, un seul ouvert à la fois) : 1 Mo
IXB = 7340032; MEMTOP = IXB;
IX_FI = IXB; IX_NO = IXB + 8000; IX_NL = IXB + 16000; IX_RO = IXB + 24000; IX_RL = IXB + 32000;
IX_PO = IXB + 40000; IX_PL = IXB + 48000; IX_DO = IXB + 56000; IX_DL = IXB + 57000; IX_DF = IXB + 58000; IX_DN = IXB + 59000;
IX_MAP = IXB + 60000; IX_POOL = IXB + 61000; IX_PEND = 8388608; IX_MAXF = 8000; IX_MAXD = 1000;

NKS = 1600000; NDIL = 1600032; NW = 1600064; NHB = 1600096; NMASK = 1600128; NPOS = 1600160; NR = 1600192;
NAM_W = 1600256; NAM_RING = 1613000;
NKS[0] = 6; NDIL[0] = 1;
NKS[1] = 6; NDIL[1] = 3;
NKS[2] = 6; NDIL[2] = 7;
NKS[3] = 6; NDIL[3] = 17;
NKS[4] = 6; NDIL[4] = 41;
NKS[5] = 6; NDIL[5] = 101;
NKS[6] = 6; NDIL[6] = 239;
NKS[7] = 6; NDIL[7] = 1;
NKS[8] = 6; NDIL[8] = 3;
NKS[9] = 6; NDIL[9] = 7;
NKS[10] = 6; NDIL[10] = 17;
NKS[11] = 6; NDIL[11] = 41;
NKS[12] = 6; NDIL[12] = 101;
NKS[13] = 6; NDIL[13] = 239;
NKS[14] = 15; NDIL[14] = 1;
NKS[15] = 15; NDIL[15] = 13;
NKS[16] = 6; NDIL[16] = 1;
NKS[17] = 6; NDIL[17] = 3;
NKS[18] = 6; NDIL[18] = 7;
NKS[19] = 6; NDIL[19] = 17;
NKS[20] = 6; NDIL[20] = 41;
NKS[21] = 6; NDIL[21] = 101;
NKS[22] = 6; NDIL[22] = 239;

// ---- moteur NAM A2 (WaveNet 23 couches, LeakyReLU, tête k=16) ------------------------
// Fichier RMNAM (WAV float 32, écrit par IR Buddy) : en-tête 16 valeurs, puis pour chaque sous-modèle
// 8 valeurs (C, nombre de poids, loudness, input dBu, output dBu, fréquence) et les poids dans l'ordre NAM.
function nam_layout(src, nc) local(l, k, kn, dl, o, c, w, ptr, rp, lb, rr)
(
  // src : poids dans l'ordre NAM. Rangement : W[k][o][c], cb, mw, lw[o][c], lb ; anneaux par couche
  ptr = NAM_W; rp = NAM_RING;
  c = 0; loop(nc, NR[c] = src[c]; c += 1;); src += nc;
  l = 0;
  loop(23,
    kn = NKS[l]; dl = NDIL[l];
    NW[l] = ptr;
    o = 0; loop(nc, c = 0; loop(nc, k = 0; loop(kn, ptr[k*nc*nc + o*nc + c] = src[0]; src += 1; k += 1;); c += 1;); o += 1;);
    w = ptr + kn*nc*nc;
    o = 0; loop(nc, w[o] = src[0]; src += 1; o += 1;);           // cb
    o = 0; loop(nc, w[nc + o] = src[0]; src += 1; o += 1;);       // mixin
    lb = w + 2*nc;
    o = 0; loop(nc, c = 0; loop(nc, lb[o*nc + c] = src[0]; src += 1; c += 1;); o += 1;);  // layer1x1
    o = 0; loop(nc, lb[nc*nc + o] = src[0]; src += 1; o += 1;);    // bias 1x1
    ptr = lb + nc*nc + nc;
    rr = 1; while (rr < (kn - 1)*dl + 1) ( rr *= 2; );
    NHB[l] = rp; NMASK[l] = rr - 1; NPOS[l] = 0; rp += rr*nc;
    l += 1;
  );
  NHW = ptr;
  c = 0; loop(nc, k = 0; loop(16, NHW[k*nc + c] = src[0]; src += 1; k += 1;); c += 1;);
  NHBIAS = src[0]; NHSCALE = src[1]; src += 2;
  NHH = rp; rp += 16*nc; nhpos = 0;
  memset(NAM_RING, 0, rp - NAM_RING);
  src;
);


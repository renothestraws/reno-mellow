// ---- table du sinus cardinal fenêtré (rééchantillonnage des IR) -----------------------------
function sinc_table() local(j, u, w)
(
  j = 0;
  loop(SN_Z*SN_OS + 2,
    u = j/SN_OS;
    w = u < SN_Z ? 0.42 + 0.5*cos($pi*u/SN_Z) + 0.08*cos(2*$pi*u/SN_Z) : 0;
    SNC[j] = (u == 0 ? 1 : sin($pi*u)/($pi*u))*w;
    j += 1;
  );
);
sinc_table();

// ---- auto-test FFT (format de la paire DC/Nyquist, échelle) ---------------------------------
function fft_cal(n) local(i, ar, ai, br, bi, sxy0, syy0, sxx, sxy1, syy1, c, y0, y1)
(
  i = 0; loop(n, 65536[i] = sin(i*i*0.7 + i*1.3) + 0.3*cos(i*0.11); i += 1;);
  memset(0, 0, n); 0[3] = 1; fft_real(0, n);
  memcpy(32768, 65536, n); fft_real(32768, n);
  i = 0;
  loop(n/2,
    ar = 32768[2*i]; ai = 32768[2*i + 1]; br = 0[2*i]; bi = 0[2*i + 1];
    98304[2*i] = ar*br - ai*bi; 98304[2*i + 1] = ar*bi + ai*br;
    i == 0 ? ( 131072[0] = ar*br; 131072[1] = ai*bi; ) : ( 131072[2*i] = ar*br - ai*bi; 131072[2*i + 1] = ar*bi + ai*br; );
    i += 1;
  );
  ifft_real(98304, n); ifft_real(131072, n);
  sxy0 = syy0 = sxy1 = syy1 = sxx = 0; i = 0;
  loop(n,
    c = 65536[(i - 3 + n) % n]; y0 = 98304[i]; y1 = 131072[i];
    sxy0 += c*y0; syy0 += y0*y0; sxy1 += c*y1; syy1 += y1*y1; sxx += c*c;
    i += 1;
  );
  cal_k0 = sxy0/max(syy0, EPS); cal_k1 = sxy1/max(syy1, EPS);
  cal_e0 = max(sxx - sxy0*cal_k0, 0)/max(sxx, EPS);
  cal_e1 = max(sxx - sxy1*cal_k1, 0)/max(sxx, EPS);
);
fft_cal(64);
dcmode = cal_e1 < cal_e0;
fft_ok = min(cal_e0, cal_e1) < 0.000001;
function ksc_of(n) ( fft_cal(n); dcmode ? cal_k1 : cal_k0; );

// ---- convolution partitionnée non uniforme, zéro latence (moteur de RM1982Verb, entrée mono) ----
// niveaux : 0 B, 1 p0, 2 début, 3 fin, 4 P, 5 Pa, 6 R, 7 H0, 8 H1, 9 X, 11 A0, 12 A1, 13 IN,
//           15 OC0, 16 OC1, 17 ON0, 18 ON1, 19 pos, 20 ri, 21 wq, 22 wc, 23 wi, 24 wst, 25 cps, 26 actif,
//           27 Pa à appliquer, 29 Pa visé par la construction, 30 échelle ifft
function lev_def(l, bs, p0, st, en) local(lv)
(
  lv = LVT + l*64;
  memset(lv, 0, 64);
  lv[0] = bs; lv[1] = p0; lv[2] = st; lv[3] = en; lv[24] = 3;
  lv[30] = ksc_of(2*bs);
);
lev_def(0, 64, 1, 64, 1024);
lev_def(1, 512, 2, 1024, 8192);
lev_def(2, 4096, 2, 8192, 32768);
lev_def(3, 16384, 2, 32768, 100000000);

function lev_work(lv, n, fin) local(bs, rr, q, c, i, m, dc, xp, hp, ap, op, xr, xi, hr, hm)
(
  bs = lv[0]; rr = lv[6];
  while (n > 0 && lv[24] < 3) (
    lv[24] < 1 ? (
      lv[5] < 1 ? ( lv[24] = 1; ) : (
        q = lv[21]; c = lv[22]; i = lv[23];
        m = min(n, bs - i);
        dc = dcmode && i == 0;
        xp = lv[9] + ((lv[20] - q + rr) % rr)*2*bs + 2*i;
        hp = (c ? lv[8] : lv[7]) + q*2*bs + 2*i;
        ap = (c ? lv[12] : lv[11]) + 2*i;
        n -= m; i += m;
        dc ? ( ap[0] += xp[0]*hp[0]; ap[1] += xp[1]*hp[1]; xp += 2; hp += 2; ap += 2; m -= 1; );
        loop(m,
          xr = xp[0]; xi = xp[1]; hr = hp[0]; hm = hp[1];
          ap[0] += xr*hr - xi*hm; ap[1] += xr*hm + xi*hr;
          xp += 2; hp += 2; ap += 2;
        );
        i >= bs ? ( i = 0; c += 1; c >= nchir ? ( c = 0; q += 1; q >= lv[5] ? lv[24] = 1; ); );
        lv[21] = q; lv[22] = c; lv[23] = i;
      );
    ) : (
      c = lv[24] - 1;
      c >= nchir ? ( lv[24] = 3; ) : (
        ap = c ? lv[12] : lv[11]; op = c ? lv[18] : lv[17];
        ifft_real(ap, 2*bs);
        i = 0; m = lv[30]; loop(bs, op[i] = ap[bs + i]*m; i += 1;);
        lv[24] += 1;
        !fin ? n = 0;
      );
    );
  );
);
function lev_swap(lv) local(t)
(
  t = lv[15]; lv[15] = lv[17]; lv[17] = t;
  t = lv[16]; lv[16] = lv[18]; lv[18] = t;
);
function lev_bound(lv) local(bs, sz, ri, sl)
(
  bs = lv[0]; sz = 2*bs;
  lv[1] > 1 ? ( lev_work(lv, 1000000000, 1); lev_swap(lv); );
  ri = (lv[20] + 1) % lv[6]; lv[20] = ri;
  sl = lv[9] + ri*sz; memcpy(sl, lv[13], sz); fft_real(sl, sz); memcpy(lv[13], lv[13] + bs, bs);
  lv[5] = lv[27];
  lv[21] = 0; lv[22] = 0; lv[23] = 0;
  lv[5] > 0 ? (
    memset(lv[11], 0, sz); memset(lv[12], 0, sz); lv[24] = 0;
    lv[25] = ceil(lv[5]*sz/(bs - 4)) + 1;
    lv[1] < 2 ? lev_work(lv, 1000000000, 1);
  ) : (
    memset(lv[17], 0, bs); memset(lv[18], 0, bs); lv[24] = 3;
  );
  lv[1] < 2 ? lev_swap(lv);
);
function lev_sample(lv, a) local(bs, pos, p)
(
  bs = lv[0]; pos = lv[19];
  p = lv[13]; p[bs + pos] = a;
  p = lv[15]; w0 += p[pos];
  p = lv[16]; w1 += p[pos];
  lv[24] < 3 ? lev_work(lv, lv[25], 0);
  pos += 1;
  pos >= bs ? ( lev_bound(lv); pos = 0; );
  lv[19] = pos;
);
function layout() local(l, lv, bs, P, ptr, sz)
(
  ptr = LVBASE; lay_ok = 1;
  l = 3;
  while (l >= 0) (
    lv = LVT + l*64;
    bs = lv[0];
    P = max(0, ceil((min(lv[3], Lir) - lv[2])/bs));
    lv[4] = P; lv[26] = P > 0; lv[6] = max(P, 1);
    lv[5] = 0; lv[27] = 0; lv[29] = 0; lv[19] = 0; lv[20] = 0; lv[21] = 0; lv[22] = 0; lv[23] = 0; lv[24] = 3; lv[25] = 0;
    P > 0 ? (
      sz = 2*bs;
      ptr = ceil(ptr/sz)*sz;
      lv[7] = ptr; ptr += sz*P;
      nchir > 1 ? ( lv[8] = ptr; ptr += sz*P; ) : ( lv[8] = lv[7]; );
      lv[9] = ptr; ptr += sz*P;
      lv[11] = ptr; ptr += sz; lv[12] = ptr; ptr += sz;
      lv[13] = ptr; ptr += sz;
      lv[15] = ptr; ptr += bs; lv[16] = ptr; ptr += bs; lv[17] = ptr; ptr += bs; lv[18] = ptr; ptr += bs;
    );
    l -= 1;
  );
  ptr > MEMTOP ? ( lay_ok = 0; l = 0; loop(4, lv = LVT + l*64; lv[4] = 0; lv[26] = 0; l += 1;); ) : memset(LVBASE, 0, ptr - LVBASE);
  memset(FHB, 0, 128);
  lay_on = lay_ok;
);
function shp(c, t) local(p)
(
  (t < 0 || t >= Lir) ? 0 : ( p = c ? IRB1 : IRB0; p[t]*gnorm; );
);
function build_start() local(l, lv)
(
  l = 0;
  loop(4,
    lv = LVT + l*64;
    lv[29] = lv[4] > 0 ? min(lv[4], max(0, ceil((min(lv[3], Lir) - lv[2])/lv[0]))) : 0;
    l += 1;
  );
  bd_l = 3; bd_c = 0; bd_q = 0; building = 1; ready = 0;
);
function build_step(budget) local(lv, bs, sl, t0, i, j)
(
  while (building && budget > 0) (
    bd_l >= 0 ? (
      lv = LVT + bd_l*64;
      bd_q >= lv[29] ? ( bd_l -= 1; bd_q = 0; bd_c = 0; ) : (
        bs = lv[0];
        sl = (bd_c ? lv[8] : lv[7]) + bd_q*2*bs;
        t0 = lv[2] + bd_q*bs;
        i = 0; loop(bs, sl[i] = shp(bd_c, t0 + i); i += 1;);
        memset(sl + bs, 0, bs);
        fft_real(sl, 2*bs);
        budget -= bs;
        bd_c += 1; bd_c >= nchir ? ( bd_c = 0; bd_q += 1; );
      );
    ) : (
      j = 0;
      loop(64,
        FIRC0[j] = shp(0, 63 - j);
        FIRC1[j] = shp(nchir > 1 ? 1 : 0, 63 - j);
        j += 1;
      );
      j = 0; loop(4, lv = LVT + j*64; lv[27] = lv[29]; j += 1;);
      building = 0; ready = 1;
    );
  );
);


// ---- filtres ------------------------------------------------------------------------
function setc(c, b0, b1, b2, a0, a1, a2) ( c[0] = b0/a0; c[1] = b1/a0; c[2] = b2/a0; c[3] = a1/a0; c[4] = a2/a0; );
function rbjf(ty, f, q, db, fs) local(A, w, cs, sn, al, sq)
(
  f = min(max(f, 5), 0.45*fs);
  A = pow(10, db/40); w = 2*$pi*f/fs; cs = cos(w); sn = sin(w);
  al = sn/(2*q); sq = 2*sqrt(A)*al;
  ty == 0 ? (
    qb0 = (1 - cs)/2; qb1 = 1 - cs; qb2 = (1 - cs)/2; qa0 = 1 + al; qa1 = -2*cs; qa2 = 1 - al;
  ) : ty == 1 ? (
    qb0 = (1 + cs)/2; qb1 = -(1 + cs); qb2 = (1 + cs)/2; qa0 = 1 + al; qa1 = -2*cs; qa2 = 1 - al;
  ) : ty == 2 ? (
    qb0 = 1 + al*A; qb1 = -2*cs; qb2 = 1 - al*A; qa0 = 1 + al/A; qa1 = -2*cs; qa2 = 1 - al/A;
  ) : ty == 3 ? (
    qb0 = A*((A + 1) - (A - 1)*cs + sq); qb1 = 2*A*((A - 1) - (A + 1)*cs); qb2 = A*((A + 1) - (A - 1)*cs - sq);
    qa0 = (A + 1) + (A - 1)*cs + sq; qa1 = -2*((A - 1) + (A + 1)*cs); qa2 = (A + 1) + (A - 1)*cs - sq;
  ) : (
    qb0 = A*((A + 1) + (A - 1)*cs + sq); qb1 = -2*A*((A - 1) + (A + 1)*cs); qb2 = A*((A + 1) + (A - 1)*cs - sq);
    qa0 = (A + 1) - (A - 1)*cs + sq; qa1 = 2*((A - 1) - (A + 1)*cs); qa2 = (A + 1) - (A - 1)*cs - sq;
  );
);
function rbj_set(c, ty, f, q, db, fs) ( rbjf(ty, f, q, db, fs); setc(c, qb0, qb1, qb2, qa0, qa1, qa2); );
function bq_mag(c, f) local(w, c1, s1, c2, s2, nr, ni, dr, di)
(
  w = 2*$pi*f/srate;
  c1 = cos(w); s1 = sin(w); c2 = cos(2*w); s2 = sin(2*w);
  nr = c[0] + c[1]*c1 + c[2]*c2; ni = -(c[1]*s1 + c[2]*s2);
  dr = 1 + c[3]*c1 + c[4]*c2;    di = -(c[3]*s1 + c[4]*s2);
  sqrt((nr*nr + ni*ni)/max(dr*dr + di*di, EPS));
);
// biquad DF2T (coefficients c[0..4], états st[0..1])
function bq1(x, c, st) local(y)
(
  y = c[0]*x + st[0];
  st[0] = c[1]*x - c[3]*y + st[1];
  st[1] = c[2]*x - c[4]*y;
  y;
);
function tnh(v) local(e)
(
  v = min(max(v, -20), 20);
  e = exp(2*v);
  (e - 1)/(e + 1);
);

// ---- baffles d'usine : réponse d'un baffle + micro, calculée à la fréquence du projet ------------
// hp f/Q, résonance, creux, présence, cassure du cône, creux haut, LPF 1, LPF 2, réflexion (ms, gain)
function cab_def(i)
(
  i == 0 ? ( cd_hf = 75; cd_hq = 1.0; cd_rf = 110; cd_rg = 3; cd_rq = 1.2; cd_df = 400; cd_dg = -3; cd_dq = 0.8;
             cd_pf = 2500; cd_pg = 4; cd_pq = 1.0; cd_bf = 4200; cd_bg = 3; cd_bq = 4; cd_nf = 6500; cd_ng = -6; cd_nq = 3;
             cd_l1 = 6000; cd_l2 = 7500; cd_ms = 0.8; cd_mg = -0.35; ) :
  i == 1 ? ( cd_hf = 70; cd_hq = 1.0; cd_rf = 100; cd_rg = 3; cd_rq = 1.2; cd_df = 500; cd_dg = -4; cd_dq = 0.8;
             cd_pf = 2200; cd_pg = 4; cd_pq = 1.0; cd_bf = 3800; cd_bg = 3; cd_bq = 4; cd_nf = 5500; cd_ng = -6; cd_nq = 3;
             cd_l1 = 5500; cd_l2 = 7000; cd_ms = 1.0; cd_mg = -0.30; ) :
  i == 2 ? ( cd_hf = 80; cd_hq = 1.0; cd_rf = 120; cd_rg = 2; cd_rq = 1.2; cd_df = 600; cd_dg = -2; cd_dq = 0.8;
             cd_pf = 2000; cd_pg = 5; cd_pq = 1.0; cd_bf = 3500; cd_bg = 4; cd_bq = 4; cd_nf = 5000; cd_ng = -5; cd_nq = 3;
             cd_l1 = 5000; cd_l2 = 6500; cd_ms = 0.7; cd_mg = -0.30; ) :
  i == 3 ? ( cd_hf = 70; cd_hq = 1.4; cd_rf = 100; cd_rg = 5; cd_rq = 1.5; cd_df = 450; cd_dg = -4; cd_dq = 0.8;
             cd_pf = 2000; cd_pg = 5; cd_pq = 1.2; cd_bf = 3500; cd_bg = 4; cd_bq = 3; cd_nf = 4800; cd_ng = -7; cd_nq = 3;
             cd_l1 = 4500; cd_l2 = 6000; cd_ms = 0; cd_mg = 0; ) :
  i == 4 ? ( cd_hf = 75; cd_hq = 1.3; cd_rf = 110; cd_rg = 4; cd_rq = 1.4; cd_df = 600; cd_dg = -5; cd_dq = 0.7;
             cd_pf = 2800; cd_pg = 6; cd_pq = 1.0; cd_bf = 4200; cd_bg = 3; cd_bq = 3; cd_nf = 6000; cd_ng = -6; cd_nq = 3;
             cd_l1 = 5500; cd_l2 = 7000; cd_ms = 0; cd_mg = 0; ) :
  i == 5 ? ( cd_hf = 40; cd_hq = 1.0; cd_rf = 70; cd_rg = 3; cd_rq = 1.2; cd_df = 500; cd_dg = -3; cd_dq = 0.8;
             cd_pf = 1500; cd_pg = 2; cd_pq = 1.0; cd_bf = 2500; cd_bg = 2; cd_bq = 3; cd_nf = 3500; cd_ng = -6; cd_nq = 3;
             cd_l1 = 3500; cd_l2 = 5000; cd_ms = 0; cd_mg = 0; ) :
           ( cd_hf = 45; cd_hq = 1.2; cd_rf = 80; cd_rg = 4; cd_rq = 1.3; cd_df = 400; cd_dg = -2; cd_dq = 0.8;
             cd_pf = 1800; cd_pg = 3; cd_pq = 1.0; cd_bf = 3000; cd_bg = 3; cd_bq = 3; cd_nf = 4200; cd_ng = -5; cd_nq = 3;
             cd_l1 = 4500; cd_l2 = 6000; cd_ms = 0; cd_mg = 0; );
);
// filtre en place sur IRB0[0..n)
function ir_filt(n) local(i, s0, s1, y, x)
(
  s0 = 0; s1 = 0; i = 0;
  loop(n,
    x = IRB0[i];
    y = C_TMP[0]*x + s0;
    s0 = C_TMP[1]*x - C_TMP[3]*y + s1;
    s1 = C_TMP[2]*x - C_TMP[4]*y;
    IRB0[i] = y;
    i += 1;
  );
);
function cab_gen(ci) local(n, d, k, sd, r1, r2, f, g)
(
  cab_def(ci);
  n = min(ceil(4096*srate/48000), IRMAX);
  memset(IRB0, 0, n); IRB0[0] = 1;
  cd_ms > 0 ? ( d = floor(cd_ms*0.001*srate + 0.5); IRB0[d] += cd_mg; );
  rbj_set(C_TMP, 1, cd_hf, cd_hq, 0, srate); ir_filt(n);
  rbj_set(C_TMP, 2, cd_rf, cd_rq, cd_rg, srate); ir_filt(n);
  rbj_set(C_TMP, 2, cd_df, cd_dq, cd_dg, srate); ir_filt(n);
  rbj_set(C_TMP, 2, cd_pf, cd_pq, cd_pg, srate); ir_filt(n);
  rbj_set(C_TMP, 2, cd_bf, cd_bq, cd_bg, srate); ir_filt(n);
  rbj_set(C_TMP, 2, cd_nf, cd_nq, cd_ng, srate); ir_filt(n);
  // irrégularités du cône : 6 bandes étroites pseudo-aléatoires (Park-Miller, graine = n° de baffle)
  sd = 1 + ci*7919; k = 0;
  loop(6,
    sd = sd*16807 - floor(sd*16807/2147483647)*2147483647; r1 = sd/2147483647;
    sd = sd*16807 - floor(sd*16807/2147483647)*2147483647; r2 = sd/2147483647;
    f = 1200*pow(6, (k + r1)/6); g = (r2*2 - 1)*4.5;
    rbj_set(C_TMP, 2, f, 6, g, srate); ir_filt(n);
    k += 1;
  );
  rbj_set(C_TMP, 0, cd_l1, 0.8, 0, srate); ir_filt(n);
  rbj_set(C_TMP, 0, cd_l2, 1.1, 0, srate); ir_filt(n);
  rs_len = n; nchir = 1; f_nch = 1; f_sr = srate; capped = 0;
);
function cab_name(i)
(
  i == 0 ? strcpy(#cn, "1x12 OPEN") : i == 1 ? strcpy(#cn, "2x12 OPEN") : i == 2 ? strcpy(#cn, "4x10 OPEN") :
  i == 3 ? strcpy(#cn, "4x12 VINTAGE") : i == 4 ? strcpy(#cn, "4x12 MODERN") : i == 5 ? strcpy(#cn, "1x15 BASS") :
  i == 6 ? strcpy(#cn, "8x10 BASS") : strcpy(#cn, "USER IR");
  #cn;
);



// ---- chargement d'un modèle (fichier RMNAM converti par IR Buddy) ---------------------------
// en-tête : 4242, version, nombre de sous-modèles ; puis par sous-modèle : C, nombre de poids, loudness,
// input dBu, output dBu, fréquence, 0, 0, poids
function nam_read() local(h, nch, sr, n, k, off)
(
  nam_err = 0; nam_nsub = 0; nam_cab = 0;
  h = file_open(#nampath);
  h < 0 ? ( nam_err = 1; ) : (
    nch = 0; sr = 0; file_riff(h, nch, sr);
    n = file_avail(h);
    (nch != 1 || n < 24 || n > NRAWN) ? ( nam_err = 2; ) : (
      file_mem(h, NRAW, n);
      (NRAW[0] != 4242 || NRAW[1] != 1) ? ( nam_err = 2; ) : (
        nam_cab = NRAW[3] >= 0.5;   // 1 = capture avec baffle (full rig / amp + cab)
        nam_nsub = min(NRAW[2], 8); off = 16; k = 0;
        while (k < nam_nsub && nam_err == 0) (
          NS_C[k] = NRAW[off]; NS_N[k] = NRAW[off + 1]; NS_LD[k] = NRAW[off + 2]; NS_IN[k] = NRAW[off + 3];
          NS_SR[k] = NRAW[off + 5]; NS_OFF[k] = off + 8;
          (NS_C[k] != 3 && NS_C[k] != 8) ? nam_err = 3;
          off += 8 + NS_N[k];
          off > n ? nam_err = 2;
          k += 1;
        );
      );
    );
    file_close(h);
  );
  nam_err > 0 ? nam_nsub = 0;
  nam_has3 = 0; nam_has8 = 0; k = 0;
  loop(nam_nsub, NS_C[k] == 3 ? ( nam_has3 = 1; ) : ( nam_has8 = 1; ); k += 1;);
);
// met en place le sous-modèle voulu (Lite = 3 canaux, Full = 8) et lance le préchauffage
function nam_setup() local(k, want, pick)
(
  nam_ok = 0;
  nam_nsub > 0 ? (
    want = slider9 >= 0.5 ? 8 : 3;
    (want == 8 && !nam_has8) ? want = 3; (want == 3 && !nam_has3) ? want = 8;
    pick = 0; k = 0; loop(nam_nsub, NS_C[k] == want ? pick = k; k += 1;);
    nam_C = NS_C[pick]; nam_ld = NS_LD[pick]; nam_indbu = NS_IN[pick]; nam_sr = NS_SR[pick];
    nam_layout(NRAW + NS_OFF[pick], nam_C);
    nam_C == 3 ? nam_bind3() : nam_bind8();
    nam_size_cur = slider9 >= 0.5;
    // préchauffage : le modèle tourne sur du silence le temps de son champ réceptif (sortie coupée)
    nam_warm = 6347; amp_fade = 0;
    nam_ok = 1; nam_gen += 1;
  );
);

// ---- index des navigateurs (REAPER/Data/RMIRIndex, écrit par IR Buddy) ----------------------
// ligne D<tab>dossier ; ligne F<tab>n° dossier<tab>nom<tab>chemin relatif<tab>chemin absolu
// dossier 0 virtuel : amplis d'usine (kind 0) ou baffles intégrés (kind 1), chemin = -1 - n°
function ix_put(a, b) local(i, n, o)
(
  n = b - a;
  (n <= 0 || ix_pp + n > IX_PEND) ? -1 : (
    o = ix_pp; i = 0;
    loop(n, o[i] = str_getchar(#ixl, a + i, 'cu'); i += 1;);
    ix_pp += n; o;
  );
);
function ix_tab(p, L) local(i, r)
(
  r = L; i = p;
  while (i < L && r == L) ( str_getchar(#ixl, i, 'cu') == 9 ? r = i; i += 1; );
  r;
);
function ix_virt(str) local(L)
(
  strcpy(#ixl, str); L = strlen(#ixl);
  IX_FI[ix_nf] = 0; IX_NO[ix_nf] = ix_put(0, L); IX_NL[ix_nf] = L;
  IX_RO[ix_nf] = -1; IX_RL[ix_nf] = 0; IX_PO[ix_nf] = -1 - ix_nf; IX_PL[ix_nf] = 0;
  IX_DN[0] += 1; ix_nf += 1;
);
function ix_read(kind) local(h, L, c, t1, t2, t3, fd, i, k)
(
  ix_ok = 0; ix_nf = 0; ix_nd = 0; ix_pp = IX_POOL; ix_kind = kind;
  // dossier virtuel
  kind == 0 ? strcpy(#ixl, "FACTORY") : strcpy(#ixl, "BUILT-IN");
  L = strlen(#ixl); IX_DO[0] = ix_put(0, L); IX_DL[0] = L; IX_DN[0] = 0; IX_DF[0] = 0; ix_nd = 1;
  // pas d'entrée virtuelle : le dossier 0 est masqué (amplis et baffles = fichiers seulement)

  h = kind == 0 ? file_open(slider16) : file_open(slider17);
  h >= 0 ? (
    file_text(h);
    file_string(h, #ixl);
    (kind == 0 ? !strncmp(#ixl, "RMAMPINDEX", 10) : !strncmp(#ixl, "RMIRINDEX", 9)) ? (
      ix_ok = 1; ix_nr = 0;
      while (file_avail(h) > 0) (
        strcpy(#ixl, "");
        file_string(h, #ixl);
        L = strlen(#ixl);
        while (L > 0 && str_getchar(#ixl, L - 1, 'cu') < 32) ( L -= 1; );
        c = L > 2 ? str_getchar(#ixl, 0, 'cu') : 0;
        c == 'D' ? (
          // baffles : seulement RM IR/Cab et ses sous-dossiers
          strcpy_substr(#ixd, #ixl, 2, L - 2);
          (ix_nd < IX_MAXD && (kind == 0 || stricmp(#ixd, "Cab") == 0 || strnicmp(#ixd, "Cab/", 4) == 0 || strnicmp(#ixd, "Cab\\", 4) == 0)) ? (
            IX_DO[ix_nd] = ix_put(2, L); IX_DL[ix_nd] = L - 2; IX_DN[ix_nd] = 0; IX_DF[ix_nd] = -1;
            ix_nr < 1000 ? IX_MAP[ix_nr] = ix_nd;
            ix_nd += 1;
          ) : ( ix_nr < 1000 ? IX_MAP[ix_nr] = -1; );
          ix_nr += 1;
        ) : (c == 'F' && ix_nf < IX_MAXF) ? (
          t1 = ix_tab(2, L); t2 = ix_tab(t1 + 1, L); t3 = ix_tab(t2 + 1, L);
          t3 < L ? (
            fd = 0; i = 2; loop(t1 - 2, fd = fd*10 + str_getchar(#ixl, i, 'cu') - '0'; i += 1;);
            fd = (fd >= 0 && fd < min(ix_nr, 1000)) ? IX_MAP[fd] : -1;
            (fd >= 1 && fd < ix_nd) ? (
              IX_FI[ix_nf] = fd;
              IX_NO[ix_nf] = ix_put(t1 + 1, t2); IX_NL[ix_nf] = t2 - t1 - 1;
              IX_RO[ix_nf] = ix_put(t2 + 1, t3); IX_RL[ix_nf] = t3 - t2 - 1;
              IX_PO[ix_nf] = ix_put(t3 + 1, L);  IX_PL[ix_nf] = L - t3 - 1;
              IX_PO[ix_nf] >= 0 ? (
                IX_DF[fd] < 0 ? IX_DF[fd] = ix_nf;
                IX_DN[fd] += 1; ix_nf += 1;
              );
            );
          );
        );
      );
    );
    file_close(h);
  );
);
// texte d'une entrée du pool -> #ixs
function ix_str(off, n) local(i)
(
  strcpy(#ixs, "");
  off >= 0 ? ( i = 0; loop(n, sprintf(#ixc, "%c", off[i]); strcat(#ixs, #ixc); i += 1;); );
  #ixs;
);
// entrée correspondant à la sélection actuelle (-1 si aucune)
function ix_match() local(i, r, b)
(
  r = -1; i = 0;
  ix_kind == 0 ? (
    strlen(#nampath) > 0 ? (
      while (i < ix_nf && r < 0) ( IX_PO[i] >= 0 ? ( ix_str(IX_PO[i], IX_PL[i]); strcmp(#ixs, #nampath) == 0 ? r = i; ); i += 1; );
    );
  ) : (
    b = floor(slider11 + 0.5);
    b < 7 ? ( r = b; ) : (
      ir_src == 1 ? (
        while (i < ix_nf && r < 0) ( IX_PO[i] >= 0 ? ( ix_str(IX_PO[i], IX_PL[i]); strcmp(#ixs, #irpath) == 0 ? r = i; ); i += 1; );
      ) : (
        while (i < ix_nf && r < 0) ( IX_RO[i] >= 0 ? ( ix_str(IX_RO[i], IX_RL[i]); stricmp(#ixs, #irname) == 0 ? r = i; ); i += 1; );
      );
    );
  );
  r;
);
// charge l'entrée i de l'index courant
function ix_load(i) local(b)
(
  (i >= 0 && i < ix_nf) ? (
    IX_PO[i] < 0 ? (
      b = -1 - IX_PO[i];
      ix_kind == 1 ? cab_pick = b;
    ) : (
      ix_kind == 0 ? ( ix_str(IX_PO[i], IX_PL[i]); strcpy(#nampath, #ixs); ix_str(IX_NO[i], IX_NL[i]); strcpy(#namname, #ixs); amp_pick = 1; ) :
                     ( ix_str(IX_PO[i], IX_PL[i]); strcpy(#irpath, #ixs); ir_src = 1; cab_pick = 7; cab_force = 1; );
    );
    ix_cur = i;
  );
);


// ---- chargement de l'IR (machine à états répartie sur plusieurs @block) ---------------------
// 1 ouverture, 2 lecture, 3 rééchantillonnage, 4 analyse + construction, 10 baffle d'usine
function basename() local(i, n, c, p)
(
  n = strlen(#irpath); p = 0; i = 0;
  loop(n, c = str_getchar(#irpath, i); (c == '/' || c == '\\') ? p = i + 1; i += 1;);
  strcpy_substr(#irname, #irpath, p);
);
function load_step() local(n, k, k1, t, acc, u, ui, c, nn, bud, y, e, pk, i, last, v)
(
  ld_st == 10 ? (
    cab_gen(ld_cab); ld_err = 0; ld_st = 4;
  ) :
  ld_st == 1 ? (
    ld_err = 0; capped = 0;
    ir_src == 1 ? ( fh = file_open(#irpath); basename(); ) : ( fh = file_open(slider14); strcpy_fromslider(#irname, slider14);
      (!strncmp(#irname, "RM IR/", 6) || !strncmp(#irname, "RM IR\\", 6)) ? str_delsub(#irname, 0, 6); );
    fh < 0 ? (
      ld_err = (ir_src == 0 && (strlen(#irname) == 0 || stricmp(#irname, "none") == 0)) ? 4 : 1; ld_st = 0;
    ) : (
      f_nch = 0; f_sr = 0;
      file_riff(fh, f_nch, f_sr);
      (f_nch < 1 || f_sr < 1) ? ( file_close(fh); ld_err = 2; ld_st = 0; ) : (
        f_nfr = floor(file_avail(fh)/f_nch);
        n = min(floor(RAWN/f_nch), ceil(f_sr));
        capped = f_nfr > n; f_nfr = min(f_nfr, n);
        f_nfr < 1 ? ( file_close(fh); ld_err = 3; ld_st = 0; ) : (
          rd_n = 0; rd_tot = f_nfr*f_nch; ld_st = 2;
        );
      );
    );
  ) :
  ld_st == 2 ? (
    n = min(262144, rd_tot - rd_n);
    k = file_mem(fh, RAW + rd_n, n);
    rd_n += n;
    (k < n || rd_n >= rd_tot) ? (
      k < n ? ( f_nfr = floor((rd_n - n + k)/f_nch); );
      file_close(fh);
      nchir = min(f_nch, 2);
      rs_r = f_sr/srate; rs_fc = min(1, srate/f_sr); rs_hw = SN_Z/rs_fc;
      rs_same = abs(f_sr - srate) < 0.5;
      rs_len = min(floor(f_nfr/rs_r), LMAXS);
      rs_n = 0; rs_c = 0; ld_st = 3;
    );
  ) :
  ld_st == 3 ? (
    bud = 65536;
    while (bud > 0 && ld_st == 3) (
      c = rs_c; y = c ? IRB1 : IRB0;
      rs_same ? (
        nn = min(rs_len - rs_n, 16384);
        i = 0; loop(nn, y[rs_n + i] = RAW[(rs_n + i)*f_nch + c]; i += 1;);
        rs_n += nn; bud -= nn;
      ) : (
        t = rs_n*rs_r;
        k = max(ceil(t - rs_hw), 0); k1 = min(floor(t + rs_hw), f_nfr - 1);
        acc = 0;
        loop(k1 - k + 1,
          u = abs(t - k)*rs_fc*SN_OS; ui = floor(u);
          acc += RAW[k*f_nch + c]*(SNC[ui] + (SNC[ui + 1] - SNC[ui])*(u - ui));
          k += 1;
        );
        y[rs_n] = acc*rs_fc;
        rs_n += 1; bud -= 2*rs_hw + 4;
      );
      rs_n >= rs_len ? ( rs_n = 0; rs_c += 1; rs_c >= nchir ? ld_st = 4; );
    );
  ) :
  ld_st == 4 ? (
    // énergie, crête, coupe du silence final (-80 dB sous la crête), normalisation en énergie
    e = 0; pk = 0; i = 0;
    loop(rs_len,
      v = IRB0[i]; e += v*v; pk = max(pk, abs(v));
      nchir > 1 ? ( v = IRB1[i]; e += v*v; pk = max(pk, abs(v)); );
      i += 1;
    );
    last = 0; i = rs_len - 1;
    while (i > 0 && last == 0) (
      v = max(abs(IRB0[i]), nchir > 1 ? abs(IRB1[i]) : 0);
      v > pk*0.0001 ? last = i;
      i -= 1;
    );
    Lir = max(64, last + 1);
    gnorm = pk > 0 ? 0.70795/sqrt(max(e/nchir, EPS)) : 0;
    ir_dur = Lir/srate; ir_fsr = f_sr; ir_nch = f_nch; ir_user = ld_cab > 6;
    loaded = 1; ld_st = 0; ld_gen += 1;
    layout(); build_start();
  );
);


// ---- paramètres -----------------------------------------------------------------------
function update_params() local(g)
(
  amp_on = slider1 >= 0.5;
  g = db2lin(slider2);
  (slider8 > 0.25 && nam_ok && nam_indbu > -900) ? g *= db2lin(slider8 - nam_indbu);
  in_t = g;
  norm_t = (nam_ok && nam_ld > -900) ? db2lin(-24 - nam_ld) : 1;
  rbj_set(C_EQ, 3, 120, 0.7, slider3, srate);
  rbj_set(C_EQ + 5, 2, 750, 0.8, slider4, srate);
  rbj_set(C_EQ + 10, 4, 2800, 0.7, slider5, srate);
  rbj_set(C_EQ + 15, 2, 5500, 0.9, slider6, srate);
  eq_on = abs(slider3) + abs(slider4) + abs(slider5) + abs(slider6) > 0.01;
  // micro (étagère 2 kHz : centre brillant, bord sombre) et sortie
  cab_on = slider10 >= 0.5;
  rbj_set(C_MIC, 4, 2000, 0.7, 3 - 12*slider12/100, srate);
  out_t = db2lin(slider7);
);

sm_a = 1 - exp(-1/(0.02*srate));
fade_a = 1/(0.03*srate);
dc_a = exp(-2*$pi*8/srate);
pk_dg = 0.86;
need_load = 1; ld_st = 0; loaded = 0; ready = 0; building = 0; lay_on = 0; sl16_seen = 0;
nam_ok = 0; nam_nsub = 0; need_amp = 0; ix_cur = -1; ix_kind = -1; br_on = 0;
amp_pick = -1; cab_pick = -1; amp_user = 0; cab_auto = 0;
update_params();
in_s = in_t; norm_s = norm_t; out_s = out_t;

@serialize
ser_src = ir_src; strcpy(#ser_old, #irpath); strcpy(#ser_nold, #nampath);
file_var(0, ir_src);
file_string(0, #irpath);
file_string(0, #nampath);
file_string(0, #namname);
file_avail(0) >= 0 ? (
  (ir_src != ser_src || strcmp(#ser_old, #irpath) != 0) ? ( floor(slider11 + 0.5) == 7 ? need_load = 1; );
  (strcmp(#ser_nold, #nampath) != 0 || !nam_ok) ? need_amp = strlen(#nampath) > 0;
);

@slider
update_params();

@block
// modèle NAM : chargement (navigateur / projet) ou changement de taille Lite / Full
// nouvelle instance (rien de sauvegardé) : modèle par défaut « Hot Plexi Head » s'il est indexé
!def_done ? (
  def_done = 1;
  (strlen(#nampath) == 0 && !br_on) ? (
    ix_read(0); i_d = 0; f_d = -1;
    while (i_d < ix_nf && f_d < 0) (
      IX_PO[i_d] >= 0 ? ( ix_str(IX_NO[i_d], IX_NL[i_d]); stricmp(#ixs, "Hot Plexi Head") == 0 ? f_d = i_d; );
      i_d += 1;
    );
    f_d >= 0 ? (
      ix_str(IX_PO[f_d], IX_PL[f_d]); strcpy(#nampath, #ixs); ix_str(IX_NO[f_d], IX_NL[f_d]); strcpy(#namname, #ixs);
      ix_cur = f_d; need_amp = 1; amp_user = 1;
    );
  );
);
need_amp ? (
  need_amp = 0; nam_read(); nam_setup();
  // modèle choisi par l'utilisateur : capture « full rig » (baffle compris) -> CAB coupé ; retour à un ampli seul -> CAB rallumé
  (amp_user && nam_nsub > 0) ? (
    nam_cab ? ( slider10 >= 0.5 ? ( slider10 = 0; slider_automate(512); cab_auto = 1; ); ) : (
      (cab_auto && slider10 < 0.5) ? ( slider10 = 1; slider_automate(512); );
      cab_auto = 0;
    );
  );
  amp_user = 0;
  update_params();
);
(nam_ok && (slider9 >= 0.5) != nam_size_cur) ? ( nam_setup(); update_params(); );
update_params();
// liste du dossier REAPER/Data/RM IR/Cab : un fichier choisi passe en USER IR
slider14 != sl16_last ? (
  sl16_seen ? ( ir_src = 0; slider11 = 7; sliderchange(slider11); need_load = 1; );
  sl16_last = slider14;
);
sl16_seen = 1;
// baffles intégrés retirés (0.15) : un ancien projet réglé sur un baffle intégré passe sur le fichier IR
slider11 < 6.5 ? ( slider11 = 7; sliderchange(slider11); need_load = 1; );
cab_sel = 7;
cab_sel != cab_cur ? ( cab_cur = cab_sel; need_load = 1; );
need_load ? (
  need_load = 0; ld_cab = cab_sel;
  ld_cab < 7 ? ( ld_st = 10; ) : (
    ((ir_src == 1 && strlen(#irpath) > 0) || ir_src == 0) ? ( ld_st = 1; ) : ( ld_st = 0; );
  );
);
ld_st > 0 ? load_step();
ld_st == 4 ? load_step();
building ? build_step(65536);
// USER IR choisie mais introuvable : pas de baffle
usr_miss = cab_sel == 7 && ld_err > 0 && !(loaded && ir_user);
pdc_delay = 0;

@sample
xi = 0.5*(spl0 + spl1);
pin0 = max(pin0, abs(xi));
in_s += (in_t - in_s)*sm_a; norm_s += (norm_t - norm_s)*sm_a; out_s += (out_t - out_s)*sm_a;

// ---- ampli NAM (AMP éteint ou pas de modèle : le signal va directement au baffle) ----
(amp_on && nam_ok) ? (
  nam_warm > 0 ? (
    nam_C == 3 ? nam_run3(0) : nam_run8(0);
    nam_warm -= 1; ya_ = 0;
  ) : (
    ya_ = nam_C == 3 ? nam_run3(xi*in_s) : nam_run8(xi*in_s);
    amp_fade < 1 ? ( amp_fade = min(1, amp_fade + fade_a); ya_ *= amp_fade; );
  );
  ya_ *= norm_s;
  eq_on ? ( ya_ = bq1(ya_, C_EQ, FS + 40); ya_ = bq1(ya_, C_EQ + 5, FS + 42); ya_ = bq1(ya_, C_EQ + 10, FS + 44); ya_ = bq1(ya_, C_EQ + 15, FS + 46); );
  // bloqueur de continu (8 Hz)
  dcy_ = dc_a*(dcy_ + ya_ - dcx_); dcx_ = ya_; ya_ = dcy_;
  !(ya_ == ya_) ? ( ya_ = 0; nam_setup(); );
) : ( ya_ = xi; );


// ---- baffle (convolution, zéro latence) ----
(cab_on && !usr_miss) ? (
  w0 = 0; w1 = 0;
  (lay_on && ready) ? (
    fwp = (fwp + 1) & 63;
    FHB[fwp] = ya_; FHB[fwp + 64] = ya_;
    fp_ = FHB + fwp + 1; fq_ = FIRC0; fa_ = 0; loop(64, fa_ += fp_[0]*fq_[0]; fp_ += 1; fq_ += 1;); w0 = fa_;
    nchir > 1 ? ( fp_ = FHB + fwp + 1; fq_ = FIRC1; fa_ = 0; loop(64, fa_ += fp_[0]*fq_[0]; fp_ += 1; fq_ += 1;); w1 = fa_; );
    LVT[26] ? lev_sample(LVT, ya_);
    LVT[64 + 26] ? lev_sample(LVT + 64, ya_);
    LVT[128 + 26] ? lev_sample(LVT + 128, ya_);
    LVT[192 + 26] ? lev_sample(LVT + 192, ya_);
    nchir < 2 ? w1 = w0;
  );
  w0 = bq1(w0, C_MIC, FS + 30); w1 = bq1(w1, C_MIC, FS + 32);
) : ( w0 = ya_; w1 = ya_; );

// sortie + écrêteur caché à 0 dBFS
spl0 = min(max(w0*out_s, -1), 1);
spl1 = min(max(w1*out_s, -1), 1);
pout0 = max(pout0, abs(spl0)); pout1 = max(pout1, abs(spl1));


@gfx 1060 470
// thème : orange ou vert (double-clic sur le nom du plug-in), mémorisé dans slider15
slider15 >= 0.5 ? (
  thc0r = 0.424; thc0g = 0.851; thc0b = 0.78;
  thc1r = 0.6; thc1g = 0.92; thc1b = 0.86;
  thc2r = 0.55; thc2g = 0.9; thc2b = 0.83;
  thc5r = 0.02; thc5g = 0.1; thc5b = 0.09;
) : (
  thc0r = 1.0; thc0g = 0.58; thc0b = 0.12;
  thc1r = 1.0; thc1g = 0.7; thc1b = 0.35;
  thc2r = 1.0; thc2g = 0.7; thc2b = 0.2;
  thc5r = 0.1; thc5g = 0.06; thc5b = 0.02;
);
function PX(x) ( ox + x*S; );
function PY(y) ( oy + y*S; );
function col(r,g,b) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = 1; );
function rct(x,y,w,h,f) ( gfx_rect(PX(x), PY(y), ceil(w*S), ceil(h*S), f); );
function ln(x1,y1,x2,y2) ( gfx_line(PX(x1), PY(y1), PX(x2), PY(y2), 1); );
function text_c(x,y,str) local(w,h) ( gfx_measurestr(str,w,h); gfx_x = PX(x) - w*0.5; gfx_y = PY(y) - h*0.5; gfx_drawstr(str); );
function text_l(x,y,str) local(w,h) ( gfx_measurestr(str,w,h); gfx_x = PX(x); gfx_y = PY(y) - h*0.5; gfx_drawstr(str); );
function text_r(x,y,str) local(w,h) ( gfx_measurestr(str,w,h); gfx_x = PX(x) - w; gfx_y = PY(y) - h*0.5; gfx_drawstr(str); );
function knob_pt(cx,cy,rad,frac) local(an)
(
  an = (225 - 270*frac)*$pi/180;
  kx = cx + rad*cos(an);
  ky = cy - rad*sin(an);
);
function arc(cx,cy,r,f1,f2,th) local(i, a1, a2)
(
  a1 = (-135 + 270*min(f1,f2))*$pi/180;
  a2 = (-135 + 270*max(f1,f2))*$pi/180;
  i = 0;
  loop(max(1, ceil(th*S)), gfx_arc(PX(cx), PY(cy), r*S + i, a1, a2, 1); i += 1;);
);
function draw_knob(cx,cy,r,frac,fz) local(i, x1, y1, t)
(
  col(0.07,0.07,0.08); arc(cx, cy, r + 9, 0, 1, 4);
  col(thc0r,thc0g,thc0b); arc(cx, cy, r + 9, fz, frac, 4);
  col(0.03,0.03,0.035); gfx_circle(PX(cx), PY(cy + 3), (r + 2)*S, 1, 1);
  i = 0;
  loop(10,
    t = 0.30 + 0.05*i;
    col(t, t, t + 0.01); gfx_circle(PX(cx), PY(cy), r*(1 - i*0.035)*S, 1, 1);
    i += 1;
  );
  col(0.72,0.73,0.75); gfx_circle(PX(cx), PY(cy), r*0.62*S, 1, 1);
  col(0.80,0.81,0.83); gfx_circle(PX(cx - r*0.1), PY(cy - r*0.12), r*0.45*S, 1, 1);
  col(0.66,0.67,0.69); gfx_circle(PX(cx), PY(cy), r*0.62*S, 0, 1);
  col(0.06,0.06,0.07);
  knob_pt(cx, cy, r*0.66, frac); x1 = kx; y1 = ky;
  knob_pt(cx, cy, r*0.95, frac);
  t = 0; loop(max(2, ceil(3*S)), gfx_line(PX(x1)+t-1, PY(y1), PX(kx)+t-1, PY(ky), 1); t += 1;);
);
function draw_btn(x,y,w,h,on,str)
(
  on ? col(thc0r,thc0g,thc0b) : col(0.16,0.165,0.18);
  rct(x,y,w,h,1);
  col(0.03,0.03,0.035); rct(x,y,w,h,0);
  on ? col(thc5r,thc5g,thc5b) : col(0.72,0.73,0.76);
  text_c(x + w*0.5, y + h*0.5, str);
);
function in_rect(x,y,w,h) ( mx >= x && mx < x+w && my >= y && my < y+h; );
function in_circ(cx,cy,r) ( sqr(mx - cx) + sqr(my - cy) <= r*r; );
function set_sl(idx, v) ( v != slider(idx) ? ( slider(idx) = v; slider_automate(2^(idx-1)); ); );

// ---- Table des potards : 1 INPUT, 2 BASS, 3 MID, 4 TREBLE, 5 PRESENCE, 6 LEVEL, 7 MIC, 8 IN CAL
function k_sl(i) ( i == 1 ? 2 : i == 2 ? 3 : i == 3 ? 4 : i == 4 ? 5 : i == 5 ? 6 : i == 6 ? 7 : i == 7 ? 12 : 8; );
function k_lo(i) ( i == 1 ? -24 : i <= 5 ? -12 : i == 6 ? -24 : 0; );
function k_hi(i) ( i == 1 ? 24 : i <= 5 ? 12 : i == 6 ? 12 : i == 7 ? 100 : 30; );
function k_df(i) ( i == 7 ? 25 : 0; );
function k_st(i) ( i == 7 ? 1 : i == 8 ? 0.5 : 0.1; );
function k_cx(i) ( i == 1 ? 110 : i == 2 ? 262 : i == 3 ? 374 : i == 4 ? 486 : i == 5 ? 598 : i == 6 ? 860 : i == 7 ? 566 : 872; );
function k_cy(i) ( (i == 7 || i == 8) ? 362 : 200; );
function k_r(i) ( i == 8 ? 24 : (i == 1 || i == 6) ? 30 : 26; );
function k_vy(i) ( (i == 7 || i == 8) ? 408 : 252; );
function k_vw(i) ( 80; );
function k_frac(i) local(v, lo, hi)
(
  v = slider(k_sl(i)); lo = k_lo(i); hi = k_hi(i);
  min(max((v - lo)/(hi - lo), 0), 1);
);
function k_put(i, v) local(lo, hi, st)
(
  lo = k_lo(i); hi = k_hi(i); st = k_st(i);
  v = min(max(v, lo), hi);
  v = floor(v/st + 0.5)*st;
  set_sl(k_sl(i), min(max(v, lo), hi));
);
function k_set_frac(i, f) local(lo, hi)
(
  f = min(max(f, 0), 1); lo = k_lo(i); hi = k_hi(i);
  k_put(i, lo + (hi - lo)*f);
);
function k_hit() local(i, r)
(
  r = 0; i = 1;
  loop(8, (r == 0 && in_circ(k_cx(i), k_cy(i), k_r(i) + 8)) ? r = i; i += 1;);
  r;
);
function v_hit() local(i, r)
(
  r = 0; i = 1;
  loop(8, (r == 0 && in_rect(k_cx(i) - k_vw(i)/2, k_vy(i) - 10, k_vw(i), 20)) ? r = i; i += 1;);
  r;
);
function k_str(i) local(v)
(
  v = slider(k_sl(i));
  i == 7 ? ( v < 0.5 ? strcpy(#ks, "CENTER") : v > 99.5 ? strcpy(#ks, "EDGE") : sprintf(#ks, "%d %%", v); ) :
  i == 8 ? ( v < 0.25 ? strcpy(#ks, "OFF") : sprintf(#ks, "%+.1f dBu", v); ) :
  sprintf(#ks, "%+.1f dB", v);
);
function pk_y(d, y, h) ( y + h*(1 - (min(max(d, -60), 3) + 60)/63); );
function pk_bar(x, y, w, h, d) local(ii, n, yy, lit, dd)
(
  col(0.03,0.03,0.035); rct(x - 2, y - 2, w + 4, h + 4, 1);
  n = 60; ii = 0;
  loop(n,
    dd = -60 + 63*(ii + 1)/n;
    lit = d >= dd - 63/n;
    lit ? ( dd > 0.01 ? col(1.00,0.22,0.18) : dd > -6 ? col(thc2r,thc2g,thc2b) : col(0.35,0.90,0.45); )
        : col(0.10,0.11,0.12);
    yy = y + h - (ii + 1)*h/n;
    rct(x, yy + 1, w, h/n - 1, 1);
    ii += 1;
  );
);
// réponse en fréquence du baffle chargé (DFT des 8192 premiers échantillons, 88 points de 20 Hz à 20 kHz)
function cab_resp() local(j, f, w, cw, sw, cr, ci, t, re, im, n, v, mx_)
(
  n = min(Lir, 8192); mx_ = -200; j = 0;
  loop(NRESP,
    f = 20*pow(1000, j/(NRESP - 1));
    w = 2*$pi*min(f, 0.49*srate)/srate; cw = cos(w); sw = sin(w);
    cr = 1; ci = 0; re = 0; im = 0; t = 0;
    loop(n,
      v = IRB0[t];
      re += v*cr; im -= v*ci;
      v = cr*cw - ci*sw; ci = ci*cw + cr*sw; cr = v;
      t += 1;
    );
    RESP[j] = lin2db(sqrt(re*re + im*im)*gnorm);
    mx_ = max(mx_, RESP[j]);
    j += 1;
  );
  resp_max = mx_;
);

// ---- navigateur ampli / baffle -----------------------------------------------------------
// amplis : le dossier 0 (virtuel) est masqué, ix_d0 = premier dossier affiché
function br_open(kind)
(
  ix_read(kind); ix_cur = ix_match(); br_kind = kind; br_on = 1;
  ix_d0 = 1;
  br_fold = ix_cur >= 0 ? IX_FI[ix_cur] : min(ix_d0, ix_nd - 1);
  br_sd = max(ix_d0, min(br_fold - 7, ix_nd - BR_N));
  br_sf = ix_cur >= 0 ? max(0, min(ix_cur - IX_DF[br_fold] - 7, IX_DN[br_fold] - BR_N)) : 0;
);
function br_step(kind, dir) local(d, k)
(
  ix_kind != kind ? ix_read(kind);
  ix_cur = ix_match();
  ix_cur < 0 ? ( ix_nf > 0 ? ix_load(kind == 0 ? 0 : 3); ) : (
    d = IX_FI[ix_cur]; k = ix_cur - IX_DF[d] + dir;
    k < 0 ? k = IX_DN[d] - 1 : k >= IX_DN[d] ? k = 0;
    ix_load(IX_DF[d] + k);
  );
  (br_on && ix_cur >= 0) ? ( br_fold = IX_FI[ix_cur]; );
);

// ---- saisie clavier (standard ReNo Mellow) ----------------------------------------
function kbx_pnum() local(i, n, c, v, frac, dv)
(
  n = strlen(#kbx_ed); i = 0; v = 0; frac = 0; dv = 1;
  kbx_ok = 0; kbx_neg = 0; kbx_kilo = 0; kbx_off = 0;
  loop(n,
    c = str_getchar(#kbx_ed, i);
    (c >= 'A' && c <= 'Z') ? c += 32;
    c == '-' ? kbx_neg = 1;
    c == 'k' ? kbx_kilo = 1;
    c == 'o' ? kbx_off = 1;
    (c == '.' || c == ',') ? frac = 1;
    (c >= '0' && c <= '9') ? (
      kbx_ok = 1;
      frac ? ( dv *= 10; v += (c - '0')/dv; ) : ( v = v*10 + (c - '0'); );
    );
    i += 1;
  );
  kbx_kilo ? v *= 1000;
  kbx_neg ? -v : v;
);
function kbx_apply(i) local(v)
(
  v = kbx_pnum();
  (kbx_off && !kbx_ok && i == 8) ? k_put(8, 0);
  kbx_ok ? k_put(i, v);
);


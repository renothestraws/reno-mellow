PNM[21] = "PITCH CHANGE A";  defp(21,1,21,"PITCH",0); defp(21,2,22,"FINE",0); defp(21,3,9,"DELAY",0.1); defp(21,4,15,"F.B GAIN",0); defp(21,5,23,"BASE KEY",25);
PNM[22] = "PITCH CHANGE B";  defp(22,1,21,"1 PITCH",0); defp(22,2,22,"1 FINE",8); defp(22,3,9,"1 DLY",0.1); defp(22,4,21,"2 PITCH",0); defp(22,5,22,"2 FINE",-8); defp(22,6,9,"2 DLY",20);

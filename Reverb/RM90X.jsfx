desc:RM90X - ReNo Mellow 90X (Digital Multi-Effect Processor)
//tags: multi-effect reverb early-reflections delay echo flanger chorus phaser tremolo symphonic pitch freeze gate compressor pan eq SPX90 vintage digital
//@author ReNo Mellow
//@version 1.3
//@changelog Double-clic sur le numéro de mémoire = saisie au clavier du programme (1 à 90) ; potard WET/DRY global (100 % wet par défaut) ; réverbes recalées sur les IR : grave plus plein (bosse 40-100 Hz, coupure raide sous 35 Hz), coupure d'aigu raide vers 12,5-14 kHz et images de conversion très basses, amortissement de l'aigu corrigé (Hall, Room, Vocal, Plate)
//@about Multi-effet numérique inspiré de la Yamaha SPX90II : les 30 programmes d'usine (4 réverbes, early reflections, gate reverb, reverse gate, delay, echo, flanger, chorus, phasing, tremolo, symphonic, ADR noise gate, compressor, reverb & gate, 4 pitch change, 2 freeze, pan, triggered pan, delay vibrato, EQ paramétrique), mémoires utilisateur 31 à 90 avec titres, face avant opérationnelle (LCD 2 x 16, PARAMETER, BALANCE, STORE, RECALL, UTILITY, BYPASS), MIDI (notes et program change). Traitement interne à 31,25 kHz / 16 bits comme l'original, sans latence ; réverbes calées sur des réponses impulsionnelles de l'appareil.
//
// ---------------------------------------------------------------------------
// RM90X - multi-effet numérique inspiré de la Yamaha SPX90II
//
// CONVERSION (comme l'appareil : une seule entrée, sortie stéréo)
//   - L'entrée stéréo est sommée en mono (la SPX90II n'a qu'un convertisseur A/N).
//   - Filtre anti-repliement Butterworth d'ordre 12 à 13,8 kHz, puis
//     échantillonnage à 31,25 kHz, quantification 16 bits (écrêtage à 0 dBFS).
//   - Tout le traitement tourne à 31,25 kHz, quelle que soit la fréquence du projet.
//   - Sortie : bloqueur d'ordre zéro (images au-dessus de 15,6 kHz, comme le
//     vrai convertisseur), passe-bas de reconstruction 17 kHz et compensation
//     du sin(x)/x (+5 dB à 12,3 kHz), puis filtre elliptique d'ordre 5 (bord
//     12,4 kHz) : réponse calée sur les IR, -12 dB à 12,5 kHz, -45 dB à 14 kHz,
//     images de conversion sous -45 dB.
//   - Aucune latence : l'échantillonnage à 31,25 kHz se fait au fil de l'eau.
//
// RÉVERBES (REV 1-4, REVERB & GATE)
//   FDN 8 lignes (matrice de Hadamard) précédée de diffuseurs passe-tout.
//   Analyse des 46 IR de la SPX90II : l'amortissement de l'aigu est FIXE en
//   dB/s pour chaque programme (indépendant du temps réglé) ; le RT60 grave
//   suit le réglage. Pertes mesurées à 8 kHz (au-delà de 60/RT) :
//   Hall 72 dB/s, Room 41 dB/s, Vocal 32 dB/s, Plate 56 dB/s. HIGH décale
//   cet amortissement autour de sa valeur d'usine (HIGH d'usine = son des IR).
//   Corrélation L/R de la queue et premières réflexions relevées sur les IR.
//   Couleur commune des réverbes relevée sur les IR : bosse de +5 à +8 dB entre
//   40 et 100 Hz, coupure raide sous 35 Hz, léger creux large au-dessus de 2 kHz.
//
// EARLY REFLECTIONS (EARLY REF 1-2, GATE REVERB, REVERSE GATE)
//   Motif HALL relevé sur l'IR ER-6 (59 réflexions à gauche, 50 à droite),
//   ER 1 = basse densité (une réflexion sur trois), ER 2 = haute densité.
//   RANDOM / REVERSE / PLATE et ROOM SIZE d'après les abaques du manuel.
//
// AUTRES PROGRAMMES : paramètres, plages et valeurs d'usine du manuel.
//   Choix personnels là où le manuel est muet : voix et délais internes du
//   chorus, du tremolo et du symphonic, fenêtre des pitch shifters (A 30 ms,
//   B/C 25 ms, D 60 ms = plus doux sur les graves), seuils de déclenchement
//   (100 % = 0 dBFS, 1 % = -59 dBFS), L/R BALANCE du triggered pan = niveau
//   du côté opposé pendant le balayage.
//
// FACE AVANT
//   PARAMETER : paramètre suivant. BALANCE : BALANCE puis OUT LVL.
//   DEC / INC : valeur (maintenir = répétition, accélère après 1,5 s).
//   Double-clic sur le numéro : saisie au clavier (1 à 90), Entrée = rappel, Échap = annuler.
//   MEMORY v / ^ : choisir une mémoire (le numéro clignote), RECALL pour la
//   charger, STORE pour enregistrer (31 à 90 seulement ; 1 à 30 = usine).
//   UTILITY : EDIT TITLE (taper au clavier, INC/DEC = caractère), MIDI CH,
//   PGM CHANGE. TRIGGER = pédale (déclenchements, freeze manuel).
//   Sur le LCD : glisser verticalement ou molette = valeur, Shift = fin,
//   Ctrl + clic = valeur d'usine. Bouton INPUT : glisser, Ctrl + clic = 0 dB.
//   Bouton WET/DRY (global, après OUT LVL) : 100 % = traité seul ; Ctrl + clic = 100 %.
//
// OPTIONS
//   Character : Modern = son direct propre (hors convertisseur) ; Vintage =
//               le direct passe aussi par le convertisseur 31,25 kHz / 16 bits,
//               comme sur l'appareil (BALANCE est calculée dans le DSP).
//   Dry       : en Modern, direct stéréo ou mono.
//   Size      : 75 / 100 / 125 / 150 % de l'interface.
//   Hard-clip permanent à 0 dBFS en sortie (convertisseur N/A).
// ---------------------------------------------------------------------------

slider1:1<1,30,1{REV 1 HALL,REV 2 ROOM,REV 3 VOCAL,REV 4 PLATE,EARLY REF. 1,EARLY REF. 2,DELAY L-R,STEREO ECHO,STEREO FLANGE A,STEREO FLANGE B,CHORUS A,CHORUS B,STEREO PHASING,TREMOLO,SYMPHONIC,GATE REVERB,REVERSE GATE,ADR-NOISE GATE,COMPRESSOR,REVERB & GATE,PITCH CHANGE A,PITCH CHANGE B,PITCH CHANGE C,PITCH CHANGE D,FREEZE A,FREEZE B,PAN,TRIGGERED PAN,DELAY VIBRATO,PARAMETRIC EQ}>-Program
slider2:0<0,1,0.0001>-Param 1 (normalized)
slider3:0<0,1,0.0001>-Param 2 (normalized)
slider4:0<0,1,0.0001>-Param 3 (normalized)
slider5:0<0,1,0.0001>-Param 4 (normalized)
slider6:0<0,1,0.0001>-Param 5 (normalized)
slider7:0<0,1,0.0001>-Param 6 (normalized)
slider8:0<0,1,0.0001>-Param 7 (normalized)
slider9:0<0,1,0.0001>-Param 8 (normalized)
slider10:0<0,1,0.0001>-Param 9 (normalized)
slider11:100<0,100,1>-Balance (%)
slider12:100<0,100,1>-Out Level (%)
slider13:0<-24,12,0.1>-Input (dB)
slider14:0<0,1,1{Off,On}>-Bypass
slider15:0<0,1,1{Modern,Vintage}>-Character
slider16:0<0,1,1{Stereo,Mono}>-Dry (Modern)
slider17:1<0,3,1{75%,100%,125%,150%}>-Size
slider18:0<0,1,1{Orange,Green}>-Theme (double-click the plug-in name)
slider19:100<0,100,1>-Wet/Dry (%)

in_pin:Left In
in_pin:Right In
out_pin:Left Out
out_pin:Right Out

@init
ext_noinit = 1;

// ---- Constantes et carte mémoire ---------------------------------------------
FS  = 31250;                // fréquence interne (Hz)
MA  = 131071;               // masque du tampon d'entrée (4,19 s)
MB  = 65535;                // masque des tampons de 2,1 s
FZN = 62500;                // 2000 ms de freeze à 31,25 kHz

BUFA = 0;       // historique mono de l'entrée (131072)
BUFL = 131072;  // ligne gauche (65536)
BUFR = 196608;  // ligne droite (65536)
FDN  = 262144;  // 8 lignes de réverbe x 4096
APB  = 294912;  // 6 diffuseurs x 2048
FZB  = 307200;  // mémoire du freeze (65536)
PBUF = 372736;  // pitch avec réinjection (65536)

T_RT  = 440000; T_HPF = 440200; T_LPF = 440250; T_MID = 440300; T_HI = 440350;
T_T5  = 440400; T_T1  = 440950;
PK = 441500; PL = 441900; PD = 442300; PN = 442700; PNM = 442740; ROMBAL = 442780;
BHLT = 443000; BHLG = 443100; BHRT = 443200; BHRG = 443300;
ERSL = 443400; ERGL = 443500; ERSR = 443600; ERGR = 443700;
RLEN = 443800; RAP = 443840; RAPN = 443870; RAPG = 443875; RE8 = 443880; RH0 = 443885;
RCOR = 443890; RTG = 443895; RTK = 443900;
RELT = 443910; RELG = 443950; RERT = 443990; RERG = 444030; RELN = 444070; RERN = 444075;
LM = 444100; LG = 444110; LA = 444120; LP = 444130; APM = 444140;
VAL = 444200;
UB = 445000; CURT = 447000; TMPT = 447020;

// ---- Outils ---------------------------------------------------------------
function db2lin(d) ( exp(d*0.11512925464970228); );
function q16(v) ( v = min(max(v, -1), 0.999969482421875); floor(v*32768 + 0.5)/32768; );

function parse_list(dst, sp) local(n, i, len, c, v, sc, innum)
(
  n = 0; i = 0; v = 0; sc = 0; innum = 0; len = strlen(sp);
  loop(len + 1,
    c = i < len ? str_getchar(sp, i) : 44;
    (c >= 48 && c <= 57) ? (
      v = v*10 + (c - 48); sc > 0 ? (sc *= 10); innum = 1;
    ) : c == 46 ? (
      sc = 1;
    ) : c == 44 ? (
      innum ? ( dst[n] = sc > 0 ? v/sc : v; n += 1; );
      v = 0; sc = 0; innum = 0;
    );
    i += 1;
  );
  n;
);

function rnd() ( seed = (seed*16807) % 2147483647; seed/2147483647; );

// lecture interpolée dans un tampon circulaire (d en échantillons 31,25 kHz)
function rdi(buf, mask, d) local(p, i, f)
(
  p = w - d; i = floor(p); f = p - i;
  buf[i & mask]*(1 - f) + buf[(i + 1) & mask]*f;
);

// ---- Filtres ----------------------------------------------------------------
function bq_lp(f, q, fs) instance(b0, b1, b2, a1, a2) local(w0, c, al, a0)
(
  w0 = 2*$pi*f/fs; c = cos(w0); al = sin(w0)/(2*q); a0 = 1 + al;
  b0 = (1 - c)*0.5/a0; b1 = (1 - c)/a0; b2 = b0; a1 = -2*c/a0; a2 = (1 - al)/a0;
);
function bq_peak(f, g, q, fs) instance(b0, b1, b2, a1, a2) local(w0, c, al, a0, aa)
(
  aa = pow(10, g/40); w0 = 2*$pi*f/fs; c = cos(w0); al = sin(w0)/(2*q); a0 = 1 + al/aa;
  b0 = (1 + al*aa)/a0; b1 = -2*c/a0; b2 = (1 - al*aa)/a0; a1 = -2*c/a0; a2 = (1 - al/aa)/a0;
);
function bq_hp(f, q, fs) instance(b0, b1, b2, a1, a2) local(w0, c, al, a0)
(
  w0 = 2*$pi*f/fs; c = cos(w0); al = sin(w0)/(2*q); a0 = 1 + al;
  b0 = (1 + c)*0.5/a0; b1 = -(1 + c)/a0; b2 = b0; a1 = -2*c/a0; a2 = (1 - al)/a0;
);
// section analogique normalisée (fréquence de coupure 1) transposée par transformée bilinéaire, prédéformée à fp
function bq_an(nb2, nb1, nb0, na2, na1, na0, fp, fs) instance(b0, b1, b2, a1, a2) local(c, c2, a0)
(
  c = 1/tan($pi*fp/fs); c2 = c*c;
  a0 = na2*c2 + na1*c + na0;
  b0 = (nb2*c2 + nb1*c + nb0)/a0; b1 = 2*(nb0 - nb2*c2)/a0; b2 = (nb2*c2 - nb1*c + nb0)/a0;
  a1 = 2*(na0 - na2*c2)/a0; a2 = (na2*c2 - na1*c + na0)/a0;
);
function bq_run(v) instance(b0, b1, b2, a1, a2, z1, z2) local(y)
(
  y = b0*v + z1; z1 = b1*v - a1*y + z2; z2 = b2*v - a2*y; y;
);
function bq_clr() instance(z1, z2) ( z1 = z2 = 0; );
function hp1_set(f, fs) instance(c) ( c = exp(-2*$pi*f/fs); );
function hp1_run(v) instance(c, xp, y) ( y = c*(y + v - xp); xp = v; y; );
function hp1_clr() instance(xp, y) ( xp = y = 0; );

// ---- Couleur des réverbes relevée sur les IR (domaine 31,25 kHz) -----------------
// Écart moyen IR / modèle sur Hall, Room, Vocal et Plate : bosse de +5 à +8 dB entre
// 40 et 100 Hz avec chute raide sous 35 Hz (deux passe-haut résonants à 45 Hz),
// léger creux large au-dessus de 2 kHz et forte atténuation vers 12,5-14 kHz.
rc_h1l.bq_hp(45, 1.4, FS); rc_h2l.bq_hp(45, 1.4, FS); rc_h1r.bq_hp(45, 1.4, FS); rc_h2r.bq_hp(45, 1.4, FS);
rc_p1l.bq_peak(3967, -3.18, 0.3, FS); rc_p1r.bq_peak(3967, -3.18, 0.3, FS);
rc_p2l.bq_peak(14017, -13.96, 0.5, FS); rc_p2r.bq_peak(14017, -13.96, 0.5, FS);
function rcol_l(v) ( rc_p2l.bq_run(rc_p1l.bq_run(rc_h2l.bq_run(rc_h1l.bq_run(v)))); );
function rcol_r(v) ( rc_p2r.bq_run(rc_p1r.bq_run(rc_h2r.bq_run(rc_h1r.bq_run(v)))); );

// ---- Tables de valeurs --------------------------------------------------------
i_ = 0; loop(98, T_RT[i_] = 0.3 + 0.1*i_; i_ += 1;);
loop(89, T_RT[i_] = 11 + (i_ - 98); i_ += 1;);
parse_list(T_HPF, "0,32,36,40,45,50,56,63,71,80,90,100,110,125,140,160,180,200,225,250,280,315,355,400,450,500,560,630,710,800,900,1000");
parse_list(T_LPF, "1000,1100,1200,1400,1600,1800,2000,2200,2500,2800,3200,3600,4000,4500,5000,5600,6300,7000,8000,9000,10000,11000,0");
parse_list(T_MID, "315,355,400,450,500,560,630,710,800,900,1000,1100,1250,1400,1600,1800,2000,2200,2500,2800,3200,3600,4000");
parse_list(T_HI,  "800,900,1000,1100,1250,1400,1600,1800,2000,2200,2500,2800,3200,3600,4000,4500,5000,5600,6300,7100,8000");
i_ = 0;
loop(95,  T_T5[i_] = 5 + i_;                 T_T1[i_] = 1 + i_;          i_ += 1;);
loop(4,                                       T_T1[i_] = 1 + i_;          i_ += 1;);
// T_T5 : 5..99 (95) puis 100..995 pas de 5 ; T_T1 : 1..99 (99) puis idem
i5 = 95; i1 = 99;
loop(180, T_T5[i5] = 100 + 5*(i5 - 95);  T_T1[i1] = 100 + 5*(i1 - 99);  i5 += 1; i1 += 1;);
loop(180, T_T5[i5] = 1000 + 50*(i5 - 275); T_T1[i1] = 1000 + 50*(i1 - 279); i5 += 1; i1 += 1;);
loop(45,  T_T5[i5] = 10000 + 500*(i5 - 455); i5 += 1;);
loop(41,  T_T1[i1] = 10000 + 500*(i1 - 459); i1 += 1;);

// ---- Types de paramètres ------------------------------------------------------
//  1 REV TIME  2 HIGH  3 0.1-1000ms  4 HPF  5 LPF  6 ER TYPE  7 ROOM SIZE  8 LIVENESS
//  9 0.1-1800ms  10 0.1-2000ms  11 F.B -99..99%  12 0.1-40Hz  13 0-100%  14 0.1-100ms
// 15 F.B 0-99%  16 0.1-8ms  17 TRG 1-100  18 -100..100ms  19 5-32000ms  20 1-30000ms
// 21 PITCH  22 FINE  23 BASE KEY  24 0.1-900ms  25 REC MODE  26 -2000..2000ms  27 action
// 28 0-2000.0  29 OFF/ON  30 10-2000ms  31 DIR 3  32 DIR 2  33 0.1-20Hz  34 MID FRQ
// 35 -15..15dB  36 Q  37 HI FRQ
function pcount(k)
(
  k == 1 ? 187 : k == 2 ? 10 : k == 3 ? 10000 : k == 4 ? 32 : k == 5 ? 23 : k == 6 ? 4 :
  k == 7 ? 200 : k == 8 ? 11 : k == 9 ? 18000 : k == 10 ? 20000 : k == 11 ? 199 : k == 12 ? 400 :
  k == 13 ? 101 : k == 14 ? 1000 : k == 15 ? 100 : k == 16 ? 80 : k == 17 ? 100 : k == 18 ? 201 :
  k == 19 ? 500 : k == 20 ? 500 : k == 21 ? 25 : k == 22 ? 201 : k == 23 ? 62 : k == 24 ? 9000 :
  k == 25 ? 2 : k == 26 ? 4001 : k == 27 ? 1 : k == 28 ? 20001 : k == 29 ? 2 : k == 30 ? 1991 :
  k == 31 ? 3 : k == 32 ? 2 : k == 33 ? 200 : k == 34 ? 23 : k == 35 ? 31 : k == 36 ? 46 :
  k == 37 ? 21 : 1;
);
function pval(k, i)
(
  k == 1 ? T_RT[i] :
  (k == 2 || k == 3 || k == 7 || k == 9 || k == 10 || k == 12 || k == 14 || k == 16 || k == 24 || k == 33) ? 0.1*(i + 1) :
  k == 4 ? T_HPF[i] : k == 5 ? T_LPF[i] :
  k == 11 ? i - 99 : k == 17 ? i + 1 : k == 18 ? i - 100 :
  k == 19 ? T_T5[i] : k == 20 ? T_T1[i] :
  k == 21 ? i - 12 : k == 22 ? i - 100 : k == 26 ? i - 2000 :
  k == 28 ? 0.1*i : k == 30 ? i + 10 :
  k == 34 ? T_MID[i] : k == 35 ? i - 15 : k == 36 ? 0.5 + 0.1*i : k == 37 ? T_HI[i] :
  i;
);
function idx_of(k, v) local(n, i, best, bd, dd)
(
  n = pcount(k);
  (k == 1 || k == 4 || k == 5 || k == 19 || k == 20 || k == 34 || k == 37) ? (
    best = 0; bd = 1000000000000; i = 0;
    loop(n, dd = abs(pval(k, i) - v); dd < bd ? (bd = dd; best = i;); i += 1;);
  ) : (
    best = (k == 2 || k == 3 || k == 7 || k == 9 || k == 10 || k == 12 || k == 14 || k == 16 || k == 24 || k == 33) ? floor(v*10 + 0.5) - 1 :
           k == 11 ? v + 99 : k == 17 ? v - 1 : k == 18 ? v + 100 : k == 21 ? v + 12 :
           k == 22 ? v + 100 : k == 26 ? v + 2000 : k == 28 ? floor(v*10 + 0.5) : k == 30 ? v - 10 :
           k == 35 ? v + 15 : k == 36 ? floor((v - 0.5)*10 + 0.5) : v;
  );
  min(max(floor(best + 0.5), 0), n - 1);
);

function note_name(n) local(pc, oc, nm)
(
  pc = n % 12; oc = floor(n/12) - 2;
  nm = pc == 0 ? "C" : pc == 1 ? "C#" : pc == 2 ? "D" : pc == 3 ? "D#" : pc == 4 ? "E" : pc == 5 ? "F" :
       pc == 6 ? "F#" : pc == 7 ? "G" : pc == 8 ? "G#" : pc == 9 ? "A" : pc == 10 ? "A#" : "B";
  sprintf(#fv, "%s%d", nm, oc);
);
function khz(v) local(fr)
(
  fr = v/1000;
  abs(fr*10 - floor(fr*10 + 0.5)) < 0.001 ? sprintf(#fv, "%.1fkHz", fr) : sprintf(#fv, "%.2fkHz", fr);
);
function fmt(k, i) local(v)
(
  v = pval(k, i);
  k == 1 ? ( v < 10 ? sprintf(#fv, "%.1fs", v) : sprintf(#fv, "%.0fs", v); ) :
  (k == 2 || k == 7 || k == 36) ? sprintf(#fv, "%.1f", v) :
  (k == 3 || k == 9 || k == 10 || k == 14 || k == 16 || k == 24) ? sprintf(#fv, "%.1fms", v) :
  k == 4 ? ( v == 0 ? strcpy(#fv, "THRU") : v < 1000 ? sprintf(#fv, "%dHz", v) : khz(v); ) :
  k == 5 ? ( v == 0 ? strcpy(#fv, "THRU") : khz(v); ) :
  k == 6 ? ( v == 0 ? strcpy(#fv, "HALL") : v == 1 ? strcpy(#fv, "RANDOM") : v == 2 ? strcpy(#fv, "REVERSE") : strcpy(#fv, "PLATE"); ) :
  (k == 8 || k == 17 || k == 21 || k == 22) ? sprintf(#fv, "%d", v) :
  (k == 11 || k == 13 || k == 15) ? sprintf(#fv, "%d%%", v) :
  (k == 12 || k == 33) ? sprintf(#fv, "%.1fHz", v) :
  (k == 18 || k == 19 || k == 20 || k == 26 || k == 30) ? sprintf(#fv, "%dms", v) :
  k == 23 ? ( v == 0 ? strcpy(#fv, "OFF") : note_name(35 + v); ) :
  k == 25 ? ( v == 0 ? strcpy(#fv, "MANUAL") : strcpy(#fv, "AUTO"); ) :
  k == 28 ? sprintf(#fv, "%.1f", v) :
  k == 29 ? ( v == 0 ? strcpy(#fv, "OFF") : strcpy(#fv, "ON"); ) :
  k == 31 ? ( v == 0 ? strcpy(#fv, "L->R") : v == 1 ? strcpy(#fv, "L<-R") : strcpy(#fv, "L<->R"); ) :
  k == 32 ? ( v == 0 ? strcpy(#fv, "L->R") : strcpy(#fv, "L<-R"); ) :
  (k == 34 || k == 37) ? ( v < 1000 ? sprintf(#fv, "%dHz", v) : khz(v); ) :
  k == 35 ? sprintf(#fv, "%+ddB", v) :
  strcpy(#fv, "");
);

// ---- Les 30 programmes d'usine (manuel, page 25) --------------------------------
function defp(t, j, k, lab, dv) ( PK[t*10 + j] = k; PL[t*10 + j] = lab; PD[t*10 + j] = dv; PN[t] = max(PN[t], j); );
memset(PN, 0, 31);
i_ = 1; loop(30, ROMBAL[i_] = 100; i_ += 1;);
PNM[1]  = "REV 1 HALL";      defp(1,1,1,"REV TIME",2.6); defp(1,2,2,"HIGH",0.6); defp(1,3,3,"DELAY",30); defp(1,4,4,"HPF",0); defp(1,5,5,"LPF",8000);
PNM[2]  = "REV 2 ROOM";      defp(2,1,1,"REV TIME",1.5); defp(2,2,2,"HIGH",0.7); defp(2,3,3,"DELAY",20); defp(2,4,4,"HPF",0); defp(2,5,5,"LPF",8000);
PNM[3]  = "REV 3 VOCAL";     defp(3,1,1,"REV TIME",2.4); defp(3,2,2,"HIGH",0.5); defp(3,3,3,"DELAY",45); defp(3,4,4,"HPF",80); defp(3,5,5,"LPF",8000);
PNM[4]  = "REV 4 PLATE";     defp(4,1,1,"REV TIME",1.8); defp(4,2,2,"HIGH",0.7); defp(4,3,3,"DELAY",10); defp(4,4,4,"HPF",40); defp(4,5,5,"LPF",10000);
PNM[5]  = "EARLY REF. 1";    defp(5,1,6,"TYPE",0); defp(5,2,7,"ROOM SIZE",2.0); defp(5,3,8,"LIVENESS",5); defp(5,4,9,"DELAY",10); defp(5,5,5,"LPF",0);
PNM[6]  = "EARLY REF. 2";    defp(6,1,6,"TYPE",0); defp(6,2,7,"ROOM SIZE",2.0); defp(6,3,8,"LIVENESS",5); defp(6,4,9,"DELAY",10); defp(6,5,5,"LPF",0);
PNM[7]  = "DELAY L,R";       defp(7,1,10,"Lch DLY",100); defp(7,2,11,"Lch F.B",0); defp(7,3,10,"Rch DLY",200); defp(7,4,11,"Rch F.B",0); defp(7,5,2,"HIGH",1.0);

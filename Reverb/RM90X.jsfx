// ---- Réverbes : données relevées sur les IR -------------------------------------
// 0 = Hall, 1 = Room, 2 = Vocal, 3 = Plate
parse_list(RLEN,      "29.7,37.1,41.1,43.7,47.9,53.3,59.3,67.1");
parse_list(RLEN + 8,  "19.1,23.3,27.1,29.9,31.7,35.3,39.1,43.9");
parse_list(RLEN + 16, "22.1,25.7,29.3,33.1,36.7,39.7,44.3,49.1");
parse_list(RLEN + 24, "13.3,16.1,19.7,23.1,26.3,29.9,33.7,37.3");
parse_list(RAP,       "4.7,3.6,12.7,9.3");
parse_list(RAP + 6,   "4.1,3.1,9.7,7.3");
parse_list(RAP + 12,  "4.3,3.3,10.9,8.1");
parse_list(RAP + 18,  "1.9,2.9,4.1,5.3,7.1,9.7");
parse_list(RAPN, "4,4,4,6");
parse_list(RAPG, ".70,.70,.70,.75");
parse_list(RE8,  "72.0,40.9,31.7,56.0");     // pertes HF à 8 kHz (dB/s)
parse_list(RH0,  ".6,.7,.5,.7");             // HIGH des IR (valeurs d'usine)
parse_list(RCOR, ".18,.33,.33,.23");         // corrélation L/R de la queue
parse_list(RTG,  ".47,.61,.58,.46");         // niveau de queue / premières réflexions
parse_list(RTK,  "1.03,1.07,1.0,1.07");      // correction du temps
RELN[0] = parse_list(RELT,      "11.2,16.2,20.3,27.4,36.5");      parse_list(RELG,      "1,.83,.72,.95,.89");
RERN[0] = parse_list(RERT,      "10.3,13.4,20.9,23.6,34.2");      parse_list(RERG,      ".73,.76,.75,.88,.75");
RELN[1] = parse_list(RELT + 8,  "7.4,15.7,37.6,43.3,50.6,59.9");  parse_list(RELG + 8,  ".68,.71,.84,.96,.84,.74");
RERN[1] = parse_list(RERT + 8,  "9.1,13.7,37.6,43.3,50.6,59.9");  parse_list(RERG + 8,  ".72,.62,.79,.75,.72,.72");
RELN[2] = parse_list(RELT + 16, "8.0,10.8,18.7,24.7,54.9,68.6");  parse_list(RELG + 16, ".69,.81,.84,.72,.70,.70");
RERN[2] = parse_list(RERT + 16, "6.9,8.2,15.1,22.8,54.9,68.6");   parse_list(RERG + 16, ".63,.75,.75,.70,.63,.65");
RELN[3] = parse_list(RELT + 24, "5.1");                           parse_list(RELG + 24, "1");
RERN[3] = parse_list(RERT + 24, "6.0");                           parse_list(RERG + 24, "1");

// motif HALL des early reflections (IR ER-6, temps normalisés)
NBL = parse_list(BHLT, ".0454,.0498,.0558,.0589,.0744,.0950,.0988,.1013,.1054,.1300,.1506,.1575,.1610,.1753,.1795,.2247,.2311,.2340,.2520,.2595,.2635,.2764,.2806,.3076,.3259,.3360,.3505,.3572,.3621,.4024,.4061,.4092,.4208,.4386,.4557,.4648,.5009,.5113,.5144,.5194,.5398,.5596,.5669,.5959,.6139,.6164,.6616,.6695,.6970,.7190,.7642,.7711,.8268,.8463,.8763,.9019,.9215,.9515,.9967");
parse_list(BHLG, ".91,.87,.71,.49,.61,.94,.43,.51,.72,.83,.82,.72,.42,.84,.82,1.00,.64,.49,.51,.45,.31,.55,.87,.74,.95,.47,.61,.77,.64,.86,.65,.63,.33,.32,.71,.73,.88,.61,.70,.31,.44,.91,.64,.35,.53,.77,.91,.59,.37,.64,.80,.54,.55,.53,.71,.51,.87,.66,.81");
NBR = parse_list(BHRT, ".0479,.0505,.0773,.0835,.0981,.1022,.1290,.1498,.1612,.1732,.1792,.1821,.2062,.2269,.2341,.2565,.2598,.2751,.2780,.3082,.3228,.3300,.3431,.3551,.3584,.4061,.4390,.4570,.5047,.5090,.5161,.5359,.5567,.5678,.5976,.6131,.6180,.6657,.6935,.7150,.7627,.7706,.7730,.8223,.8501,.8725,.9018,.9202,.9521,.9997");
parse_list(BHRG, ".83,.68,.50,.51,.76,.71,.54,.85,.37,.56,1.00,.50,.33,.76,.44,.58,.31,.70,.49,.67,.83,.45,.40,.54,.68,.90,.42,.72,.81,.69,.50,.35,.81,.54,.36,.44,.68,.79,.34,.66,.70,.41,.35,.47,.40,.64,.48,.68,.58,.71");

// accès aux sliders 2..10 (paramètres normalisés) par numéro
function pget(j) ( j == 1 ? slider2 : j == 2 ? slider3 : j == 3 ? slider4 : j == 4 ? slider5 : j == 5 ? slider6 :
                   j == 6 ? slider7 : j == 7 ? slider8 : j == 8 ? slider9 : j == 9 ? slider10 : 0; );
function pset(j, v) ( j == 1 ? (slider2 = v) : j == 2 ? (slider3 = v) : j == 3 ? (slider4 = v) : j == 4 ? (slider5 = v) :
                      j == 5 ? (slider6 = v) : j == 6 ? (slider7 = v) : j == 7 ? (slider8 = v) : j == 8 ? (slider9 = v) :
                      j == 9 ? (slider10 = v); );

// ---- Programmes, valeurs et mémoires ---------------------------------------------
function cur_idx(j) local(k, n)
(
  k = PK[pt*10 + j]; n = pcount(k);
  n > 1 ? min(max(floor(pget(j)*(n - 1) + 0.5), 0), n - 1) : 0;
);
function norm_def(t, j) local(k, n)
(
  k = PK[t*10 + j]; n = pcount(k);
  n > 1 ? idx_of(k, PD[t*10 + j])/(n - 1) : 0;
);
function str_to_chars(dst, sp) local(i, n)
(
  i = 0; n = strlen(sp);
  loop(16, dst[i] = i < n ? str_getchar(sp, i) : 32; i += 1;);
);
function load_defaults(t) local(j)
(
  j = 1;
  loop(9, pset(j, j <= PN[t] ? norm_def(t, j) : 0); j += 1;);
  slider11 = ROMBAL[t]; slider12 = 100;
  str_to_chars(CURT, PNM[t]);
);
function init_bank() local(n, t, sl, j)
(
  n = 31;
  loop(60,
    t = ((n - 31) % 30) + 1; sl = UB + (n - 31)*32;
    sl[0] = t;
    j = 1; loop(9, sl[j] = j <= PN[t] ? norm_def(t, j) : 0; j += 1;);
    sl[10] = ROMBAL[t]; sl[11] = 100;
    str_to_chars(sl + 12, PNM[t]);
    n += 1;
  );
  ub_init = 1;
);

// ---- Remise à zéro du DSP (changement de programme) -------------------------------
function clear_dsp()
(
  memset(0, 0, FZB);            // tampons d'entrée, lignes, réverbe, diffuseurs
  memset(PBUF, 0, 65536);
  memset(LP, 0, 8);
  wfh_l.hp1_clr(); wfh_r.hp1_clr(); wfl_l.bq_clr(); wfl_r.bq_clr();
  rc_h1l.bq_clr(); rc_h2l.bq_clr(); rc_h1r.bq_clr(); rc_h2r.bq_clr(); rc_p1l.bq_clr(); rc_p1r.bq_clr(); rc_p2l.bq_clr(); rc_p2r.bq_clr();
  peq_h1.hp1_clr(); peq_m.bq_clr(); peq_h.bq_clr(); peq_l.bq_clr();
  dlp_l = dlp_r = 0; g_st = 0; g_env = 0; c_st = 0; c_g = 1; rg_env = 0; rg_cnt = 0;
  tp_st = 0; tp_env = 0; vb_cnt = 0; vb_init = 0; t_mask = 0; t_armed = 1;
  fz_state = 0; fz_play = 0; fz_flash = 0;
  pa.ph = 0; p1.ph = 0; p2.ph = 0; pl_.ph = 0; pr_.ph = 0;
);

// ---- Convertisseurs (fréquence du projet) -----------------------------------------
function conv_setup() local(fa)
(
  fa = min(13800, 0.42*srate);
  aa1.bq_lp(fa, 1/(2*sin(1*$pi/24)), srate);
  aa2.bq_lp(fa, 1/(2*sin(3*$pi/24)), srate);
  aa3.bq_lp(fa, 1/(2*sin(5*$pi/24)), srate);
  aa4.bq_lp(fa, 1/(2*sin(7*$pi/24)), srate);
  aa5.bq_lp(fa, 1/(2*sin(9*$pi/24)), srate);
  aa6.bq_lp(fa, 1/(2*sin(11*$pi/24)), srate);
  rcl.bq_lp(min(17000, 0.45*srate), 0.6, srate);
  rcr.bq_lp(min(17000, 0.45*srate), 0.6, srate);
  pkl.bq_peak(min(12300, 0.4*srate), 5, 1.1, srate);
  pkr.bq_peak(min(12300, 0.4*srate), 5, 1.1, srate);
  // filtre de reconstruction elliptique d'ordre 5 (0,1 dB / 28 dB, bord 12,4 kHz) :
  // coupure raide relevée sur les IR (-12 dB à 12,5 kHz, -45 dB à 14 kHz) et images très basses
  fe = min(12400, 0.42*srate);
  el1l.bq_an(0, 0, 0.78697, 0, 1, 0.78697, fe, srate);                el1r.bq_an(0, 0, 0.78697, 0, 1, 0.78697, fe, srate);
  el2l.bq_an(0.91363/2.93437, 0, 0.91363, 1, 0.75568, 0.91363, fe, srate); el2r.bq_an(0.91363/2.93437, 0, 0.91363, 1, 0.75568, 0.91363, fe, srate);
  el3l.bq_an(1.11068/1.50921, 0, 1.11068, 1, 0.14904, 1.11068, fe, srate); el3r.bq_an(1.11068/1.50921, 0, 1.11068, 1, 0.14904, 1.11068, fe, srate);
  cinc = FS/srate; sr_last = srate;
);

// ---- Déclenchement (niveau d'entrée, MIDI, pédale) ------------------------------
function trig_thr(lv) ( db2lin((lv - 100)*0.6); );
function trig_check(thr, msk, midien) local(tg)
(
  tg = 0;
  t_mask > 0 ? (t_mask -= 1);
  lvl_env < thr*0.5 ? (t_armed = 1);
  t_mask <= 0 ? (
    (abs(x) >= thr && t_armed) ? ( tg = 1; t_armed = 0; );
    ((midien && midi_hit) || foot_hit) ? (tg = 1);
    tg ? ( t_mask = msk; trig_led = 1; );
  );
  tg;
);
function wrap12(dd) ( dd > 12 ? ((dd - 1) % 12) + 1 : dd < -12 ? -(((-dd - 1) % 12) + 1) : dd; );

// ---- Pitch shifter : deux têtes de lecture en fondu sin² ---------------------------
function pv_run(buf, mask, base, ratio, win) instance(ph) local(f1, f2, g1)
(
  ph += (1 - ratio)/win; ph -= floor(ph);
  f1 = ph; f2 = ph + 0.5; f2 >= 1 ? (f2 -= 1);
  g1 = sin($pi*f1); g1 *= g1;
  g1*rdi(buf, mask, base + f1*win) + (1 - g1)*rdi(buf, mask, base + f2*win);
);

// =================================================================================
//  RÉGLAGES DES MOTEURS (appelés dans @block pour le programme courant)
// =================================================================================
function rev_setup() local(rt, hi, e8, i, m, q, aa, c8, l8)
(
  rs = pt == 2 ? 1 : pt == 3 ? 2 : pt == 4 ? 3 : 0;
  rt = max(VAL[1], 0.3)*RTK[rs]; hi = VAL[2];
  e8 = max(0, RE8[rs] + 60/rt*(1/hi - 1/RH0[rs]));
  c8 = cos(2*$pi*8000/FS);
  i = 0;
  loop(8,
    m = floor(RLEN[rs*8 + i]*FS/1000 + 0.5); LM[i] = m;
    LG[i] = pow(10, -3*m/(FS*rt));
    l8 = e8*m/FS; q = pow(10, -l8/10);
    q > 0.999999 ? ( LA[i] = 0; ) : (
      aa = 1 - q*c8;
      LA[i] = (aa - sqrt(max(aa*aa - (1 - q)*(1 - q), 0)))/(1 - q);
    );
    i += 1;
  );
  r_nap = RAPN[rs]; r_apg = RAPG[rs];
  i = 0; loop(r_nap, APM[i] = floor(RAP[rs*6 + i]*FS/1000 + 0.5); i += 1;);
  r_pd = max(1, floor(VAL[3]*FS/1000 + 0.5));
  r_nl = RELN[rs]; r_nr = RERN[rs];
  i = 0; loop(r_nl, ERSL[i] = r_pd + floor(RELT[rs*8 + i]*FS/1000 + 0.5); ERGL[i] = 0.5*RELG[rs*8 + i]; i += 1;);
  i = 0; loop(r_nr, ERSR[i] = r_pd + floor(RERT[rs*8 + i]*FS/1000 + 0.5); ERGR[i] = 0.5*RERG[rs*8 + i]; i += 1;);
  r_th = asin(RCOR[rs])*0.5; r_cs = cos(r_th); r_sn = sin(r_th); r_tg = RTG[rs];
  w_hp = VAL[4] > 0; w_hp ? ( wfh_l.hp1_set(VAL[4], FS); wfh_r.hp1_set(VAL[4], FS); );
  w_lp = VAL[5] > 0; w_lp ? ( wfl_l.bq_lp(VAL[5], 0.707, FS); wfl_r.bq_lp(VAL[5], 0.707, FS); );
  pt == 20 ? (
    rg_thr = trig_thr(VAL[6]); rg_hold = floor(VAL[7]*FS/1000); rg_ir = 1/max(1, VAL[8]*FS/1000);
    rg_midi = VAL[9] > 0;
  );
);

function er_build() local(typ, size, liv, span, i, ch, step, cnt, tn, g, db, dh, sum, srt, srg, nsrc, dss, dsg, nrm, dpd)
(
  typ = VAL[1]; size = max(VAL[2], 0.1); liv = VAL[3];
  dpd = max(1, floor(VAL[4]*FS/1000 + 0.5));
  span = typ == 0 ? 70*pow(size, 0.8) : typ == 1 ? 105*pow(size, 0.8) : typ == 2 ? 55*pow(size, 0.8) : 30*pow(size, 0.6);
  dh = 36 - 3.3*liv;
  step = pt == 5 ? 3 : 1;
  ch = 0;
  loop(2,
    srt = ch ? BHRT : BHLT; srg = ch ? BHRG : BHLG; nsrc = ch ? NBR : NBL;
    dss = ch ? ERSR : ERSL; dsg = ch ? ERGR : ERGL;
    seed = ch ? 7919 : 104729;
    cnt = 0; i = 0; sum = 0;
    loop(nsrc,
      (i % step) == 0 ? (
        tn = srt[i]; g = srg[i];
        typ == 0 ? ( db = -dh*tn; ) :
        typ == 1 ? ( tn = 0.05 + 0.95*(cnt + 0.2 + 0.6*rnd())/ceil(nsrc/step); g = 0.75 + 0.25*rnd(); db = -0.5*dh*tn; ) :
        typ == 2 ? ( db = -(12 + 3.6*liv)*(1 - tn); ) :
                   ( tn = 0.4 + 0.6*tn; db = -(6 + 2*(10 - liv))*(1 - tn); );
        dss[cnt] = dpd + floor(tn*span*FS/1000 + 0.5);
        dsg[cnt] = g*pow(10, db/20);
        sum += dsg[cnt]*dsg[cnt];
        cnt += 1;
      );
      i += 1;
    );
    nrm = 0.9/sqrt(max(sum, 0.000000001));
    i = 0; loop(cnt, dsg[i] *= nrm; i += 1;);
    ch ? ( e_nr = cnt; ) : ( e_nl = cnt; );
    ch += 1;
  );
  w_hp = 0;
  w_lp = VAL[5] > 0; w_lp ? ( wfl_l.bq_lp(VAL[5], 0.707, FS); wfl_r.bq_lp(VAL[5], 0.707, FS); );
);

function prog_setup() local(hv, fc)
(
  (pt <= 4 || pt == 20) ? rev_setup() :
  (pt == 5 || pt == 6 || pt == 16 || pt == 17) ? er_build() :
  (pt == 7 || pt == 8) ? (
    d_l = max(1, floor(VAL[1]*FS/1000 + 0.5)); d_fl = VAL[2]/100;
    d_r = max(1, floor(VAL[3]*FS/1000 + 0.5)); d_fr = VAL[4]/100;
    hv = VAL[5]; d_hon = hv < 0.999;
    fc = 400*pow(2, 5*hv); d_hc = exp(-2*$pi*min(fc, 14000)/FS);
  ) :
  (pt == 9 || pt == 10) ? (
    m_inc = VAL[1]/FS; m_dep = VAL[2]/100*4*FS/1000; m_base = VAL[3]*FS/1000; m_fb = VAL[4]/100;
  ) :
  (pt == 11 || pt == 12) ? (
    m_inc = VAL[1]/FS; m_dep = VAL[2]/100*4*FS/1000; m_am = VAL[3]/100;
  ) :
  pt == 13 ? ( m_inc = VAL[1]/FS; m_dep = VAL[2]/100; m_base = VAL[3]*FS/1000; ) :
  pt == 14 ? ( m_inc = VAL[1]/FS; m_dep = VAL[2]/100; ) :
  pt == 15 ? ( m_inc = VAL[1]/FS; m_dep = VAL[2]/100; ) :
  pt == 18 ? (
    g_thr = trig_thr(VAL[1]); g_adly = max(0, -VAL[2])*FS/1000; g_edly = max(0, VAL[2])*FS/1000;
    g_msk = VAL[3]*FS/1000; g_ia = 1/max(1, VAL[4]*FS/1000); g_dl = VAL[6]/100;
    g_id = (1 - g_dl)/max(1, VAL[5]*FS/1000); g_hold = VAL[7]*FS/1000;
    g_ir = max(g_dl, 0.001)/max(1, VAL[8]*FS/1000); g_midi = VAL[9] > 0;
  ) :
  pt == 19 ? (
    c_thr = trig_thr(VAL[1]); c_adly = max(0, -VAL[2])*FS/1000; c_edly = max(0, VAL[2])*FS/1000;
    c_msk = VAL[3]*FS/1000; c_hl = VAL[6]/100;
    c_ia = (1 - c_hl)/max(1, VAL[4]*FS/1000); c_hold = VAL[5]*FS/1000;
    c_ir = (1 - c_hl)/max(1, VAL[7]*FS/1000); c_midi = VAL[8] > 0;
  ) :
  (pt == 21 || pt == 24) ? (
    p_semi = VAL[1];
    (VAL[5] > 0 && midi_valid) ? p_semi = wrap12(midi_note - (35 + VAL[5]));
    p_r1 = pow(2, (p_semi + VAL[2]/100)/12);
    p_d1 = max(1, VAL[3]*FS/1000); p_fb = VAL[4]/100;
    p_win = (pt == 21 ? 30 : 60)*FS/1000;
  ) :
  (pt == 22 || pt == 23) ? (
    p_r1 = pow(2, (VAL[1] + VAL[2]/100)/12); p_d1 = max(1, VAL[3]*FS/1000);
    p_r2 = pow(2, (VAL[4] + VAL[5]/100)/12); p_d2 = max(1, VAL[6]*FS/1000);
    p_win = 25*FS/1000;
  ) :
  pt == 25 ? (
    fz_auto = VAL[1] > 0; fz_tdly = floor(VAL[2]*FS/1000);
    fz_start = min(FZN - 1, floor(VAL[6]*FS/1000)); fz_end = min(FZN, floor(VAL[7]*FS/1000));
    fz_itrg = VAL[8] > 0; fz_msk = VAL[9]*FS/1000;
  ) :
  pt == 26 ? (
    fz_auto = VAL[1] > 0; fz_tdly = floor(VAL[2]*FS/1000);
    p_semi = VAL[6];
    (VAL[8] > 0 && midi_valid) ? p_semi = wrap12(midi_note - (35 + VAL[8]));
    fz_rate = pow(2, (p_semi + VAL[7]/100)/12);
  ) :
  pt == 27 ? ( m_inc = VAL[1]/FS; pn_dir = VAL[2]; m_dep = VAL[3]/100; ) :
  pt == 28 ? (
    tp_thr = trig_thr(VAL[1]); tp_adly = max(0, -VAL[2])*FS/1000; tp_edly = max(0, VAL[2])*FS/1000;
    tp_msk = VAL[3]*FS/1000; tp_a = max(1, VAL[4]*FS/1000); tp_p = max(1, VAL[5]*FS/1000);
    tp_r = max(1, VAL[6]*FS/1000); tp_dir = VAL[7]; tp_bal = VAL[8]/100; tp_midi = VAL[9] > 0;
  ) :
  pt == 29 ? (
    vb_thr = trig_thr(VAL[1]); vb_dly = VAL[2]*FS/1000; vb_dep = VAL[5]/100;
    vb_inc = vb_dep/max(1, VAL[3]*FS/1000); m_inc = VAL[4]/FS; vb_midi = VAL[6] > 0;
    !vb_init ? ( vb_d = vb_dep; vb_init = 1; );
    vb_d = min(vb_d, vb_dep);
  ) :
  pt == 30 ? (
    q_hp = VAL[1] > 0; q_hp ? peq_h1.hp1_set(VAL[1], FS);
    peq_m.bq_peak(VAL[2], VAL[3], VAL[4], FS);
    peq_h.bq_peak(VAL[5], VAL[6], VAL[7], FS);
    q_lp = VAL[8] > 0; q_lp ? peq_l.bq_lp(VAL[8], 0.707, FS);
    q_d = floor(VAL[9]*FS/1000 + 0.5);
  );
);

// =================================================================================
//  MOTEURS (un échantillon à 31,25 kHz)
// =================================================================================
function rev_tick() local(d, k, ab, z, v, y0, y1, y2, y3, y4, y5, y6, y7, l0, l1, l2, l3, l4, l5, l6, l7,
                           a0, a1, a2, a3, a4, a5, a6, a7, b0, b1, b2, b3, b4, b5, b6, b7, wi, ol_, or_, el, er, op)
(
  d = BUFA[(w - r_pd) & MA];
  k = 0;
  loop(r_nap,
    ab = APB + k*2048; z = ab[(w - APM[k]) & 2047];
    v = d + r_apg*z; d = z - r_apg*v; ab[w & 2047] = v;
    k += 1;
  );
  y0 = FDN[(w - LM[0]) & 4095];         y1 = FDN[4096 + ((w - LM[1]) & 4095)];
  y2 = FDN[8192 + ((w - LM[2]) & 4095)];  y3 = FDN[12288 + ((w - LM[3]) & 4095)];
  y4 = FDN[16384 + ((w - LM[4]) & 4095)]; y5 = FDN[20480 + ((w - LM[5]) & 4095)];
  y6 = FDN[24576 + ((w - LM[6]) & 4095)]; y7 = FDN[28672 + ((w - LM[7]) & 4095)];
  l0 = LP[0] = (1 - LA[0])*y0*LG[0] + LA[0]*LP[0];
  l1 = LP[1] = (1 - LA[1])*y1*LG[1] + LA[1]*LP[1];
  l2 = LP[2] = (1 - LA[2])*y2*LG[2] + LA[2]*LP[2];
  l3 = LP[3] = (1 - LA[3])*y3*LG[3] + LA[3]*LP[3];
  l4 = LP[4] = (1 - LA[4])*y4*LG[4] + LA[4]*LP[4];
  l5 = LP[5] = (1 - LA[5])*y5*LG[5] + LA[5]*LP[5];
  l6 = LP[6] = (1 - LA[6])*y6*LG[6] + LA[6]*LP[6];
  l7 = LP[7] = (1 - LA[7])*y7*LG[7] + LA[7]*LP[7];
  a0 = l0 + l1; a1 = l0 - l1; a2 = l2 + l3; a3 = l2 - l3;
  a4 = l4 + l5; a5 = l4 - l5; a6 = l6 + l7; a7 = l6 - l7;
  b0 = a0 + a2; b2 = a0 - a2; b1 = a1 + a3; b3 = a1 - a3;
  b4 = a4 + a6; b6 = a4 - a6; b5 = a5 + a7; b7 = a5 - a7;
  wi = w & 4095;
  FDN[wi]         = (b0 + b4)*0.35355339 + d;
  FDN[4096 + wi]  = (b1 + b5)*0.35355339 + d;
  FDN[8192 + wi]  = (b2 + b6)*0.35355339 - d;
  FDN[12288 + wi] = (b3 + b7)*0.35355339 + d;
  FDN[16384 + wi] = (b0 - b4)*0.35355339 - d;
  FDN[20480 + wi] = (b1 - b5)*0.35355339 - d;
  FDN[24576 + wi] = (b2 - b6)*0.35355339 + d;
  FDN[28672 + wi] = (b3 - b7)*0.35355339 - d;
  ol_ = y0 - y1 + y2 - y3 + y4 - y5 + y6 - y7;
  or_ = y0 + y1 - y2 - y3 + y4 + y5 - y6 - y7;
  el = 0; k = 0; loop(r_nl, el += ERGL[k]*BUFA[(w - ERSL[k]) & MA]; k += 1;);
  er = 0; k = 0; loop(r_nr, er += ERGR[k]*BUFA[(w - ERSR[k]) & MA]; k += 1;);
  wl = r_tg*(r_cs*ol_ + r_sn*or_) + el;
  wr = r_tg*(r_sn*ol_ + r_cs*or_) + er;
  w_hp ? ( wl = wfh_l.hp1_run(wl); wr = wfh_r.hp1_run(wr); );
  w_lp ? ( wl = wfl_l.bq_run(wl); wr = wfl_r.bq_run(wr); );
  wl = rcol_l(wl); wr = rcol_r(wr);
  pt == 20 ? (
    op = abs(x) >= rg_thr || (rg_midi && midi_hit) || foot_hit;
    op ? ( rg_cnt = rg_hold + 1; trig_led = 1; );
    rg_cnt > 0 ? ( rg_cnt -= 1; rg_env = min(1, rg_env + 0.032); ) : ( rg_env = max(0, rg_env - rg_ir); );
    wl *= rg_env; wr *= rg_env;
  );
);

function er_tick() local(k, el, er)
(
  el = 0; k = 0; loop(e_nl, el += ERGL[k]*BUFA[(w - ERSL[k]) & MA]; k += 1;);
  er = 0; k = 0; loop(e_nr, er += ERGR[k]*BUFA[(w - ERSR[k]) & MA]; k += 1;);
  w_lp ? ( el = wfl_l.bq_run(el); er = wfl_r.bq_run(er); );
  wl = el; wr = er;
);

function dl_tick() local(yl, yr)
(
  yl = BUFL[(w - d_l) & MB]; yr = BUFR[(w - d_r) & MB];
  dlp_l = yl + d_hc*(dlp_l - yl); dlp_r = yr + d_hc*(dlp_r - yr);
  BUFL[w & MB] = x + d_fl*(d_hon ? dlp_l : yl);
  BUFR[w & MB] = x + d_fr*(d_hon ? dlp_r : yr);
  wl = yl; wr = yr;
);

function fl_tick() local(sn, dl, dr, yl, yr)
(
  m_ph += m_inc; m_ph -= floor(m_ph);
  sn = sin(2*$pi*m_ph);
  dl = max(1, m_base + m_dep*sn); dr = max(1, m_base - m_dep*sn);
  yl = rdi(BUFL, MB, dl); yr = rdi(BUFR, MB, dr);
  BUFL[w & MB] = x + m_fb*yl; BUFR[w & MB] = x + m_fb*yr;
  wl = yl; wr = yr;
);

function ch_tick() local(s0, s1, s2, vc, vl, vr)
(
  m_ph += m_inc; m_ph -= floor(m_ph);
  s0 = sin(2*$pi*m_ph); s1 = sin(2*$pi*(m_ph + 0.33333)); s2 = sin(2*$pi*(m_ph + 0.66667));
  vc = rdi(BUFA, MA, 375 + m_dep*s0)*(1 - m_am*0.5*(1 + s0));
  vl = rdi(BUFA, MA, 281 + m_dep*s1)*(1 - m_am*0.5*(1 + s1));
  vr = rdi(BUFA, MA, 469 + m_dep*s2)*(1 - m_am*0.5*(1 + s2));
  wl = 0.6*vc + 0.8*vl; wr = 0.6*vc + 0.8*vr;
);

function ph_tick() local(sn)
(
  m_ph += m_inc; m_ph -= floor(m_ph);
  sn = sin(2*$pi*m_ph);
  wl = 0.5*(x + rdi(BUFA, MA, max(0, m_base*(1 + m_dep*sn))));
  wr = 0.5*(x + rdi(BUFA, MA, max(0, m_base*(1 - m_dep*sn))));
);

function tr_tick() local(g, s0, s1, s2, vc, vl, vr, md)
(
  m_ph += m_inc; m_ph -= floor(m_ph);
  g = 1 - m_dep*(0.5 - 0.5*cos(2*$pi*m_ph));
  md = m_dep*15.625;
  s0 = sin(2*$pi*m_ph); s1 = sin(2*$pi*(m_ph + 0.33333)); s2 = sin(2*$pi*(m_ph + 0.66667));
  vc = rdi(BUFA, MA, 94 + md*s0); vl = rdi(BUFA, MA, 94 + md*s1); vr = rdi(BUFA, MA, 94 + md*s2);
  wl = (0.5*vc + 0.5*vl)*g; wr = (0.5*vc + 0.5*vr)*g;
);

function sy_tick() local(v0, v1, v2, v3, am)
(
  am = m_dep*78.125;
  sy0 += m_inc;       sy0 -= floor(sy0);
  sy1 += m_inc*1.27;  sy1 -= floor(sy1);
  sy2 += m_inc*0.79;  sy2 -= floor(sy2);
  sy3 += m_inc*1.61;  sy3 -= floor(sy3);
  v0 = rdi(BUFA, MA, 219 + am*sin(2*$pi*sy0));
  v1 = rdi(BUFA, MA, 344 + am/1.27*sin(2*$pi*(sy1 + 0.25)));
  v2 = rdi(BUFA, MA, 469 + am/0.79*sin(2*$pi*(sy2 + 0.5)));
  v3 = rdi(BUFA, MA, 594 + am/1.61*sin(2*$pi*(sy3 + 0.75)));
  wl = 0.5*(v0 + v2) + 0.25*v1; wr = 0.5*(v1 + v3) + 0.25*v2;
);

function adr_tick() local(xd)
(
  trig_check(g_thr, g_msk, g_midi) ? ( g_st = 1; g_cnt = g_edly; );
  g_st == 1 ? ( g_cnt -= 1; g_cnt <= 0 ? (g_st = 2); );
  g_st == 2 ? ( g_env += g_ia; g_env >= 1 ? ( g_env = 1; g_st = 3; ); );
  g_st == 3 ? ( g_env -= g_id; g_env <= g_dl ? ( g_env = g_dl; g_st = 4; g_cnt = g_hold; ); );
  g_st == 4 ? ( g_cnt -= 1; g_cnt <= 0 ? (g_st = 5); );
  g_st == 5 ? ( g_env -= g_ir; g_env <= 0 ? ( g_env = 0; g_st = 0; ); );
  xd = BUFA[(w - floor(g_adly)) & MA];
  wl = wr = xd*g_env;
);

function cp_tick() local(xd)
(
  trig_check(c_thr, c_msk, c_midi) ? ( c_st = 1; c_cnt = c_edly; );
  c_st == 1 ? ( c_cnt -= 1; c_cnt <= 0 ? (c_st = 2); );
  c_st == 2 ? ( c_g -= c_ia; c_g <= c_hl ? ( c_g = c_hl; c_st = 3; c_cnt = c_hold; ); );
  c_st == 3 ? ( c_cnt -= 1; c_cnt <= 0 ? (c_st = 4); );
  c_st == 4 ? ( c_g += c_ir; c_g >= 1 ? ( c_g = 1; c_st = 0; ); );
  xd = BUFA[(w - floor(c_adly)) & MA];
  wl = wr = xd*c_g;
);

function pitch_tick() local(yp)
(
  (pt == 21 || pt == 24) ? (
    yp = pa.pv_run(PBUF, MB, p_d1, p_r1, p_win);
    PBUF[w & MB] = x + p_fb*yp;
    wl = wr = yp;
  ) : pt == 22 ? (
    wl = wr = 0.6*(p1.pv_run(BUFA, MA, p_d1, p_r1, p_win) + p2.pv_run(BUFA, MA, p_d2, p_r2, p_win));
  ) : (
    wl = pl_.pv_run(BUFA, MA, p_d1, p_r1, p_win);
    wr = pr_.pv_run(BUFA, MA, p_d2, p_r2, p_win);
  );
);

function fz_begin() ( fz_rd = w + fz_tdly; fz_n = 0; fz_state = 3; fz_flash = floor(0.4*FS); trig_led = 1; );
function fz_tick() local(v, i, f, go)
(
  // ---- enregistrement ----
  fz_state == 1 ? (
    (ui_rec || foot_hit || (fz_auto && abs(x) >= 0.0316)) ? fz_begin();
  );
  fz_state == 3 ? (
    fz_flash > 0 ? (fz_flash -= 1);
    (w - fz_rd) >= 0 ? (
      v = BUFA[fz_rd & MA];
      FZB[fz_n] = fz_od ? FZB[fz_n] + v : v;
      fz_n += 1; fz_rd += 1;
      fz_n >= FZN ? ( fz_state = 0; fz_len = FZN; fz_ok = 1; );
    );
  );
  // ---- lecture ----
  pt == 25 ? (
    t_mask > 0 ? (t_mask -= 1);
    lvl_env < 0.0631 ? (t_armed = 1);
    go = ui_play || midi_hit || (foot_hit && fz_state != 1);
    (fz_itrg && fz_state != 1 && fz_state != 3 && abs(x) >= 0.125 && t_armed && t_mask <= 0) ? ( go = 1; t_armed = 0; t_mask = fz_msk; );
    go ? (
      fz_pp = fz_start; fz_play = 1; trig_led = 1;
      fz_rem = fz_end > fz_start ? fz_end - fz_start : FZN - fz_start + fz_end;
    );
    wl = 0;
    fz_play ? (
      wl = FZB[fz_pp]; fz_pp += 1; fz_pp >= FZN ? (fz_pp = 0);
      fz_rem -= 1; fz_rem <= 0 ? (fz_play = 0);
    );
  ) : (
    (ui_play || (foot_hit && fz_state != 1)) ? ( fz_play = !fz_play; fz_pos = 0; trig_led = 1; );
    midi_hit ? ( fz_play = 1; fz_pos = 0; trig_led = 1; );
    midi_off ? (fz_play = 0);
    wl = 0;
    fz_play ? (
      i = floor(fz_pos); f = fz_pos - i;
      wl = FZB[i]*(1 - f) + FZB[min(i + 1, FZN - 1)]*f;
      fz_pos += fz_rate; fz_pos >= FZN - 1 ? (fz_play = 0);
    );
  );
  wr = wl;
  ui_rec = 0; ui_play = 0;
);

function pan_tick() local(p, th)
(
  m_ph += m_inc; m_ph -= floor(m_ph);
  p = pn_dir == 0 ? -1 + 2*m_ph : pn_dir == 1 ? 1 - 2*m_ph : 4*abs(m_ph - 0.5) - 1;
  th = (p*m_dep + 1)*$pi*0.25;
  wl = x*cos(th)*1.41421356; wr = x*sin(th)*1.41421356;
);

function tp_tick() local(u, p, th, gl, gr, xd)
(
  trig_check(tp_thr, tp_msk, tp_midi) ? ( tp_st = 1; tp_cnt = tp_edly; );
  tp_st == 1 ? ( tp_cnt -= 1; tp_cnt <= 0 ? ( tp_st = 2; tp_t = 0; ); );
  tp_st == 2 ? (
    tp_env = tp_t < tp_a ? tp_t/tp_a : tp_t < tp_a + tp_p ? 1 : max(0, 1 - (tp_t - tp_a - tp_p)/tp_r);
    tp_t += 1; tp_t >= tp_a + tp_p + tp_r ? ( tp_st = 0; tp_env = 0; );
  );
  u = min(1, tp_t/(tp_a + tp_p + tp_r));
  p = tp_dir == 0 ? -1 + 2*u : 1 - 2*u;
  th = (p + 1)*$pi*0.25;
  gl = tp_bal + (1 - tp_bal)*cos(th)*1.41421356;
  gr = tp_bal + (1 - tp_bal)*sin(th)*1.41421356;
  xd = BUFA[(w - floor(tp_adly)) & MA];
  wl = xd*tp_env*gl; wr = xd*tp_env*gr;
);

function vb_tick() local(dd)
(
  trig_check(vb_thr, 1, vb_midi) ? ( vb_cnt = vb_dly; vb_d = 0; );
  vb_cnt > 0 ? ( vb_cnt -= 1; vb_d = 0; ) : ( vb_d = min(vb_dep, vb_d + vb_inc); );
  m_ph += m_inc; m_ph -= floor(m_ph);
  dd = 62.5 + 31.25*vb_d*sin(2*$pi*m_ph);
  wl = wr = rdi(BUFA, MA, dd);
);

function eq_tick() local(v)
(
  v = x;
  q_hp ? (v = peq_h1.hp1_run(v));
  v = peq_m.bq_run(v); v = peq_h.bq_run(v);
  q_lp ? (v = peq_l.bq_run(v));
  BUFL[w & MB] = v;
  wl = wr = BUFL[(w - q_d) & MB];
);

// ---- Un échantillon du DSP à 31,25 kHz ----------------------------------------------
function tick(xin)
(
  ad_pk = max(ad_pk, abs(xin));
  x = q16(xin);                                  // convertisseur A/N 16 bits
  BUFA[w & MA] = x;
  lvl_env = max(abs(x), lvl_env*c_lvl);
  wl = wr = 0;
  (pt <= 4 || pt == 20) ? rev_tick() :
  (pt == 5 || pt == 6 || pt == 16 || pt == 17) ? er_tick() :
  (pt == 7 || pt == 8) ? dl_tick() :
  (pt == 9 || pt == 10) ? fl_tick() :
  (pt == 11 || pt == 12) ? ch_tick() :
  pt == 13 ? ph_tick() :
  pt == 14 ? tr_tick() :
  pt == 15 ? sy_tick() :
  pt == 18 ? adr_tick() :
  pt == 19 ? cp_tick() :
  (pt >= 21 && pt <= 24) ? pitch_tick() :
  (pt == 25 || pt == 26) ? fz_tick() :
  pt == 27 ? pan_tick() :
  pt == 28 ? tp_tick() :
  pt == 29 ? vb_tick() :
  pt == 30 ? eq_tick();
  vintage ? (
    wl = (1 - bal)*x + bal*wl; wr = (1 - bal)*x + bal*wr;
  );
  hl = q16(wl); hr = q16(wr);                    // convertisseur N/A 16 bits
  midi_hit = 0; midi_off = 0; foot_hit = 0;
  w = (w + 1) & 1073741823;
);

// ---- Initialisation (une seule fois par instance) --------------------------------
!inited ? (
  inited = 1; pt = 0; w = 0; cph = 0; aa_prev = 0;
  mem_cur = 1; mem_sel = 1; browsing = 0; edited = 0; disp_mode = 0; cur_param = 1; bal_sel = 0;
  util_sel = 0; midich = 0; pc_en = 1; title_pos = 0; fz_len = 0; fz_ok = 0; fz_od = 0;
  t_armed = 1; c_g = 1; seed = 1;
  memset(FZB, 0, 65536);
  str_to_chars(CURT, PNM[1]);
);
!ub_init ? init_bank();
c_lvl = exp(-1/(0.05*FS));
conv_setup();

@serialize
ser_ver = 1;
file_var(0, ser_ver);
file_var(0, pt);
file_var(0, mem_cur);
file_var(0, edited);
file_var(0, midich);
file_var(0, pc_en);
file_var(0, ub_init);
file_mem(0, CURT, 16);
file_mem(0, UB, 1920);
file_var(0, fz_len);
fz_len > 0 ? file_mem(0, FZB, fz_len);
mem_sel = mem_cur; browsing = 0;

@slider
tn_ = floor(slider1 + 0.5);
tn_ != pt ? (
  pt = tn_;
  load_defaults(pt);
  mem_cur = pt; mem_sel = pt; browsing = 0; edited = 0; cur_param = 1; disp_mode = 0;
  clear_dsp();
);

@block
srate != sr_last ? conv_setup();

// ---- MIDI : notes (déclenchements, pitch), program change -----------------------------
while (midirecv(mofs, m1, m2, m3)) (
  mst = m1 & 0xF0;
  (midich == 0 || (m1 & 15) == midich - 1) ? (
    (mst == 0x90 && m3 > 0) ? ( midi_note = m2; midi_valid = 1; midi_hit = 1; ) :
    (mst == 0x80 || (mst == 0x90 && m3 == 0)) ? ( m2 == midi_note ? (midi_off = 1); ) :
    (mst == 0xC0 && pc_en && m2 < 90) ? ( pc_pending = m2 + 1; );
  );
  midisend(mofs, m1, m2, m3);
);
pc_pending > 0 ? (
  rc_n = pc_pending; pc_pending = 0;
  rc_n <= 30 ? (
    pt != rc_n ? ( pt = rc_n; clear_dsp(); ); slider1 = rc_n; load_defaults(rc_n);
  ) : (
    rc_s = UB + (rc_n - 31)*32;
    pt != rc_s[0] ? ( pt = rc_s[0]; clear_dsp(); ); slider1 = pt;
    rc_j = 1; loop(9, pset(rc_j, rc_s[rc_j]); rc_j += 1;);
    slider11 = rc_s[10]; slider12 = rc_s[11];
    rc_j = 0; loop(16, CURT[rc_j] = rc_s[12 + rc_j]; rc_j += 1;);
  );
  mem_cur = mem_sel = rc_n; browsing = 0; edited = 0; disp_mode = 0; cur_param = 1;
  sliderchange(4095);
);

// ---- Paramètres du programme courant -------------------------------------------------
pt >= 1 ? (
  bj_ = 1;
  loop(9, VAL[bj_] = bj_ <= PN[pt] ? pval(PK[pt*10 + bj_], cur_idx(bj_)) : 0; bj_ += 1;);
  prog_setup();
);
gin     = db2lin(slider13);
bal     = slider11/100;
outl    = slider12/100;
vintage = slider15 >= 0.5;
drymono = slider16 >= 0.5;
byp     = slider14 >= 0.5;
wdm     = min(max(slider19, 0), 100)/100;

@sample
inl = spl0; inr = spl1;
xm = 0.5*(inl + inr)*gin;
aa = aa1.bq_run(xm); aa = aa2.bq_run(aa); aa = aa3.bq_run(aa);
aa = aa4.bq_run(aa); aa = aa5.bq_run(aa); aa = aa6.bq_run(aa);

// ---- Horloge 31,25 kHz : prise d'échantillon interpolée, sans latence -------------
cph += cinc;
nt_ = floor(cph); cph -= nt_;
tj_ = nt_ - 1;
loop(nt_,
  tick(aa + (aa_prev - aa)*((cph + tj_)/cinc));
  tj_ -= 1;
);
aa_prev = aa;

// ---- Bloqueur d'ordre zéro + reconstruction ----------------------------------------
ol = el3l.bq_run(el2l.bq_run(el1l.bq_run(pkl.bq_run(rcl.bq_run(hl)))));
orr = el3r.bq_run(el2r.bq_run(el1r.bq_run(pkr.bq_run(rcr.bq_run(hr)))));
vintage ? (
  yl = ol; yr = orr;
) : (
  drymono ? ( dyl = dyr = 0.5*(inl + inr)*gin; ) : ( dyl = inl*gin; dyr = inr*gin; );
  yl = (1 - bal)*dyl + bal*ol; yr = (1 - bal)*dyr + bal*orr;
);
yl *= outl; yr *= outl;
// WET/DRY global : mélange avec le signal d'entrée propre (après INPUT)
wdm < 1 ? ( yl = (1 - wdm)*inl*gin + wdm*yl; yr = (1 - wdm)*inr*gin + wdm*yr; );
byp ? ( yl = inl; yr = inr; );
spl0 = min(max(yl, -1), 1);
spl1 = min(max(yr, -1), 1);

@gfx 1060 240
// thème : orange ou vert (double-clic sur le nom du plug-in), mémorisé dans slider18
slider18 >= 0.5 ? ( thc6r = 0.4; thc6g = 0.82; thc6b = 0.75; ) : ( thc6r = 0.93; thc6g = 0.62; thc6b = 0.22; );
S  = 0.75 + 0.25*floor(slider17 + 0.5);
ox = max(0, floor((gfx_w - 1060*S)/2));
oy = max(0, floor((gfx_h - 240*S)/2));
mx = (mouse_x - ox)/S;
my = (mouse_y - oy)/S;
gnow = time_precise();

gfx_setfont(1, "Arial", max(6, floor(11*S)), 'b');
gfx_setfont(2, "Arial", max(9, floor(22*S)), 'b');
gfx_setfont(3, "Arial", max(5, floor(10*S)));
gfx_setfont(4, "Courier New", max(10, floor(42*S)), 'b');
gfx_setfont(5, "Courier New", max(8, floor(26*S)), 'b');

function PX(v) ( ox + v*S; );
function PY(v) ( oy + v*S; );
function col(r, g, b) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = 1; );
function rct(rx, ry, rw, rh, f) ( gfx_rect(PX(rx), PY(ry), ceil(rw*S), ceil(rh*S), f); );
function text_c(tx, ty, sp) local(tw, th) ( gfx_measurestr(sp, tw, th); gfx_x = PX(tx) - tw*0.5; gfx_y = PY(ty) - th*0.5; gfx_drawstr(sp); );
function text_l(tx, ty, sp) ( gfx_x = PX(tx); gfx_y = PY(ty); gfx_drawstr(sp); );
function in_rect(rx, ry, rw, rh) ( mx >= rx && mx < rx + rw && my >= ry && my < ry + rh; );
function set_msg(sp) ( strcpy(#msg, sp); msg_t = time_precise() + 1.3; );
function tri(cx, cy, up) local(h)
(
  h = 5;
  up ? gfx_triangle(PX(cx - h), PY(cy + h*0.6), PX(cx + h), PY(cy + h*0.6), PX(cx), PY(cy - h*0.8)) :
       gfx_triangle(PX(cx - h), PY(cy - h*0.6), PX(cx + h), PY(cy - h*0.6), PX(cx), PY(cy + h*0.8));
);
function draw_key(kx, ky, kw, kh, lab, hot)
(
  hot ? col(0.30,0.30,0.32) : col(0.21,0.21,0.23);
  rct(kx, ky, kw, kh, 1);
  col(0.05,0.05,0.05); rct(kx, ky, kw, kh, 0);
  col(0.36,0.36,0.38); rct(kx + 1, ky + 1, kw - 2, 1, 1);
  gfx_setfont(1); col(0.88,0.88,0.86);
  text_c(kx + kw*0.5, ky + kh*0.5, lab);
);
function draw_led(lx, ly, on, r, g, b)
(
  on ? col(r, g, b) : col(r*0.22, g*0.22, b*0.22);
  gfx_circle(PX(lx), PY(ly), 3.2*S, 1, 1);
);
function draw_btn(bx, by, bw, bh, on, lab)
(
  on ? col(thc6r,thc6g,thc6b) : col(0.19,0.19,0.21);
  rct(bx, by, bw, bh, 1);
  col(0.04,0.04,0.04); rct(bx, by, bw, bh, 0);
  on ? col(0.10,0.07,0.03) : col(0.82,0.79,0.72);
  gfx_setfont(1); text_c(bx + bw*0.5, by + bh*0.5, lab);
);
function knob_s(cx, cy, r, frac) local(a, x1, y1, x2, y2, t)
(
  col(0.06,0.06,0.07); gfx_circle(PX(cx), PY(cy), r*S, 1, 1);
  col(0.32,0.32,0.34); gfx_circle(PX(cx), PY(cy), r*0.88*S, 0, 1);
  a = (225 - 270*frac)*$pi/180;
  x1 = cx + r*0.2*cos(a); y1 = cy - r*0.2*sin(a);
  x2 = cx + r*0.82*cos(a); y2 = cy - r*0.82*sin(a);
  col(thc6r,thc6g,thc6b);
  t = 0; loop(max(1, ceil(2*S)), gfx_line(PX(x1) + t, PY(y1), PX(x2) + t, PY(y2), 1); t += 1;);
);

// ---- Actions de la face avant ---------------------------------------------------------
function set_param_idx(j, ix) local(k, n)
(
  k = PK[pt*10 + j]; n = pcount(k);
  n > 1 ? (
    ix = min(max(ix, 0), n - 1);
    pset(j, ix/(n - 1)); slider_automate(2^j);
    edited = 1;
  );
);
function recall_mem(n) local(sl, j)
(
  n <= 30 ? (
    pt != n ? ( pt = n; clear_dsp(); ); slider1 = n; load_defaults(n);
  ) : (
    sl = UB + (n - 31)*32;
    pt != sl[0] ? ( pt = sl[0]; clear_dsp(); ); slider1 = pt;
    j = 1; loop(9, pset(j, sl[j]); j += 1;);
    slider11 = sl[10]; slider12 = sl[11];
    j = 0; loop(16, CURT[j] = sl[12 + j]; j += 1;);
  );
  mem_cur = n; mem_sel = n; browsing = 0; edited = 0; disp_mode = 0; cur_param = 1;
  sliderchange(4095); slider_automate(4095);
);
function store_mem(n) local(sl, j)
(
  n <= 30 ? ( set_msg("PROTECTED!"); ) : (
    sl = UB + (n - 31)*32;
    sl[0] = pt;
    j = 1; loop(9, sl[j] = pget(j); j += 1;);
    sl[10] = slider11; sl[11] = slider12;
    j = 0; loop(16, sl[12 + j] = CURT[j]; j += 1;);
    mem_cur = n; mem_sel = n; browsing = 0; edited = 0;
    set_msg("STORED");
  );
);
function build_title(src) local(i, c)
(
  #tt = ""; i = 0;
  loop(16, c = src[i]; (c < 32 || c > 126) ? (c = 32); sprintf(#ch, "%c", c); strcat(#tt, #ch); i += 1;);
);
function data_step(dir, big) local(k, n, ix, st, c)
(
  disp_mode == 0 ? (
    k = PK[pt*10 + cur_param]; n = pcount(k);
    k == 27 ? (
      cur_param == 5 ? ( ui_play = 1; ) : (
        dir < 0 ? ( fz_state = 1; fz_od = cur_param == 4; fz_ok = 0; fz_play = 0; ) :
                  ( fz_state == 1 ? (ui_rec = 1); );
      );
    ) : (
      st = big ? max(1, floor(n/100)) : 1;
      set_param_idx(cur_param, cur_idx(cur_param) + dir*st);
    );
  ) : disp_mode == 1 ? (
    st = big ? 5 : 1;
    bal_sel == 0 ? ( slider11 = min(max(floor(slider11 + 0.5) + dir*st, 0), 100); slider_automate(2^10); ) :
                   ( slider12 = min(max(floor(slider12 + 0.5) + dir*st, 0), 100); slider_automate(2^11); );
    edited = 1;
  ) : (
    util_sel == 0 ? (
      c = CURT[title_pos] + dir; c > 126 ? (c = 32); c < 32 ? (c = 126);
      CURT[title_pos] = c; edited = 1;
    ) : util_sel == 1 ? (
      midich = min(max(midich + dir, 0), 16);
    ) : (
      pc_en = !pc_en;
    );
  );
);
function param_default() local(k, n)
(
  disp_mode == 0 ? (
    k = PK[pt*10 + cur_param]; n = pcount(k);
    k != 27 ? set_param_idx(cur_param, idx_of(k, PD[pt*10 + cur_param]));
  ) : disp_mode == 1 ? (
    bal_sel == 0 ? ( slider11 = ROMBAL[pt]; slider_automate(2^10); ) : ( slider12 = 100; slider_automate(2^11); );
  );
);
function key_action(id)
(
  id == 1 ? ( disp_mode != 0 ? ( disp_mode = 0; ) : ( cur_param = (cur_param % max(PN[pt], 1)) + 1; ); browsing = 0; ) :
  id == 2 ? ( disp_mode == 1 ? ( bal_sel = 1 - bal_sel; ) : ( disp_mode = 1; bal_sel = 0; ); browsing = 0; ) :
  id == 3 ? data_step(-1, 0) :
  id == 4 ? data_step(1, 0) :
  id == 5 ? store_mem(browsing ? mem_sel : mem_cur) :
  id == 6 ? recall_mem(browsing ? mem_sel : mem_cur) :
  id == 7 ? ( browsing = 1; mem_sel = mem_sel <= 1 ? 90 : mem_sel - 1; ) :
  id == 8 ? ( browsing = 1; mem_sel = mem_sel >= 90 ? 1 : mem_sel + 1; ) :
  id == 9 ? ( disp_mode == 2 ? ( util_sel = (util_sel + 1) % 3; ) : ( disp_mode = 2; util_sel = 0; ); browsing = 0; ) :
  id == 10 ? ( foot_hit = 1; trig_led = 1; ) :
  id == 11 ? ( slider14 = slider14 >= 0.5 ? 0 : 1; slider_automate(2^13); );
);

// ---- Fond -------------------------------------------------------------------------
col(0.08,0.08,0.085); gfx_rect(0, 0, gfx_w, gfx_h);
col(0.14,0.14,0.15);  rct(6, 6, 1048, 228, 1);
col(0.03,0.03,0.03);  rct(6, 6, 1048, 30, 1);
gfx_setfont(2); col(thc6r,thc6g,thc6b); text_l(16, 10, "RM90X");
th_x1 = gfx_x; th_y0 = gfx_y; gfx_measurestr("RM90X", th_w, th_h); th_x0 = th_x1 - th_w;
gfx_setfont(3); col(0.72,0.69,0.63); text_l(104, 17, "RENO MELLOW  -  DIGITAL MULTI-EFFECT PROCESSOR");
col(0.62,0.60,0.55); gfx_setfont(3); text_l(920, 17, "31.25 kHz  16 BIT");

// ---- INPUT + LED --------------------------------------------------------------------
gfx_setfont(1); col(0.85,0.84,0.80); text_c(58, 56, "INPUT");
knob_s(58, 100, 24, (slider13 + 24)/36);
gfx_setfont(3); col(0.70,0.69,0.66);
sprintf(#s, "%+.1f dB", slider13); text_c(58, 140, #s);
g_pk = ad_pk; ad_pk = 0;
led_lv = max(g_pk, led_lv*0.8);
gi = 0;
loop(7,
  g_db = gi == 0 ? -30 : gi == 1 ? -24 : gi == 2 ? -18 : gi == 3 ? -12 : gi == 4 ? -6 : gi == 5 ? -3 : -0.1;
  g_on = led_lv >= db2lin(g_db);
  gi == 6 ? draw_led(112, 140 - gi*14, g_on, 1, 0.15, 0.1) :
  gi == 5 ? draw_led(112, 140 - gi*14, g_on, 1, 0.8, 0.1) :
            draw_led(112, 140 - gi*14, g_on, 0.25, 1, 0.25);
  gi += 1;
);
gfx_setfont(3); col(0.6,0.59,0.56); text_c(112, 156, "LEVEL");

// ---- WET / DRY (global, 100 % = traité seul) --------------------------------------------
gfx_setfont(1); col(0.85,0.84,0.80); text_c(1010, 56, "WET/DRY");
knob_s(1010, 100, 24, slider19/100);
gfx_setfont(3); col(0.70,0.69,0.66);
sprintf(#s, "%d %% WET", floor(slider19 + 0.5)); text_c(1010, 140, #s);

// ---- LCD 2 x 16 --------------------------------------------------------------------------
lcx = 150; lcy = 48; lcw = 412; lch = 104;
col(0.04,0.04,0.04); rct(lcx - 8, lcy - 6, lcw + 16, lch + 12, 1);
col(0.50,0.60,0.33); rct(lcx, lcy, lcw, lch, 1);
cw_ = 24; cx0 = lcx + (lcw - 16*cw_)*0.5; cy1 = lcy + 12; cy2 = lcy + 56; chh = 36;

// ligne 1
disp_mode == 2 ? (
  util_sel == 0 ? strcpy(#l1, "EDIT TITLE") : strcpy(#l1, "UTILITY");
) : browsing ? (
  mem_sel <= 30 ? ( str_to_chars(TMPT, PNM[mem_sel]); build_title(TMPT); ) : build_title(UB + (mem_sel - 31)*32 + 12);
  strcpy(#l1, #tt);
) : (
  build_title(CURT); strcpy(#l1, #tt);
);
// ligne 2
gnow < msg_t ? strcpy(#l2, #msg) :
browsing ? strcpy(#l2, "RECALL / STORE ?") :
disp_mode == 1 ? (
  bal_sel == 0 ? sprintf(#l2, "BALANCE=%d%%", floor(slider11 + 0.5)) : sprintf(#l2, "OUT LVL=%d%%", floor(slider12 + 0.5));
) : disp_mode == 2 ? (
  util_sel == 0 ? ( build_title(CURT); strcpy(#l2, #tt); ) :
  util_sel == 1 ? ( midich == 0 ? strcpy(#l2, "MIDI CH=OMNI") : sprintf(#l2, "MIDI CH=%d", midich); ) :
  ( pc_en ? strcpy(#l2, "PGM CHANGE=ON") : strcpy(#l2, "PGM CHANGE=OFF"); );
) : (
  cur_param = min(max(cur_param, 1), max(PN[pt], 1));
  g_k = PK[pt*10 + cur_param];
  g_k == 27 ? (
    cur_param == 5 ? ( fz_play ? strcpy(#l2, "PLAYING") : strcpy(#l2, "PLAY"); ) : (
      g_isod = cur_param == 4;
      (fz_state == 1 && fz_od == g_isod) ? strcpy(#l2, "REC READY") :
      (fz_state == 3 && fz_od == g_isod) ? ( fz_flash > 0 ? strcpy(#l2, "TRIGGER!") : strcpy(#l2, "...") ) :
      (fz_ok && fz_od == g_isod) ? strcpy(#l2, "OK") :
      ( g_isod ? strcpy(#l2, "OVER DUB") : strcpy(#l2, "RECORD") );
    );
  ) : (
    fmt(g_k, cur_idx(cur_param));
    strcpy(#l2, PL[pt*10 + cur_param]); strcat(#l2, "="); strcat(#l2, #fv);
  );
);

gfx_setfont(5);
gfx_measurestr("M", g_mw, g_mh);
gl_ = 0;
loop(2,
  gi = 0;
  loop(16,
    g_cx = cx0 + gi*cw_; g_cy = gl_ ? cy2 : cy1;
    col(0.46,0.56,0.30); rct(g_cx + 1, g_cy, cw_ - 3, chh, 1);
    strcpy(#cur, gl_ ? #l2 : #l1);
    gi < strlen(#cur) ? (
      g_c = str_getchar(#cur, gi);
      g_c > 32 ? (
        col(0.06,0.09,0.04);
        gfx_x = PX(g_cx + (cw_ - 2)*0.5) - g_mw*0.5; gfx_y = PY(g_cy + chh*0.5) - g_mh*0.5;
        gfx_drawchar(g_c);
      );
    );
    // curseur d'édition du titre
    (gl_ && disp_mode == 2 && util_sel == 0 && gi == title_pos && (floor(gnow*3) % 2)) ? (
      col(0.06,0.09,0.04); rct(g_cx + 2, g_cy + chh - 4, cw_ - 5, 3, 1);
    );
    gi += 1;
  );
  gl_ += 1;
);

// ---- Numéro de mémoire -----------------------------------------------------------------
mnx = 580; mny = 52;
col(0.03,0.03,0.03); rct(mnx - 4, mny - 4, 96, 70, 1);
col(0.10,0.02,0.02); rct(mnx, mny, 88, 62, 1);
gfx_setfont(4);
pn_edit ? (
  // saisie clavier du numéro de programme
  col(1, 0.16, 0.10);
  pn_len > 0 ? sprintf(#s, "%2d", pn_buf) : strcpy(#s, "  ");
  (floor(gnow*3) % 2) == 0 ? ( pn_len == 0 ? strcpy(#s, "--") : strcat(#s, "_"); );
  text_c(mnx + 44, mny + 31, #s);
) : (
  (browsing && (floor(gnow*4) % 2) == 0) ? col(0.30,0.04,0.03) : col(1, 0.16, 0.10);
  sprintf(#s, "%2d", browsing ? mem_sel : mem_cur); text_c(mnx + 44, mny + 31, #s);
);
edited ? ( col(1,0.16,0.10); gfx_circle(PX(mnx + 82), PY(mny + 54), 2.6*S, 1, 1); );
gfx_setfont(3); col(0.70,0.69,0.66); text_c(mnx + 44, mny + 80, "MEMORY NO.");
gfx_setfont(3); col(0.56,0.55,0.52);
sprintf(#s, "PROGRAM %d", pt); text_c(mnx + 44, mny + 94, #s);

// ---- Touches -----------------------------------------------------------------------------
kx0 = 690; kdx = 70; kw_ = 62; kh_ = 28; ky1 = 50; ky2 = 100; ky3 = 150;
draw_key(kx0,          ky1, kw_, kh_, "PARAMETER", disp_mode == 0);
draw_key(kx0 + kdx,    ky1, kw_, kh_, "BALANCE",   disp_mode == 1);
draw_key(kx0 + 2*kdx,  ky1, kw_, kh_, "", 0);
draw_key(kx0 + 3*kdx,  ky1, kw_, kh_, "", 0);
col(0.88,0.88,0.86); tri(kx0 + 2*kdx + kw_*0.5, ky1 + kh_*0.5, 0); tri(kx0 + 3*kdx + kw_*0.5, ky1 + kh_*0.5, 1);
gfx_setfont(3); col(0.70,0.69,0.66); text_c(kx0 + 2.5*kdx + kw_*0.5, ky1 - 7, "DEC    PARAMETER    INC");
draw_key(kx0,          ky2, kw_, kh_, "STORE", 0);
draw_key(kx0 + kdx,    ky2, kw_, kh_, "RECALL", browsing);
draw_key(kx0 + 2*kdx,  ky2, kw_, kh_, "", 0);
draw_key(kx0 + 3*kdx,  ky2, kw_, kh_, "", 0);
col(0.88,0.88,0.86); tri(kx0 + 2*kdx + kw_*0.5, ky2 + kh_*0.5, 0); tri(kx0 + 3*kdx + kw_*0.5, ky2 + kh_*0.5, 1);
gfx_setfont(3); col(0.70,0.69,0.66); text_c(kx0 + 2.5*kdx + kw_*0.5, ky2 - 7, "MEMORY");
draw_key(kx0,          ky3, kw_, kh_, "UTILITY", disp_mode == 2);
draw_key(kx0 + kdx,    ky3, kw_, kh_, "TRIGGER", 0);
draw_key(kx0 + 2*kdx,  ky3, kw_, kh_, "BYPASS", slider14 >= 0.5);
trig_led > 0 ? ( g_tl = gnow + 0.12; trig_led = 0; );
draw_led(kx0 + kdx + kw_ - 7, ky3 + 6, gnow < g_tl, 0.25, 1, 0.25);
draw_led(kx0 + 2*kdx + kw_ - 7, ky3 + 6, slider14 >= 0.5, 1, 0.15, 0.1);
gfx_setfont(3); col(0.56,0.55,0.52);
text_l(kx0 + 3*kdx - 2, ky3 + 4, "MIDI");
midich == 0 ? text_l(kx0 + 3*kdx - 2, ky3 + 16, "OMNI") : ( sprintf(#s, "CH %d", midich); text_l(kx0 + 3*kdx - 2, ky3 + 16, #s); );

// ---- Bandeau d'options --------------------------------------------------------------
col(0.06,0.06,0.06); rct(6, 196, 1048, 38, 1);
oby = 204;
gfx_setfont(3); col(0.85,0.82,0.75); text_l(20, oby + 6, "CHARACTER");
draw_btn(84, oby, 68, 22, slider15 < 0.5, "MODERN");
draw_btn(156, oby, 68, 22, slider15 >= 0.5, "VINTAGE");
gfx_setfont(3); col(0.85,0.82,0.75); text_l(246, oby + 6, "DRY");
draw_btn(274, oby, 60, 22, slider15 < 0.5 && slider16 < 0.5, "STEREO");
draw_btn(338, oby, 60, 22, slider15 < 0.5 && slider16 >= 0.5, "MONO");
gfx_setfont(3); col(0.55,0.54,0.50);
text_l(420, oby + 6, "LCD: DRAG / WHEEL = DATA    SHIFT = FINE    CTRL+CLICK = DEFAULT");
gfx_setfont(3); col(0.85,0.82,0.75); text_l(850, oby + 6, "SIZE");
szx = 880; sz = floor(slider17 + 0.5);
draw_btn(szx,       oby, 40, 22, sz == 0, "75%");
draw_btn(szx + 43,  oby, 40, 22, sz == 1, "100%");
draw_btn(szx + 86,  oby, 40, 22, sz == 2, "125%");
draw_btn(szx + 129, oby, 40, 22, sz == 3, "150%");

// ---- Souris ---------------------------------------------------------------------------
md = mouse_cap & 1;
g_shift = mouse_cap & 8;
g_ctrl = mouse_cap & 4;
(md && !last_md) ? (
  hold_id = 0; lcd_drag = 0; knob_drag = 0;
  // double-clic sur le numéro de mémoire : saisie au clavier
  in_rect(mnx - 4, mny - 4, 96, 70) ? (
    (gnow - pn_t < 0.4) ? ( pn_edit = 1; pn_buf = 0; pn_len = 0; pn_t = 0; ) : ( pn_t = gnow; );
  ) : ( pn_edit = 0; );
  g_hit = in_rect(kx0, ky1, kw_, kh_) ? 1 : in_rect(kx0 + kdx, ky1, kw_, kh_) ? 2 :
          in_rect(kx0 + 2*kdx, ky1, kw_, kh_) ? 3 : in_rect(kx0 + 3*kdx, ky1, kw_, kh_) ? 4 :
          in_rect(kx0, ky2, kw_, kh_) ? 5 : in_rect(kx0 + kdx, ky2, kw_, kh_) ? 6 :
          in_rect(kx0 + 2*kdx, ky2, kw_, kh_) ? 7 : in_rect(kx0 + 3*kdx, ky2, kw_, kh_) ? 8 :
          in_rect(kx0, ky3, kw_, kh_) ? 9 : in_rect(kx0 + kdx, ky3, kw_, kh_) ? 10 :
          in_rect(kx0 + 2*kdx, ky3, kw_, kh_) ? 11 : 0;
  g_hit > 0 ? (
    key_action(g_hit);
    (g_hit == 3 || g_hit == 4 || g_hit == 7 || g_hit == 8) ? ( hold_id = g_hit; hold_t0 = gnow; hold_last = gnow; );
  ) : in_rect(lcx, lcy, lcw, lch) ? (
    g_ctrl ? param_default() : ( lcd_drag = 1; drag_acc = 0; );
  ) : ((mx - 58)*(mx - 58) + (my - 100)*(my - 100) <= 900) ? (
    g_ctrl ? ( slider13 = 0; slider_automate(2^12); ) : knob_drag = 1;
  ) : ((mx - 1010)*(mx - 1010) + (my - 100)*(my - 100) <= 900) ? (
    g_ctrl ? ( slider19 = 100; slider_automate(2^18); ) : knob_drag = 2;
  ) : in_rect(84, oby, 68, 22) ? ( slider15 = 0; slider_automate(2^14); ) :
    in_rect(156, oby, 68, 22) ? ( slider15 = 1; slider_automate(2^14); ) :
    in_rect(274, oby, 60, 22) ? ( slider16 = 0; slider_automate(2^15); ) :
    in_rect(338, oby, 60, 22) ? ( slider16 = 1; slider_automate(2^15); ) :
    in_rect(szx, oby, 40, 22) ? ( slider17 = 0; sliderchange(2^16); ) :
    in_rect(szx + 43, oby, 40, 22) ? ( slider17 = 1; sliderchange(2^16); ) :
    in_rect(szx + 86, oby, 40, 22) ? ( slider17 = 2; sliderchange(2^16); ) :
    in_rect(szx + 129, oby, 40, 22) ? ( slider17 = 3; sliderchange(2^16); );
);
// répétition des touches DEC / INC / MEMORY
(md && hold_id > 0 && gnow - hold_t0 > 0.4 && gnow - hold_last > 0.06) ? (
  hold_last = gnow;
  (hold_id == 3 || hold_id == 4) ? data_step(hold_id == 3 ? -1 : 1, gnow - hold_t0 > 1.5) : key_action(hold_id);
);
// glisser sur le LCD = valeur
(md && lcd_drag) ? (
  g_dy = last_my - my;
  g_dy != 0 ? (
    disp_mode == 0 ? ( g_n = pcount(PK[pt*10 + cur_param]); g_rate = g_shift ? 0.25 : max(0.34, g_n/250); ) : ( g_rate = g_shift ? 0.25 : 0.5; );
    drag_acc += g_dy*g_rate;
    gd_st = drag_acc >= 0 ? floor(drag_acc) : -floor(-drag_acc);
    gd_st != 0 ? (
      drag_acc -= gd_st;
      (disp_mode == 0 && PK[pt*10 + cur_param] != 27) ? set_param_idx(cur_param, cur_idx(cur_param) + gd_st) :
      disp_mode != 0 ? data_step(gd_st > 0 ? 1 : -1, 0);
    );
  );
);
// bouton INPUT
(md && knob_drag == 1) ? (
  g_dy = last_my - my;
  g_dy != 0 ? ( slider13 = min(max(slider13 + g_dy*(g_shift ? 0.02 : 0.15), -24), 12); slider_automate(2^12); );
);
// bouton WET/DRY
(md && knob_drag == 2) ? (
  g_dy = last_my - my;
  g_dy != 0 ? ( slider19 = min(max(slider19 + g_dy*(g_shift ? 0.1 : 0.5), 0), 100); slider_automate(2^18); );
);
// molette sur le LCD
mouse_wheel != 0 ? (
  in_rect(lcx, lcy, lcw, lch) ? (
    g_dir = mouse_wheel > 0 ? 1 : -1;
    (disp_mode == 0 && PK[pt*10 + cur_param] != 27) ? (
      g_n = pcount(PK[pt*10 + cur_param]);
      set_param_idx(cur_param, cur_idx(cur_param) + g_dir*(g_shift ? 1 : max(1, floor(g_n/200))));
    ) : disp_mode != 0 ? data_step(g_dir, 0);
  );
  mouse_wheel = 0;
);
!md ? ( hold_id = 0; lcd_drag = 0; knob_drag = 0; );
last_md = md;
last_my = my;

// ---- Clavier : édition du titre (UTILITY > EDIT TITLE) -------------------------------
loop(8,
  g_ch = gfx_getchar();
  (g_ch > 0 && pn_edit) ? (
    (g_ch >= 48 && g_ch <= 57 && pn_len < 2) ? ( pn_buf = pn_buf*10 + g_ch - 48; pn_len += 1; ) :
    g_ch == 8 ? ( pn_buf = floor(pn_buf/10); pn_len = max(pn_len - 1, 0); ) :
    g_ch == 13 ? ( (pn_buf >= 1 && pn_buf <= 90) ? recall_mem(pn_buf); pn_edit = 0; ) :
    g_ch == 27 ? ( pn_edit = 0; );
    g_ch = 0;
  );
  (g_ch > 0 && disp_mode == 2 && util_sel == 0) ? (
    (g_ch >= 32 && g_ch <= 126) ? (
      g_ch >= 97 && g_ch <= 122 ? (g_ch -= 32);
      CURT[title_pos] = g_ch; title_pos = min(title_pos + 1, 15); edited = 1;
    ) : g_ch == 8 ? (
      title_pos = max(title_pos - 1, 0); CURT[title_pos] = 32; edited = 1;
    ) : g_ch == 1818584692 ? ( title_pos = max(title_pos - 1, 0); ) :
        g_ch == 1919379572 ? ( title_pos = min(title_pos + 1, 15); );
  );
);

// ---- Thème : double-clic sur le nom du plug-in = orange / vert ----------------------------
th_mb = mouse_cap & 1;
(th_mb && !th_lmb) ? (
  (mouse_x >= th_x0 - 6 && mouse_x <= th_x1 + 6 && mouse_y >= th_y0 - 6 && mouse_y <= th_y0 + th_h + 6) ? (
    (time_precise() - th_t < 0.4) ? ( slider18 = slider18 >= 0.5 ? 0 : 1; sliderchange(2^17); th_t = 0; ) : ( th_t = time_precise(); );
  );
);
th_lmb = th_mb;

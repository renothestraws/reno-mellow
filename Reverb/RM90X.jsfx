PNM[30] = "PARAMETRIC EQ";   defp(30,1,4,"HPF",0); defp(30,2,34,"MID FRQ",500); defp(30,3,35,"MID GAIN",0); defp(30,4,36,"MID Q",1.0); defp(30,5,37,"HI FRQ",2000);

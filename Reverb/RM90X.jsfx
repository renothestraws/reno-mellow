PNM[17] = "REVERSE GATE";    defp(17,1,6,"TYPE",2); defp(17,2,7,"ROOM SIZE",3.3); defp(17,3,8,"LIVENESS",5); defp(17,4,9,"DELAY",29); defp(17,5,5,"LPF",0);

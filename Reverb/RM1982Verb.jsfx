  );
);
kbx_lmb = kbx_mb;
kbx_ed > 0 ? ( mouse_wheel = 0; );

// ---- Souris ----------------------------------------------------------------------------------
mb1 = mouse_cap & 1;
(mb1 && !last_mb) ? (
  drag = br_hit ? 0 : k_hit();
  drag > 0 ? (
    (mouse_cap & 4) ? ( k_put(drag, k_df(drag)); drag = 0; ) : ( drag_f = k_frac(drag); );
  );
  fld_was = fld_help; fld_help = 0;
  (in_rect(590, 84, 30, 24) && !fld_was) ? ( fld_help = 1; br_on = 0; );
  // navigateur : clic sur le nom de l'IR
  in_rect(102, 84, 484, 24) ? (
    br_on = !br_on;
    br_on ? (
      ix_read(); ix_cur = ix_ok ? ix_match() : -1;
      br_fold = ix_cur >= 0 ? IX_FI[ix_cur] : min(max(br_fold, 0), max(ix_nd - 1, 0));
      br_sd = max(0, min(br_fold - 7, ix_nd - BR_N));
      br_sf = ix_cur >= 0 ? max(0, min(ix_cur - IX_DF[br_fold] - 7, IX_DN[br_fold] - BR_N)) : 0;
    );
  );
  // flèches : IR précédente / suivante du dossier (index IR Buddy)
  (in_rect(34, 84, 28, 24) || in_rect(66, 84, 28, 24)) ? (
    !ix_ok ? ix_read();
    ix_nf > 0 ? (
      ix_cur < 0 ? (
        br_d = min(max(br_fold, 0), ix_nd - 1); ix_load(IX_DF[br_d]);
      ) : (
        br_d = IX_FI[ix_cur]; br_k = ix_cur - IX_DF[br_d] + (in_rect(66, 84, 28, 24) ? 1 : -1);
        br_k < 0 ? br_k = IX_DN[br_d] - 1 : br_k >= IX_DN[br_d] ? br_k = 0;
        ix_load(IX_DF[br_d] + br_k);
      );
      br_fold = IX_FI[ix_cur];
    ) : ( br_on = 1; );
  );
  // navigateur ouvert : dossiers, fichiers, fermeture
  br_hit ? (
    in_rect(620, 119, 20, 18) ? br_on = 0 :
    in_rect(34, 142, 182, BR_N*18) ? (
      br_d = br_sd + floor((my - 142)/18);
      br_d < ix_nd ? ( br_fold = br_d; br_sf = 0; );
    ) :
    in_rect(218, 142, 424, BR_N*18) ? (
      br_k = br_sf + floor((my - 142)/18);
      (ix_nd > 0 && br_k < IX_DN[br_fold]) ? ix_load(IX_DF[br_fold] + br_k);
    );
  );
  in_rect(872, 342, 106, 22) ? set_sl(13, 1);
  in_rect(872, 368, 106, 22) ? set_sl(13, 0);
  (in_rect(1056, 84, 124, 310)) ? ( gm_i0 = gm_i1 = gm_o0 = gm_o1 = 0; );
  ui = 0; loop(5, in_rect(992 + ui*42, 435, 40, 24) ? ( slider14 = ui; sliderchange(slider14); ); ui += 1;);
);
(mb1 && drag > 0) ? (
  fine = (mouse_cap & 8) ? 0.2 : 1;
  dy = (last_my - my)*fine;
  dy != 0 ? ( drag_f = min(max(drag_f + dy*0.005, 0), 1); k_set_frac(drag, drag_f); );
);
(mouse_wheel != 0 && br_hit) ? (
  wv = mouse_wheel > 0 ? -3 : 3;
  mx < 216 ? br_sd = max(0, min(br_sd + wv, ix_nd - BR_N)) : ( ix_nd > 0 ? br_sf = max(0, min(br_sf + wv, IX_DN[br_fold] - BR_N)); );
  mouse_wheel = 0;
);
mouse_wheel != 0 ? (
  wv = mouse_wheel/120*((mouse_cap & 8) ? 0.2 : 1);
  kw = k_hit();
  kw > 0 ? k_set_frac(kw, k_frac(kw) + wv*0.02);
  mouse_wheel = 0;
);
!mb1 ? (drag = 0);
last_mb = mb1;
last_my = (mouse_y - oy)/S;

// ---- Thème : double-clic sur le nom du plug-in = orange / vert ----------------------------
th_mb = mouse_cap & 1;
(th_mb && !th_lmb) ? (
  (mouse_x >= th_x0 - 6 && mouse_x <= th_x1 + 6 && mouse_y >= th_y0 - 6 && mouse_y <= th_y0 + th_h + 6) ? (
    (time_precise() - th_t < 0.4) ? ( slider18 = slider18 >= 0.5 ? 0 : 1; sliderchange(slider18); th_t = 0; ) : ( th_t = time_precise(); );
  );
);
th_lmb = th_mb;

// ---- Navigateur d'IR (clic sur le nom de l'IR) --------------------------------------------
BR_N = 15;
br_on && !fld_help ? (
  col(0.06,0.065,0.07); rct(34, 116, 610, 300, 1); col(thc0r,thc0g,thc0b); rct(34, 116, 610, 300, 0);
  gfx_setfont(4); col(thc0r,thc0g,thc0b); text_l(44, 128, "IR BROWSER");
  gfx_setfont(6); col(0.55,0.56,0.60);
  sprintf(#s, "%d IR  -  %d folders  -  REAPER/Data/RM IR", ix_nf, ix_nd); text_l(140, 128, #s);
  draw_btn(620, 119, 20, 18, 0, "x");
  col(0.03,0.03,0.035); rct(34, 140, 610, 1, 1); rct(216, 141, 1, 274, 1);
  ix_nf <= 0 ? (
    gfx_setfont(4); col(0.92,0.93,0.95); ix_ok ? strcpy(#s, "No IR in the index") : strcpy(#s, "No IR index yet"); text_c(339, 230, #s);
    gfx_setfont(5); col(0.62,0.63,0.66);
    text_c(339, 256, "Run the action  ReNo Mellow - IR Buddy - Rescan RM IR  (IR Buddy script),");
    text_c(339, 274, "then click the IR name again. The \"IR file\" list above still works without it.");
  ) : (
    br_fold = min(max(br_fold, 0), ix_nd - 1);
    gfx_setfont(1); ui = 0;
    loop(BR_N,
      br_d = br_sd + ui;
      br_d < ix_nd ? (
        br_d == br_fold ? ( col(thc0r,thc0g,thc0b); rct(36, 142 + ui*18, 179, 18, 1); col(thc5r,thc5g,thc5b); ) :
          ( (ix_cur >= 0 && IX_FI[ix_cur] == br_d) ? col(thc1r,thc1g,thc1b) : col(0.80,0.81,0.84); );
        ix_str(IX_DO[br_d], IX_DL[br_d]); strcpy(#s, #ixs);
        strlen(#s) > 24 ? ( strcpy_substr(#s2, #s, strlen(#s) - 22); strcpy(#s, ".."); strcat(#s, #s2); );
        text_l(42, 151 + ui*18, #s);
      );
      br_k = br_sf + ui;
      br_k < IX_DN[br_fold] ? (
        br_i = IX_DF[br_fold] + br_k;
        br_i == ix_cur ? ( col(thc0r,thc0g,thc0b); rct(218, 142 + ui*18, 424, 18, 1); col(thc5r,thc5g,thc5b); ) :
          ( (in_rect(218, 142 + ui*18, 424, 18)) ? col(1,1,1) : col(0.80,0.81,0.84); );
        ix_str(IX_NO[br_i], IX_NL[br_i]); strcpy(#s, #ixs);
        strlen(#s) > 60 ? ( strcpy_substr(#s2, #s, 0, 58); strcpy(#s, #s2); strcat(#s, ".."); );
        text_l(226, 151 + ui*18, #s);
      );
      ui += 1;
    );
    gfx_setfont(6); col(0.45,0.46,0.50);
    ix_nd > BR_N ? text_c(125, 410, "wheel: more folders");
    IX_DN[br_fold] > BR_N ? text_c(430, 410, "wheel: more IRs");
  );
);

// ---- Aide : ajouter son propre dossier d'IR ------------------------------------------------
fld_help ? (
  col(0.06,0.065,0.07); rct(34, 116, 586, 120, 1); col(thc0r,thc0g,thc0b); rct(34, 116, 586, 120, 0);
  gfx_setfont(4); col(thc0r,thc0g,thc0b); text_l(48, 132, "YOUR OWN IR FOLDER");
  gfx_setfont(5); col(0.92,0.93,0.95);
  text_l(48, 156, "1.  In REAPER: Actions > Show action list");
  text_l(48, 174, "2.  Run  ReNo Mellow - IR Buddy - Add IR folder  and pick your folder");
  text_l(48, 192, "3.  Click the IR name to browse it (after adding files by hand: IR Buddy - Rescan RM IR)");
  gfx_setfont(6); col(0.55,0.56,0.60); text_l(48, 216, "IR Buddy is a free ReNo Mellow script (ReaPack / .ReaperPkg).  Click anywhere to close.");
);

// ---- Saisie clavier : cadre d'édition ----------------------------------------------------
kbx_ed > 0 ? (
  kbx_cx = k_cx(kbx_ed); kbx_cy = k_vy(kbx_ed);
  gfx_setfont(15, "Arial", 14*kbx_sc, 'b');
  col(0.06,0.065,0.07); gfx_a = 0.96;
  gfx_rect(PX(kbx_cx - 46), PY(kbx_cy - 11), 92*kbx_sc, 22*kbx_sc);
  col(thc0r,thc0g,thc0b);
  gfx_rect(PX(kbx_cx - 46), PY(kbx_cy - 11), 92*kbx_sc, 22*kbx_sc, 0);
  strcpy(#kbx_sh, #kbx_ed);
  (time_precise()*2) % 2 < 1 ? strcat(#kbx_sh, "_");
  gfx_measurestr(#kbx_sh, kbx_tw, kbx_th);
  gfx_x = PX(kbx_cx) - kbx_tw/2; gfx_y = PY(kbx_cy) - kbx_th/2;
  col(0.95,0.95,0.95);
  gfx_drawstr(#kbx_sh);
);

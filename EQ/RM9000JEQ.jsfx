// ---- Vumètres LED d'entrée / sortie -----------------------------------------------------
in_m  = 10*log10(max(mi, 0.00000000000000000001)) + 18;
out_m = 10*log10(max(mo, 0.00000000000000000001)) + 18;
gfx_setfont(6); col(0.95,0.95,0.95);
text_l(16, 826, "IN"); text_l(16, 848, "OUT");
i = 0;
loop(8,
  w = MTV[i]; x = 76 + i*34;
  gfx_setfont(3); col(0.95,0.95,0.95);
  w > 0 ? sprintf(#s, "+%d", w) : sprintf(#s, "%d", w); text_c(x, 806, #s);
  w >= 6 ? ( vled(x, 826, in_m >= w, 0.95, 0.15, 0.10); vled(x, 848, out_m >= w, 0.95, 0.15, 0.10); ) :
  w >= 0 ? ( vled(x, 826, in_m >= w, 0.98, 0.88, 0.15); vled(x, 848, out_m >= w, 0.98, 0.88, 0.15); ) :
           ( vled(x, 826, in_m >= w, 0.20, 0.95, 0.25); vled(x, 848, out_m >= w, 0.20, 0.95, 0.25); );
  i += 1;
);


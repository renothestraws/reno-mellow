draw_btn(260, 915, 62, 22, sz == 3, "150%");

// ---- Souris ----------------------------------------------------------------------------------
mb1 = mouse_cap & 1;
(mb1 && !last_mb) ? (
  drag = 0;
  dist(HPX, HPY)   < 30 ? ( drag = 1; scp = hp_pos(slider1); );
  dist(LPX, LPY)   < 30 ? ( drag = 3; scp = lp_pos(slider3); );
  dist(HFGX, HFGY) < 30 ? drag = 5;
  dist(HFFX, HFFY) < 30 ? ( drag = 6;  scp = lpos(slider6, 1500, 22000); );
  dist(HMGX, HMGY) < 30 ? drag = 8;
  dist(HMFX, HMFY) < 30 ? ( drag = 9;  scp = lpos(slider9, 600, 7000); );
  dist(HMQX, HMQY) < 24 ? ( drag = 10; scp = q_pos(slider10); );
  dist(LMGX, LMGY) < 30 ? drag = 12;
  dist(LMFX, LMFY) < 30 ? ( drag = 13; scp = lpos(slider13, 200, 2500); );
  dist(LMQX, LMQY) < 24 ? ( drag = 14; scp = q_pos(slider14); );
  dist(LFGX, LFGY) < 30 ? drag = 16;
  dist(LFFX, LFFY) < 30 ? ( drag = 17; scp = lpos(slider17, 40, 600); );
  dist(70, 894)  < 13 ? drag = 21;
  dist(218, 894) < 13 ? drag = 22;
  in_rect(150, 52, 44, 24)   ? flip(2);
  in_rect(278, 52, 44, 24)   ? flip(4);
  in_rect(212, 192, 110, 22) ? flip(19);
  in_rect(236, 13, 88, 26)   ? flip(20);
  in_rect(122, 226, 70, 22)  ? flip(7);
  in_rect(136, 466, 44, 22)  ? flip(11);
  in_rect(136, 630, 44, 22)  ? flip(15);
  in_rect(122, 682, 70, 22)  ? flip(18);
  in_rect(282, 883, 42, 22) ? set_sl(24, slider24 >= 0.5 ? 0 : 1);
  in_rect(62,  915, 62, 22) ? (slider23 = 0; sliderchange(slider23););
  in_rect(128, 915, 62, 22) ? (slider23 = 1; sliderchange(slider23););
  in_rect(194, 915, 62, 22) ? (slider23 = 2; sliderchange(slider23););
  in_rect(260, 915, 62, 22) ? (slider23 = 3; sliderchange(slider23););
  // Ctrl+clic : valeur par défaut
  (drag > 0 && (mouse_cap & 4)) ? (
    set_sl(drag, drag == 1 ? 0 : drag == 3 ? 30000 : drag == 6 ? 8000 : drag == 9 ? 2500 :
                 drag == 13 ? 600 : drag == 17 ? 100 : (drag == 10 || drag == 14) ? 1.2 : 0);
    drag = 0;
  );
);
(mb1 && drag > 0) ? (
  fine = (mouse_cap & 8) ? 0.1 : 1;
  dy = (last_my - my)*fine;
  dy != 0 ? (
    (drag == 1 || drag == 3 || drag == 6 || drag == 9 || drag == 10 || drag == 13 || drag == 14 || drag == 17) ? (
      scp = min(max(scp + dy*0.005, 0), 1);
      drag == 1  ? set_sl(1,  floor(hp_hz(scp) + 0.5)) :
      drag == 3  ? set_sl(3,  floor(lp_hz(scp) + 0.5)) :
      drag == 6  ? set_sl(6,  floor(lval(scp, 1500, 22000) + 0.5)) :
      drag == 9  ? set_sl(9,  floor(lval(scp, 600, 7000) + 0.5)) :
      drag == 13 ? set_sl(13, floor(lval(scp, 200, 2500) + 0.5)) :
      drag == 17 ? set_sl(17, floor(lval(scp, 40, 600) + 0.5)) :
                   set_sl(drag, floor(q_val(scp)*100 + 0.5)/100);
    ) :
    (drag == 5 || drag == 16) ? set_sl(drag, floor(min(max(slider(drag) + dy*0.15, -15), 15)*10 + 0.5)/10) :
    (drag == 8 || drag == 12) ? set_sl(drag, floor(min(max(slider(drag) + dy*0.2, -20), 20)*10 + 0.5)/10) :
    set_sl(drag, floor(min(max(slider(drag) + dy*0.12, -12), 12)*10 + 0.5)/10);
  );
);
!mb1 ? (drag = 0);
last_mb = mb1;
last_my = (mouse_y - oy)/S;
